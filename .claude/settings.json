{
  "permissions": {
    "allow": [
      "Bash(python3 competitive-intelligence/run_daily.py)",
      "Bash(python3 competitive-intelligence/run_daily.py *)",
      "Bash(python3 -m unittest discover *)",
      "Bash(bash competitive-intelligence/storage/data_sync_ci.sh *)",
      "Bash(git fetch *)",
      "Bash(git checkout main)",
      "Bash(git reset --hard origin/main)",
      "Bash(git rev-parse *)",
      "Bash(git ls-tree *)",
      "Bash(git status *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./src/data/zoho-hierarchy.ts)",
      "Read(./scripts/catalog/*.json)",
      "Read(./scripts/content/zoho-rules.json)",
      "Read(./scripts/content/zoho-cards.json)",
      "Read(./scripts/seo/tests/fixtures/**)",
      "Read(./pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 240
          }
        ]
      }
    ]
  }
}

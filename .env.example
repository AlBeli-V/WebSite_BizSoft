# ─── Directus (внутренняя сеть Docker на проде; локально — через SSH-тоннель) ───
DIRECTUS_URL=http://127.0.0.1:8055
# Токен сервисного аккаунта (read published) ИЛИ статический токен админа для инструментов
DIRECTUS_TOKEN=
# Учётка админа Directus — нужна скрипту создания схемы и инструментам цен
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=

# ─── Сайт ───
SITE_URL=https://biz-soft.pro

# ─── Защита админ-инструментов цен (массовое изменение, CSV, курс ЦБ) ───
ADMIN_TOOLS_TOKEN=change-me-long-random-string

# ─── SMTP для писем КП/уведомлений (nodemailer) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Отправитель по умолчанию
SMTP_FROM="BizSoft <hello@biz-soft.pro>"
# Отправитель писем клиентам (КП, ответы). SMTP-сервер должен разрешать этот адрес.
SMTP_FROM_SALES="BizSoft <hello@biz-soft.pro>"
# Менеджер: сюда уходят заявки со всех форм и копии отправленных КП
MANAGER_EMAIL=avbelyaev@biz-soft.pro

# ─── Аналитика (публичные) ───
PUBLIC_METRIKA_ID=
PUBLIC_GA_ID=

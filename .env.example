# ─── Directus (внутренняя сеть Docker на проде; локально — через SSH-тоннель) ───
DIRECTUS_URL=http://127.0.0.1:8055
# Токен сервисного аккаунта (read published) ИЛИ статический токен админа для инструментов
DIRECTUS_TOKEN=
# Учётка админа Directus — нужна скрипту создания схемы и инструментам цен
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=

# ─── Сайт ───
SITE_URL=https://biz-soft.pro

# ─── Защита админ-инструментов цен (массовое изменение, CSV, курс ЦБ) ───
ADMIN_TOOLS_TOKEN=change-me-long-random-string

# ─── SMTP для писем КП/уведомлений (nodemailer) ───
# Почта biz-soft.pro развёрнута на хостинге reg.ru.
# Сервер входящей/исходящей почты: mail.hosting.reg.ru (IMAP 143, SMTP 25).
# SMTP 25 — без SSL (STARTTLS при поддержке сервером); альтернатива — 465 (SMTP_SECURE=true).
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=25
SMTP_SECURE=false
# Логин = полный адрес ящика; пароль — пароль ящика из панели reg.ru.
# Ящик должен иметь право слать от адреса в SMTP_FROM.
SMTP_USER=hello@biz-soft.pro
SMTP_PASS=
# Отправитель по умолчанию (должен совпадать с ящиком SMTP_USER или его разрешённым алиасом)
SMTP_FROM="BizSoft <hello@biz-soft.pro>"
# Отправитель писем клиентам (КП, ответы)
SMTP_FROM_SALES="BizSoft <hello@biz-soft.pro>"
# Менеджер: сюда уходят заявки со всех форм и копии отправленных КП
MANAGER_EMAIL=hello@biz-soft.pro

# ─── Защита публичных форм (SEC-RL-001) ───
# Соль для хэша IP в счётчиках лимитов: в базе лежит псевдоним адреса, а не
# сам адрес. Значение произвольное; менять его на работающем сайте не стоит —
# все текущие счётчики обнулятся (порог на час-сутки откроется заново).
FORM_GUARD_SALT=
# Сколько секунд живёт закэшированный ответ DaData по ИНН (по умолчанию сутки).
DADATA_CACHE_TTL_SEC=86400

# ─── Аналитика (публичные) ───
PUBLIC_METRIKA_ID=
PUBLIC_GA_ID=

# ─── WebMCP (инструменты для AI-агентов браузера) ───
# Слой включён по умолчанию. Значение 0 гасит и регистрацию инструментов
# на страницах, и read-only API /api/agent/* (см. docs/webmcp/architecture.md).
# PUBLIC_WEBMCP=0

# ─── Bitrix24: зеркало заявок (docs/rules/crm-mirror.md) ───
# Входящий вебхук портала целиком, вместе с кодом: он же пароль и он же права
# выписавшего пользователя. Пустое значение — зеркало выключено, сайт работает
# как до интеграции. На прод значение кладёт ops-b24-setup из секрета
# репозитория B24_WEBHOOK_URL, руками по SSH ходить не нужно.
# Вид: https://<портал>.bitrix24.ru/rest/<id пользователя>/<код>/
B24_WEBHOOK_URL=
# Ключ приложения исходящего вебхука портала: им приёмник /api/b24/hook отличает
# событие Битрикса от подделки — адрес приёмника публичен. Пусто — стадии из
# портала не принимаются (приёмник отвечает 503, а не делает вид, что работает).
B24_APP_TOKEN=

# ─── Согласия, журнал 152-ФЗ и рассылки (docs/rules/consent-audit.md) ───
# Раздел «Комплаенс → Согласия и рассылки» закрыт двумя факторами: токен роли
# плюс шестизначный код из приложения-аутентификатора. Значения на прод кладёт
# ops-consent-setup (сначала mode=check, потом mode=apply) из секретов
# репозитория — руками по SSH ходить не нужно.
#
# Токен роли владельца: журнал целиком (включая IP и user-agent), выгрузки,
# смена маркетингового статуса, фиксация отзыва. Минимум 16 символов.
COMPLIANCE_OWNER_TOKEN=
# Токен роли комплаенс-администратора: журнал и реестр без технических
# реквизитов и без права выгружать. Обязан отличаться от токена владельца —
# одинаковые значения молча снимают разделение доступа.
COMPLIANCE_ADMIN_TOKEN=
# Секрет второго фактора в base32 (как его принимает приложение-
# аутентификатор). Пустое значение — раздел не открывается вовсе, а не
# открывается без второго фактора.
COMPLIANCE_TOTP_SECRET=
# Подпись одношаговых ссылок отписки в рекламных письмах. Смена значения
# обесценивает ссылки во всех уже отправленных письмах: получатель попадёт на
# страницу с ручным вводом адреса вместо готовой отписки.
UNSUBSCRIBE_SECRET=
# Отдельный секрет проверки CSRF. Если не задан, используется
# UNSUBSCRIBE_SECRET — заводить второй смысл имеет при ротации по разным
# графикам.
CSRF_SECRET=
# Коды пользовательских полей Bitrix24, куда портал принимает идентификатор
# события согласия и статус рассылки. У каждого портала они свои
# (UF_CRM_<число>); пока не заданы, значения уходят строками в комментарий
# лида и в портале видны, но не в отдельных полях.
B24_UF_CONSENT_EVENT=
B24_UF_MARKETING_STATUS=

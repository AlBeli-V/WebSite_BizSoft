---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSteps from '../components/HeroSteps.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';

const steps = [
  { n: '01', t: 'Заявка', d: 'Вы оставляете заявку или собираете список избранного и запрашиваете КП. Уточняем сервисы, количество пользователей и сроки.' },
  { n: '02', t: 'Договор', d: 'Готовим договор поставки/оказания услуг под ваше юрлицо. Согласуем условия и ответственность сторон.' },
  { n: '03', t: 'Счёт', d: 'Выставляем счёт на оплату по безналу. Реквизиты — в счёте и в КП.' },
  { n: '04', t: 'Оплата', d: 'Вы оплачиваете счёт с расчётного счёта организации.' },
  { n: '05', t: 'Поставка', d: 'Предоставляем доступы к сервисам в оговорённый срок. Помогаем с активацией.' },
  { n: '06', t: 'ЭДО', d: 'Передаём закрывающие документы (акт, счёт-фактуру при необходимости) через электронный документооборот.' },
  { n: '07', t: 'Гарантии', d: 'Сопровождаем на всём сроке подписки, отвечаем за работоспособность и своевременность.' },
];

const faq = [
  { q: 'Сколько занимает оформление?', a: 'Договор и счёт — обычно в течение рабочего дня после согласования состава. Поставка доступов — в оговорённый срок, чаще всего 1–3 рабочих дня.' },
  { q: 'Через какие операторы ЭДО работаете?', a: 'Работаем с основными операторами ЭДО. Уточните вашего оператора — настроим обмен.' },
  { q: 'Можно ли без предоплаты?', a: 'Базовый порядок — оплата по счёту. Условия по постоплате обсуждаются индивидуально по договору.' },
];
---
<BaseLayout title="Как мы работаем" description="Процесс работы BIZSoft: заявка → договор → счёт → оплата → поставка → ЭДО → гарантии. Прозрачно и по закону для юрлиц РФ.">
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'Как мы работаем', url: '/how-we-work' }]} />
    <header class="head hero-cols">
      <div>
      <h1>Как мы работаем</h1>
      <p class="lead">От заявки до закрывающих документов. Каждый шаг оформлен: вы получаете легальный доступ и пакет документов для бухгалтерии.</p>
    </div>
      <HeroSteps />
    </header>
    <ol class="steps">
      {steps.map((s) => (
        <li class="card step reveal">
          <span class="section-num">/{s.n}</span>
          <h2>{s.t}</h2>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
    <FAQ items={faq} />
  </div>
  <CTASection />
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .head { max-width: 720px; margin-bottom: 2.5rem; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); margin-bottom: 1rem; }
  .lead { color: var(--color-text-muted); font-size: 1.08rem; }
  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.2rem; }
  .step { padding: 1.6rem; }
  .step h2 { font-size: 1.25rem; margin: 0.6rem 0 0.5rem; }
  .step p { color: var(--color-text-muted); font-size: 0.94rem; }
</style>

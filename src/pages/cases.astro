---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSteps from '../components/HeroSteps.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';

// Демонстрационные кейсы (примеры). Реальные — добавляются по мере накопления.
const cases = [
  { industry: 'Дизайн-студия', task: 'Нужны лицензии на графические редакторы для команды из 12 человек с закрывающими документами.', result: 'Подобрали годовые подписки, заключили договор, поставили доступы за 2 рабочих дня, акты передали через ЭДО.', tag: 'Графика' },
  { industry: 'IT-компания', task: 'AI-ассистент для кода на отдел разработки и единый счёт для бухгалтерии.', result: 'Оформили командный тариф с привязкой к курсу, выставили счёт в рублях, настроили обмен документами через ЭДО.', tag: 'Разработка' },
  { industry: 'Маркетинговое агентство', task: 'AI-сервисы для текста и графики плюс видеоконференцсвязь для распределённой команды.', result: 'Собрали комплект из трёх сервисов, дали КП в PDF, поставили доступы в срок.', tag: 'AI и связь' },
];
---
<BaseLayout title="Кейсы" description="Примеры поставок ПО для российских компаний через BIZSoft: задача, решение и результат. Договор, счёт, ЭДО.">
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'Кейсы', url: '/cases' }]} />
    <header class="head hero-cols">
      <div>
      <h1>Типовые сценарии поставки</h1>
      <p class="lead">Как мы помогаем компаниям получить нужное ПО легально и в срок. Ниже — типовые примеры.</p>
    </div>
      <HeroSteps />
    </header>
    <div class="cases">
      {cases.map((c) => (
        <article class="card case reveal">
          <span class="tag">{c.tag}</span>
          <h2>{c.industry}</h2>
          <p class="task"><strong>Задача:</strong> {c.task}</p>
          <p class="result"><strong>Результат:</strong> {c.result}</p>
        </article>
      ))}
    </div>
    <p class="note">Ниже — типовые сценарии поставки: так проходит закупка у наших клиентов. Названия компаний не раскрываем по условиям договоров.</p>
  </div>
  <CTASection />
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .head { max-width: 720px; margin-bottom: 2.5rem; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); margin-bottom: 1rem; }
  .lead { color: var(--color-text-muted); font-size: 1.08rem; }
  .cases { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; }
  .case { padding: 1.6rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .tag { align-self: flex-start; background: color-mix(in srgb, var(--color-accent) 16%, transparent); color: var(--color-accent); font-size: 0.72rem; font-weight: 600; padding: 0.15rem 0.6rem; border-radius: 6px; }
  .case h2 { font-size: 1.25rem; }
  .case p { color: var(--color-text-muted); font-size: 0.92rem; margin: 0; }
  .case strong { color: var(--color-text); }
  .note { color: var(--color-text-dim); font-size: 0.85rem; margin-top: 1.5rem; }
</style>

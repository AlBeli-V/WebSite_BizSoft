---
// ВРЕМЕННАЯ диагностическая страница, 05.09.2026. Удалить после прогона.
//
// Зачем: PageSpeed Insights (движок веб-интерфейса pagespeed.web.dev) не
// регистрирует кандидата LCP на главной — NO_LCP в 4 прогонах из 5, — а на
// /catalog, /catalog/ai, /about и /vendors даёт 99–100. Общие с этими
// страницами компоненты (карусель, плитки, анимация секций) исключены
// бисектом; остались три, которые есть только на главной. Здесь главная
// отдаётся копиями: полной (контроль адреса) и с одним отключённым
// компонентом в каждой. Прогон PSI по всем пяти адресам называет виновника.
//
// Страницы закрыты noindex (пропом в главную) и в sitemap не входят:
// STATIC_ROUTES заполняется руками. Правки самой главной — только проп
// perfVariant, по своему адресу она рендерится как прежде.
import Home from '../index.astro';

// Как и сама главная — рендер на запрос: сайт собран в static с Node-адаптером,
// динамический маршрут без getStaticPaths обязан отказаться от пререндера.
export const prerender = false;

// Вторая серия (05.09.2026, после первой без результата): hero-only — на
// странице остаётся только хиро; no-hero — всё, кроме хиро; system-fonts —
// без фирменных шрифтов вовсе; no-reveal — анимация появления секций
// выключена стилем.
// Третья серия: no-carousel — без логопанели; no-pop — без витрины
// популярного; upper-half — хиро, цифры, логопанель, витрина (без остальных
// секций); lower-half — хиро и остальные секции (без цифр, логопанели, витрины).
const VARIANTS = ['control', 'no-stats', 'no-banner', 'no-hero-decor', 'hero-only', 'no-hero', 'system-fonts', 'no-reveal', 'no-carousel', 'no-pop', 'upper-half', 'lower-half'] as const;
const variant = Astro.params.variant ?? '';
if (!(VARIANTS as readonly string[]).includes(variant)) {
  return new Response(null, { status: 404 });
}
---
<Home perfVariant={variant} />

---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';
import VendorIcon from '../../components/VendorIcon.astro';
import { productIcons } from '../../data/product-icons';
import ProductIcon from '../../components/ProductIcon.astro';
import AddToCartButton from '../../components/AddToCartButton.astro';
import VendorInterlinks from '../../components/VendorInterlinks.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getProducts } from '../../lib/directus';
import { effectivePrice, formatRub } from '../../lib/pricing';
import { listingProducts } from '../../lib/catalog';
import { collectionPageSchema } from '../../lib/seo';
import {
  OPENAI_VENDOR, OPENAI_SUMMARY, OPENAI_ORDER, OPENAI_CARD_META,
  OPENAI_COMPARISON, OPENAI_DECISION, OPENAI_SCENARIOS, OPENAI_SEGMENTS,
  OPENAI_FAQ, OPENAI_FAQ_GROUPS,
} from '../../data/openai';
import type { Product } from '../../lib/types';

let all: Product[] = [];
try { all = await getProducts({ vendor: 'OpenAI' }); } catch (e) { console.error('openai landing', e); }
// Без фильтра по префиксу sku: у части товаров «интеграционные» sku
// (ChatGPT Business = INT-AI-CHATGPT). Порядок — по OPENAI_ORDER (slug или sku),
// не перечисленные в нём товары — в конец списка.
// listingProducts убирает варианты (номиналы пополнения баланса API): в сетке
// стоит родительская карточка, номинал выбирается на её странице.
const orderKey = (p: Product) => {
  const i = OPENAI_ORDER.findIndex((k) => k === p.slug || k === p.sku);
  return i === -1 ? OPENAI_ORDER.length : i;
};
const items = listingProducts(all).slice().sort((a, b) => orderKey(a) - orderKey(b));

// Сегмент карточки — по slug или sku; карточка вне сегментов видна всегда.
const segmentOf = (p: Product) => OPENAI_SEGMENTS.find((s) => s.keys.includes(p.slug) || s.keys.includes(p.sku))?.id || '';

const cards = items.map((p) => {
  const eff = effectivePrice(p);
  const meta = OPENAI_CARD_META[p.slug] ?? OPENAI_CARD_META[p.sku];
  return {
    name: p.name, slug: p.slug, sku: p.sku,
    price: eff.price, priceText: formatRub(eff.price),
    note: p.price_note || '', byRequest: !(eff.price > 0),
    priceFrom: Boolean(p.price_from),
    meta, features: meta?.features?.slice(0, 5) || [],
    seg: segmentOf(p),
  };
});
const priced = items.filter((p) => effectivePrice(p).price > 0);
const minPrice = priced.length ? Math.min(...priced.map((p) => effectivePrice(p).price)) : 0;
const hasMin = minPrice > 0;
// Сегменты, под которые на витрине действительно есть карточки: пустой
// сегмент на странице — обещание товара, которого нет.
const segments = OPENAI_SEGMENTS.filter((s) => cards.some((c) => c.seg === s.id));
// Список для выбора тарифа прямо в форме: то же, что показано в сетке.
const plans = [
  ...cards.map((c) => ({ value: `OpenAI — ${c.name}`, label: c.name })),
  // Обращение не про тариф, а про требования ИБ: у него своя строка, иначе
  // кнопка блока безопасности сбрасывала бы выбор в «подберите под задачу».
  { value: 'OpenAI — требования ИБ', label: 'Требования к безопасности и ИБ' },
];

const title = 'Купить ChatGPT (OpenAI) для юрлица — Business, Enterprise и баланс API';
const description = 'ChatGPT для бизнеса: тарифы Business и Enterprise, пополнение баланса OpenAI API. Оформление на юрлицо по договору и счёту, оплата в рублях, закрывающие через ЭДО.';
const pageUrl = '/vendors/openai';
const crumbs = [{ name: 'Каталог', url: '/catalog' }, { name: 'AI-сервисы', url: '/catalog/ai' }, { name: 'OpenAI (ChatGPT)', url: pageUrl }];
// FAQPage и BreadcrumbList не дублируем: их выводят компоненты FAQ и Breadcrumbs.
const ld = [
  collectionPageSchema({ name: 'OpenAI (ChatGPT) для бизнеса', description, url: pageUrl, items: cards.map((c) => ({ name: c.name, slug: c.slug })) }),
];
---
<BaseLayout title={title} description={description} type="website" canonical={pageUrl}>
  <JsonLd schema={ld} />
  <div class="container-page section" style={`--vc:${OPENAI_VENDOR.brandColor}`}>
    <Breadcrumbs items={crumbs} />

    <header class="hero">
      <div class="vendor-row"><VendorIcon slug="openai" name="OpenAI" size={44} /><span class="vendor-name">OpenAI</span><span class="vendor-legal">{OPENAI_VENDOR.legalName}</span></div>
      <h1>OpenAI (ChatGPT) для юридических лиц: тарифы и оформление через BIZSoft</h1>
      <p class="hero-sub">ChatGPT Business для команды, Enterprise для организации, пополнение баланса OpenAI API для разработки. Оформление на организацию с оплатой по счёту и закрывающими документами.</p>
      <ul class="chips"><li>Для юрлиц</li><li>КП и счёт</li><li>Договор и закрывающие</li><li>Оплата в рублях</li></ul>
      {/* Один призыв на первый экран: раньше «Получить расчёт и КП» стоял
          четырежды и вёл в модальное окно, где тариф приходилось называть
          словами. Теперь кнопка ведёт в единственную форму страницы и
          подставляет выбранный тариф. */}
      <div class="hero-actions">
        <button class="btn btn-primary" data-plan="" data-ev="click_get_quote">Получить расчёт и КП</button>
        <a href="#choose" class="btn btn-ghost" data-ev="click_choose_plan">Подобрать под задачу</a>
      </div>
      {hasMin && <p class="from">Цены от <b>{formatRub(minPrice)}</b> в год</p>}
    </header>

    <div class="summary"><strong>Коротко:</strong> {OPENAI_SUMMARY}</div>

    {segments.length > 0 && (
      <section class="block" id="choose">
        <h2>С чего начать: выберите свой случай</h2>
        <p class="muted lead-note">Варианты OpenAI делятся на разные ситуации, и выбирают не между тарифами, а между ними. Отметьте свою — в списке ниже останется только подходящее.</p>
        <div class="segs" role="group" aria-label="Выбор ситуации">
          {segments.map((s) => (
            <button type="button" class="card card-hover seg" data-seg-btn={s.id} aria-pressed="false">
              <b>{s.title}</b>
              <span class="muted">{s.text}</span>
              <em>{cards.filter((c) => c.seg === s.id).length === 1 ? '1 вариант' : `${cards.filter((c) => c.seg === s.id).length} варианта`} →</em>
            </button>
          ))}
        </div>
        {segments.map((s) => (
          <p class="seg-why" data-seg-why={s.id} hidden>{s.why}</p>
        ))}
        <button type="button" class="btn btn-ghost btn-sm seg-reset" data-seg-reset hidden>Показать все варианты</button>
      </section>
    )}

    <section class="block" id="products">
      <h2>Тарифы и продукты OpenAI</h2>
      <div class="vgrid">
        {cards.map((c) => (
          <article class:list={['card', 'vcard', c.seg === 'api' && 'vcard-api']} data-seg-card={c.seg}>
            {c.meta && <div class="vhead"><span class="vbadge">{c.meta.badge}</span></div>}
            <div class="pih">
              {productIcons(c.slug).length > 0 && <ProductIcon slug={c.slug} name={c.name} size={36} />}
              <h3>{c.name}</h3>
            </div>
            {c.meta?.forWhom && <p class="forwhom">{c.meta.forWhom}</p>}
            <div class="vprice">{c.byRequest ? <span class="req">Цена по запросу</span> : <span class="pv"><b>{c.priceFrom ? `от ${c.priceText}` : c.priceText}</b> <span class="note">{c.note}</span></span>}</div>
            {c.features.length > 0 && <ul class="vfeat">{c.features.map((f) => <li>{f}</li>)}</ul>}
            {c.meta?.check && <p class="vcheck">⚠ {c.meta.check}</p>}
            <div class="vactions">
              {c.byRequest ? (
                <button class="btn btn-primary btn-sm" data-plan={`OpenAI — ${c.name}`} data-ev="click_get_quote">Запросить цену</button>
              ) : c.seg === 'api' ? (
                <a href={`/product/${c.slug}`} class="btn btn-primary btn-sm" data-ev="click_product_card">Выбрать номинал</a>
              ) : (
                <AddToCartButton sku={c.sku} slug={c.slug} name={c.name} vendor="OpenAI" price={c.price} compact />
              )}
              <a href={`/product/${c.slug}`} class="btn btn-ghost btn-sm" data-ev="click_product_card">Подробнее</a>
            </div>
          </article>
        ))}
      </div>
      <p class="muted small">Цена в рублях пересчитывается по курсу ЦБ РФ.</p>
    </section>

    <section class="block" id="compare">
      <h2>Сравнение тарифов ChatGPT</h2>
      <div class="table-wrap">
        <table class="cmp">
          <thead><tr><th class="sticky">Параметр</th>{OPENAI_COMPARISON.cols.map((c) => <th>{c}</th>)}</tr></thead>
          <tbody>{OPENAI_COMPARISON.rows.map((r) => (<tr><th class="sticky">{r.label}</th>{r.values.map((v) => <td>{v}</td>)}</tr>))}</tbody>
        </table>
      </div>
      <p class="muted small">«уточн.» — доступность функции проверяется перед КП (зависит от региона и тарифа). Пополнение баланса API в таблицу не входит: там оплата идёт по использованию, а не за место.</p>
    </section>

    <section class="block">
      <h2>Какой продукт OpenAI выбрать</h2>
      <div class="table-wrap">
        <table class="cmp decision">
          <thead><tr><th class="sticky">Сценарий</th><th>Рекомендуем</th><th>Почему</th></tr></thead>
          <tbody>{OPENAI_DECISION.map((d) => (<tr><th class="sticky">{d.scenario}</th><td>{d.product}</td><td class="muted">{d.note}</td></tr>))}</tbody>
        </table>
      </div>
    </section>

    <section class="block">
      <h2>Сценарии использования</h2>
      <div class="cells">{OPENAI_SCENARIOS.map((s) => (<div class="card cell"><h3>{s.title}</h3><p>{s.text}</p></div>))}</div>
    </section>

    <section class="block">
      <h2>Безопасность и данные</h2>
      <div class="prose-bizsoft"><p>В тарифах ChatGPT Business и Enterprise данные организации по умолчанию не используются
        для обучения моделей; доступны админ-управление, SSO, верификация домена, а в Enterprise — SCIM, EKM, RBAC и
        аналитика. Конкретные настройки приватности, хранения данных и соответствие внутренним политикам ИБ уточняются
        перед оформлением: опишите требования <a href="#lead" data-plan="OpenAI — требования ИБ">в форме внизу страницы</a>.</p></div>
    </section>

    <section class="block">
      <h2>Как купить OpenAI через BIZSoft</h2>
      <ol class="steps">
        <li>Вы оставляете заявку или выбираете тариф.</li>
        <li>Менеджер уточняет продукт, количество пользователей, срок и документы.</li>
        <li>BIZSoft готовит КП или счёт с ценой в рублях.</li>
        <li>Оформляются договор и оплата по счёту.</li>
        <li>После оплаты передаём доступы и инструкции по активации.</li>
        <li>Закрывающие документы — в согласованном формате, в том числе через ЭДО.</li>
      </ol>
    </section>

    <FAQ items={OPENAI_FAQ} groups={OPENAI_FAQ_GROUPS} title="Частые вопросы про ChatGPT и OpenAI для бизнеса" />

    <section class="block final" id="lead">
      <div class="final-grid">
        <div>
          <h2>Подобрать OpenAI для компании</h2>
          <p class="muted">Опишите задачу: сколько сотрудников, нужен ли программный доступ, какие требования к безопасности. Подготовим расчёт, КП или счёт.</p>
          <ul class="vfeat"><li>Оформление для юрлиц: договор, счёт, закрывающие</li><li>Оплата в рублях по курсу ЦБ РФ</li><li>Подбор тарифа и количества пользователей</li></ul>
          <p class="muted small">Это единственная форма страницы: тариф подставляется кнопками выше, называть его словами не нужно.</p>
        </div>
        <LeadForm source="vendor-openai" title="Подбор OpenAI" submitLabel="Получить расчёт и КП" plans={plans} />
      </div>
    </section>

    <section class="block links">
      <h2>Связанные товары и разделы</h2>
      <div class="link-grid">
        {cards.map((c) => <a href={`/product/${c.slug}`}>{c.name}</a>)}
        <a href="/catalog/ai">Все AI-сервисы</a><a href="/vendors">Все производители</a>
        <a href="/how-we-work">Как мы работаем</a><a href="/documents">Документы</a><a href="/contacts">Контакты</a>
      </div>
    </section>
  </div>
  {/* Ещё по теме: статьи, аналоги, сравнения этого вендора (IDX-001).
      Блок стоит после формы: это сильные ссылки, но уводить по ним человека
      в шаге от заявки нельзя. */}
  <VendorInterlinks vendorSlug="openai" productSlugs={items.map((p) => p.slug)} />
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .hero { padding: 1rem 0 1.5rem; max-width: 820px; }
  .vendor-row { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1rem; }
  .vendor-name { font-weight: 700; font-size: 1.05rem; }
  .vendor-legal { color: var(--color-text-dim); font-size: 0.85rem; }
  h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); margin-bottom: 1rem; }
  .hero-sub { color: var(--color-text-muted); font-size: 1.08rem; max-width: 64ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 1.2rem 0; }
  .chips li { background: var(--color-bg-elevated); border: 1px solid var(--color-border); color: var(--color-text-muted); font-size: 0.82rem; padding: 0.25rem 0.7rem; border-radius: 999px; }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.8rem; }
  .from { color: var(--color-text-muted); font-size: 0.92rem; } .from b { color: var(--color-text); }
  .summary { background: var(--color-bg-card); border: 1px solid var(--color-border); border-left: 3px solid var(--vc, var(--color-accent)); border-radius: var(--radius); padding: 1rem 1.2rem; margin: 1.5rem 0; color: var(--color-text); } .summary strong { color: var(--color-text); }
  .block { margin-top: 3rem; } .block > h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-bottom: 1.2rem; }
  .lead-note { max-width: 70ch; margin-top: -0.6rem; margin-bottom: 1.2rem; font-size: 0.95rem; }

  /* Сегменты первого шага: выбирают ситуацию, а не тариф */
  .segs { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; }
  .seg { display: grid; gap: 0.35rem; text-align: left; font: inherit; cursor: pointer; padding: 1.3rem; color: var(--color-text); }
  .seg b { font-size: 1.05rem; }
  .seg span { font-size: 0.88rem; line-height: 1.5; }
  .seg em { font-style: normal; font-size: 0.82rem; font-weight: 600; color: var(--vc, var(--color-accent)); }
  .seg[aria-pressed='true'] { border-color: var(--vc, var(--color-accent)); box-shadow: 0 0 0 3px color-mix(in srgb, var(--vc) 14%, transparent); }
  .seg-why { margin: 1.2rem 0 0; max-width: 70ch; color: var(--color-text-muted); font-size: 0.92rem; }
  .seg-reset { margin-top: 1rem; }

  .vgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.2rem; }
  .vcard { padding: 1.4rem; display: flex; flex-direction: column; }
  /* Пополнение баланса — другая модель продажи, и карточка это показывает */
  .vcard-api { border-style: dashed; border-color: var(--color-border-strong); }
  .vhead { display: flex; margin-bottom: 0.5rem; }
  .vbadge { font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.55rem; border-radius: 6px; background: color-mix(in srgb, var(--vc) 16%, transparent); color: var(--vc); }
  .vcard h3 { font-size: 1.1rem; margin-bottom: 0.3rem; }
  .forwhom { color: var(--color-text-dim); font-size: 0.83rem; margin-bottom: 0.6rem; }
  .vprice { margin: 0.3rem 0 0.7rem; } .vprice b { font-size: 1.2rem; } .vprice .note { color: var(--color-text-dim); font-size: 0.8rem; } .vprice .req { font-weight: 700; }
  .vfeat { list-style: none; padding: 0; margin: 0 0 0.7rem; display: grid; gap: 0.3rem; }
  .vfeat li { padding-left: 1.3rem; position: relative; color: var(--color-text); font-size: 0.88rem; } .vfeat li::before { content: '✓'; position: absolute; left: 0; color: var(--vc, var(--color-accent)); font-weight: 700; }
  .vcheck { color: var(--color-text-dim); font-size: 0.78rem; margin: 0 0 0.7rem; }
  .vactions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: auto; }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table.cmp { width: 100%; border-collapse: collapse; min-width: 560px; font-size: 0.92rem; }
  table.cmp th, table.cmp td { border: 1px solid var(--color-border); padding: 0.55rem 0.8rem; text-align: left; }
  table.cmp thead th { background: var(--color-bg-elevated); }
  table.cmp .sticky { position: sticky; left: 0; background: var(--color-bg-card); font-weight: 600; }
  .muted { color: var(--color-text-muted); } .small { font-size: 0.82rem; margin-top: 0.6rem; }
  .cells { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
  .cell { padding: 1.3rem; } .cell h3 { font-size: 1.05rem; margin-bottom: 0.4rem; } .cell p { color: var(--color-text-muted); font-size: 0.9rem; }
  .steps { padding-left: 1.2rem; color: var(--color-text); display: grid; gap: 0.5rem; margin-bottom: 1.2rem; max-width: 800px; }
  .final-grid { display: grid; grid-template-columns: 1fr 400px; gap: 2.5rem; align-items: start; }
  .links .link-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.6rem; }
  .links a { color: var(--color-accent); font-size: 0.92rem; padding: 0.5rem 0; }
  @media (max-width: 880px) { .final-grid { grid-template-columns: 1fr; } }
  /* Значок продукта слева от названия в плитке */
  .pih { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.4rem; }
  .pih h3 { margin-bottom: 0; }
</style>

<script>
  import { trackGoal, trackGoalOnce } from '@/lib/analytics';

  trackGoal('view_vendor_landing', { vendor: 'openai', page_url: location.pathname });
  document.querySelectorAll('[data-ev]').forEach((el) => el.addEventListener('click', () => trackGoal((el as HTMLElement).dataset.ev!, { block_name: 'openai' })));

  // ── Сегменты: выбор ситуации сужает сетку карточек ──────────────────
  // Без скрипта видны все карточки: фильтр — усиление, а не условие показа.
  const segBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-seg-btn]'));
  const segCards = Array.from(document.querySelectorAll<HTMLElement>('[data-seg-card]'));
  const segWhy = Array.from(document.querySelectorAll<HTMLElement>('[data-seg-why]'));
  const segReset = document.querySelector<HTMLButtonElement>('[data-seg-reset]');

  function applySegment(id: string) {
    segBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.segBtn === id)));
    segCards.forEach((c) => { c.hidden = Boolean(id) && c.dataset.segCard !== id; });
    segWhy.forEach((p) => { p.hidden = p.dataset.segWhy !== id; });
    if (segReset) segReset.hidden = !id;
  }

  segBtns.forEach((b) => b.addEventListener('click', () => {
    const id = b.getAttribute('aria-pressed') === 'true' ? '' : (b.dataset.segBtn || '');
    applySegment(id);
    trackGoal('vendor_selector_step', { vendor: 'openai', segment: id || 'сброшен' });
    if (id) document.getElementById('products')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  segReset?.addEventListener('click', () => {
    applySegment('');
    trackGoal('vendor_selector_step', { vendor: 'openai', segment: 'сброшен' });
  });

  // ── Один призыв — одна форма ────────────────────────────────────────
  // Кнопка с data-plan подставляет тариф в единственную форму страницы и
  // ведёт к ней. Модальное окно «Задать вопрос» со страницы убрано: три
  // формы на одну страницу заставляли посетителя описывать тариф словами.
  const planSelect = document.querySelector<HTMLSelectElement>('[data-lead-plan]');
  document.querySelectorAll<HTMLElement>('[data-plan]').forEach((el) => {
    el.addEventListener('click', (e) => {
      const plan = el.dataset.plan || '';
      if (planSelect) {
        const has = Array.from(planSelect.options).some((o) => o.value === plan);
        planSelect.value = has ? plan : '';
      }
      trackGoal('vendor_quote_request', { vendor: 'openai', tariff: plan || 'подбор' });
      if (el.tagName === 'BUTTON') {
        e.preventDefault();
        document.getElementById('lead')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // ── Замеры шагов воронки ────────────────────────────────────────────
  // Просмотр тарифов — один раз на страницу: сетку видно и сверху, и после
  // выбора сегмента, а шаг воронки при этом один.
  const products = document.getElementById('products');
  if (products && typeof IntersectionObserver === 'function') {
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (en.isIntersecting) {
          trackGoalOnce('vendor_tariff_view', { vendor: 'openai', tariffs: segCards.length });
          io.disconnect();
        }
      }
    }, { threshold: 0.25 });
    io.observe(products);
  }

  document.querySelectorAll<HTMLElement>('[data-add-to-cart]').forEach((el) => {
    el.addEventListener('click', () => trackGoal('vendor_cart_add', { vendor: 'openai', sku: el.dataset.sku || '' }));
  });

  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) trackGoal('vendor_faq_expand', { vendor: 'openai', question: d.querySelector('summary span')?.textContent?.slice(0, 120) || '' });
    });
  });
</script>

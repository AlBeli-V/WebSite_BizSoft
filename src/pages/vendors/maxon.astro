---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';
import VendorIcon from '../../components/VendorIcon.astro';
import { productIcons } from '../../data/product-icons';
import ProductIcon from '../../components/ProductIcon.astro';
import AddToCartButton from '../../components/AddToCartButton.astro';
import QuestionForm from '../../components/QuestionForm.astro';
import VendorInterlinks from '../../components/VendorInterlinks.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getProducts } from '../../lib/directus';
import { effectivePrice, formatRub } from '../../lib/pricing';
import { collectionPageSchema } from '../../lib/seo';
import {
  MAXON_CARD_META, MAXON_COMPARISON, MAXON_DECISION, MAXON_FAQ,
  MAXON_ORDER_IND, MAXON_ORDER_TEAMS, MAXON_PRODUCTS_GUIDE,
  MAXON_SEGMENTS, MAXON_SUMMARY, MAXON_VENDOR,
} from '../../data/maxon';
import type { Product } from '../../lib/types';

// Товары — из Directus по точному vendor (по префиксу sku не фильтруем — правило CLAUDE.md).
let all: Product[] = [];
try {
  all = await getProducts();
} catch (e) {
  console.error('maxon landing data error', e);
}
const maxon = all.filter((p) => p.vendor === MAXON_VENDOR.vendor && p.status === 'published');
const bySku = new Map(maxon.map((p) => [p.sku, p]));

// Вью-модель карточки: цену и сравнения считаем здесь, чтобы в шаблоне не было < / <=
function card(sku: string) {
  const p = bySku.get(sku);
  if (!p) return null;
  const eff = effectivePrice(p);
  return {
    name: p.name,
    slug: p.slug,
    sku: p.sku,
    price: eff.price,
    priceText: formatRub(eff.price),
    note: p.price_note || '',
    byRequest: !(eff.price > 0),
    meta: MAXON_CARD_META[sku],
  };
}
const indCards = MAXON_ORDER_IND.map(card).filter((c) => c !== null);
const teamCards = MAXON_ORDER_TEAMS.map(card).filter((c) => c !== null);

const priced = maxon.filter((p) => effectivePrice(p).price > 0);
const minPrice = priced.length ? Math.min(...priced.map((p) => effectivePrice(p).price)) : 0;

const title = 'Купить Maxon для юридических лиц — индивидуальные и командные планы Cinema 4D, ZBrush, Redshift';
const description = 'Подписки Maxon для бизнеса: Maxon One, Cinema 4D, Red Giant, Redshift, ZBrush и Universe. Индивидуальные (Individuals) и командные (Teams) планы, отличия и сравнение. Договор, счёт в рублях, закрывающие документы для юрлиц.';

const ldItems = maxon.map((p) => ({ name: p.name, slug: p.slug }));
const collectionLd = collectionPageSchema({ name: 'Maxon для бизнеса', description, url: '/vendors/maxon', items: ldItems });
---
<BaseLayout title={title} description={description} type="website" canonical="/vendors/maxon">
  <JsonLd schema={collectionLd} />

  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'Каталог', url: '/catalog' }, { name: 'Дизайн и графика', url: '/catalog/design' }, { name: 'Maxon для бизнеса', url: '/vendors/maxon' }]} />

    <!-- HERO -->
    <header class="hero">
      <div class="hero-main">
        <div class="vendor-row">
          <VendorIcon slug="maxon" name="Maxon" size={44} />
          <span class="vendor-name">Maxon</span>
          <span class="vendor-legal">{MAXON_VENDOR.legalName}</span>
        </div>
        <h1>Maxon для юридических лиц: индивидуальные и командные планы</h1>
        <p class="hero-sub">
          Оформите годовые подписки Maxon: пакет Maxon One или отдельные продукты — Cinema 4D,
          Red Giant, Redshift, ZBrush и Universe. Поможем выбрать между индивидуальным планом
          (Individuals) и командным (Teams), рассчитаем количество мест и подготовим документы.
        </p>
        <ul class="chips">
          <li>Для юрлиц</li><li>КП и счёт</li><li>Договор и закрывающие</li><li>Планы Individuals и Teams</li>
        </ul>
        <div class="hero-actions">
          <button class="btn btn-primary" data-open-question data-product="Maxon — подбор плана" data-ev="click_get_quote">Получить расчёт и КП</button>
          <a href="#chooser" class="btn btn-ghost" data-ev="click_choose_plan">Подобрать план Maxon</a>
        </div>
        {minPrice > 0 && <p class="from">Цены от <b>{formatRub(minPrice)}</b> в год</p>}
      </div>
    </header>

    <!-- Прямой ответ (GEO/AEO) -->
    <div class="summary"><strong>Коротко:</strong> {MAXON_SUMMARY}</div>

    <!-- Вводный SEO-блок -->
    <section class="block prose-bizsoft">
      <p>Maxon — экосистема инструментов для 3D-графики, моушн-дизайна, VFX и цифрового скульптинга.
        В линейке шесть подписок: пакет Maxon One со всем стеком сразу и отдельные продукты — Cinema 4D
        для 3D-моделирования и анимации, Red Giant для VFX и постпродакшена, GPU-рендер Redshift,
        скульптинг ZBrush и коллекция эффектов Universe. Каждая подписка продаётся в двух моделях
        лицензирования: <b>индивидуальный план (Individuals)</b> — лицензия на конкретного специалиста,
        и <b>командный план (Teams)</b> — места принадлежат компании, управляются из единой консоли
        и переназначаются между сотрудниками. Исключение — Universe: отдельной командной версии у него
        нет, для команд он входит в состав Red Giant.</p>
    </section>

    <!-- Раздел индивидуальных планов -->
    <section class="block" id="individuals">
      <h2>Раздел индивидуальных планов</h2>
      <p class="section-sub">Подписка оформляется на конкретного специалиста: фрилансера, ИП или
        единственного 3D-художника в компании. Дешевле командных планов, но место нельзя передать
        другому сотруднику.</p>
      <div class="mgrid">
        {indCards.map((c) => (
          <article class="card mcard">
            <div class="mhead">
              <span class="mbadge ind">Индивидуальный план</span>
              {c.meta && <span class="mbadge kind">{c.meta.badge}</span>}
            </div>
            <div class="pih">
              {productIcons(c.slug).length > 0 && <ProductIcon slug={c.slug} name={c.name} size={36} />}
              <h3>{c.name}</h3>
            </div>
            {c.meta?.forWhom && <p class="forwhom">{c.meta.forWhom}</p>}
            <div class="mprice">
              {c.byRequest
                ? <span class="req">Цена по запросу</span>
                : <span class="pv"><b>{c.priceText}</b> <span class="note">{c.note}</span></span>}
            </div>
            {c.meta && c.meta.features.length > 0 && (
              <ul class="mfeat">{c.meta.features.map((f) => <li>{f}</li>)}</ul>
            )}
            <div class="mactions">
              {c.byRequest ? (
                <button class="btn btn-primary btn-sm" data-open-question data-product={`Maxon — ${c.name}`} data-sku={c.sku} data-ev="click_get_quote">Запросить цену</button>
              ) : (
                <AddToCartButton sku={c.sku} slug={c.slug} name={c.name} vendor="Maxon" price={c.price} compact />
              )}
              <a href={`/product/${c.slug}`} class="btn btn-ghost btn-sm" data-ev="click_product_card">Подробнее</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Раздел командных планов -->
    <section class="block plans-teams" id="teams">
      <h2>Раздел командных планов</h2>
      <p class="section-sub">Лицензии принадлежат организации: администратор назначает и переназначает
        места между сотрудниками из единой консоли. Дороже индивидуальных планов, но остаются активом
        компании при смене состава команды. Командной версии Universe у производителя нет — для команд
        он входит в Red Giant.</p>
      <div class="mgrid">
        {teamCards.map((c) => (
          <article class="card mcard">
            <div class="mhead">
              <span class="mbadge team">Командный план</span>
              {c.meta && <span class="mbadge kind">{c.meta.badge}</span>}
            </div>
            <div class="pih">
              {productIcons(c.slug).length > 0 && <ProductIcon slug={c.slug} name={c.name} size={36} />}
              <h3>{c.name}</h3>
            </div>
            {c.meta?.forWhom && <p class="forwhom">{c.meta.forWhom}</p>}
            <div class="mprice">
              {c.byRequest
                ? <span class="req">Цена по запросу</span>
                : <span class="pv"><b>{c.priceText}</b> <span class="note">{c.note}</span></span>}
            </div>
            {c.meta && c.meta.features.length > 0 && (
              <ul class="mfeat">{c.meta.features.map((f) => <li>{f}</li>)}</ul>
            )}
            <div class="mactions">
              {c.byRequest ? (
                <button class="btn btn-primary btn-sm" data-open-question data-product={`Maxon — ${c.name}`} data-sku={c.sku} data-ev="click_get_quote">Запросить цену</button>
              ) : (
                <AddToCartButton sku={c.sku} slug={c.slug} name={c.name} vendor="Maxon" price={c.price} compact />
              )}
              <a href={`/product/${c.slug}`} class="btn btn-ghost btn-sm" data-ev="click_product_card">Подробнее</a>
            </div>
          </article>
        ))}
      </div>
      {teamCards.length === 0 && (
        <p class="muted">Командные планы Maxon оформляются по запросу — нажмите «Получить расчёт и КП»,
          и менеджер подготовит предложение под ваше количество мест.</p>
      )}
    </section>

    <!-- Сравнение моделей лицензирования -->
    <section class="block" id="compare">
      <h2>Чем командные планы отличаются от индивидуальных</h2>
      <div class="table-wrap" data-ev-view="open_comparison_table">
        <table class="cmp">
          <thead>
            <tr><th class="sticky">Критерий</th>{MAXON_COMPARISON.cols.map((c) => <th>{c}</th>)}</tr>
          </thead>
          <tbody>
            {MAXON_COMPARISON.rows.map((r) => (
              <tr><th class="sticky">{r.label}</th>{r.values.map((v) => <td>{v}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted small">Функциональность продуктов в обоих планах одинаковая — различается только
        модель лицензирования: кому принадлежит место и как им можно распоряжаться.</p>
    </section>

    <!-- Какой план выбрать -->
    <section class="block" id="chooser">
      <h2>Какой план Maxon выбрать</h2>
      <div class="table-wrap">
        <table class="cmp decision">
          <thead><tr><th class="sticky">Сценарий</th><th>Рекомендуем</th><th>Почему</th></tr></thead>
          <tbody>
            {MAXON_DECISION.map((d) => (
              <tr>
                <th class="sticky">{d.scenario}</th>
                <td>{d.slug ? <a href={`/product/${d.slug}`}>{d.product}</a> : d.product}</td>
                <td class="muted">{d.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Состав экосистемы -->
    <section class="block">
      <h2>Что входит в экосистему Maxon</h2>
      <div class="cells">
        {MAXON_PRODUCTS_GUIDE.map((s) => (<div class="card cell"><h3>{s.title}</h3><p>{s.text}</p></div>))}
      </div>
    </section>

    <!-- Сегменты -->
    <section class="block">
      <h2>Для каких компаний подходит Maxon</h2>
      <div class="cells">
        {MAXON_SEGMENTS.map((s) => (<div class="card cell"><h3>{s.title}</h3><p>{s.text}</p></div>))}
      </div>
    </section>

    <!-- Как купить -->
    <section class="block">
      <h2>Как купить Maxon через BIZSoft</h2>
      <ol class="steps">
        <li>Вы оставляете заявку или выбираете подписки в каталоге.</li>
        <li>Менеджер уточняет сценарий: продукты, план (Individuals или Teams), количество мест, срок.</li>
        <li>BIZSoft готовит КП или счёт в рублях по курсу ЦБ РФ.</li>
        <li>После согласования оформляются договор и оплата по счёту.</li>
        <li>После оплаты передаются доступы и инструкции по активации (обычно 1–3 рабочих дня).</li>
        <li>Закрывающие документы передаются в согласованном формате, в том числе через ЭДО.</li>
      </ol>
      <button class="btn btn-primary" data-open-question data-product="Maxon — расчёт и КП" data-ev="click_get_quote">Получить расчёт и КП</button>
    </section>

    <!-- Документы -->
    <section class="block">
      <h2>Документы для бухгалтерии и закупки</h2>
      <div class="prose-bizsoft">
        <p>Для юридических лиц важно корректное оформление. Через BIZSoft можно запросить КП, счёт,
          договор и закрывающие документы; закрывающие могут передаваться через <a href="/documents">ЭДО</a>.
          Финальный состав документов зависит от условий сделки и подтверждается до оплаты. Для КП
          подготовьте: название организации, ИНН, контактное лицо, email, нужные продукты Maxon, план
          (индивидуальный или командный), количество мест и срок подписки.</p>
      </div>
    </section>

    <!-- FAQ -->
    <FAQ items={MAXON_FAQ} title="Частые вопросы про Maxon для бизнеса" />

    <!-- Финальный CTA -->
    <section class="block final">
      <div class="final-grid">
        <div>
          <h2>Подобрать Maxon для компании</h2>
          <p class="muted">Опишите задачу: какие продукты нужны, сколько специалистов будет работать
            и требуется ли централизованное управление местами. Подготовим расчёт, КП или счёт.</p>
          <ul class="mfeat">
            <li>Оформление для юрлиц: договор, счёт, закрывающие</li>
            <li>Individuals и Teams в одном заказе</li>
            <li>Подбор по составу команды и числу мест</li>
          </ul>
        </div>
        <LeadForm source="maxon-landing" title="Подбор Maxon" submitLabel="Получить расчёт и КП" />
      </div>
    </section>

    <!-- Внутренние ссылки -->
    <section class="block links">
      <h2>Связанные товары и разделы</h2>
      <div class="link-grid">
        {maxon.map((p) => <a href={`/product/${p.slug}`}>{p.name}</a>)}
        <a href="/catalog/design">Всё для дизайна и графики</a>
        <a href="/how-we-work">Как мы работаем</a>
        <a href="/pricing">Стоимость и расчёт</a>
        <a href="/documents">Документы</a>
        <a href="/contacts">Контакты</a>
      </div>
    </section>
  </div>

  <!-- Ещё по теме: статьи, аналоги, сравнения этого вендора (IDX-001) -->
  <VendorInterlinks vendorSlug="maxon" productSlugs={maxon.map((p) => p.slug)} />

  <QuestionForm source="maxon" />
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .hero { padding: 1rem 0 1.5rem; }
  .hero-main { max-width: 820px; }
  .vendor-row { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem; }
  .vendor-name { font-weight: 700; font-size: 1.05rem; }
  .vendor-legal { color: var(--color-text-dim); font-size: 0.85rem; }
  h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); margin-bottom: 1rem; }
  .hero-sub { color: var(--color-text-muted); font-size: 1.08rem; max-width: 62ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 1.2rem 0; }
  .chips li { background: var(--color-bg-elevated); border: 1px solid var(--color-border); color: var(--color-text-muted); font-size: 0.82rem; padding: 0.25rem 0.7rem; border-radius: 999px; }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.8rem; }
  .from { color: var(--color-text-muted); font-size: 0.92rem; }
  .from b { color: var(--color-text); }
  .summary { background: var(--color-bg-card); border: 1px solid var(--color-border); border-left: 3px solid var(--color-accent); border-radius: var(--radius); padding: 1rem 1.2rem; margin: 1.5rem 0; color: var(--color-text); box-shadow: var(--shadow-sm); }
  .summary strong { color: var(--color-text); }
  .block { margin-top: 3rem; }
  .block > h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-bottom: 1.2rem; }
  .section-sub { color: var(--color-text-muted); max-width: 72ch; margin: -0.6rem 0 1.2rem; }
  /* Командный раздел логически отделён линией сверху */
  .plans-teams { border-top: 1px solid var(--color-border); padding-top: 2.4rem; }
  .mgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.2rem; }
  .mcard { padding: 1.4rem; display: flex; flex-direction: column; }
  .mhead { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .mbadge { font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.55rem; border-radius: 6px; }
  .mbadge.ind { background: color-mix(in srgb, var(--color-accent) 16%, transparent); color: var(--color-accent); }
  .mbadge.team { background: color-mix(in srgb, #E5006D 14%, transparent); color: #E5006D; }
  .mbadge.kind { background: var(--color-bg-elevated); color: var(--color-text-muted); }
  .mcard h3 { font-size: 1.12rem; margin-bottom: 0.3rem; min-height: 2.4em; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .forwhom { color: var(--color-text-dim); font-size: 0.82rem; margin-bottom: 0.6rem; }
  .mprice { margin: 0.3rem 0 0.7rem; }
  .mprice b { font-size: 1.2rem; }
  .mprice .note { color: var(--color-text-dim); font-size: 0.8rem; }
  .mprice .req { font-weight: 700; }
  .mfeat { list-style: none; padding: 0; margin: 0 0 0.7rem; display: grid; gap: 0.3rem; }
  .mfeat li { padding-left: 1.3rem; position: relative; color: var(--color-text); font-size: 0.88rem; }
  .mfeat li::before { content: '✓'; position: absolute; left: 0; color: var(--color-accent); font-weight: 700; }
  .mactions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: auto; }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table.cmp { width: 100%; border-collapse: collapse; min-width: 640px; font-size: 0.92rem; }
  table.cmp th, table.cmp td { border: 1px solid var(--color-border); padding: 0.55rem 0.8rem; text-align: left; }
  table.cmp thead th { background: var(--color-bg-elevated); }
  table.cmp .sticky { position: sticky; left: 0; background: var(--color-bg-card); font-weight: 600; }
  table.decision a { color: var(--color-accent); }
  .muted { color: var(--color-text-muted); }
  .small { font-size: 0.82rem; margin-top: 0.6rem; }
  .cells { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
  .cell { padding: 1.3rem; }
  .cell h3 { font-size: 1.05rem; margin-bottom: 0.4rem; }
  .cell p { color: var(--color-text-muted); font-size: 0.9rem; }
  .steps { padding-left: 1.2rem; color: var(--color-text); display: grid; gap: 0.5rem; margin-bottom: 1.2rem; max-width: 800px; }
  .final-grid { display: grid; grid-template-columns: 1fr 400px; gap: 2.5rem; align-items: start; }
  .links .link-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.6rem; }
  .links a { color: var(--color-accent); font-size: 0.92rem; padding: 0.5rem 0; }
  @media (max-width: 880px) { .final-grid { grid-template-columns: 1fr; } }
  /* Значок продукта слева от названия в плитке. Заголовок в карточке
     резервирует две строки (min-height у .mcard h3) — при однострочном
     названии текст прижимался к верху резерва и уезжал вверх относительно
     значка; в строке со значком резерв высоты не нужен. */
  .pih { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.4rem; }
  .pih h3 { margin-bottom: 0; min-height: 0; }
</style>

<script>
  import { trackGoal } from '@/lib/analytics';
  // Аналитические события (Метрика + GA4)
  trackGoal('view_vendor_landing', { vendor: 'maxon', page_url: location.pathname });
  document.querySelectorAll('[data-ev]').forEach((el) => {
    el.addEventListener('click', () => trackGoal((el as HTMLElement).dataset.ev!, { block_name: 'maxon' }));
  });
  // событие просмотра таблицы сравнения (один раз)
  const cmp = document.querySelector('[data-ev-view]');
  if (cmp && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { trackGoal((cmp as HTMLElement).dataset.evView!); io.disconnect(); } }), { threshold: 0.3 });
    io.observe(cmp);
  }
</script>

---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import LeadForm from '../../components/LeadForm.astro';
import VendorIcon from '../../components/VendorIcon.astro';
import { productIcons } from '../../data/product-icons';
import ProductIcon from '../../components/ProductIcon.astro';
import AddToCartButton from '../../components/AddToCartButton.astro';
import QuestionForm from '../../components/QuestionForm.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getProducts } from '../../lib/directus';
import { effectivePrice, formatRub } from '../../lib/pricing';
import { collectionPageSchema, faqSchema, breadcrumbSchema } from '../../lib/seo';
import {
  FIGMA_VENDOR, FIGMA_SUMMARY, FIGMA_SEATS, FIGMA_ORDER, FIGMA_CARD_META,
  FIGMA_COMPARISON, FIGMA_DECISION, FIGMA_SCENARIOS, FIGMA_FAQ,
} from '../../data/figma';
import type { Product } from '../../lib/types';

let all: Product[] = [];
try { all = await getProducts({ vendor: 'Figma' }); } catch (e) { console.error('figma landing', e); }
const items = all.filter((p) => p.sku.startsWith('FIGMA-')).sort((a, b) => FIGMA_ORDER.indexOf(a.sku) - FIGMA_ORDER.indexOf(b.sku));

const cards = items.map((p) => {
  const eff = effectivePrice(p);
  const meta = FIGMA_CARD_META[p.sku];
  return { name: p.name, slug: p.slug, sku: p.sku, price: eff.price, priceText: formatRub(eff.price), note: p.price_note || '', byRequest: !(eff.price > 0), meta, features: meta?.features?.slice(0, 5) || [] };
});
const priced = items.filter((p) => effectivePrice(p).price > 0);
const minPrice = priced.length ? Math.min(...priced.map((p) => effectivePrice(p).price)) : 0;
const hasMin = minPrice > 0;

const title = 'Купить Figma для юрлица — Professional, Organization, Enterprise (места Full/Dev/Collab)';
const description = 'Figma для бизнеса по модели посадочных мест: Full, Dev и Collab на планах Professional, Organization и Enterprise. Оформление на юрлицо по договору и счёту, оплата в рублях.';
const pageUrl = '/vendors/figma';
const crumbs = [{ name: 'Каталог', url: '/catalog' }, { name: 'Дизайн и графика', url: '/catalog/design' }, { name: 'Figma', url: pageUrl }];
const ld = [
  collectionPageSchema({ name: 'Figma для бизнеса', description, url: pageUrl, items: cards.map((c) => ({ name: c.name, slug: c.slug })) }),
  faqSchema(FIGMA_FAQ),
  breadcrumbSchema([{ name: 'Главная', url: '/' }, ...crumbs]),
];
---
<BaseLayout title={title} description={description} type="website" canonical={pageUrl}>
  <JsonLd schema={ld} />
  <div class="container-page section" style={`--vc:${FIGMA_VENDOR.brandColor}`}>
    <Breadcrumbs items={crumbs} />

    <header class="hero">
      <div class="vendor-row"><VendorIcon slug="figma" name="Figma" size={44} /><span class="vendor-name">Figma</span><span class="vendor-legal">{FIGMA_VENDOR.legalName}</span></div>
      <h1>Figma для юридических лиц: места, планы и оформление через BIZSoft</h1>
      <p class="hero-sub">Подберите Figma по новой модели посадочных мест — Full (дизайн), Dev (разработка) и Collab (просмотр) на планах Professional, Organization и Enterprise. Оформление на организацию с оплатой по счёту.</p>
      <ul class="chips"><li>Для юрлиц</li><li>КП и счёт</li><li>Договор и закрывающие</li><li>Оплата в рублях</li></ul>
      <div class="hero-actions">
        <button class="btn btn-primary" data-open-question data-product="Figma — подбор мест" data-ev="click_get_quote">Получить расчёт и КП</button>
        <a href="#products" class="btn btn-ghost" data-ev="click_choose_plan">Смотреть тарифы</a>
      </div>
      {hasMin && <p class="from">Цены от <b>{formatRub(minPrice)}</b> в год</p>}
    </header>

    <div class="summary"><strong>Коротко:</strong> {FIGMA_SUMMARY}</div>

    <section class="block">
      <h2>Типы мест в Figma</h2>
      <div class="cells">{FIGMA_SEATS.map((s) => (<div class="card cell"><h3>{s.title}</h3><p>{s.text}</p></div>))}</div>
      <p class="muted small">Вы платите только за нужный тип места каждому сотруднику — это снижает стоимость по сравнению с покупкой всем полного места.</p>
    </section>

    <section class="block" id="products">
      <h2>Тарифы и места Figma</h2>
      <div class="vgrid">
        {cards.map((c) => (
          <article class="card vcard">
            {c.meta && <div class="vhead"><span class="vbadge">{c.meta.badge}</span></div>}
            <div class="pih">
              {productIcons(c.slug).length > 0 && <ProductIcon slug={c.slug} name={c.name} size={36} />}
              <h3>{c.name}</h3>
            </div>
            {c.meta?.forWhom && <p class="forwhom">{c.meta.forWhom}</p>}
            <div class="vprice">{c.byRequest ? <span class="req">Цена по запросу</span> : <span class="pv"><b>{c.priceText}</b> <span class="note">{c.note}</span></span>}</div>
            {c.features.length > 0 && <ul class="vfeat">{c.features.map((f) => <li>{f}</li>)}</ul>}
            <div class="vactions">
              {c.byRequest ? (
                <button class="btn btn-primary btn-sm" data-open-question data-product={`Figma — ${c.name}`} data-sku={c.sku} data-ev="click_get_quote">Запросить цену</button>
              ) : (
                <AddToCartButton sku={c.sku} slug={c.slug} name={c.name} vendor="Figma" price={c.price} compact />
              )}
              <a href={`/product/${c.slug}`} class="btn btn-ghost btn-sm" data-ev="click_product_card">Подробнее</a>
            </div>
          </article>
        ))}
      </div>
      <p class="muted small">Цена в рублях пересчитывается по курсу ЦБ РФ.</p>
    </section>

    <section class="block" id="compare">
      <h2>Сравнение планов Figma</h2>
      <div class="table-wrap">
        <table class="cmp">
          <thead><tr><th class="sticky">Параметр</th>{FIGMA_COMPARISON.cols.map((c) => <th>{c}</th>)}</tr></thead>
          <tbody>{FIGMA_COMPARISON.rows.map((r) => (<tr><th class="sticky">{r.label}</th>{r.values.map((v) => <td>{v}</td>)}</tr>))}</tbody>
        </table>
      </div>
      <p class="muted small">Цены за место в месяц при годовой оплате (USD-прайс Figma). В рублях — по курсу ЦБ РФ на дату счёта.</p>
    </section>

    <section class="block">
      <h2>Что выбрать</h2>
      <div class="table-wrap">
        <table class="cmp decision">
          <thead><tr><th class="sticky">Сценарий</th><th>Рекомендуем</th><th>Почему</th></tr></thead>
          <tbody>{FIGMA_DECISION.map((d) => (<tr><th class="sticky">{d.scenario}</th><td>{d.product}</td><td class="muted">{d.note}</td></tr>))}</tbody>
        </table>
      </div>
    </section>

    <section class="block">
      <h2>Сценарии использования</h2>
      <div class="cells">{FIGMA_SCENARIOS.map((s) => (<div class="card cell"><h3>{s.title}</h3><p>{s.text}</p></div>))}</div>
    </section>

    <section class="block">
      <h2>Как купить Figma через BIZSoft</h2>
      <ol class="steps">
        <li>Вы оставляете заявку или выбираете план и места.</li>
        <li>Менеджер уточняет план и количество мест каждого типа (Full/Dev/Collab).</li>
        <li>BIZSoft готовит КП или счёт с ценой в рублях.</li>
        <li>Оформляются договор и оплата по счёту.</li>
        <li>После оплаты передаём доступы и инструкции.</li>
        <li>Закрывающие документы — в согласованном формате, в том числе через ЭДО.</li>
      </ol>
      <button class="btn btn-primary" data-open-question data-product="Figma — расчёт и КП" data-ev="click_get_quote">Получить расчёт и КП</button>
    </section>

    <FAQ items={FIGMA_FAQ} title="Частые вопросы про Figma для бизнеса" />

    <section class="block final">
      <div class="final-grid">
        <div>
          <h2>Подобрать Figma для компании</h2>
          <p class="muted">Опишите команду: сколько дизайнеров, разработчиков и стейкхолдеров. Подберём план и места, подготовим расчёт, КП или счёт.</p>
          <ul class="vfeat"><li>Оформление для юрлиц: договор, счёт, закрывающие</li><li>Оплата в рублях по курсу ЦБ РФ</li><li>Оптимальный набор мест Full/Dev/Collab</li></ul>
        </div>
        <LeadForm source="vendor-figma" title="Подбор Figma" submitLabel="Получить расчёт и КП" />
      </div>
    </section>

    <section class="block links">
      <h2>Связанные товары и разделы</h2>
      <div class="link-grid">
        {cards.map((c) => <a href={`/product/${c.slug}`}>{c.name}</a>)}
        <a href="/catalog/design">Весь дизайн и графика</a><a href="/vendors">Все производители</a>
        <a href="/how-we-work">Как мы работаем</a><a href="/documents">Документы</a><a href="/contacts">Контакты</a>
      </div>
    </section>
  </div>
  <QuestionForm source="figma" />
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .hero { padding: 1rem 0 1.5rem; max-width: 820px; }
  .vendor-row { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1rem; }
  .vendor-name { font-weight: 700; font-size: 1.05rem; }
  .vendor-legal { color: var(--color-text-dim); font-size: 0.85rem; }
  h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); margin-bottom: 1rem; }
  .hero-sub { color: var(--color-text-muted); font-size: 1.08rem; max-width: 64ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 1.2rem 0; }
  .chips li { background: var(--color-bg-elevated); border: 1px solid var(--color-border); color: var(--color-text-muted); font-size: 0.82rem; padding: 0.25rem 0.7rem; border-radius: 999px; }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.8rem; }
  .from { color: var(--color-text-muted); font-size: 0.92rem; } .from b { color: var(--color-text); }
  .summary { background: var(--color-bg-card); border: 1px solid var(--color-border); border-left: 3px solid var(--vc, var(--color-accent)); border-radius: var(--radius); padding: 1rem 1.2rem; margin: 1.5rem 0; color: var(--color-text); } .summary strong { color: var(--color-text); }
  .block { margin-top: 3rem; } .block > h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-bottom: 1.2rem; }
  .vgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.2rem; }
  .vcard { padding: 1.4rem; display: flex; flex-direction: column; }
  .vhead { display: flex; margin-bottom: 0.5rem; }
  .vbadge { font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.55rem; border-radius: 6px; background: color-mix(in srgb, var(--vc) 16%, transparent); color: var(--vc); }
  .vcard h3 { font-size: 1.1rem; margin-bottom: 0.3rem; }
  .forwhom { color: var(--color-text-dim); font-size: 0.83rem; margin-bottom: 0.6rem; }
  .vprice { margin: 0.3rem 0 0.7rem; } .vprice b { font-size: 1.2rem; } .vprice .note { color: var(--color-text-dim); font-size: 0.8rem; } .vprice .req { font-weight: 700; }
  .vfeat { list-style: none; padding: 0; margin: 0 0 0.7rem; display: grid; gap: 0.3rem; }
  .vfeat li { padding-left: 1.3rem; position: relative; color: var(--color-text); font-size: 0.88rem; } .vfeat li::before { content: '✓'; position: absolute; left: 0; color: var(--vc, var(--color-accent)); font-weight: 700; }
  .vactions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: auto; }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table.cmp { width: 100%; border-collapse: collapse; min-width: 560px; font-size: 0.92rem; }
  table.cmp th, table.cmp td { border: 1px solid var(--color-border); padding: 0.55rem 0.8rem; text-align: left; }
  table.cmp thead th { background: var(--color-bg-elevated); }
  table.cmp .sticky { position: sticky; left: 0; background: var(--color-bg-card); font-weight: 600; }
  .muted { color: var(--color-text-muted); } .small { font-size: 0.82rem; margin-top: 0.6rem; }
  .cells { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
  .cell { padding: 1.3rem; } .cell h3 { font-size: 1.05rem; margin-bottom: 0.4rem; } .cell p { color: var(--color-text-muted); font-size: 0.9rem; }
  .steps { padding-left: 1.2rem; color: var(--color-text); display: grid; gap: 0.5rem; margin-bottom: 1.2rem; max-width: 800px; }
  .final-grid { display: grid; grid-template-columns: 1fr 400px; gap: 2.5rem; align-items: start; }
  .links .link-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.6rem; }
  .links a { color: var(--color-accent); font-size: 0.92rem; padding: 0.5rem 0; }
  @media (max-width: 880px) { .final-grid { grid-template-columns: 1fr; } }
  /* Значок продукта слева от названия в плитке */
  .pih { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.4rem; }
  .pih h3 { margin-bottom: 0; }
</style>

<script>
  function track(name: string, params: Record<string, unknown> = {}) {
    const w = window as unknown as { ym?: (...a: unknown[]) => void; gtag?: (...a: unknown[]) => void };
    const id = (import.meta as { env: Record<string, string> }).env.PUBLIC_METRIKA_ID || '110206070';
    if (typeof w.ym === 'function' && id) w.ym(Number(id), 'reachGoal', name, params);
    if (typeof w.gtag === 'function') w.gtag('event', name, params);
  }
  track('view_figma_landing', { page_url: location.pathname });
  document.querySelectorAll('[data-ev]').forEach((el) => el.addEventListener('click', () => track((el as HTMLElement).dataset.ev!, { block_name: 'figma' })));
</script>

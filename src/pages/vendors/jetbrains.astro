  /* Карточки */
  .zgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.2rem; }
  .zcard { padding: 1.4rem; display: flex; flex-direction: column; scroll-margin-top: 90px; }
  .zhead { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem; }
  .zlic { font-size: 0.7rem; color: var(--color-text-dim); border: 1px solid var(--color-border); border-radius: 6px; padding: 0.1rem 0.45rem; }
  .zbadge { font-size: 0.7rem; font-weight: 700; padding: 0.15rem 0.55rem; border-radius: 6px; }
  .zbadge.cap { background: color-mix(in srgb, #FB0F60 16%, transparent); color: #FB0F60; }
  .zbadge.pack { background: color-mix(in srgb, #FB0F60 22%, transparent); color: #FB0F60; }
  .zbadge.dotnet { background: color-mix(in srgb, #8b5cf6 16%, transparent); color: #7c3aed; }
  .zbadge.db { background: color-mix(in srgb, #0ea5e9 16%, transparent); color: #0369a1; }
  .zbadge.ai { background: color-mix(in srgb, #8b5cf6 16%, transparent); color: #7c3aed; }
  .zbadge.req { background: var(--color-bg-elevated); color: var(--color-text-muted); }
  .zcard h3 { font-size: 1.12rem; margin-bottom: 0.3rem; }
  .forwhom { color: var(--color-text-dim); font-size: 0.82rem; margin-bottom: 0.6rem; }
  .zprice { margin: 0.3rem 0 0.7rem; }
  .zprice b { font-size: 1.2rem; }
  .zprice .note { color: var(--color-text-dim); font-size: 0.8rem; }
  .zprice .req { font-weight: 700; }
  .zfeat { list-style: none; padding: 0; margin: 0 0 0.7rem; display: grid; gap: 0.3rem; }
  .zfeat li { padding-left: 1.3rem; position: relative; color: var(--color-text); font-size: 0.88rem; }
  .zfeat li::before { content: '✓'; position: absolute; left: 0; color: #FB0F60; font-weight: 700; }
  .zcheck { color: var(--color-text-dim); font-size: 0.78rem; margin: 0 0 0.7rem; }
  .zactions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: auto; }
  .zfine { color: var(--color-text-dim); font-size: 0.72rem; margin: 0.6rem 0 0; }
  /* Таблицы */
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table.cmp { width: 100%; border-collapse: collapse; min-width: 640px; font-size: 0.92rem; }
  table.cmp th, table.cmp td { border: 1px solid var(--color-border); padding: 0.55rem 0.8rem; text-align: left; vertical-align: top; }
  table.cmp thead th { background: var(--color-bg-elevated); }
  table.cmp .sticky { position: sticky; left: 0; background: var(--color-bg-card); font-weight: 600; }

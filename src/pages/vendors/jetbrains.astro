  .ai-tiers .cell { display: flex; flex-direction: column; }
  .caveat { background: var(--color-bg-elevated); border: 1px solid var(--color-border); border-left: 3px solid #FB0F60; border-radius: var(--radius); padding: 0.9rem 1.1rem; margin: 1.2rem 0; color: var(--color-text-muted); font-size: 0.9rem; max-width: 80ch; }

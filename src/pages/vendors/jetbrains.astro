  .links a { color: #FB0F60; font-size: 0.92rem; padding: 0.5rem 0; }
  @media (max-width: 880px) { .final-grid { grid-template-columns: 1fr; } }
  /* Значок продукта слева от названия в плитке */
  .pih { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.4rem; }
  .pih h3 { margin-bottom: 0; }
</style>

<script>
  // Аналитические события (Метрика + GA4)
  function track(name: string, params: Record<string, unknown> = {}) {
    const w = window as unknown as { ym?: (...a: unknown[]) => void; gtag?: (...a: unknown[]) => void };
    const id = (import.meta as { env: Record<string, string> }).env.PUBLIC_METRIKA_ID || '110206070';
    if (typeof w.ym === 'function' && id) w.ym(Number(id), 'reachGoal', name, params);
    if (typeof w.gtag === 'function') w.gtag('event', name, params);
  }
  track('view_jetbrains_landing', { page_url: location.pathname });
  document.querySelectorAll('[data-ev]').forEach((el) => {
    el.addEventListener('click', () => track((el as HTMLElement).dataset.ev!, { block_name: 'jetbrains' }));
  });

  // Быстрый подбор: при выборе стека показываем результат и предзаполняем КП
  const result = document.querySelector('[data-pick-result]') as HTMLElement | null;
  const resultName = document.querySelector('[data-pick-name]') as HTMLElement | null;
  const resultCta = document.querySelector('[data-pick-cta]') as HTMLElement | null;
  document.querySelectorAll('[data-pick]').forEach((el) => {
    el.addEventListener('click', () => {
      const q = (el as HTMLElement).dataset.pick || '';
      if (result && resultName && resultCta) {
        resultName.textContent = q;
        resultCta.setAttribute('data-product', `JetBrains — ${q}`);
        result.hidden = false;
      }
    });
  });

  // Событие просмотра таблицы сравнения (один раз)
  const cmp = document.querySelector('[data-ev-view]');
  if (cmp && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { track((cmp as HTMLElement).dataset.evView!); io.disconnect(); } }), { threshold: 0.3 });
    io.observe(cmp);
  }
</script>

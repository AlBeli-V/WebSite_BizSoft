---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ScaffoldPage from '../../components/ScaffoldPage.astro';
import VendorLanding from '../../components/VendorLanding.astro';
import VendorGenericLanding from '../../components/VendorGenericLanding.astro';
import { vendorBySlug } from '../../data/vendors';
import { vendors as scaffoldVendors } from '../../data/scaffold';
import { getVendors } from '../../lib/directus';
import { isSourceUnavailable, serviceUnavailable } from '../../lib/http';
import { vendorSlug } from '../../lib/vendor-links';
import { SEO_EXPERIMENTS } from '../../data/seo-experiments';

const { slug } = Astro.params;
const entry = slug ? vendorBySlug(slug) : undefined;
const scaffold = !entry && slug ? scaffoldVendors.find((v) => v.slug === slug) : undefined;

// Типовой лендинг для вендоров каталога без bespoke-страницы (эталон — /vendors/jetbrains).
let live: { vendor: string; count: number } | undefined;
if (!entry && !scaffold && slug) {
  try {
    live = (await getVendors()).find((r) => vendorSlug(r.vendor) === slug);
  } catch (e) {
    // Список вендоров живёт в БД: без него нельзя отличить «вендора нет»
    // от «БД недоступна», а 404 удалил бы лендинг из индекса.
    console.error('vendor fallback error', e);
    if (isSourceUnavailable(e)) return serviceUnavailable();
  }
}
if (!entry && !scaffold && !live) return new Response(null, { status: 404 });

const vTitle = entry ? (entry.title || entry.vendor) : '';
// SEO-эксперимент P0-1: точечные метаданные 5 страниц (см. seo-experiments.ts).
const exp = entry ? SEO_EXPERIMENTS[entry.slug] : undefined;
const title = entry ? (exp?.title ?? `Купить ${vTitle} для юрлица — тарифы, счёт и КП`) : '';
const description = entry
  ? (exp?.description ?? `${vTitle} для юридических лиц: ${entry.tagline} Оформление по договору и счёту, оплата в рублях, закрывающие документы через ЭДО.`)
  : '';
const liveName = live ? (live.vendor.match(/^(.+?)\s*\(/)?.[1] ?? live.vendor) : '';
---
{entry ? (
  <BaseLayout title={title} description={description} type="website" canonical={`/vendors/${entry.slug}`}>
    <VendorLanding entry={entry} />
  </BaseLayout>
) : live ? (
  <BaseLayout
    title={`Купить ${liveName} для юрлица — тарифы, счёт и КП`}
    description={`${liveName} для юридических лиц: годовые подписки и лицензии по договору и счёту в рублях, закрывающие документы через ЭДО. Расчёт и КП за 1 день.`}
    type="website"
    canonical={`/vendors/${slug}`}
  >
    <VendorGenericLanding vendor={live.vendor} slug={slug!} />
  </BaseLayout>
) : (
  <ScaffoldPage
    title={`${scaffold!.title} — ПО по договору и счёту`}
    description={scaffold!.description}
    crumbs={[{ name: 'Производители', url: '/vendors' }, { name: scaffold!.title, url: `/vendors/${scaffold!.slug}` }]}
  />
)}

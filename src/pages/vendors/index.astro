---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { vendors } from '../../data/scaffold';
import { vendorLandings } from '../../config/site';
---
<BaseLayout
  title="Производители ПО"
  description="Каталог по производителям ПО. Готова страница Zoom для бизнеса; остальные вендоры в подготовке."
  noindex={true}
>
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'Производители', url: '/vendors' }]} />
    <h1>Производители ПО</h1>
    <p class="lead">Подбор и оформление ПО на юрлицо по договору и счёту. Готовые страницы вендоров:</p>
    <div class="vgrid">
      {vendorLandings.map((v) => (
        <a href={`/vendors/${v.slug}`} class="card card-hover v ready">
          <strong>{v.name}</strong>
          <span>{v.description}</span>
          <em>Открыть →</em>
        </a>
      ))}
      {vendors.map((v) => (
        <div class="card v soon">
          <strong>{v.title}</strong>
          <span>{v.description}</span>
          <em class="muted">Скоро</em>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
<style>
  .section { padding: 2rem 0 4rem; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom: 0.8rem; }
  .lead { color: var(--color-text-muted); margin-bottom: 1.5rem; }
  .vgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
  .v { padding: 1.4rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .v strong { font-size: 1.15rem; }
  .v span { color: var(--color-text-muted); font-size: 0.9rem; flex-grow: 1; }
  .v.ready em { color: var(--color-accent); font-weight: 600; font-style: normal; }
  .v.soon { opacity: 0.7; }
  .muted { color: var(--color-text-dim); font-style: normal; font-size: 0.85rem; }
</style>

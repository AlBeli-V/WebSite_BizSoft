---
/**
 * Раздел «Правовая информация» — точка входа во все документы сайта.
 *
 * В главное меню документы не выносятся (ТЗ 16.09.2026, п. 1): их место —
 * подвал и эта страница. Но без собственной страницы раздел не имел бы ни
 * хлебных крошек, ни адреса, который можно дать в ответ на запрос.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { LEGAL_MANIFEST, LEGAL_DOC_IDS, legalDateRu } from '../../lib/legal';
import { COOKIE_UI, LEGAL_CARD_SUMMARY } from '../../config/legal';

// Подпись карточки — не подзаголовок документа, а ответ на вопрос «что мне
// это даёт»: человек выбирает из пяти документов, не открывая каждый.
const docs = LEGAL_DOC_IDS.map((id) => ({
  id,
  meta: LEGAL_MANIFEST[id],
  summary: LEGAL_CARD_SUMMARY[id],
  dateRu: legalDateRu(LEGAL_MANIFEST[id].version),
}));
---
<BaseLayout
  title="Правовая информация"
  description="Политика обработки персональных данных, согласия, cookies и веб-аналитика, условия использования сайта BIZSoft. Действующие редакции с датой."
  canonical="/legal"
>
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'Правовая информация', url: '/legal' }]} />
    <h1>Правовая информация</h1>
    <p class="lg-lead">
      Здесь размещены действующие документы BIZSoft, регулирующие обработку персональных данных,
      использование файлов cookie и сервисов веб-аналитики, информационные и рекламные сообщения,
      а также использование сайта.
    </p>

    {/* Заголовок второго уровня нужен не для красоты: без него на странице
        было h1, а следующим — h3 подвала, то есть пропуск уровня (смоук
        ловит это проверкой «h1→h3»). */}
    <h2>Действующие редакции</h2>
    <ul class="lg-list">
      {docs.map((d) => (
        <li class="lg-item">
          <a class="lg-title" href={d.meta.url}>{d.meta.title}</a>
          <p class="lg-sub">{d.summary}</p>
          <p class="lg-rev">Редакция от {d.dateRu}</p>
        </li>
      ))}
    </ul>

    <h2>Аналитика и cookies</h2>
    <p class="lg-cookies-lead">
      Яндекс.Метрика и Google Analytics включаются только по вашему выбору. Изменить его
      можно в любой момент — здесь или по ссылке «Настройки cookies» в подвале сайта.
    </p>
    <p class="lg-cookies">
      <button type="button" class="btn btn-outline btn-sm" data-cookie-settings>{COOKIE_UI.footerLink}</button>
    </p>
  </div>
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  h1 { font-size: clamp(1.7rem, 3.4vw, 2.3rem); margin-bottom: 0.5rem; }
  .lg-lead { color: var(--color-text-muted); max-width: 70ch; margin-bottom: 2rem; }
  .lg-list { list-style: none; padding: 0; display: grid; gap: 0.9rem; max-width: 820px; }
  .lg-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-elevated);
    padding: 1rem 1.2rem;
  }
  .lg-title { font-weight: 700; font-size: 1.02rem; color: var(--color-text); }
  .lg-title:hover { color: var(--color-accent); }
  .lg-sub { margin: 0.3rem 0 0; color: var(--color-text-muted); font-size: 0.9rem; }
  .lg-rev { margin: 0.45rem 0 0; color: var(--color-text-dim); font-size: 0.8rem; }
  h2 { font-size: clamp(1.1rem, 2.2vw, 1.35rem); margin: 2.2rem 0 0.9rem; }
  .lg-cookies-lead { color: var(--color-text-muted); max-width: 70ch; margin: 0 0 1rem; font-size: 0.92rem; }
  .lg-cookies { margin-top: 0; }
</style>

---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import QuestionForm from '../../components/QuestionForm.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getProducts, getCategoryBySlug, getProductsBySlugs } from '../../lib/directus';
import { LICENSE_LABEL, type LicenseType } from '../../lib/types';
import { productKind, PRODUCT_KIND_LABEL, type ProductKind } from '../../lib/catalog';
import { itemListSchema } from '../../lib/seo';
import { aiSubcategories, aiFlagships } from '../../data/ai-hub';
import { comparisons } from '../../data/comparisons';
import { solutions } from '../../data/solutions';
import { effectivePrice } from '../../lib/pricing';
import type { Product } from '../../lib/types';

const { segment } = Astro.params;

// Отечественное ПО убрано: старые origin-маршруты ведут в общий каталог.
if (segment === 'domestic' || segment === 'foreign') {
  return Astro.redirect('/catalog', 301);
}

// Разделы-дубли, слитые в основные: у каждого было по одному-два товара при
// соседнем разделе того же назначения. Товары переехали, сам раздел снят с
// витрины — без редиректа его адрес отдавал бы 404 уже проиндексированной
// странице. Список тот же, что в `merge` из data/catalog/categories.json.
const MERGED: Record<string, string> = {
  'graphics-design': 'design',
  'ai-services': 'ai',
  communications: 'vcs',
  'developer-tools': 'development',
};
if (segment && MERGED[segment]) {
  return Astro.redirect(`/catalog/${MERGED[segment]}`, 301);
}

// Плоские slug AI-подкатегорий Directus (ai-text и т.п.) канонизируем на вложенные
// URL (/catalog/ai/text), чтобы не плодить дубли одной выдачи.
const flatAiSub = aiSubcategories.find((s) => s.categorySlug === segment);
if (flatAiSub) {
  return Astro.redirect(`/catalog/ai/${flatAiSub.sub}`, 301);
}

const url = Astro.url;
const qp = url.searchParams;
const selVendor = qp.get('vendor') || '';
const selLicense = (qp.get('license') || '') as LicenseType | '';
const selKind = (qp.get('ptype') || '') as ProductKind | '';
const q = (qp.get('q') || '').trim();

let title = '';
let lead = '';
let base: Product[] = [];
let pageCategory = null;

try {
  pageCategory = await getCategoryBySlug(segment!);
  if (pageCategory) {
    if (segment === 'ai') {
      // Родительская категория AI агрегирует товары всех дочерних ai-*:
      // прямые привязки к «ai» + все подкатегории (ai-text, ai-code, …).
      const all = await getProducts();
      base = all.filter((p) => {
        const cs = typeof p.category === 'object' && p.category ? p.category.slug : '';
        return cs === 'ai' || cs.startsWith('ai-');
      });
    } else {
      base = await getProducts({ categorySlug: segment! });
    }
    title = pageCategory.name;
    lead = pageCategory.intro || pageCategory.seo_text || `${pageCategory.name}: зарубежные лицензии и подписки для юрлиц по договору и счёту.`;
  }
} catch (e) {
  console.error('catalog segment error', e);
}

if (!pageCategory) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// ── фасеты из базового набора ──
const vendorFacet = new Map<string, number>();
const kindFacet = new Map<ProductKind, number>();
for (const p of base) {
  if (p.vendor) vendorFacet.set(p.vendor, (vendorFacet.get(p.vendor) || 0) + 1);
  const k = productKind(p); kindFacet.set(k, (kindFacet.get(k) || 0) + 1);
}
const vendors = [...vendorFacet.entries()].sort((a, b) => a[0].localeCompare(b[0], 'ru'));

// ── применяем выбранные фильтры (в JS) ──
const ql = q.toLowerCase();
const filtered = base.filter((p) => {
  if (selVendor && p.vendor !== selVendor) return false;
  if (selKind && productKind(p) !== selKind) return false;
  if (selLicense && p.license_type !== selLicense) return false;
  if (ql) {
    const hay = `${p.name} ${p.vendor || ''} ${p.keywords || ''} ${p.sku}`.toLowerCase();
    if (!hay.includes(ql)) return false;
  }
  return true;
});
// «Цена по запросу» — всегда в конце списка
filtered.sort((a, b) => Number(!(effectivePrice(a).price > 0)) - Number(!(effectivePrice(b).price > 0)));

const categoryFaqs = Array.isArray(pageCategory?.faqs) ? pageCategory!.faqs! : [];
const faq = categoryFaqs.length > 0 ? categoryFaqs : [
  { q: 'Как купить ПО для юрлица?', a: 'Добавьте позиции в избранное и нажмите «Получить КП» либо оставьте заявку. Заключаем договор, выставляем счёт, после оплаты предоставляем доступ и передаём закрывающие через ЭДО.' },
  { q: 'Цены окончательные?', a: 'Цены ориентировочные (часть — по запросу или по курсу ЦБ). Итог подтверждаем в счёте.' },
];
const basePath = `/catalog/${segment}`;
const hasFilters = Boolean(selVendor || selLicense || selKind || q);

// AI-хаб: навигация по подкатегориям + сравнения + сценарии (только для /catalog/ai).
const isAi = segment === 'ai';
const aiScenarios = isAi ? solutions.filter((s) => s.slug.startsWith('ai-dlya-')) : [];
const aiCompare = isAi ? comparisons.slice(0, 6) : [];

// Витрина флагманов: ссылка на карточку, только если товар уже импортирован
// (проверка в рантайме); иначе — на подкатегорию. Нет 404 до импорта.
let flagships: { name: string; href: string }[] = [];
if (isAi) {
  const wanted = aiFlagships
    .filter((f) => f.href.startsWith('/product/'))
    .map((f) => f.href.slice('/product/'.length));
  let existing = new Set<string>();
  try {
    const rows = await getProductsBySlugs(wanted);
    existing = new Set(rows.map((r) => r.slug));
  } catch (e) {
    console.error('flagships lookup', e);
  }
  flagships = aiFlagships.map((f) => {
    const slug = f.href.startsWith('/product/') ? f.href.slice('/product/'.length) : null;
    return { name: f.name, href: slug && !existing.has(slug) ? `/catalog/ai/${f.sub}` : f.href };
  });
}
---
<BaseLayout
  title={pageCategory ? (pageCategory.meta_title || `${title} — каталог`) : `${title} — каталог`}
  description={pageCategory?.meta_description || lead.slice(0, 160)}
  canonical={basePath}
  noindex={hasFilters}
>
  {pageCategory && <JsonLd schema={itemListSchema(pageCategory, filtered, basePath)} />}
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'Каталог', url: '/catalog' }, { name: title, url: basePath }]} />
    <header class="head">
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
    </header>

    {isAi && flagships.length > 0 && (
      <nav class="ai-flagships" aria-label="Популярные AI-сервисы">
        {flagships.map((f) => (
          <a href={f.href} class="ai-chip">{f.name}</a>
        ))}
      </nav>
    )}

    {isAi && (
      <nav class="ai-subs" aria-label="Категории AI-сервисов">
        {aiSubcategories.map((s) => (
          <a href={`/catalog/ai/${s.sub}`} class="card card-hover ai-sub">
            <span class="ai-ico"><CategoryIcon slug={s.sub} name={s.name} size={48} /></span>
            <span class="ai-name">{s.name}</span>
            <span class="ai-desc">{s.short}</span>
          </a>
        ))}
      </nav>
    )}

    <div class="catalog-layout">
      <!-- Фильтры -->
      <aside class="filters card">
        <form method="get" action={basePath} data-filter-form>
          <div class="f-search">
            <input type="search" name="q" value={q} placeholder="Поиск по названию, вендору…" aria-label="Поиск" />
            <button type="submit" class="btn btn-primary btn-sm">Найти</button>
          </div>

          {vendors.length > 0 && (
            <div class="f-group">
              <label for="f-vendor">Производитель</label>
              <select id="f-vendor" name="vendor" data-autosubmit>
                <option value="">Все производители</option>
                {vendors.map(([v, c]) => (
                  <option value={v} selected={selVendor === v}>{v} ({c})</option>
                ))}
              </select>
            </div>
          )}

          {kindFacet.size > 1 && (
            <div class="f-group">
              <label for="f-ptype">Тип товара</label>
              <select id="f-ptype" name="ptype" data-autosubmit>
                <option value="">Любой</option>
                <option value="main" selected={selKind === 'main'}>{PRODUCT_KIND_LABEL.main} ({kindFacet.get('main') || 0})</option>
                <option value="addon" selected={selKind === 'addon'}>{PRODUCT_KIND_LABEL.addon} ({kindFacet.get('addon') || 0})</option>
              </select>
            </div>
          )}

          <div class="f-group">
            <label for="f-license">Тип использования</label>
            <select id="f-license" name="license" data-autosubmit>
              <option value="">Любой</option>
              <option value="org" selected={selLicense === 'org'}>{LICENSE_LABEL.org}</option>
              <option value="individual" selected={selLicense === 'individual'}>{LICENSE_LABEL.individual}</option>
              <option value="student" selected={selLicense === 'student'}>{LICENSE_LABEL.student}</option>
            </select>
          </div>

          <noscript><button type="submit" class="btn btn-ghost btn-sm">Применить</button></noscript>
          <a href={basePath} class="reset-link">Сбросить фильтры</a>
        </form>
      </aside>

      <!-- Результаты -->
      <div class="results">
        <div class="results-head">
          <span>Найдено: <b>{filtered.length}</b></span>
          <a href="/catalog" class="switch-link">← Весь каталог</a>
        </div>
        {filtered.length > 0 ? (
          <div class="product-grid">
            {filtered.map((p) => <ProductCard product={p} />)}
          </div>
        ) : (
          <p class="empty">Ничего не найдено по выбранным фильтрам. <a href={basePath}>Сбросить →</a></p>
        )}
      </div>
    </div>

    {isAi && (
      <section class="ai-links">
        <div class="ai-col">
          <h2>Популярные сравнения</h2>
          <div class="ai-grid">
            {aiCompare.map((c) => (
              <a href={`/compare/${c.slug}`} class="card card-hover ai-link">{c.h1} →</a>
            ))}
          </div>
        </div>
        <div class="ai-col">
          <h2>AI под задачу</h2>
          <div class="ai-grid">
            {aiScenarios.map((s) => (
              <a href={`/solutions/${s.slug}`} class="card card-hover ai-link">{s.title} →</a>
            ))}
          </div>
        </div>
      </section>
    )}

    <FAQ items={faq} title="Вопросы по разделу" />
  </div>
  <CTASection />
  <QuestionForm source="catalog" />
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .head { max-width: 820px; margin-bottom: 2rem; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom: 0.8rem; }
  .lead { color: var(--color-text-muted); font-size: 1.05rem; }
  .catalog-layout { display: grid; grid-template-columns: 260px 1fr; gap: 1.8rem; align-items: start; }
  .filters { padding: 1.3rem; position: sticky; top: 84px; }
  .f-search { display: flex; gap: 0.4rem; margin-bottom: 1rem; }
  .f-search input { flex: 1; min-width: 0; }
  .f-group { margin-bottom: 0.9rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .f-group label { font-size: 0.8rem; color: var(--color-text-muted); }
  .filters input, .filters select { background: var(--color-bg-elevated); border: 1px solid var(--color-border-strong); border-radius: 8px; padding: 0.5rem 0.6rem; color: var(--color-text); font: inherit; font-size: 0.9rem; width: 100%; }
  .reset-link { display: inline-block; margin-top: 0.6rem; color: var(--color-text-dim); font-size: 0.85rem; }
  .reset-link:hover { color: var(--color-accent); }
  .results-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.2rem; color: var(--color-text-muted); font-size: 0.92rem; }
  .switch-link { color: var(--color-accent); font-weight: 600; }
  .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 1.2rem; }
  .empty { color: var(--color-text-muted); }
  .empty a { color: var(--color-accent); }
  /* AI-хаб */
  .ai-flagships { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.6rem; }
  .ai-chip { display: inline-block; padding: 0.45rem 0.9rem; border: 1px solid var(--color-border-strong); border-radius: 999px; background: var(--color-bg-elevated); color: var(--color-text); font-size: 0.88rem; font-weight: 600; transition: border-color 0.15s, color 0.15s; }
  .ai-chip:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .ai-subs { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.9rem; margin-bottom: 2rem; }
  .ai-sub { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.45rem; padding: 1.6rem 1.2rem 1.4rem; }
  /* Единая инфографика с /catalog: крупная линейная иконка в акцентном чипе */
  .ai-ico {
    width: 76px; height: 76px; border-radius: 19px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-accent-soft); color: var(--color-accent);
    margin-bottom: 0.25rem;
  }
  .ai-name { font-weight: 700; color: var(--color-text); }
  .ai-desc { font-size: 0.85rem; color: var(--color-text-muted); }
  .ai-links { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; margin-top: 2.4rem; }
  .ai-links h2 { font-size: 1.3rem; margin-bottom: 1rem; }
  .ai-grid { display: grid; gap: 0.7rem; }
  .ai-link { padding: 0.9rem 1.1rem; font-weight: 600; color: var(--color-accent); }
  @media (max-width: 720px) { .ai-links { grid-template-columns: 1fr; } }
  @media (max-width: 820px) {
    .catalog-layout { grid-template-columns: 1fr; }
    .filters { position: static; }
  }
</style>

<script>
  // Автосабмит формы фильтров при изменении select (без JS работает кнопкой/Enter).
  const form = document.querySelector('[data-filter-form]') as HTMLFormElement | null;
  form?.querySelectorAll('[data-autosubmit]').forEach((el) => {
    el.addEventListener('change', () => form.submit());
  });
</script>

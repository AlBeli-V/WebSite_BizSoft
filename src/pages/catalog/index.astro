---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CatalogTabs from '../../components/CatalogTabs.astro';
import CTASection from '../../components/CTASection.astro';
import Carousel from '../../components/Carousel.astro';
import VendorLogo from '../../components/VendorLogo.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import FAQ from '../../components/FAQ.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuestionForm from '../../components/QuestionForm.astro';
import CatalogRequest from '../../components/CatalogRequest.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getCategories, getProducts } from '../../lib/directus';
import { site } from '../../config/site';
import { POPULAR_VENDORS } from '../../data/popular';
import { SEO_EXPERIMENT_LINKS } from '../../data/seo-experiments';
import { aiSubcategories } from '../../data/ai-hub';
import { searchProducts } from '../../lib/product-search';
import { countByCategory, listingProducts } from '../../lib/catalog';
import { categoryMembers, crossListedCount, inCategory } from '../../lib/cross-listing';
import { effectivePrice, formatRub } from '../../lib/pricing';
import { isSourceUnavailable, serviceUnavailable } from '../../lib/http';
import type { Product, Category } from '../../lib/types';

let categories: Category[] = [];
let products: Product[] = [];
try {
  categories = await getCategories();
  products = await getProducts();
} catch (e) {
  // Пустой каталог с кодом 200 опаснее отказа: поисковик видит живую страницу
  // без товаров и выводит из индекса всё, что на ней было. Карточка товара и
  // sitemap уже отдают 503 — каталог оставался единственным местом, где сбой
  // базы выглядел как «товары закончились».
  console.error('catalog index error', e);
  if (isSourceUnavailable(e)) return serviceUnavailable();
}

// Поиск из шапки: /catalog?q=… — режим результатов вместо маркетинговой страницы.
// Логика поиска общая с WebMCP-инструментом search_products (lib/product-search):
// агент и человек обязаны находить одно и то же.
const q = (Astro.url.searchParams.get('q') || '').trim();

// Один и тот же набор для счётчиков и для карточек.
//
// Раньше плитки считались по сырой выборке, а списки разделов — по
// `listingProducts`, и подарочные карты в плитке шли вместе с номиналами:
// счётчик обещал 53 позиции, а на странице раздела их оказывалось заметно
// меньше. Считаем один раз и тем же набором, каким показываем товар.
const listing = listingProducts(products);
const searchResults = q ? searchProducts(listing, q) : [];

const catCounts = countByCategory(listing);
const catSlug = (p: Product) => (typeof p.category === 'object' && p.category ? p.category.slug : '');

// Канонический адрес раздела. У AI-подкатегорий он вложенный
// (/catalog/ai/text): плоский слаг Directus отдаёт 301, и ссылка с главного
// узла каталога уходила бы через лишний прыжок.
const aiSubByCategory = new Map(aiSubcategories.map((s) => [s.categorySlug, s]));
const categoryHref = (slug: string) => {
  const sub = aiSubByCategory.get(slug);
  return sub ? `/catalog/ai/${sub.sub}` : `/catalog/${slug}`;
};

const usedCategories = categories
  .filter((c) => (catCounts[c.slug] || 0) > 0)
  .map((c) => ({
    slug: c.slug,
    name: c.name,
    href: categoryHref(c.slug),
    count: catCounts[c.slug],
    blurb: (c.intro || '').trim() || 'Лицензии и подписки для бизнеса с оформлением на юрлицо.',
  }));

// ── AI: раздел с собственной структурой ────────────────────────────────
// Страница /catalog/ai агрегирует родительский раздел и все ai-*, поэтому и
// счётчик на хабе обязан показывать агрегат. Прямая привязка к родителю —
// это два товара, и плитка годами обещала два при девяноста с лишним внутри.
const isAiSlug = (s: string) => s === 'ai' || s.startsWith('ai-');
// Счётчик обязан совпадать с тем, что показывает /catalog/ai: родитель, все
// ветки и пришедшее в них второй привязкой. Товар, попавший в ветку из другого
// раздела, на странице хаба виден — значит и в счётчике должен быть.
const aiTotal = listing.filter((p) => isAiSlug(catSlug(p))
  || aiSubcategories.some((s) => inCategory(p, s.categorySlug))).length;
const aiCategory = categories.find((c) => c.slug === 'ai') || null;
// Ветки AI собираются общим механизмом второй привязки (lib/cross-listing):
// у товара одна категория, а показывается он и в разделе, который закрывает ту
// же задачу. «Корпоративные AI» так живут с самого начала — enterprise-тарифы
// лежат в тематических ветках, а на свою страницу попадают списком.
const aiSubs = aiSubcategories
  .map((s) => {
    const items = categoryMembers(listing, s.categorySlug);
    const cross = crossListedCount(listing, s.categorySlug);
    return {
      sub: s.sub,
      name: s.name,
      short: s.short,
      count: items.length,
      // Раздел целиком собран второй привязкой — складывать его счётчик со
      // счётчиками соседних веток нельзя, товары в них уже посчитаны.
      cross: cross > 0 && cross === items.length,
      vendors: topVendors(items, 2),
    };
  })
  .sort((a, b) => b.count - a.count);

// Товары-представители AI: по одному из самых ёмких веток, порядок внутри
// ветки — редакторский (поле sort в Directus), не случайный.
const aiPicks: Product[] = [];
for (const s of aiSubs) {
  if (aiPicks.length >= 4) break;
  const pick = categoryMembers(listing, `ai-${s.sub}`).find((p) => effectivePrice(p).price > 0);
  if (pick) aiPicks.push(pick);
}

// ── Крупные и нишевые разделы ──────────────────────────────────────────
const nonAi = usedCategories.filter((c) => !isAiSlug(c.slug)).sort((a, b) => b.count - a.count);
const majorCategories = nonAi.slice(0, 4).map((c) => ({
  ...c,
  vendors: topVendors(categoryMembers(listing, c.slug), 5),
  picks: pickPriced(categoryMembers(listing, c.slug), 2),
}));
const minorCategories = nonAi.slice(4);
const majorTotal = majorCategories.reduce((n, c) => n + c.count, 0);

// ── Сводка каталога для боковой колонки ────────────────────────────────
const totalProducts = listing.length;
const vendorCount = new Set(listing.map((p) => (p.vendor || '').trim()).filter(Boolean)).size;
const pricedCount = listing.filter((p) => effectivePrice(p).price > 0).length;
const onRequestCount = totalProducts - pricedCount;
// Отечественное ПО снято с витрины: выборка товаров исключает origin=domestic
// (lib/directus.ts), поэтому в каталоге таких позиций ровно ноль. Показываем
// это числом из данных, а не подписью: вернутся позиции — вернётся и строка.
const domesticCount = listing.filter((p) => p.origin === 'domestic').length;

function topVendors(items: Product[], n: number): string[] {
  const counts = new Map<string, number>();
  for (const p of items) {
    const v = (p.vendor || '').trim();
    if (v) counts.set(v, (counts.get(v) || 0) + 1);
  }
  return [...counts.entries()]
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ru'))
    .slice(0, n)
    .map(([v, c]) => `${v} ${c}`);
}

/** Первые n товаров раздела с известной ценой — порядок редакторский (sort). */
function pickPriced(items: Product[], n: number): Product[] {
  const priced = items.filter((p) => effectivePrice(p).price > 0);
  return (priced.length >= n ? priced : [...priced, ...items.filter((p) => !(effectivePrice(p).price > 0))]).slice(0, n);
}

const plural = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'товар' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'товара' : 'товаров');
const pluralSection = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'раздел' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'раздела' : 'разделов');

// Строка собирается здесь, а не в разметке: в шаблоне пробел между двумя
// соседними выражениями схлопывается, и подпись читалась как «10товаров».
const hubEyebrow = totalProducts > 0
  ? `Каталог · ${totalProducts} ${plural(totalProducts)} · ${usedCategories.length} ${pluralSection(usedCategories.length)}`
  : 'Каталог';

function textOn(hex: string): string {
  const h = hex.replace('#', '');
  const r = parseInt(h.slice(0, 2), 16), g = parseInt(h.slice(2, 4), 16), b = parseInt(h.slice(4, 6), 16);
  return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255 > 0.62 ? '#1d1d1f' : '#ffffff';
}

const benefits = [
  { t: 'Два пути оплаты', d: 'Картой, где вендор её принимает, или через счёт нашей зарубежной компании.' },
  { t: 'Документы для бухгалтерии', d: 'Договор, счёт в рублях и закрывающие через ЭДО.' },
  { t: 'Подбор под задачу', d: 'Поможем выбрать продукт, тариф и число лицензий.' },
  { t: 'Поддержка и продление', d: 'Сопровождаем доступ на всём сроке подписки.' },
];

const faq = [
  { q: 'Какое ПО есть в каталоге BIZSoft?', a: 'Зарубежные сервисы и ПО для бизнеса: дизайн и графика, средства разработки, видео и медиа, AI-сервисы, онлайн-доски и коммуникации. Например, Adobe, Figma, JetBrains, Miro, Zoom, OpenAI и другие. Оформление на юрлицо по договору и счёту.' },
  { q: 'Как купить ПО для юридического лица?', a: 'Выберите категорию или производителя, добавьте позиции в расчёт и запросите КП, либо оставьте заявку. Заключаем договор, выставляем счёт, после оплаты предоставляем доступ и передаём закрывающие документы через ЭДО.' },
  { q: 'Можно ли оплатить без зарубежной карты?', a: 'Да. Где вендор принимает карту — оплачиваем сами. Где оплата возможна только с зарубежного счёта — закупаем через счёт нашей компании за рубежом. Вы платите в рублях по договору.' },
  { q: 'Цены в каталоге окончательные?', a: 'Цены ориентировочные: часть зависит от курса ЦБ РФ на дату счёта или считается по запросу. Итоговую стоимость фиксируем в коммерческом предложении или счёте.' },
  { q: 'Есть ли в каталоге отечественное ПО из реестра?', a: 'Сейчас в каталоге только зарубежные сервисы и ПО. Реестровое отечественное ПО подбираем и закупаем по запросу: назовите продукт или задачу — проверим наличие у дистрибьютора и подготовим КП.' },
];

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Каталог зарубежного ПО и SaaS для бизнеса — BIZSoft',
    description: 'Зарубежные сервисы и ПО для российских юрлиц по договору и счёту: дизайн, разработка, видео, AI, коммуникации.',
    url: `${site.url}/catalog`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Категории каталога',
    itemListElement: usedCategories.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, url: `${site.url}${c.href}`,
    })),
  },
  // FAQPage не дублируем: разметку выводит компонент FAQ рядом с видимым блоком.
  // ItemList на странице один: карточки товаров — навигация по хабу, своей
  // разметки они не несут (правило «один тип — один раз на страницу»).
];
---
<BaseLayout
  title={q ? `Поиск «${q}» — каталог BIZSoft` : 'Каталог зарубежного ПО и SaaS для бизнеса — по договору и счёту'}
  description="Каталог зарубежных сервисов и ПО для российских юрлиц: Adobe, Figma, JetBrains, Miro, Zoom, OpenAI и другие. Дизайн, разработка, видео, AI, коммуникации. Оплата в рублях, договор, закрывающие через ЭДО."
  noindex={Boolean(q)}
>
  {!q && <JsonLd schema={ld} />}

  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'Каталог', url: '/catalog' }]} />

    {q && (
      <section class="search-res" data-search-q={q} data-search-found={String(searchResults.length)}>
        <h1>Поиск: «{q}»</h1>
        <p class="sr-meta">Найдено: <b>{searchResults.length}</b> · <a href="/catalog">Весь каталог →</a></p>
        {searchResults.length > 0 ? (
          <>
          <h2 class="sr-only">Найденные товары</h2>
          <div class="sr-grid">
            {searchResults.slice(0, 48).map((p) => <ProductCard product={p} />)}
          </div>
          </>
        ) : (
          <>
          <p class="sr-empty">Ничего не нашлось. Попробуйте другое написание — например, латиницей.</p>
          <CatalogRequest query={q} context="search" compact />
          </>
        )}
      </section>
    )}

    {!q && (<>
    <!-- ШАПКА ХАБА: поиск как первый вход -->
    <header class="hub-head">
      <span class="eyebrow">{hubEyebrow}</span>
      <h1>Зарубежное ПО и SaaS для бизнеса — <span class="accent">с оплатой в рублях и документами</span></h1>
      <p class="lead">
        Назовите продукт — покажем цену и оформим на юрлицо. Оплачиваем картой, где вендор её
        принимает, и через счёт нашей зарубежной компании, где иначе не выйдет. Закрывающие — через ЭДО.
      </p>

      <form class="hub-search" action="/catalog" method="get" role="search" data-cat-search>
        <label class="sr-only" for="hub-q">Поиск по каталогу</label>
        <input id="hub-q" type="search" name="q" autocomplete="off"
               placeholder="Adobe, ChatGPT, Figma, JetBrains, Midjourney…"
               aria-label="Поиск по названию продукта или производителя" />
        <button type="submit" class="btn btn-primary">Найти</button>
      </form>

      <ul class="cat-badges">
        <li>Оплата картой или через зарубежный счёт</li>
        <li>Договор, счёт и ЭДО</li>
        <li>Оплата в рублях</li>
      </ul>
    </header>

    <CatalogTabs active="categories" />

    {usedCategories.length > 0 ? (
    <div class="hub-layout">
      <!-- БОКОВАЯ КОЛОНКА: происхождение и сводка -->
      <aside class="hub-side card" aria-label="О каталоге">
        <div class="side-grp">
          <span class="side-lbl">Происхождение</span>
          <span class="side-row is-on" aria-current="true" data-cat-origin="foreign">
            <span>Зарубежное</span><b>{totalProducts}</b>
          </span>
          <button type="button" class="side-row side-row-btn" data-open-question
                  data-product="Отечественное ПО из реестра — подбор"
                  data-cat-origin="domestic">
            <span>Отечественное</span><b>{domesticCount}</b>
          </button>
          <p class="side-hint">
            Отечественное ПО сейчас не поставляем. Реестровые позиции подбираем по запросу —
            нажмите, чтобы назвать продукт или задачу.
          </p>
        </div>

        <div class="side-grp">
          <span class="side-lbl">Что в каталоге</span>
          <dl class="side-stats">
            <div><dt>Разделов</dt><dd>{usedCategories.length}</dd></div>
            <div><dt>Производителей</dt><dd>{vendorCount}</dd></div>
            <div><dt>Цена на сайте</dt><dd>{pricedCount}</dd></div>
            <div><dt>Цена по запросу</dt><dd>{onRequestCount}</dd></div>
          </dl>
        </div>

        <p class="side-links">
          <a href="/vendors">Все производители →</a>
          <a href="/solutions">Подбор по задаче →</a>
        </p>
      </aside>

      <div class="hub-main">
        <!-- ФЛАГМАН: AI с раскрытыми ветками -->
        {aiTotal > 0 && (
          <section class="flagship" aria-labelledby="flagship-h">
            <div class="fl-top">
              <div>
                <span class="eyebrow">Флагман каталога</span>
                <h2 id="flagship-h">
                  <a href="/catalog/ai" data-cat-category="ai">{aiCategory?.name || 'AI-сервисы'}</a>
                </h2>
                <p class="fl-sub">
                  Корпоративные тарифы с оформлением на юрлицо: ассистенты, генерация кода,
                  изображения, видео и звук. Единственный раздел с собственной структурой веток.
                </p>
              </div>
              <a href="/catalog/ai" class="fl-badge" data-cat-category="ai">{aiTotal} {plural(aiTotal)} →</a>
            </div>

            <div class="fl-subs">
              {aiSubs.map((s) => (s.count > 0 ? (
                <a href={`/catalog/ai/${s.sub}`} class="fl-sub-tile" data-cat-ai-sub={s.sub}>
                  <span class="fs-ico"><CategoryIcon slug={`ai-${s.sub}`} name={s.name} size={28} /></span>
                  <span class="fs-name">{s.name}</span>
                  <span class="fs-meta">{s.cross ? `${s.count} · тарифы из других веток` : `${s.count} · ${s.vendors.length > 0 ? s.vendors.map((v) => v.replace(/ \d+$/, '')).join(', ') : s.short}`}</span>
                </a>
              ) : (
                <span class="fl-sub-tile is-soon" aria-disabled="true">
                  <span class="fs-ico"><CategoryIcon slug={`ai-${s.sub}`} name={s.name} size={28} /></span>
                  <span class="fs-name">{s.name}</span>
                  <span class="fs-meta">в подготовке</span>
                </span>
              )))}
            </div>

            {aiPicks.length > 0 && (
              <div class="fl-prods">
                {aiPicks.map((p) => (
                  <div data-cat-product={p.slug}><ProductCard product={p} /></div>
                ))}
              </div>
            )}
          </section>
        )}

        <!-- КРУПНЫЕ РАЗДЕЛЫ -->
        {majorCategories.length > 0 && (
          <section class="hub-block" aria-labelledby="major-h">
            <div class="hub-sechead">
              <h2 id="major-h">Крупные разделы</h2>
              <span class="hub-cnt">{majorCategories.length} {pluralSection(majorCategories.length)} из {usedCategories.length} дают {majorTotal} {plural(majorTotal)}</span>
            </div>
            <div class="major-grid">
              {majorCategories.map((c) => (
                <article class="major-card">
                  <div class="mj-head">
                    <h3><a href={c.href} data-cat-category={c.slug}>{c.name}</a></h3>
                    <span class="mj-count">{c.count}</span>
                  </div>
                  {c.vendors.length > 0 && <p class="mj-vendors">{c.vendors.join(' · ')}</p>}
                  {c.picks.map((p) => {
                    const eff = effectivePrice(p);
                    return (
                      <a href={`/product/${p.slug}`} class="mj-row" data-cat-product={p.slug}>
                        <span class="mj-name">{p.name}</span>
                        <span class="mj-price">{eff.price > 0 ? `от ${formatRub(eff.price)}` : 'по запросу'}</span>
                      </a>
                    );
                  })}
                  <a href={c.href} class="mj-all" data-cat-category={c.slug}>
                    {c.count > 1 ? `Все ${c.count} ${plural(c.count)} →` : 'Открыть раздел →'}
                  </a>
                </article>
              ))}
            </div>
          </section>
        )}

        <!-- НИШЕВЫЕ РАЗДЕЛЫ: компактный список, все ссылки на месте -->
        {minorCategories.length > 0 && (
          <section class="hub-block" aria-labelledby="minor-h">
            <div class="hub-sechead">
              <h2 id="minor-h">Ещё {minorCategories.length} {pluralSection(minorCategories.length)}</h2>
            </div>
            <ul class="minor-list">
              {minorCategories.map((c) => (
                <li>
                  <a href={c.href} data-cat-category={c.slug}>
                    <span class="mn-ico"><CategoryIcon slug={c.slug} name={c.name} size={20} /></span>
                    <span class="mn-name">{c.name}</span>
                    <span class="mn-count">{c.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
    ) : (
      <p class="cat-empty">Разделы каталога загружаются. Напишите нам — подберём нужный сервис: <button class="link-btn" data-open-question>обсудить задачу →</button></p>
    )}

    <CatalogRequest context="catalog" />

    <!-- ПРОИЗВОДИТЕЛИ -->
    <section class="cat-block">
      <SectionHeading eyebrow="Производители" title="Бренды, которые подключают чаще всего">
        <p>Откройте страницу производителя — там тарифы, сравнение и оформление на юрлицо.</p>
      </SectionHeading>

<script>
  // Поиск по каталогу — единственное место, где посетитель прямо называет,
  // что ему нужно. Пустая выдача дороже любого замера частотности: это спрос,
  // который дошёл до нас и ушёл ни с чем. Цель ставится на странице
  // результатов, а не на отправке формы, — тогда учитываются и переходы по
  // готовой ссылке с запросом.
  import { trackGoal } from '@/lib/analytics';
  const res = document.querySelector('[data-search-q]') as HTMLElement | null;
  if (res) {
    const term = res.dataset.searchQ || '';
    const found = Number(res.dataset.searchFound || '0');
    trackGoal(found > 0 ? 'search_used' : 'search_no_results', { search_term: term, results: found });
  }

  // Выходы с хаба каталога.
  //
  // Общий делегированный слушатель, а не атрибут data-goal на каждой ссылке:
  // хабу нужны параметры (какой раздел, какая ветка, какой товар), а data-goal
  // из макета шлёт только имя цели. Разметка на элементах — чтобы новая плитка
  // считалась сама, без правки скрипта.
  const HUB_GOALS: [string, string, string][] = [
    ['catOrigin', 'catalog_origin_click', 'origin'],
    ['catAiSub', 'catalog_ai_subcategory_click', 'subcategory'],
    ['catCategory', 'catalog_category_click', 'category'],
    ['catProduct', 'catalog_product_click', 'product'],
  ];
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target?.closest) return;
    for (const [attr, goal, param] of HUB_GOALS) {
      // Ветка AI лежит внутри блока раздела AI, а карточка товара — внутри
      // плитки раздела: ищем ближайшую разметку и останавливаемся на ней,
      // иначе один клик отправлял бы две цели разного уровня.
      const el = target.closest(`[data-${attr.replace(/[A-Z]/g, (c) => '-' + c.toLowerCase())}]`) as HTMLElement | null;
      if (!el) continue;
      trackGoal(goal, { [param]: el.dataset[attr] || '', page_url: location.pathname });
      return;
    }
  });

  const form = document.querySelector('[data-cat-search]') as HTMLFormElement | null;
  form?.addEventListener('submit', () => {
    const field = form.querySelector('input[name="q"]') as HTMLInputElement | null;
    const term = (field?.value || '').trim();
    if (term) trackGoal('catalog_search', { search_term: term });
  });
</script>


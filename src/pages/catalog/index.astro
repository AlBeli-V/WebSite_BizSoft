---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import HeroSteps from '../../components/HeroSteps.astro';
import CatalogTabs from '../../components/CatalogTabs.astro';
import CTASection from '../../components/CTASection.astro';
import Carousel from '../../components/Carousel.astro';
import VendorLogo from '../../components/VendorLogo.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import FAQ from '../../components/FAQ.astro';
import ProductCard from '../../components/ProductCard.astro';
import QuestionForm from '../../components/QuestionForm.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getCategories, getProducts } from '../../lib/directus';
import { site } from '../../config/site';
import { POPULAR_VENDORS } from '../../data/popular';
import { SEO_EXPERIMENT_LINKS } from '../../data/seo-experiments';
import { searchProducts } from '../../lib/product-search';
import { isSourceUnavailable, serviceUnavailable } from '../../lib/http';
import type { Product, Category } from '../../lib/types';

let categories: Category[] = [];
let products: Product[] = [];
try {
  categories = await getCategories();
  products = await getProducts();
} catch (e) {
  // Пустой каталог с кодом 200 опаснее отказа: поисковик видит живую страницу
  // без товаров и выводит из индекса всё, что на ней было. Карточка товара и
  // sitemap уже отдают 503 — каталог оставался единственным местом, где сбой
  // базы выглядел как «товары закончились».
  console.error('catalog index error', e);
  if (isSourceUnavailable(e)) return serviceUnavailable();
}

// Поиск из шапки: /catalog?q=… — режим результатов вместо маркетинговой страницы.
// Логика поиска общая с WebMCP-инструментом search_products (lib/product-search):
// агент и человек обязаны находить одно и то же.
const q = (Astro.url.searchParams.get('q') || '').trim();
const searchResults = q ? searchProducts(products, q) : [];

const catCounts: Record<string, number> = {};
for (const p of products) {
  const slug = typeof p.category === 'object' && p.category ? p.category.slug : '';
  if (slug) catCounts[slug] = (catCounts[slug] || 0) + 1;
}
const usedCategories = categories
  .filter((c) => (catCounts[c.slug] || 0) > 0)
  .map((c) => ({
    slug: c.slug,
    name: c.name,
    count: catCounts[c.slug],
    blurb: (c.intro || '').trim() || 'Лицензии и подписки для бизнеса с оформлением на юрлицо.',
  }));

const plural = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'товар' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'товара' : 'товаров');

function textOn(hex: string): string {
  const h = hex.replace('#', '');
  const r = parseInt(h.slice(0, 2), 16), g = parseInt(h.slice(2, 4), 16), b = parseInt(h.slice(4, 6), 16);
  return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255 > 0.62 ? '#1d1d1f' : '#ffffff';
}

const benefits = [
  { t: 'Два пути оплаты', d: 'Картой, где вендор её принимает, или через счёт нашей зарубежной компании.' },
  { t: 'Документы для бухгалтерии', d: 'Договор, счёт в рублях и закрывающие через ЭДО.' },
  { t: 'Подбор под задачу', d: 'Поможем выбрать продукт, тариф и число лицензий.' },
  { t: 'Поддержка и продление', d: 'Сопровождаем доступ на всём сроке подписки.' },
];

const faq = [
  { q: 'Какое ПО есть в каталоге BIZSoft?', a: 'Зарубежные сервисы и ПО для бизнеса: дизайн и графика, средства разработки, видео и медиа, AI-сервисы, онлайн-доски и коммуникации. Например, Adobe, Figma, JetBrains, Miro, Zoom, OpenAI и другие. Оформление на юрлицо по договору и счёту.' },
  { q: 'Как купить ПО для юридического лица?', a: 'Выберите категорию или производителя, добавьте позиции в избранное и запросите КП, либо оставьте заявку. Заключаем договор, выставляем счёт, после оплаты предоставляем доступ и передаём закрывающие документы через ЭДО.' },
  { q: 'Можно ли оплатить без зарубежной карты?', a: 'Да. Где вендор принимает карту — оплачиваем сами. Где оплата возможна только с зарубежного счёта — закупаем через счёт нашей компании за рубежом. Вы платите в рублях по договору.' },
  { q: 'Цены в каталоге окончательные?', a: 'Цены ориентировочные: часть зависит от курса ЦБ РФ на дату счёта или считается по запросу. Итоговую стоимость фиксируем в коммерческом предложении или счёте.' },
];

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Каталог зарубежного ПО и SaaS для бизнеса — BIZSoft',
    description: 'Зарубежные сервисы и ПО для российских юрлиц по договору и счёту: дизайн, разработка, видео, AI, коммуникации.',
    url: `${site.url}/catalog`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Категории каталога',
    itemListElement: usedCategories.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, url: `${site.url}/catalog/${c.slug}`,
    })),
  },
  // FAQPage не дублируем: разметку выводит компонент FAQ рядом с видимым блоком.
];
---
<BaseLayout
  title={q ? `Поиск «${q}» — каталог BIZSoft` : 'Каталог зарубежного ПО и SaaS для бизнеса — по договору и счёту'}
  description="Каталог зарубежных сервисов и ПО для российских юрлиц: Adobe, Figma, JetBrains, Miro, Zoom, OpenAI и другие. Дизайн, разработка, видео, AI, коммуникации. Оплата в рублях, договор, закрывающие через ЭДО."
  noindex={Boolean(q)}
>
  {!q && <JsonLd schema={ld} />}

  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'Каталог', url: '/catalog' }]} />

    {q && (
      <section class="search-res" data-search-q={q} data-search-found={String(searchResults.length)}>
        <h1>Поиск: «{q}»</h1>
        <p class="sr-meta">Найдено: <b>{searchResults.length}</b> · <a href="/catalog">Весь каталог →</a></p>
        {searchResults.length > 0 ? (
          <div class="sr-grid">
            {searchResults.slice(0, 48).map((p) => <ProductCard product={p} />)}
          </div>
        ) : (
          <p class="sr-empty">Ничего не нашлось. Попробуйте другое написание (например, латиницей) или <button class="btn btn-primary btn-sm" data-open-question>спросите нас</button> — подключаем и то, чего нет в каталоге.</p>
        )}
      </section>
    )}

    {!q && (<>
    <!-- HERO -->
    <header class="cat-hero hero-cols">
      <div>
      <span class="eyebrow">Каталог</span>
      <h1>Зарубежное ПО и SaaS для бизнеса — <span class="accent">с оплатой и документами</span></h1>
      <p class="lead">
        Подбираем и оформляем на юрлицо сервисы, которыми пользуется весь мир: дизайн, разработка,
        видео, AI и коммуникации. Оплачиваем картой, где вендор её принимает, и через счёт нашей
        зарубежной компании, где иначе не выйдет. Вы платите в рублях по договору, закрывающие —
        через ЭДО.
      </p>
      <div class="cat-actions">
        <button class="btn btn-primary" data-open-question data-goal="catalog_discuss">Обсудить задачу</button>
        <a href="/vendors" class="btn btn-ghost">Производители</a>
      </div>
      <ul class="cat-badges">
        <li>Оплата картой или через зарубежный счёт</li>
        <li>Договор, счёт и ЭДО</li>
        <li>Оплата в рублях</li>
      </ul>
    </div>
      <HeroSteps />
    </header>

    <CatalogTabs active="categories" />

    <!-- ПЛАШКИ ЗАДАЧ -->
    <section class="cat-block">
      <SectionHeading num="01" eyebrow="По задачам" title="Выберите, что нужно команде">
        <p>Каждый раздел — набор проверенных сервисов под конкретную задачу бизнеса.</p>
      </SectionHeading>
      {usedCategories.length > 0 ? (
        <div class="task-grid">
          {usedCategories.map((c) => (
            <a href={`/catalog/${c.slug}`} class="task-tile reveal" aria-label={`${c.name} — ${c.count} ${plural(c.count)}`}>
              <span class="task-icon"><CategoryIcon slug={c.slug} name={c.name} size={64} /></span>
              <h3>{c.name}</h3>
              <span class="task-count">{c.count} {plural(c.count)}</span>
              <p>{c.blurb}</p>
              <span class="task-link">Открыть раздел →</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="cat-empty">Разделы каталога загружаются. Напишите нам — подберём нужный сервис: <button class="link-btn" data-open-question>обсудить задачу →</button></p>
      )}
    </section>

    <!-- ПРОИЗВОДИТЕЛИ -->
    <section class="cat-block">
      <SectionHeading num="02" eyebrow="Производители" title="Бренды, которые подключают чаще всего">
        <p>Откройте страницу производителя — там тарифы, сравнение и оформление на юрлицо.</p>
      </SectionHeading>
      <Carousel label="Производители" autoplay={2600} slideWidth="clamp(200px, 60vw, 240px)">
        {POPULAR_VENDORS.map((b) => (
          <a href={`/vendors/${b.slug}`} class="brand-chip" role="listitem" aria-label={`${b.name} — купить для юрлица`}>
            <span class="brand-badge" style={`--bc:${b.color}; --tc:${textOn(b.color)}`}><VendorLogo slug={b.slug} name={b.name} size={24} /></span>
            <span class="brand-name">{b.name}</span>
          </a>
        ))}
      </Carousel>
      <p class="pop-links">
        {SEO_EXPERIMENT_LINKS.map((l) => <a href={`/vendors/${l.slug}`}>{l.anchor}</a>)}
      </p>
      <p class="all-vendors"><a href="/vendors">Все производители →</a></p>
    </section>

    <!-- ВЫГОДЫ -->
    <section class="cat-block band">
      <SectionHeading num="03" eyebrow="Почему BIZSoft" title="Закупка без простоев и с документами">
      </SectionHeading>
      <div class="benefit-grid">
        {benefits.map((b) => (
          <div class="card benefit-card reveal">
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </div>
        ))}
      </div>
    </section>

    <FAQ items={faq} title="Частые вопросы по каталогу" />
    </>)}
  </div>

  <CTASection
    title="Не нашли нужный сервис?"
    text="Опишите задачу — подберём способ закупки, посчитаем стоимость и подготовим КП."
    primaryLabel="Обсудить задачу"
    primaryHref="/contacts"
    secondaryLabel="Все производители"
    secondaryHref="/vendors"
  />
  <QuestionForm source="catalog" />
</BaseLayout>

<script>
  // Поиск по каталогу — единственное место, где посетитель прямо называет,
  // что ему нужно. Пустая выдача дороже любого замера частотности: это спрос,
  // который дошёл до нас и ушёл ни с чем. Цель ставится на странице
  // результатов, а не на отправке формы, — тогда учитываются и переходы по
  // готовой ссылке с запросом.
  import { trackGoal } from '@/lib/analytics';
  const res = document.querySelector('[data-search-q]') as HTMLElement | null;
  if (res) {
    const term = res.dataset.searchQ || '';
    const found = Number(res.dataset.searchFound || '0');
    trackGoal(found > 0 ? 'search_used' : 'search_no_results', { search_term: term, results: found });
  }
</script>

<style>
  .section { padding-top: 2rem; }

  /* Результаты поиска (?q=) */
  .search-res { margin: 1rem 0 2rem; }
  .search-res h1 { font-size: clamp(1.6rem, 3.5vw, 2.3rem); margin-bottom: 0.5rem; }
  .sr-meta { color: var(--color-text-muted); margin-bottom: 1.4rem; }
  .sr-meta a { color: var(--color-accent); font-weight: 600; }
  .sr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.2rem; }
  .sr-empty { color: var(--color-text-muted); display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap; }

  /* HERO */
  .cat-hero { max-width: 760px; margin: 1rem 0 3rem; }
  .cat-hero h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); margin: 0.8rem 0 1rem; }
  .accent { color: var(--color-accent); }
  .cat-hero .lead { color: var(--color-text-muted); font-size: clamp(1.02rem, 1.6vw, 1.18rem); }
  .cat-actions { display: flex; gap: 0.8rem; margin: 1.6rem 0 1.2rem; flex-wrap: wrap; }
  .cat-badges { display: flex; gap: 0.6rem 1.4rem; list-style: none; padding: 0; margin: 0; flex-wrap: wrap; color: var(--color-text-muted); font-size: 0.9rem; }
  .cat-badges li { position: relative; padding-left: 1.1rem; }
  .cat-badges li::before { content: '●'; position: absolute; left: 0; color: var(--color-accent); font-size: 0.6rem; top: 0.35em; }

  .cat-block { padding-top: clamp(2.5rem, 5vw, 4rem); }

  /* Плашки задач — крупная инфографика: линейная иконка по центру, как у
     больших софт-магазинов. Hover: выпирает + заливается акцентом. */
  .task-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.2rem; }
  .task-tile {
    position: relative;
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.55rem;
    padding: 2rem 1.5rem 1.7rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform 0.28s ease, box-shadow 0.28s ease, background 0.28s ease, border-color 0.28s ease;
    will-change: transform;
  }
  .task-tile:hover { transform: translateY(-8px) scale(1.015); box-shadow: var(--shadow-lg); background: var(--color-accent); border-color: var(--color-accent); }
  .task-tile:hover h3,
  .task-tile:hover p,
  .task-tile:hover .task-count,
  .task-tile:hover .task-link,
  .task-tile:hover .task-icon { color: #fff; }
  .task-tile:hover .task-icon { background: rgba(255, 255, 255, 0.16); }
  .task-icon {
    width: 96px; height: 96px; border-radius: 24px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-accent-soft); color: var(--color-accent);
    transition: background 0.28s ease, color 0.28s ease;
    margin-bottom: 0.35rem;
  }
  .task-count { font-size: 0.85rem; font-weight: 600; color: var(--color-text-dim); transition: color 0.28s ease; }
  .task-tile h3 { font-size: 1.18rem; line-height: 1.3; transition: color 0.28s ease; }
  .task-tile p { color: var(--color-text-muted); font-size: 0.9rem; flex-grow: 1; transition: color 0.28s ease; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .task-link { color: var(--color-accent); font-weight: 600; font-size: 0.9rem; transition: color 0.28s ease; margin-top: 0.2rem; }
  @media (prefers-reduced-motion: reduce) { .task-tile:hover { transform: none; } }

  .cat-empty { color: var(--color-text-muted); }
  .link-btn { background: none; border: none; color: var(--color-accent); font: inherit; font-weight: 600; cursor: pointer; padding: 0; }

  /* Производители */
  .brand-chip { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.1rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-bg-card); box-shadow: var(--shadow-sm); transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease; }
  .brand-chip:hover { border-color: var(--color-accent); transform: translateY(-3px); box-shadow: var(--shadow); }
  .brand-badge { width: 40px; height: 40px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; background: #fff; border: 1px solid var(--color-border); color: var(--bc); flex-shrink: 0; }
  .brand-name { font-weight: 600; font-size: 0.95rem; white-space: nowrap; }
  .pop-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem; margin-top: 1.1rem; }
  .pop-links a { color: var(--color-text-muted); font-size: 0.92rem; font-weight: 600; }
  .pop-links a:hover { color: var(--color-accent); }
  .all-vendors { margin-top: 1rem; }
  .all-vendors a { color: var(--color-accent); font-weight: 600; }

  /* Выгоды */
  .benefit-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.2rem; }
  .benefit-card { padding: 1.6rem; }
  .benefit-card h3 { font-size: 1.12rem; margin-bottom: 0.5rem; }
  .benefit-card p { color: var(--color-text-muted); font-size: 0.92rem; margin: 0; }
</style>

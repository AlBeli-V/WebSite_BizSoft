---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSteps from '../components/HeroSteps.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadForm from '../components/LeadForm.astro';
import FAQ from '../components/FAQ.astro';
import { policyFaq } from '../data/policies';

const factors = [
  { t: 'Состав и количество', d: 'Какие сервисы и сколько пользователей/рабочих мест нужно.' },
  { t: 'Срок подписки', d: 'Месячная или годовая — на длительных периодах условия выгоднее.' },
  { t: 'Актуальный курс', d: 'Для привязанных к валюте позиций цена зависит от курса ЦБ РФ на дату счёта.' },
  { t: 'Объём заказа', d: 'При большом объёме считаем условия отдельно.' },
];

const faq = policyFaq('/pricing');
---
<BaseLayout title="Стоимость и расчёт" description="Как формируется стоимость подписок на ПО в BIZSoft и как запросить индивидуальный расчёт для юрлица. Оплата по счёту в рублях.">
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'Стоимость', url: '/pricing' }]} />
    <header class="head hero-cols">
      <div>
      <h1>Стоимость и расчёт</h1>
      <p class="lead">Считаем стоимость под ваш состав и объём заказа. Ниже — из чего она складывается и форма для запроса расчёта.</p>
    </div>
      <HeroSteps />
    </header>

    <div class="grid">
      <div>
        <h2>Из чего складывается цена</h2>
        <ul class="factors">
          {factors.map((f) => (
            <li class="card reveal"><strong>{f.t}</strong><span>{f.d}</span></li>
          ))}
        </ul>
        <FAQ items={faq} title="Вопросы о стоимости" />
      </div>
      <div class="form-col">
        <LeadForm source="pricing" title="Запросить расчёт" />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .head { max-width: 720px; margin-bottom: 2.5rem; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); margin-bottom: 1rem; }
  .lead { color: var(--color-text-muted); font-size: 1.08rem; }
  .grid { display: grid; grid-template-columns: 1fr 400px; gap: 2.5rem; align-items: start; }
  h2 { font-size: 1.5rem; margin-bottom: 1rem; }
  .factors { list-style: none; padding: 0; display: grid; gap: 0.8rem; }
  .factors li { padding: 1rem 1.2rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .factors strong { font-size: 1rem; }
  .factors span { color: var(--color-text-muted); font-size: 0.92rem; }
  .form-col { position: sticky; top: 84px; }
  @media (max-width: 880px) { .grid { grid-template-columns: 1fr; } .form-col { position: static; } }
</style>

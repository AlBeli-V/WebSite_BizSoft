---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { seller } from '../../config/site';
import { getProductsBySlugs } from '../../lib/directus';
import { effectivePrice, formatRub } from '../../lib/pricing';

// Б10 аудита: готовые наборы-пресеты — продолжение типовых сценариев.
const PRESETS: { name: string; note: string; slugs: string[] }[] = [
  { name: 'AI-ассистенты для команды', note: 'Тексты, знания, ассистенты', slugs: ['chatgpt-business', 'anthropic-team', 'gemini-workspace-standard'] },
  { name: 'Отдел разработки', note: 'AI-ассистенты для кода', slugs: ['ghcopilot-business', 'cursor-business'] },
  { name: 'Дизайн и маркетинг с AI', note: 'Генерация изображений', slugs: ['mj-standard', 'recraft-advanced'] },
];
let presets: { name: string; note: string; items: { sku: string; slug: string; name: string; price: number }[]; total: number }[] = [];
try {
  const all = await getProductsBySlugs(PRESETS.flatMap((p) => p.slugs));
  presets = PRESETS.map((pr) => {
    const items = pr.slugs
      .map((sl) => all.find((x) => x.slug === sl))
      .filter(Boolean)
      .map((x) => ({ sku: x.sku, slug: x.slug, name: x.name, price: effectivePrice(x).price }))
      .filter((x) => Number.isFinite(x.price) && x.price > 0);
    return { name: pr.name, note: pr.note, items, total: items.reduce((a, x) => a + x.price, 0) };
  }).filter((pr) => pr.items.length >= 2);
} catch { /* без пресетов страница работает как раньше */ }
---
<BaseLayout title="Корзина" description="Корзина BizSoft: соберите подписки и получите коммерческое предложение в PDF." noindex={true}>
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'Корзина', url: '/cart' }]} />
    <h1>Моя подборка</h1>

    <div class="cart-layout">
      <div class="cart-items" data-cart-items>
        <p class="empty" data-empty>Подборка пуста. <a href="/catalog">Перейти в каталог →</a></p>
      </div>

      <aside class="cart-summary card" data-summary hidden>
        <div class="sum-row total"><span>Итого</span><span data-total>0 ₽</span></div>
        <p class="sum-note">Цены ориентировочные. Итог подтверждаем в счёте.</p>
        <button class="btn btn-primary" data-open-kp>Получить КП</button>
        <button class="btn btn-ghost" data-pay>Оплатить</button>
        <p class="pay-note" data-pay-note hidden>
          Сейчас оплата идёт по счёту: сформируйте КП — выставим счёт и договор.
          Онлайн-оплату подключим позже.
        </p>
        <button class="btn btn-ghost" data-share>Поделиться подборкой</button>
        <p class="share-note" data-share-note hidden>Ссылка скопирована — перешлите её коллеге или руководителю: подборка откроется у него без регистрации.</p>
        <ul class="cart-trust">
          <li>✓ В КП: реквизиты, состав, цены в рублях, условия</li>
          <li>✓ Поставка 1–3 рабочих дня после оплаты</li>
          <li>✓ Договор, счёт и закрывающие через ЭДО</li>
        </ul>
      </aside>
    </div>

    {presets.length > 0 && (
      <section class="presets">
        <h2>Готовые наборы</h2>
        <p class="presets-lead">Соберите подборку в один клик — количество мест уточним в КП.</p>
        <div class="presets-grid">
          {presets.map((pr) => (
            <div class="card preset-card">
              <h3>{pr.name}</h3>
              <p class="pc-note">{pr.note}</p>
              <ul>
                {pr.items.map((it) => <li>{it.name}</li>)}
              </ul>
              <div class="pc-bottom">
                <b>от {formatRub(pr.total)}</b>
                <button class="btn btn-primary btn-sm" data-preset={JSON.stringify(pr.items)}>Добавить набор</button>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- Диалог «Получить КП» -->
  <dialog class="kp-dialog" data-kp-dialog aria-label="Получить коммерческое предложение">
    <form class="kp-form" data-kp-form>
      <button type="button" class="kp-close" data-kp-close aria-label="Закрыть">✕</button>
      <h2>Получить КП</h2>
      <p class="kp-hint">Сформируем PDF с реквизитами и составом заказа, отправим на e-mail и дадим скачать.</p>
      <label>Организация*<input name="buyer_company" required /></label>
      <div class="kp-row">
        <label>ИНН*<input name="buyer_inn" required inputmode="numeric" /></label>
        <label>Контактное лицо*<input name="contact_name" required autocomplete="name" /></label>
      </div>
      <div class="kp-row">
        <label>E-mail*<input name="email" type="email" required autocomplete="email" /></label>
        <label>Телефон*<input name="phone" type="tel" required autocomplete="tel" /></label>
      </div>
      <label class="kp-consent">
        <input type="checkbox" name="consent" required />
        <span>Согласен на обработку персональных данных согласно <a href="/privacy" target="_blank" rel="noopener noreferrer">политике</a>.</span>
      </label>
      <button type="submit" class="btn btn-primary kp-submit">Сформировать КП (PDF)</button>
      <p class="kp-status" data-kp-status role="status" aria-live="polite"></p>
    </form>
  </dialog>
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .share-note { color: var(--color-text-muted); font-size: 0.82rem; margin: 0; }
  .presets { margin-top: 3rem; }
  .presets h2 { font-size: clamp(1.3rem, 2.6vw, 1.7rem); margin-bottom: 0.4rem; }
  .presets-lead { color: var(--color-text-muted); margin-bottom: 1.2rem; }
  .presets-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.2rem; }
  .preset-card { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .preset-card h3 { font-size: 1.08rem; }
  .pc-note { color: var(--color-text-dim); font-size: 0.85rem; margin: 0; }
  .preset-card ul { list-style: none; padding: 0; margin: 0.3rem 0 0; color: var(--color-text-muted); font-size: 0.9rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .preset-card ul li::before { content: '+ '; color: var(--color-accent); font-weight: 700; }
  .pc-bottom { margin-top: auto; padding-top: 0.8rem; display: flex; justify-content: space-between; align-items: center; gap: 0.6rem; }
  .pc-bottom b { font-variant-numeric: tabular-nums; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin-bottom: 2rem; }
  .cart-layout { display: grid; grid-template-columns: 1fr 320px; gap: 2rem; align-items: start; }
  .cart-items { display: flex; flex-direction: column; gap: 0.8rem; }
  .empty { color: var(--color-text-muted); }
  .empty a { color: var(--color-accent); }
  .cart-row { display: grid; grid-template-columns: 1fr auto auto auto; gap: 1rem; align-items: center; padding: 1rem 1.2rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius); }
  .cart-row .ci-name { font-weight: 600; }
  .cart-row .ci-sku { color: var(--color-text-dim); font-size: 0.8rem; }
  .qty { display: flex; align-items: center; gap: 0.4rem; }
  .qty button { width: 28px; height: 28px; border-radius: 6px; border: 1px solid var(--color-border-strong); background: var(--color-bg-elevated); color: var(--color-text); cursor: pointer; font-size: 1rem; }
  .qty input { width: 44px; text-align: center; background: var(--color-bg-elevated); border: 1px solid var(--color-border-strong); border-radius: 6px; color: var(--color-text); padding: 0.3rem; font: inherit; }
  .ci-sum { font-weight: 700; min-width: 90px; text-align: right; }
  .ci-remove { background: none; border: none; color: var(--color-text-dim); cursor: pointer; font-size: 1.1rem; }
  .ci-remove:hover { color: var(--color-danger); }
  .cart-summary { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.8rem; position: sticky; top: 84px; }
  .sum-row { display: flex; justify-content: space-between; }
  .sum-row.total { font-size: 1.3rem; font-weight: 700; }
  .sum-note, .pay-note { color: var(--color-text-dim); font-size: 0.82rem; margin: 0; }
  .cart-trust { list-style: none; padding: 0.8rem 0 0; margin: 0; border-top: 1px solid var(--color-border); display: grid; gap: 0.3rem; color: var(--color-text-muted); font-size: 0.85rem; }
  .kp-dialog { border: 1px solid var(--color-border-strong); border-radius: var(--radius-lg); background: var(--color-bg-card); color: var(--color-text); padding: 0; max-width: 540px; width: calc(100% - 2rem); }
  .kp-dialog::backdrop { background: rgba(0,0,0,0.6); }
  .kp-form { padding: 2rem; display: flex; flex-direction: column; gap: 0.9rem; position: relative; }
  .kp-form h2 { font-size: 1.5rem; }
  .kp-hint { color: var(--color-text-muted); font-size: 0.9rem; margin-top: -0.4rem; }
  .kp-close { position: absolute; top: 1rem; right: 1rem; background: none; border: none; color: var(--color-text-muted); font-size: 1.1rem; cursor: pointer; }
  .kp-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .kp-form label { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.86rem; color: var(--color-text-muted); }
  .kp-form input { background: var(--color-bg-elevated); border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); padding: 0.6rem 0.7rem; color: var(--color-text); font: inherit; }
  .kp-form input:focus { border-color: var(--color-accent); outline: none; }
  .kp-consent { flex-direction: row; align-items: flex-start; gap: 0.5rem; font-size: 0.82rem; }
  .kp-consent input { width: auto; margin-top: 0.2rem; }
  .kp-consent a { color: var(--color-accent); }
  .kp-status { font-size: 0.9rem; margin: 0; }
  .kp-status.ok { color: var(--color-success); }
  .kp-status.err { color: var(--color-danger); }
  @media (max-width: 860px) { .cart-layout { grid-template-columns: 1fr; } .cart-summary { position: static; } }
  @media (max-width: 520px) {
    .kp-row { grid-template-columns: 1fr; }
    .cart-row { grid-template-columns: 1fr auto; }
    /* Более удобные зоны нажатия на мобильном */
    .qty button { width: 40px; height: 40px; }
    .qty input { height: 40px; }
    .ci-remove { min-width: 40px; min-height: 40px; }
  }
</style>

<script>
  import { readCart, setQty, removeFromCart, cartTotal, clearCart, addToCart } from '../../lib/cart-client';
  import { formatRub } from '../../lib/pricing';

  const itemsEl = document.querySelector('[data-cart-items]') as HTMLElement;
  const summaryEl = document.querySelector('[data-summary]') as HTMLElement;
  const totalEl = document.querySelector('[data-total]') as HTMLElement;
  const emptyEl = document.querySelector('[data-empty]') as HTMLElement;

  function render() {
    const items = readCart();
    // удаляем старые строки
    itemsEl.querySelectorAll('.cart-row').forEach((n) => n.remove());
    if (items.length === 0) {
      emptyEl.hidden = false;
      summaryEl.hidden = true;
      return;
    }
    emptyEl.hidden = true;
    summaryEl.hidden = false;
    for (const it of items) {
      const row = document.createElement('div');
      row.className = 'cart-row';
      row.innerHTML = `
        <div>
          <div class="ci-name">${escapeHtml(it.name)}</div>
          <div class="ci-sku">Артикул: ${escapeHtml(it.sku)} · ${formatRub(it.price)}</div>
        </div>
        <div class="qty">
          <button type="button" data-dec aria-label="Меньше">−</button>
          <input type="number" min="1" value="${it.qty}" data-qty />
          <button type="button" data-inc aria-label="Больше">+</button>
        </div>
        <div class="ci-sum">${formatRub(it.price * it.qty)}</div>
        <button class="ci-remove" data-remove aria-label="Удалить">✕</button>`;
      row.querySelector('[data-inc]')!.addEventListener('click', () => { setQty(it.sku, it.qty + 1); render(); });
      row.querySelector('[data-dec]')!.addEventListener('click', () => { setQty(it.sku, it.qty - 1); render(); });
      row.querySelector('[data-remove]')!.addEventListener('click', () => { removeFromCart(it.sku); render(); });
      row.querySelector('[data-qty]')!.addEventListener('change', (e) => {
        const v = Math.max(1, Math.floor(Number((e.target as HTMLInputElement).value) || 1));
        setQty(it.sku, v); render();
      });
      itemsEl.appendChild(row);
    }
    totalEl.textContent = formatRub(cartTotal(items));
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  // Подборка по ссылке: /cart?share=<base64url(JSON)> — без регистрации.
  try {
    const share = new URLSearchParams(location.search).get('share');
    if (share) {
      const json = decodeURIComponent(escape(atob(share.replace(/-/g, '+').replace(/_/g, '/'))));
      const incoming = JSON.parse(json);
      if (Array.isArray(incoming)) {
        for (const it of incoming) {
          if (it && typeof it.sku === 'string' && typeof it.name === 'string' && Number.isFinite(it.price)) {
            addToCart({ sku: it.sku, slug: String(it.slug || ''), name: it.name, price: it.price }, Math.max(1, Math.floor(it.qty || 1)));
          }
        }
      }
      history.replaceState(null, '', '/cart');
    }
  } catch { /* битая ссылка — просто показываем текущую подборку */ }

  document.querySelector('[data-share]')?.addEventListener('click', async () => {
    const items = readCart();
    if (!items.length) return;
    const payload = items.map((i) => ({ sku: i.sku, slug: i.slug, name: i.name, price: i.price, qty: i.qty }));
    const b64 = btoa(unescape(encodeURIComponent(JSON.stringify(payload)))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    const url = `${location.origin}/cart?share=${b64}`;
    try { await navigator.clipboard.writeText(url); } catch { prompt('Скопируйте ссылку на подборку:', url); }
    const note = document.querySelector('[data-share-note]');
    if (note) note.hidden = false;
  });

  document.querySelectorAll('[data-preset]').forEach((btn) => {
    btn.addEventListener('click', () => {
      try {
        const items = JSON.parse(btn.getAttribute('data-preset') || '[]');
        for (const it of items) addToCart({ sku: it.sku, slug: it.slug, name: it.name, price: it.price }, 1);
        btn.textContent = 'Добавлено ✓';
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch { /* noop */ }
    });
  });

  render();
  window.addEventListener('cart:change', render);

  // Оплатить → пояснение (заглушка). ТОЧКА ИНТЕГРАЦИИ ЭКВАЙРИНГА:
  // здесь подключается платёжный провайдер (создание платежа и редирект).
  const payNote = document.querySelector('[data-pay-note]') as HTMLElement;
  document.querySelector('[data-pay]')?.addEventListener('click', () => { payNote.hidden = false; });

  // Диалог КП
  const dialog = document.querySelector('[data-kp-dialog]') as HTMLDialogElement;
  const form = document.querySelector('[data-kp-form]') as HTMLFormElement;
  const status = document.querySelector('[data-kp-status]') as HTMLElement;
  document.querySelector('[data-open-kp]')?.addEventListener('click', () => {
    if (readCart().length === 0) return;
    status.textContent = ''; status.className = 'kp-status';
    dialog.showModal();
  });
  document.querySelector('[data-kp-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submit = form.querySelector('.kp-submit') as HTMLButtonElement;
    submit.disabled = true;
    status.textContent = 'Формируем PDF…'; status.className = 'kp-status';
    try {
      const fd = Object.fromEntries(new FormData(form).entries());
      const items = readCart().map((i) => ({ sku: i.sku, qty: i.qty }));
      const res = await fetch('/api/quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...fd, consent: (form.elements.namedItem('consent') as HTMLInputElement).checked, items }),
      });
      if (!res.ok) {
        let msg = 'Не удалось сформировать КП. Проверьте поля и попробуйте снова.';
        try { const j = await res.json(); if (j?.error) msg = j.error; } catch { /* not json */ }
        throw new Error(msg);
      }
      const blob = await res.blob();
      const quoteNo = res.headers.get('X-Quote-No') || 'KP';
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `${quoteNo}.pdf`; document.body.appendChild(a); a.click(); a.remove();
      URL.revokeObjectURL(url);
      status.textContent = 'Готово! PDF скачан и отправлен на e-mail.'; status.className = 'kp-status ok';
      const w = window as unknown as { ym?: (...a: unknown[]) => void };
      const id = (import.meta as { env: Record<string, string> }).env.PUBLIC_METRIKA_ID;
      if (typeof w.ym === 'function' && id) w.ym(Number(id), 'reachGoal', 'quote_pdf');
    } catch (err) {
      status.textContent = err instanceof Error && err.message ? err.message : 'Не удалось сформировать КП. Попробуйте позже или позвоните нам.';
      status.className = 'kp-status err';
    } finally {
      submit.disabled = false;
    }
  });
</script>

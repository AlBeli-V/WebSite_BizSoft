---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FormGuardFields from '../../components/FormGuardFields.astro';
import { seller } from '../../config/site';
import { getProductsBySlugs } from '../../lib/directus';
import { effectivePrice, formatRub } from '../../lib/pricing';
import type { Product } from '../../lib/types';

// Б10 аудита: готовые наборы-пресеты — продолжение типовых сценариев.
const PRESETS: { name: string; note: string; slugs: string[] }[] = [
  { name: 'AI-ассистенты для команды', note: 'Тексты, знания, ассистенты', slugs: ['chatgpt-business', 'anthropic-team', 'gemini-workspace-standard'] },
  { name: 'Отдел разработки', note: 'AI-ассистенты для кода', slugs: ['ghcopilot-business', 'cursor-business'] },
  { name: 'Дизайн и маркетинг с AI', note: 'Генерация изображений', slugs: ['mj-standard', 'recraft-advanced'] },
];
let presets: { name: string; note: string; items: { sku: string; slug: string; name: string; vendor?: string; price: number }[]; total: number }[] = [];
try {
  const all = await getProductsBySlugs(PRESETS.flatMap((p) => p.slugs));
  presets = PRESETS.map((pr) => {
    const items = pr.slugs
      .map((sl) => all.find((x) => x.slug === sl))
      .filter((x): x is Product => Boolean(x))
      .map((x) => ({ sku: x.sku, slug: x.slug, name: x.name, vendor: x.vendor || '', price: effectivePrice(x).price }))
      .filter((x) => Number.isFinite(x.price) && x.price > 0);
    return { name: pr.name, note: pr.note, items, total: items.reduce((a, x) => a + x.price, 0) };
  }).filter((pr) => pr.items.length >= 2);
} catch { /* без пресетов страница работает как раньше */ }
---
<BaseLayout title="Расчёт" description="Расчёт BIZSoft: соберите подписки и получите коммерческое предложение с реквизитами." noindex={true}>
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'Расчёт', url: '/cart' }]} />
    <h1 class="h1-spec">Расчёт: спецификация для подготовки КП</h1>

    <div class="cart-layout">
      <div class="cart-items" data-cart-items>
        <p class="empty" data-empty>В расчёте пока пусто. <a href="/catalog">Перейти в каталог →</a></p>
        <!-- КП-таблица: состав, количество (ввод/кнопки), цены и суммы с НДС -->
        <div class="table-wrap" data-cart-table hidden>
          <table class="kp-table">
            <thead>
              <tr>
                <th class="c-num">№</th>
                <th class="c-vendor">Производитель</th>
                <th class="c-name">Состав и описание</th>
                <th class="c-qty">Кол-во</th>
                <th class="c-money">Цена руб</th>
                <th class="c-money">Сумма руб</th>
                <th class="c-del">Удалить</th>
              </tr>
            </thead>
            <tbody data-cart-body></tbody>
            <tfoot>
              <tr class="t-total"><td colspan="5" class="t-label">ИТОГО, в т.ч. НДС 5%:</td><td class="c-money" data-t-total></td><td></td></tr>
              <tr class="t-vat"><td colspan="5" class="t-label">НДС 5%:</td><td class="c-money" data-t-vat></td><td></td></tr>
            </tfoot>
          </table>
        </div>
        <p class="amount-words" data-amount-words hidden></p>
      </div>

      <aside class="cart-summary card" data-summary hidden>
        <div class="sum-row total"><span>ИТОГО:</span><span data-total>0 ₽</span></div>
        <button class="btn btn-primary" data-open-kp>Получить КП</button>
        <button class="btn btn-ghost" data-share>Поделиться списком</button>
        <p class="share-note" data-share-note hidden>Ссылка скопирована — перешлите её коллеге или руководителю: подборка откроется у него без регистрации.</p>
        <ol class="cart-steps">
          <li>100% аванс</li>
          <li>Поставка 1–5 дней</li>
          <li>Договор, счёт и закрывающие через ЭДО</li>
        </ol>
      </aside>
    </div>

    {presets.length > 0 && (
      <section class="presets">
        <h2>Готовые наборы</h2>
        <p class="presets-lead">Добавьте набор в расчёт в один клик — количество мест уточним в КП.</p>
        <div class="presets-grid">
          {presets.map((pr) => (
            <div class="card preset-card">
              <h3>{pr.name}</h3>
              <p class="pc-note">{pr.note}</p>
              <ul>
                {pr.items.map((it) => <li>{it.name}</li>)}
              </ul>
              <div class="pc-bottom">
                <b>от {formatRub(pr.total)}</b>
                <button class="btn btn-primary btn-sm" data-preset={JSON.stringify(pr.items)}>Добавить набор</button>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- Диалог «Получить КП» -->
  <dialog class="kp-dialog" data-kp-dialog aria-label="Получить коммерческое предложение">
    <form class="kp-form" data-kp-form>
      <button type="button" class="kp-close" data-kp-close aria-label="Закрыть">✕</button>
      <h2>Получить КП</h2>
      <p class="kp-hint">Подготовим коммерческое предложение с составом заказа и реквизитами и отправим на указанную почту.</p>
      <label class="kp-suggest">
        Организация или ИНН:
        <input class="ym-disable-keys" name="buyer_company" required autocomplete="organization"
               placeholder="Начните вводить название или ИНН"
               role="combobox" aria-expanded="false" aria-autocomplete="list"
               aria-controls="kp-suggest-list" data-company />
        <ul class="kp-list" id="kp-suggest-list" role="listbox" hidden data-suggest></ul>
      </label>
      <p class="kp-found" data-found hidden></p>
      <div class="kp-row">
        <label>ИНН:<input class="ym-disable-keys" name="buyer_inn" required inputmode="numeric" data-inn /></label>
        <label>ФИО:<input class="ym-disable-keys" name="contact_name" required autocomplete="name" /></label>
      </div>
      <div class="kp-row">
        <label>E-mail:<input class="ym-disable-keys" name="email" type="email" required autocomplete="email" /></label>
        <label>Телефон:<input class="ym-disable-keys" name="phone" type="tel" required autocomplete="tel" placeholder="+7 (___) ___-__-__" /></label>
      </div>
      <FormGuardFields />
      <label class="kp-consent">
        <input type="checkbox" name="consent" required />
        <span>Согласен на обработку персональных данных согласно <a href="/privacy" target="_blank" rel="noopener noreferrer">политике</a>.</span>
      </label>
      <button type="submit" class="btn btn-primary kp-submit">Отправить КП на почту</button>
      <p class="kp-status" data-kp-status role="status" aria-live="polite"></p>
    </form>
  </dialog>
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .share-note { color: var(--color-text-muted); font-size: 0.82rem; margin: 0; }
  .presets { margin-top: 3rem; }
  .presets h2 { font-size: clamp(1.3rem, 2.6vw, 1.7rem); margin-bottom: 0.4rem; }
  .presets-lead { color: var(--color-text-muted); margin-bottom: 1.2rem; }
  .presets-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1.2rem; }
  .preset-card { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .preset-card h3 { font-size: 1.08rem; }
  .pc-note { color: var(--color-text-dim); font-size: 0.85rem; margin: 0; }
  .preset-card ul { list-style: none; padding: 0; margin: 0.3rem 0 0; color: var(--color-text-muted); font-size: 0.9rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .preset-card ul li::before { content: '+ '; color: var(--color-accent); font-weight: 700; }
  .pc-bottom { margin-top: auto; padding-top: 0.8rem; display: flex; justify-content: space-between; align-items: center; gap: 0.6rem; }
  .pc-bottom b { font-variant-numeric: tabular-nums; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin-bottom: 2rem; }
  .h1-spec { font-size: clamp(1.4rem, 2.8vw, 2.1rem); max-width: 26ch; }
  .cart-layout { display: grid; grid-template-columns: 1fr 320px; gap: 2rem; align-items: start; }
  .cart-items { display: flex; flex-direction: column; gap: 0.8rem; }
  .empty { color: var(--color-text-muted); }
  .empty a { color: var(--color-accent); }
  .cart-summary { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.8rem; position: sticky; top: 84px; }
  .sum-row { display: flex; justify-content: space-between; gap: 0.6rem; }
  .sum-row.total { font-size: 1.15rem; font-weight: 700; }
  .sum-note { color: var(--color-text-dim); font-size: 0.82rem; margin: 0; }
  /* Условия поставки: аккуратный нумерованный список с акцентными маркерами */
  .cart-steps { list-style: none; counter-reset: step; padding: 0.9rem 0 0; margin: 0; border-top: 1px solid var(--color-border); display: grid; gap: 0.55rem; color: var(--color-text); font-size: 0.88rem; }
  .cart-steps li { counter-increment: step; display: flex; align-items: center; gap: 0.6rem; }
  .cart-steps li::before { content: counter(step); flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; background: color-mix(in srgb, var(--color-accent) 14%, transparent); color: var(--color-accent); font-weight: 700; font-size: 0.78rem; display: inline-flex; align-items: center; justify-content: center; }
  .kp-dialog { border: 1px solid var(--color-border-strong); border-radius: var(--radius-lg); background: var(--color-bg-card); color: var(--color-text); padding: 0; max-width: 540px; width: calc(100% - 2rem); }
  .kp-dialog::backdrop { background: rgba(0,0,0,0.6); }
  .kp-form { padding: 2rem; display: flex; flex-direction: column; gap: 0.9rem; position: relative; }
  .kp-form h2 { font-size: 1.5rem; }
  .kp-hint { color: var(--color-text-muted); font-size: 0.9rem; margin-top: -0.4rem; }

  /* Подсказки по организациям. Список лежит поверх формы, поэтому у поля
     собственный контекст позиционирования. */
  .kp-suggest { position: relative; }
  .kp-list {
    position: absolute; z-index: 5; left: 0; right: 0; top: 100%;
    margin: 0.2rem 0 0; padding: 0.25rem; list-style: none;
    background: var(--color-bg-elevated); border: 1px solid var(--color-border-strong);
    border-radius: 10px; box-shadow: 0 10px 28px rgb(0 0 0 / 18%);
    max-height: 17rem; overflow-y: auto;
  }
  .kp-list li {
    padding: 0.5rem 0.6rem; border-radius: 7px; cursor: pointer; line-height: 1.35;
  }
  .kp-list li:hover, .kp-list li[aria-selected='true'] { background: var(--color-bg-subtle); }
  .kp-list b { display: block; font-size: 0.95rem; }
  .kp-list span { display: block; font-size: 0.82rem; color: var(--color-text-muted); }
  /* Подставленные реквизиты видны и остаются доступными для правки: человек
     должен узнать свою организацию, а не поверить на слово. */
  .kp-found {
    margin: -0.2rem 0 0; padding: 0.5rem 0.65rem; font-size: 0.85rem; line-height: 1.45;
    background: var(--color-bg-subtle); border-left: 3px solid var(--color-accent);
    border-radius: 0 8px 8px 0; color: var(--color-text-muted);
  }
  .kp-found b { color: var(--color-text); }
  .kp-close { position: absolute; top: 1rem; right: 1rem; background: none; border: none; color: var(--color-text-muted); font-size: 1.1rem; cursor: pointer; }
  .kp-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .kp-form label { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.86rem; color: var(--color-text-muted); }
  .kp-form input { background: var(--color-bg-elevated); border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); padding: 0.6rem 0.7rem; color: var(--color-text); font: inherit; }
  .kp-form input:focus { border-color: var(--color-accent); outline: none; }
  .kp-consent { flex-direction: row; align-items: flex-start; gap: 0.5rem; font-size: 0.82rem; }
  .kp-consent input { width: auto; margin-top: 0.2rem; }
  .kp-consent a { color: var(--color-accent); }
  .kp-status { font-size: 0.9rem; margin: 0; }
  .kp-status.ok { color: var(--color-success); }
  .kp-status.err { color: var(--color-danger); }
  @media (max-width: 860px) { .cart-layout { grid-template-columns: 1fr; } .cart-summary { position: static; } }
  @media (max-width: 520px) {
    .kp-row { grid-template-columns: 1fr; }
    /* Более удобные зоны нажатия на мобильном */
    .qty button { width: 34px; height: 34px; }
    .qty input { height: 34px; }
    .ci-remove { min-width: 34px; min-height: 34px; }
  }
</style>

<style is:global>
  /* КП-таблица: строки создаются скриптом (innerHTML) и не получают
     Astro-scoped атрибут — поэтому эти правила глобальные. */
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .kp-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; min-width: 680px; background: var(--color-bg-card); }
  .kp-table th, .kp-table td { border: 1px solid var(--color-border-strong); padding: 0.45rem 0.6rem; text-align: left; vertical-align: middle; }
  .kp-table thead th { background: var(--color-bg-elevated); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); }
  .kp-table .c-num { width: 3rem; text-align: center; }
  .kp-table .c-vendor { width: 9rem; }
  .kp-table .c-name { width: 40%; min-width: 220px; }
  .kp-table td.c-num { color: var(--color-text-muted); }
  .kp-table .c-qty { width: 7.6rem; white-space: nowrap; }
  .kp-table .c-money { width: 1%; text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .kp-table .c-del { width: 1%; text-align: center; white-space: nowrap; }
  .kp-table .ci-sku { color: var(--color-text-dim); font-size: 0.75rem; }
  .kp-table tfoot td { font-weight: 700; }
  .kp-table tfoot .t-label { text-align: right; }
  
  .amount-words { margin: 0.2rem 0 0; color: var(--color-text); font-size: 0.88rem; }
  .qty { display: flex; align-items: center; gap: 0.25rem; flex-wrap: nowrap; }
  .qty button { width: 26px; height: 26px; border-radius: 6px; border: 1px solid var(--color-border-strong); background: var(--color-bg-elevated); color: var(--color-text); cursor: pointer; font-size: 0.95rem; line-height: 1; }
  .qty input { width: 44px; text-align: center; background: var(--color-bg-elevated); border: 1px solid var(--color-border-strong); border-radius: 6px; color: var(--color-text); padding: 0.25rem; font: inherit; font-size: 0.85rem; }
  .qty input::-webkit-outer-spin-button, .qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .ci-remove { background: none; border: none; color: var(--color-text); cursor: pointer; font-size: 1.05rem; font-weight: 800; padding: 0.2rem 0.45rem; }
  .ci-remove:hover { color: var(--color-danger); }
</style>

<script>
  import { trackGoal } from '@/lib/analytics';
  import { attributionPayload } from '@/lib/attribution';
  import { readCart, setQty, removeFromCart, cartTotal, clearCart, addToCart } from '../../lib/cart-client';

  // Открыли подборку. Знаменатель для формы КП: видно, сколько дошло до
  // корзины и сколько из них вообще начало заполнять форму.
  trackGoal('view_cart', { items: readCart().length, total: cartTotal() });
  import { formatRub } from '../../lib/pricing';
  import { moneyFmt, vatIncluded, totalWithVatWords } from '../../lib/rub-words';
  import { maskAllPhones } from '../../lib/phone-mask';
  maskAllPhones();

  const summaryEl = document.querySelector('[data-summary]') as HTMLElement;
  const totalEl = document.querySelector('[data-total]') as HTMLElement;
  const emptyEl = document.querySelector('[data-empty]') as HTMLElement;
  const tableWrap = document.querySelector('[data-cart-table]') as HTMLElement;
  const bodyEl = document.querySelector('[data-cart-body]') as HTMLElement;
  const tTotalEl = document.querySelector('[data-t-total]') as HTMLElement;
  const tVatEl = document.querySelector('[data-t-vat]') as HTMLElement;
  const wordsEl = document.querySelector('[data-amount-words]') as HTMLElement;

  // Производитель для старых записей без поля vendor — первое слово названия.
  const vendorOf = (it: { vendor?: string; name: string }) => it.vendor || it.name.split(' ')[0];

  function render() {
    const items = readCart();
    bodyEl.innerHTML = '';
    if (items.length === 0) {
      emptyEl.hidden = false;
      summaryEl.hidden = true;
      tableWrap.hidden = true;
      wordsEl.hidden = true;
      return;
    }
    emptyEl.hidden = true;
    summaryEl.hidden = false;
    tableWrap.hidden = false;
    wordsEl.hidden = false;

    items.forEach((it, i) => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="c-num">${i + 1}</td>
        <td>${escapeHtml(vendorOf(it))}</td>
        <td class="c-name">${escapeHtml(it.name)}<div class="ci-sku">Артикул: ${escapeHtml(it.sku)}</div></td>
        <td class="c-qty">
          <div class="qty">
            <button type="button" data-dec aria-label="Меньше">−</button>
            <input type="number" min="1" value="${it.qty}" data-qty aria-label="Количество" />
            <button type="button" data-inc aria-label="Больше">+</button>
          </div>
        </td>
        <td class="c-money">${moneyFmt(it.price)}</td>
        <td class="c-money">${moneyFmt(it.price * it.qty)}</td>
        <td class="c-del"><button class="ci-remove" data-remove aria-label="Удалить позицию" title="Удалить">✕</button></td>`;
      tr.querySelector('[data-inc]')!.addEventListener('click', () => { setQty(it.sku, it.qty + 1); render(); });
      tr.querySelector('[data-dec]')!.addEventListener('click', () => { setQty(it.sku, it.qty - 1); render(); });
      tr.querySelector('[data-remove]')!.addEventListener('click', () => {
        trackGoal('remove_from_cart', { sku: it.sku });
        removeFromCart(it.sku); render();
      });
      tr.querySelector('[data-qty]')!.addEventListener('change', (e) => {
        const v = Math.max(1, Math.floor(Number((e.target as HTMLInputElement).value) || 1));
        setQty(it.sku, v); render();
      });
      bodyEl.appendChild(tr);
    });

    const total = cartTotal(items);
    tTotalEl.textContent = moneyFmt(total);
    tVatEl.textContent = moneyFmt(vatIncluded(total));
    const words = totalWithVatWords(total);
    // Первая сумма — жирным; префикс «ИТОГО (предварительный расчет…)»
    wordsEl.innerHTML = 'ИТОГО (предварительный расчет для целей бюджетирования): ' + words.replace(/^([\d\s\u202f\u00a0]+,\d\d)/, '<b>$1</b>');
    totalEl.textContent = formatRub(total);
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  // Подборка по ссылке: /cart?share=<base64url(JSON)> — без регистрации.
  try {
    const share = new URLSearchParams(location.search).get('share');
    if (share) {
      const json = decodeURIComponent(escape(atob(share.replace(/-/g, '+').replace(/_/g, '/'))));
      const incoming = JSON.parse(json);
      if (Array.isArray(incoming)) {
        for (const it of incoming) {
          if (it && typeof it.sku === 'string' && typeof it.name === 'string' && Number.isFinite(it.price)) {
            addToCart({ sku: it.sku, slug: String(it.slug || ''), name: it.name, vendor: String(it.vendor || ''), price: it.price }, Math.max(1, Math.floor(it.qty || 1)));
          }
        }
      }
      history.replaceState(null, '', '/cart');
    }
  } catch { /* битая ссылка — просто показываем текущую подборку */ }

  document.querySelector('[data-share]')?.addEventListener('click', async () => {
    const items = readCart();
    if (!items.length) return;
    const payload = items.map((i) => ({ sku: i.sku, slug: i.slug, name: i.name, vendor: i.vendor || '', price: i.price, qty: i.qty }));
    const b64 = btoa(unescape(encodeURIComponent(JSON.stringify(payload)))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    const url = `${location.origin}/cart?share=${b64}`;
    try { await navigator.clipboard.writeText(url); } catch { prompt('Скопируйте ссылку на подборку:', url); }
    const note = document.querySelector<HTMLElement>('[data-share-note]');
    if (note) note.hidden = false;
  });

  document.querySelectorAll('[data-preset]').forEach((btn) => {
    btn.addEventListener('click', () => {
      try {
        const items = JSON.parse(btn.getAttribute('data-preset') || '[]');
        for (const it of items) addToCart({ sku: it.sku, slug: it.slug, name: it.name, vendor: it.vendor || '', price: it.price }, 1);
        btn.textContent = 'Добавлено ✓';
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch { /* noop */ }
    });
  });

  render();
  window.addEventListener('cart:change', render);

  // Диалог КП
  const dialog = document.querySelector('[data-kp-dialog]') as HTMLDialogElement;
  const form = document.querySelector('[data-kp-form]') as HTMLFormElement;
  // ── Подсказки по организациям ────────────────────────────────────────
  // Заказчик вводит название или ИНН и выбирает свою организацию: остальные
  // реквизиты подставляются. Ошибиться в десятизначном номере проще, чем не
  // ошибиться, а исправлять пришлось бы уже в счёте.
  //
  // Подставленное показываем отдельной строкой и оставляем поля открытыми
  // для правки: человек должен узнать свою организацию, а не поверить на
  // слово. Филиал, недавнее переименование, работа под другим названием —
  // всё это справочник знает хуже, чем сам заказчик.
  const companyInput = form.querySelector('[data-company]') as HTMLInputElement;
  const innInput = form.querySelector('[data-inn]') as HTMLInputElement;
  const listEl = form.querySelector('[data-suggest]') as HTMLElement;
  const foundEl = form.querySelector('[data-found]') as HTMLElement;

  type Item = { name: string; fullName: string; inn: string; kpp: string;
                address: string; manager: string };
  let items: Item[] = [];
  let active = -1;
  let seq = 0;

  const closeList = () => {
    listEl.hidden = true;
    listEl.innerHTML = '';
    companyInput.setAttribute('aria-expanded', 'false');
    items = []; active = -1;
  };

  const showFound = (it: Item) => {
    const parts = [`<b>${it.fullName || it.name}</b>`];
    if (it.inn) parts.push(`ИНН ${it.inn}${it.kpp ? ` · КПП ${it.kpp}` : ''}`);
    if (it.address) parts.push(it.address);
    if (it.manager) parts.push(it.manager);
    parts.push('Проверьте и при необходимости поправьте поля.');
    foundEl.innerHTML = parts.join('<br>');
    foundEl.hidden = false;
  };

  const choose = (i: number) => {
    const it = items[i];
    if (!it) return;
    companyInput.value = it.name || it.fullName;
    if (it.inn) innInput.value = it.inn;
    showFound(it);
    closeList();
    // Факт автозаполнения, а не сам ИНН: идентификатор юрлица в параметрах
    // события — это передача реквизита клиента во внешнюю аналитику.
    trackGoal('company_autofill', { filled: true });
  };

  const renderSuggest = () => {
    if (!items.length) { closeList(); return; }
    listEl.innerHTML = items.map((it, i) => {
      const sub = [it.inn && `ИНН ${it.inn}`, it.address].filter(Boolean).join(' · ');
      return `<li role="option" data-i="${i}" aria-selected="${i === active}">`
        + `<b>${it.name}</b><span>${sub}</span></li>`;
    }).join('');
    listEl.hidden = false;
    companyInput.setAttribute('aria-expanded', 'true');
  };

  let timer: ReturnType<typeof setTimeout> | undefined;
  companyInput?.addEventListener('input', () => {
    foundEl.hidden = true;
    const q = companyInput.value.trim();
    clearTimeout(timer);
    if (q.length < 3) { closeList(); return; }
    // Пауза после ввода: запрос на каждую букву съедает суточный лимит,
    // общий у всех видов подсказок.
    timer = setTimeout(async () => {
      const mine = ++seq;
      try {
        const r = await fetch(`/api/suggest/party?q=${encodeURIComponent(q)}`);
        const d = await r.json();
        // Ответ на устаревший запрос игнорируем: иначе медленный ответ на
        // «ром» перезатрёт быстрый на «ромашка».
        if (mine !== seq) return;
        items = d.items || [];
        active = -1;
        renderSuggest();
      } catch { closeList(); }
    }, 250);
  });

  companyInput?.addEventListener('keydown', (e) => {
    if (listEl.hidden || !items.length) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      active = (active + (e.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length;
      renderSuggest();
    } else if (e.key === 'Enter' && active >= 0) {
      e.preventDefault();
      choose(active);
    } else if (e.key === 'Escape') {
      closeList();
    }
  });

  listEl?.addEventListener('mousedown', (e) => {
    // mousedown, а не click: blur успевает закрыть список до клика.
    const li = (e.target as HTMLElement).closest('li');
    if (li) { e.preventDefault(); choose(Number(li.dataset.i)); }
  });
  companyInput?.addEventListener('blur', () => setTimeout(closeList, 120));

  const status = document.querySelector('[data-kp-status]') as HTMLElement;
  document.querySelector('[data-open-kp]')?.addEventListener('click', () => {
    if (readCart().length === 0) return;
    status.textContent = ''; status.className = 'kp-status';
    // Форма открыта, но ещё не отправлена. Разрыв между этой целью и
    // quote_pdf показывает, сколько людей упирается в саму форму.
    trackGoal('begin_checkout', { items: readCart().length, total: cartTotal() });
    dialog.showModal();
  });
  document.querySelector('[data-kp-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submit = form.querySelector('.kp-submit') as HTMLButtonElement;
    submit.disabled = true;
    let httpStatus = 0;
    status.textContent = 'Формируем и отправляем…'; status.className = 'kp-status';
    try {
      const fd = Object.fromEntries(new FormData(form).entries());
      const items = readCart().map((i) => ({ sku: i.sku, qty: i.qty }));
      const attribution = await attributionPayload();
      const res = await fetch('/api/quote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...fd, attribution, consent: (form.elements.namedItem('consent') as HTMLInputElement).checked, items }),
      });
      if (!res.ok) {
        let msg = 'Не удалось сформировать КП. Проверьте поля и попробуйте снова.';
        try { const j = await res.json(); if (j?.error) msg = j.error; } catch { /* not json */ }
        httpStatus = res.status;
        throw new Error(msg);
      }
      // Документ не скачивается и не открывается в браузере: он уходит письмом.
      // Раньше ответ отдавался файлом, и просмотрщик показывал его страницей
      // «сохранить и напечатать» — человек видел документ вместо
      // подтверждения и не понимал, отправили ему что-нибудь или нет.
      const out = await res.json();
      const quoteNo = out?.quote_no || res.headers.get('X-Quote-No') || 'KP';
      const to = out?.sent_to ? ` на ${out.sent_to}` : '';
      status.innerHTML = `<b>Готово.</b> Коммерческое предложение № ${quoteNo} `
        + `отправлено${to}. Если письма нет через пару минут — проверьте «Спам».`;
      status.className = 'kp-status ok';
      trackGoal('quote_pdf', { form_source: 'quote', quote_no: quoteNo });
      // Тот же шаг в разрезе производителей: воронка лендинга вендора
      // заканчивается здесь, а не на его странице.
      trackGoal('vendor_kp_download', {
        quote_no: quoteNo,
        vendors: Array.from(new Set(readCart().map((i) => i.vendor).filter(Boolean))).join(','),
      });
    } catch (err) {
      status.textContent = err instanceof Error && err.message ? err.message : 'Не удалось сформировать КП. Попробуйте позже или позвоните нам.';
      status.className = 'kp-status err';
      // Без этой цели сбой неотличим от того, что клиент передумал: в отчёте
      // и то и другое выглядит как незавершённое оформление.
      trackGoal('quote_error', {
        form_source: 'quote',
        http_status: httpStatus,
        reason: err instanceof Error ? err.message.slice(0, 100) : 'unknown',
      });
    } finally {
      submit.disabled = false;
    }
  });
</script>

---
import { getCollection, render } from 'astro:content';
import { tagSlug } from '../../lib/blog-tags';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCover from '../../components/BlogCover.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import JsonLd from '../../components/JsonLd.astro';
import { site, expert } from '../../config/site';
import { canonicalUrl, ORG_ID, EXPERT_ID } from '../../lib/seo';
import { getProductsBySlugs } from '../../lib/directus';
import { solutions } from '../../data/solutions';

export async function getStaticPaths() {
  // noindex-статьи рендерим (с meta noindex), но draft исключаем из сборки
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function fmtDate(d: Date) {
  return d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
}

const d = post.data;
const pageUrl = canonicalUrl(`/blog/${post.id}`);

// связанные товары/решения
let relatedProducts: Awaited<ReturnType<typeof getProductsBySlugs>> = [];
try {
  if (d.relatedProducts.length) relatedProducts = await getProductsBySlugs(d.relatedProducts);
} catch (e) {
  console.error('article related products', e);
}
const relatedSolutions = d.relatedSolutions
  .map((slug) => solutions.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

// Значение по умолчанию в схеме коллекции — «Редакция BIZSoft»: такие статьи
// подписывает публичный эксперт. Явно указанный другой автор не подменяется.
const isExpertAuthor = !d.author || d.author === 'Редакция BIZSoft' || d.author === expert.name;
const bylineName = isExpertAuthor ? expert.name : d.author;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated || d.date).toISOString(),
  // Автор — человек, а не «редакция»: узел Person с общим @id, на который
  // ссылается и founder организации (ENT-001). Статьи с явно указанным во
  // frontmatter другим автором сохраняют его имя, но без узла Person: имя
  // без страницы автора сущностью не является.
  author: isExpertAuthor
    ? { '@id': EXPERT_ID }
    : { '@type': 'Organization', name: d.author, url: site.url },
  // Издатель — единый узел организации из BaseLayout, связь по @id.
  publisher: { '@id': ORG_ID },
  mainEntityOfPage: pageUrl,
  // Изображение статьи: без него карточка в выдаче и соцсетях остаётся пустой.
  ...(d.cover ? { image: new URL(d.cover, site.url).href } : {}),
  ...(d.reviewedBy ? { reviewedBy: { '@type': 'Person', name: d.reviewedBy } } : {}),
};
---
<!-- metaTitle меняет только <title>: <h1> и хлебные крошки ниже продолжают
     брать d.title. Так заголовок в выдаче правится отдельно от страницы, и
     сниппет-эксперимент на статье становится возможен. -->
<BaseLayout title={d.metaTitle || d.title} description={d.description} type="article" noindex={d.noindex}
  ogImage={d.cover}>
  <JsonLd schema={articleSchema} />
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'База знаний', url: '/blog' }, { name: d.title, url: `/blog/${post.id}` }]} />

    <article class="article">
      {d.cover && (
        <BlogCover cover={d.cover} alt={d.coverAlt || d.title} class="cover"
                   priority sizes="(max-width: 800px) 100vw, 760px" />
      )}

      <header>
        <div class="tags">{d.tags.map((t) => <a href={`/blog/tag/${tagSlug(t)}`}>{t}</a>)}</div>
        <h1>{d.title}</h1>
        <p class="byline">
          {isExpertAuthor
            ? <a href={`/authors/${expert.slug}`} rel="author">{bylineName}</a>
            : <span>{bylineName}</span>}
          <span class="dot">·</span>
          <span>Опубликовано: {fmtDate(d.date)}</span>
          <span class="dot">·</span>
          <span>Обновлено: {fmtDate(d.updated || d.date)}</span>
          {d.reviewedBy && (<><span class="dot">·</span><span>Проверил: {d.reviewedBy}</span></>)}
        </p>
      </header>

      {d.summaryAnswer && (
        <div class="summary"><strong>Коротко:</strong> {d.summaryAnswer}</div>
      )}

      <div class="prose-bizsoft">
        <Content />
      </div>

      {(relatedProducts.length > 0 || relatedSolutions.length > 0) && (
        <aside class="related">
          <h2>Связанные товары и решения</h2>
          <div class="rel-grid">
            {relatedProducts.map((rp) => (
              <a href={`/product/${rp.slug}`} class="card card-hover rel">{rp.name} →</a>
            ))}
            {relatedSolutions.map((s) => (
              <a href={`/solutions/${s.slug}`} class="card card-hover rel">{s.title} →</a>
            ))}
          </div>
        </aside>
      )}

      {d.related.length > 0 && (
        <aside class="related">
          <h2>Полезное по теме</h2>
          <div class="rel-grid">
            {d.related.map((r) => (
              <a href={r.href} class="card card-hover rel">{r.label} →</a>
            ))}
          </div>
        </aside>
      )}

      <FAQ items={d.faq} />
    </article>
  </div>
  <CTASection />
</BaseLayout>

<style>
  /* Обложка статьи: фиксированная пропорция, чтобы страница не «прыгала»
     при загрузке изображения. */
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 14px;
    display: block;
    margin-bottom: 1.4rem;
  }

  .section { padding-top: 2rem; }
  .article { max-width: 760px; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
  .tags a { background: var(--color-bg-elevated); color: var(--color-text-muted); font-size: 0.72rem; padding: 0.15rem 0.55rem; border-radius: 6px; text-decoration: none; }
  .tags a:hover { color: var(--color-text); }
  h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin-bottom: 0.6rem; }
  .byline { color: var(--color-text-dim); font-size: 0.85rem; margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .byline .dot { color: var(--color-border-strong); }
  .summary { background: var(--color-bg-card); border: 1px solid var(--color-border); border-left: 3px solid var(--color-accent); border-radius: var(--radius); padding: 1rem 1.2rem; margin-bottom: 2rem; color: var(--color-text-muted); }
  .summary strong { color: var(--color-text); }
  .related { margin-top: 3rem; }
  .related h2 { font-size: 1.4rem; margin-bottom: 1rem; }
  .rel-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 1rem; }
  .rel { padding: 1.1rem 1.3rem; font-weight: 600; color: var(--color-accent); }
</style>

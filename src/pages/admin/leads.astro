---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Заявки — воронка (админ)" description="Служебная страница" noindex={true}>
  <div class="container-page section admin">
    <h1>Заявки</h1>

    <div class="token-bar card">
      <label>
        <span>Токен доступа</span>
        <input type="password" data-token placeholder="ADMIN_TOOLS_TOKEN" autocomplete="current-password" />
      </label>
      <button class="btn btn-primary" data-load>Показать</button>
    </div>

    <div class="stats" data-stats hidden></div>

    <div class="filters" data-filters hidden>
      <button class="chip is-on" data-filter="active">В работе</button>
      <button class="chip" data-filter="all">Все</button>
      <button class="chip" data-filter="won">Оплачено</button>
      <button class="chip" data-filter="lost">Отказы</button>
    </div>

    <div data-list class="list"></div>
    <p class="msg" data-msg></p>
  </div>
</BaseLayout>

<style>
  .admin { max-width: 780px; }
  h1 { font-size: 1.6rem; margin-bottom: 1.2rem; }
  .token-bar { padding: 1rem; display: flex; gap: 0.8rem; align-items: end; flex-wrap: wrap; margin-bottom: 1.2rem; }
  .token-bar label { display: flex; flex-direction: column; gap: 0.35rem; flex: 1 1 220px; }
  .token-bar span { font-size: 0.82rem; color: var(--color-text-dim); }
  input, select, textarea {
    width: 100%; padding: 0.65rem 0.7rem; border-radius: 8px;
    border: 1px solid var(--color-border); background: var(--color-bg);
    color: var(--color-text); font: inherit; font-size: 16px; /* 16px — иначе iOS зумит форму */
  }
  textarea { min-height: 64px; resize: vertical; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.7rem; margin-bottom: 1.2rem; }
  .stat { padding: 0.8rem; border: 1px solid var(--color-border); border-radius: 10px; }
  .stat b { display: block; font-size: 1.3rem; }
  .stat span { font-size: 0.78rem; color: var(--color-text-dim); }
  .filters { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .chip {
    padding: 0.45rem 0.9rem; border-radius: 999px; border: 1px solid var(--color-border);
    background: transparent; color: var(--color-text); font: inherit; font-size: 0.9rem; cursor: pointer;
  }
  .chip.is-on { background: var(--color-text); color: var(--color-bg); }
  .list { display: flex; flex-direction: column; gap: 0.9rem; }
  .lead { border: 1px solid var(--color-border); border-radius: 12px; padding: 1rem; }
  .lead header { display: flex; justify-content: space-between; gap: 0.6rem; align-items: start; }
  .lead h2 { font-size: 1.02rem; margin: 0; }
  .lead .co { font-size: 0.86rem; color: var(--color-text-dim); }
  .badge { font-size: 0.74rem; padding: 0.2rem 0.55rem; border-radius: 999px; border: 1px solid var(--color-border); white-space: nowrap; }
  .badge.won { background: #ECFDF3; border-color: #12B76A; color: #027A48; }
  .badge.lost { background: #FEF3F2; border-color: #F04438; color: #B42318; }
  .contacts { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 0.6rem 0; font-size: 0.9rem; }
  .contacts a { color: inherit; }
  .msgtext { font-size: 0.9rem; color: var(--color-text-dim); margin: 0.5rem 0; white-space: pre-wrap; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; margin-top: 0.7rem; }
  .grid label { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.78rem; color: var(--color-text-dim); }
  .grid .wide { grid-column: 1 / -1; }
  .lead footer { display: flex; gap: 0.6rem; align-items: center; margin-top: 0.8rem; }
  .saved { font-size: 0.84rem; color: #027A48; }
  .msg { margin-top: 1rem; font-size: 0.9rem; color: var(--color-text-dim); }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
</style>

<script>
  const $ = (s: string) => document.querySelector(s);
  const tokenInput = $('[data-token]') as HTMLInputElement;
  const list = $('[data-list]') as HTMLElement;
  const statsBox = $('[data-stats]') as HTMLElement;
  const filtersBox = $('[data-filters]') as HTMLElement;
  const msg = $('[data-msg]') as HTMLElement;

  const STAGES: [string, string][] = [
    ['new', 'Новая'], ['in_progress', 'В работе'], ['qualified', 'Квалифицирована'],
    ['proposal', 'Отправлено КП'], ['invoiced', 'Выставлен счёт'],
    ['won', 'Оплачено'], ['lost', 'Отказ'],
  ];
  const REASONS: [string, string][] = [
    ['', '—'], ['price', 'Цена'], ['timing', 'Сроки'], ['no_supply', 'Не смогли поставить'],
    ['competitor', 'Выбрали другого'], ['no_contact', 'Не вышли на связь'], ['not_our_case', 'Не наш профиль'],
  ];
  const stageName = (v: string) => (STAGES.find((s) => s[0] === v) || ['', v])[1];

  let TOKEN = localStorage.getItem('bz_admin_token') || '';
  let LEADS: any[] = [];
  let FILTER = 'active';
  if (TOKEN) tokenInput.value = TOKEN;

  const money = (n: number) => new Intl.NumberFormat('ru-RU').format(Math.round(n)) + ' ₽';
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

  async function api(method: string, body?: unknown) {
    const res = await fetch('/api/admin/leads', {
      method,
      headers: { 'Content-Type': 'application/json', 'x-admin-token': TOKEN },
      body: body ? JSON.stringify(body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
    return data;
  }

  function renderStats(s: any) {
    const cards = [
      ['Всего заявок', String(s.total)],
      ['В работе', String(s.total - s.by_stage.won - s.by_stage.lost)],
      ['Оплачено', String(s.won)],
      ['Выручка', s.revenue ? money(s.revenue) : '—'],
      ['Конверсия', s.close_rate === null ? 'нет закрытых' : Math.round(s.close_rate * 100) + '%'],
      ['Средний чек', s.average_deal ? money(s.average_deal) : '—'],
    ];
    statsBox.innerHTML = cards.map(([label, val]) =>
      `<div class="stat"><b>${esc(val)}</b><span>${esc(label)}</span></div>`).join('');
    statsBox.hidden = false;
    filtersBox.hidden = false;
  }

  function visible(l: any) {
    const s = l.status || 'new';
    if (FILTER === 'all') return true;
    if (FILTER === 'won') return s === 'won';
    if (FILTER === 'lost') return s === 'lost';
    return s !== 'won' && s !== 'lost';
  }

  function render() {
    const rows = LEADS.filter(visible);
    if (!rows.length) { list.innerHTML = '<p class="msg">Заявок в этом разделе нет.</p>'; return; }
    list.innerHTML = rows.map((l) => {
      const s = l.status || 'new';
      const cls = s === 'won' ? ' won' : s === 'lost' ? ' lost' : '';
      const date = l.created_at ? new Date(l.created_at).toLocaleDateString('ru-RU') : '';
      return `<article class="lead" data-id="${esc(l.id)}">
        <header>
          <div>
            <h2>${esc(l.name || 'Без имени')}</h2>
            <div class="co">${esc(l.company || '—')} · ${esc(date)}${l.source ? ' · ' + esc(l.source) : ''}</div>
          </div>
          <span class="badge${cls}">${esc(stageName(s))}</span>
        </header>
        <div class="contacts">
          ${l.phone ? `<a href="tel:${esc(l.phone)}">${esc(l.phone)}</a>` : ''}
          ${l.email ? `<a href="mailto:${esc(l.email)}">${esc(l.email)}</a>` : ''}
        </div>
        ${l.product_ref ? `<div class="co">Товар: ${esc(l.product_ref)}</div>` : ''}
        ${l.message ? `<p class="msgtext">${esc(l.message)}</p>` : ''}
        <div class="grid">
          <label>Стадия
            <select data-f="status">${STAGES.map(([v, t]) =>
              `<option value="${v}"${v === s ? ' selected' : ''}>${t}</option>`).join('')}</select>
          </label>
          <label>Ответственный
            <input data-f="owner" value="${esc(l.owner || '')}" placeholder="Кто ведёт" />
          </label>
          <label>Сумма, ₽
            <input data-f="amount" inputmode="decimal" value="${l.amount ?? ''}" placeholder="0" />
          </label>
          <label>Вернуться
            <input data-f="next_action_at" type="date" value="${l.next_action_at ? String(l.next_action_at).slice(0, 10) : ''}" />
          </label>
          <label class="wide reason" ${s === 'lost' ? '' : 'hidden'}>Причина отказа
            <select data-f="lost_reason">${REASONS.map(([v, t]) =>
              `<option value="${v}"${v === (l.lost_reason || '') ? ' selected' : ''}>${t}</option>`).join('')}</select>
          </label>
          <label class="wide">Комментарий
            <textarea data-f="note" placeholder="Что обсудили, что дальше">${esc(l.note || '')}</textarea>
          </label>
        </div>
        <footer><button class="btn btn-primary" data-save>Сохранить</button><span class="saved" hidden>Сохранено</span></footer>
      </article>`;
    }).join('');
  }

  async function load() {
    TOKEN = tokenInput.value.trim();
    localStorage.setItem('bz_admin_token', TOKEN);
    msg.textContent = 'Загружаю…';
    try {
      const data = await api('GET');
      LEADS = data.leads || [];
      renderStats(data.summary);
      render();
      msg.textContent = '';
    } catch (e: any) {
      msg.textContent = e.message;
      statsBox.hidden = true;
      filtersBox.hidden = true;
      list.innerHTML = '';
    }
  }

  ($('[data-load]') as HTMLElement).addEventListener('click', load);

  filtersBox.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest('[data-filter]') as HTMLElement | null;
    if (!chip) return;
    FILTER = chip.dataset.filter || 'active';
    filtersBox.querySelectorAll('.chip').forEach((c) => c.classList.toggle('is-on', c === chip));
    render();
  });

  list.addEventListener('change', (e) => {
    const sel = e.target as HTMLSelectElement;
    if (sel.dataset.f !== 'status') return;
    const card = sel.closest('.lead') as HTMLElement;
    const reason = card.querySelector('.reason') as HTMLElement;
    if (reason) reason.hidden = sel.value !== 'lost';
  });

  list.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-save]') as HTMLButtonElement | null;
    if (!btn) return;
    const card = btn.closest('.lead') as HTMLElement;
    const payload: Record<string, unknown> = { id: card.dataset.id };
    card.querySelectorAll('[data-f]').forEach((el) => {
      const f = (el as HTMLElement).dataset.f as string;
      const v = (el as HTMLInputElement).value.trim();
      payload[f] = f === 'amount' ? (v === '' ? null : Number(v)) : v;
    });
    btn.disabled = true;
    try {
      await api('PATCH', payload);
      const flag = card.querySelector('.saved') as HTMLElement;
      flag.hidden = false;
      setTimeout(() => { flag.hidden = true; }, 2000);
      await load();
    } catch (err: any) {
      msg.textContent = err.message;
    } finally {
      btn.disabled = false;
    }
  });

  if (TOKEN) load();
</script>

---
export const prerender = false;

/**
 * Страница коммерческого предложения — `/offer/<токен>`.
 *
 * Здесь живёт то, чего не может быть в письме: настоящие чекбоксы, поля и
 * отправка формы. Почтовые клиенты вырезают формы и скрипты, поэтому письмо
 * показывает перечень действий, а отмечает их клиент здесь.
 *
 * Адрес не содержит ни номера сделки, ни идентификатора клиента: страница
 * показывает состав и суммы, и такие данные в ссылке, которая уедет в
 * переписку и в отчёты аналитики, оставлять нельзя. Токен — подпись номера
 * КП на серверном секрете (`offer-token.ts`), перебором не открывается.
 *
 * В индекс страница не попадает (`noindex`) и в sitemap не значится: это
 * персональный документ, а не витрина.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { edo, offerDocs, offerManager, seller, site, taxation } from '../../config/site';
import { resolveOffer } from '../../lib/offer-lookup';
import { OFFER_ACTIONS } from '../../lib/offer-actions';
import { offerCategoryLinks, offerProductLinks } from '../../lib/offer-content';
import { quotePdfFileName } from '../../lib/offer-doc';
import { edoAccountingMailto, finalQuoteMailto, invoiceMailto } from '../../lib/mailto';
import { salutation } from '../../lib/salutation';
import { PRELIMINARY_NOTE } from '../../lib/quote-layout';

const { token } = Astro.params;
const offer = await resolveOffer(String(token || ''));

if (!offer) return new Response('Предложение не найдено', { status: 404 });

const { data, expired, products } = offer;
const items = offerProductLinks(data.items, products, site.url, false);
const categories = offerCategoryLinks(data.items, products, site.url);
const pdfName = quotePdfFileName(data.quoteNo, data.buyerCompany, data.date);
const mailCtx = {
  to: offerManager.email,
  managerName: offerManager.name.split(' ')[0] || offerManager.name,
  quoteNo: data.quoteNo,
  buyerCompany: data.buyerCompany || 'вашей организации',
};
const edoHref = edoAccountingMailto({
  legalName: seller.legalName,
  inn: seller.inn,
  participantId: edo.participantId,
  provider: edo.provider,
  howTo: edo.howTo,
});
const kpi = [
  { label: 'Номер КП', value: data.quoteNo, hint: '' },
  { label: 'Сумма', value: `${data.total.toLocaleString('ru-RU')} ₽`, hint: `в т.ч. НДС ${taxation.vatPercent}%` },
  { label: 'Позиций', value: String(data.items.length), hint: 'наименований' },
  { label: 'Действует до', value: data.validUntil, hint: 'включительно' },
];
---
<BaseLayout
  title={`Коммерческое предложение № ${data.quoteNo}`}
  description="Персональное коммерческое предложение BIZSoft."
  noindex={true}
>
  <div class="container-page section offer">
    <header class="head">
      <span class="eyebrow">Коммерческое предложение</span>
      <h1>{data.buyerCompany ? `для ${data.buyerCompany}` : 'Ваше предложение'}</h1>
      <p class="lead">{salutation(data.contactName)} Ниже — состав и условия предложения № {data.quoteNo}.
        Отметьте, что подготовить дальше, — запрос уйдёт менеджеру сразу.</p>
    </header>

    {expired && (
      <div class="expired">
        <b>Предложение больше не активно.</b>
        Свяжитесь с менеджером BIZSoft — обновим условия и цены по текущему курсу.
      </div>
    )}

    <div class="kpi">
      {kpi.map((k) => (
        <div class="kpi-cell">
          <span class="kpi-label">{k.label}</span>
          <span class="kpi-value">{k.value}</span>
          {k.hint && <span class="kpi-hint">{k.hint}</span>}
        </div>
      ))}
    </div>

    <a class="doc" href={`/offer/${token}/document.pdf`} data-ev="offer_pdf_open">
      <span class="doc-title">Открыть коммерческое предложение (PDF)</span>
      <span class="doc-meta">{pdfName}</span>
    </a>

    <section class="block">
      <h2>Что подготовить для вас</h2>
      <p class="sub">Отметьте нужное — запрос уйдёт менеджеру сразу.</p>
      <form id="offer-form" class="actions">
        {OFFER_ACTIONS.map((a) => (
          <label class="check">
            <input type="checkbox" name="actions" value={a.id} id={`act-${a.id}`} />
            <span>{a.label}</span>
          </label>
        ))}

        <label class="field" for="offer-comment">Комментарий
          <textarea id="offer-comment" name="comment" rows="3" class="ym-disable-keys"></textarea>
        </label>
        <div class="two">
          <label class="field" for="offer-name">Имя
            <input id="offer-name" name="contact_name" type="text" class="ym-disable-keys" value={data.contactName} />
          </label>
          <label class="field" for="offer-phone">Телефон
            <input id="offer-phone" name="contact_phone" type="tel" class="ym-disable-keys" value={data.phone} />
          </label>
        </div>
        <label class="field" for="offer-email">E-mail
          <input id="offer-email" name="contact_email" type="email" class="ym-disable-keys" value={data.email} />
        </label>

        <button type="submit" class="btn btn-primary wide" id="offer-send">ОТПРАВИТЬ ЗАПРОС</button>
        <p class="err" id="offer-err" hidden></p>
      </form>
      <div class="ok" id="offer-ok" hidden>
        <b>Спасибо. Запрос отправлен менеджеру BIZSoft.</b>
        <span>Мы свяжемся с вами по указанным контактным данным.</span>
      </div>
    </section>

    <div class="cta-row">
      <a class="btn btn-primary" href={finalQuoteMailto(mailCtx)} data-ev="offer_final_request_click">Запросить финальное КП</a>
      <a class="btn btn-outline" href={invoiceMailto(mailCtx)} data-ev="offer_invoice_request_click">Запросить счёт по КП</a>
    </div>
    <p class="sub">Финальное предложение — без водяных знаков, после согласования условий.</p>

    {items.length > 0 && (
      <section class="block">
        <h2>Состав предложения</h2>
        <ul class="items">
          {items.map((p) => (
            <li>
              <a href={p.url} data-ev="offer_product_click" data-sku={p.sku}>
                {p.vendor && <b>{p.vendor}</b>}
                <span>{p.name}</span>
              </a>
            </li>
          ))}
        </ul>
        {categories.length > 0 && (
          <p class="cats">
            {categories.map((c) => (
              <a href={c.url} data-ev="offer_category_click">{c.label} →</a>
            ))}
          </p>
        )}
      </section>
    )}

    <section class="block">
      <h2>Типовые документы</h2>
      <p class="sub">Рамочный договор и дополнительное соглашение №1 — одним файлом.</p>
      <a class="doc" href={offerDocs.contract.path} data-ev="offer_contract_download" download>
        <span class="doc-title">{offerDocs.contract.title}</span>
        <span class="doc-meta">{offerDocs.contract.format}</span>
      </a>
    </section>

    <section class="block" id="edo">
      <h2>Электронный документооборот</h2>
      <p class="sub">Обмениваемся документами через {edo.provider}. {edo.howTo}.</p>
      <dl class="edo">
        <div><dt>Организация</dt><dd>{seller.legalName}</dd></div>
        <div><dt>ИНН</dt><dd><span id="edo-inn">{seller.inn}</span></dd></div>
        <div><dt>Идентификатор участника ЭДО</dt><dd><span id="edo-id">{edo.participantId}</span></dd></div>
      </dl>
      <div class="cta-row">
        <button type="button" class="btn btn-outline" data-copy="edo-id">Скопировать идентификатор</button>
        <button type="button" class="btn btn-outline" data-copy="edo-inn">Скопировать ИНН</button>
        <a class="btn btn-outline" href={edoHref} data-ev="offer_edo_accounting_mail_click">Передать бухгалтерии</a>
      </div>
    </section>

    <section class="block manager">
      <div class="who">
        <div class="ava" aria-hidden="true">{offerManager.initials}</div>
        <div>
          <b>{offerManager.name}</b>
          <span>{offerManager.role}</span>
        </div>
      </div>
      <p class="contacts">
        <a href={`tel:${offerManager.phoneHref}`} data-ev="click_phone">{offerManager.phone}</a>
        <a href={`mailto:${offerManager.email}`} data-ev="click_email">{offerManager.email}</a>
        <a href={offerManager.telegram} data-ev="click_messenger" rel="noopener">Telegram</a>
      </p>
    </section>

    <p class="legal">{PRELIMINARY_NOTE} Конфиденциально: информация предназначена только для адресата.</p>
  </div>
</BaseLayout>

<style>
  .offer { max-width: 780px; }
  .eyebrow { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .head h1 { margin: 6px 0 8px; }
  .lead { color: var(--muted); }
  .expired { margin: 16px 0; padding: 14px 16px; border-left: 3px solid var(--accent);
    background: var(--surface-2, #FFF4EF); border-radius: 0 10px 10px 0; }
  .kpi { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    border: 1px solid var(--border); border-radius: 12px; margin: 22px 0 16px; overflow: hidden; }
  .kpi-cell { display: flex; flex-direction: column; gap: 2px; padding: 14px 16px; }
  .kpi-label { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .kpi-value { font-size: 18px; font-weight: 700; }
  .kpi-hint { font-size: 12px; color: var(--muted); }
  .doc { display: flex; flex-direction: column; gap: 3px; padding: 14px 16px; border: 1px solid var(--border);
    border-radius: 12px; text-decoration: none; margin-bottom: 8px; }
  .doc-title { font-weight: 600; }
  .doc-meta { font-size: 12.5px; color: var(--muted); word-break: break-all; }
  .block { margin-top: 38px; }
  .block h2 { font-size: 20px; margin: 0 0 4px; }
  .sub { color: var(--muted); font-size: 14px; margin: 0 0 14px; }
  .check { display: flex; gap: 11px; align-items: flex-start; border: 1px solid var(--border);
    border-radius: 10px; padding: 13px 15px; margin-bottom: 9px; cursor: pointer; }
  .check input { width: 17px; height: 17px; margin: 2px 0 0; accent-color: var(--accent); }
  .field { display: block; margin: 12px 0; font-size: 13px; color: var(--muted); }
  .field input, .field textarea { display: block; width: 100%; box-sizing: border-box; margin-top: 5px;
    border: 1px solid var(--border); border-radius: 10px; padding: 11px 12px; font: inherit; font-size: 15px; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 12px; }
  .wide { width: 100%; }
  .err { color: #C81E1E; font-size: 14px; }
  .ok { border: 1px solid #CFE6D8; background: #F1F8F3; border-radius: 12px; padding: 16px;
    display: flex; flex-direction: column; gap: 4px; color: #1F6B41; }
  .cta-row { display: flex; gap: 10px; flex-wrap: wrap; margin: 14px 0 6px; }
  .items { list-style: none; padding: 0; margin: 0; }
  .items li a { display: flex; flex-direction: column; gap: 2px; padding: 12px 0;
    border-bottom: 1px solid var(--border); text-decoration: none; }
  .cats { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 14px; }
  .edo { margin: 0 0 14px; }
  .edo div { display: flex; gap: 10px; flex-wrap: wrap; padding: 7px 0; border-bottom: 1px solid var(--border); }
  .edo dt { color: var(--muted); font-size: 13.5px; min-width: 210px; }
  .edo dd { margin: 0; font-weight: 600; word-break: break-all; }
  .manager .who { display: flex; gap: 14px; align-items: center; }
  .manager .ava { width: 52px; height: 52px; border-radius: 26px; display: grid; place-items: center;
    border: 1px solid var(--border); font-weight: 700; color: var(--muted); }
  .manager .who b { display: block; }
  .manager .who span { color: var(--muted); font-size: 13.5px; }
  .contacts { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 12px; }
  .legal { margin-top: 36px; font-size: 12px; line-height: 18px; color: var(--muted); }
</style>

<script>
  import { trackGoal, trackGoalOnce } from '../../lib/analytics';

  const token = location.pathname.split('/')[2] || '';
  trackGoalOnce('offer_webview_open', { placement: 'offer_page' });

  // Пришли по кнопке «Выбрать нужные действия» — это открытие выбора, а не
  // просто визит на страницу: шаг воронки считается отдельно.
  if (new URLSearchParams(location.search).get('utm_content') === 'actions') {
    trackGoalOnce('offer_actions_open', { source: 'email' });
  }

  // Блок ЭДО показался на экране — до него дочитывают не все, и это как раз
  // тот сигнал, по которому видно готовность к документообороту.
  const edoBlock = document.getElementById('edo');
  if (edoBlock && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        trackGoalOnce('offer_edo_open', { placement: 'offer_page' });
        io.disconnect();
      }
    }, { threshold: 0.4 });
    io.observe(edoBlock);
  }

  // Метка кампании из письма нужна один раз — дальше адрес чистится, чтобы
  // ссылка не разошлась по переписке вместе с utm и не переписала источник.
  if (location.search.includes('utm_')) {
    history.replaceState(null, '', location.pathname);
  }

  document.querySelectorAll<HTMLElement>('[data-ev]').forEach((el) => {
    el.addEventListener('click', () => {
      const goal = el.dataset.ev || '';
      if (!goal) return;
      trackGoal(goal, { placement: 'offer_page', sku: el.dataset.sku || undefined });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.copy || '');
      if (!target) return;
      try {
        await navigator.clipboard.writeText(target.textContent?.trim() || '');
        const was = btn.textContent;
        btn.textContent = 'Скопировано';
        setTimeout(() => { btn.textContent = was; }, 1800);
        trackGoal('offer_edo_copy', { action_type: btn.dataset.copy });
      } catch {
        // Буфер закрыт настройками браузера — значение и так на экране.
      }
    });
  });

  const form = document.getElementById('offer-form') as HTMLFormElement | null;
  const ok = document.getElementById('offer-ok');
  const err = document.getElementById('offer-err');
  const send = document.getElementById('offer-send') as HTMLButtonElement | null;

  form?.querySelectorAll<HTMLInputElement>('input[name="actions"]').forEach((box) => {
    box.addEventListener('change', () => {
      if (box.checked) trackGoal('offer_action_select', { action_type: box.value });
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !send) return;
    const actions = [...form.querySelectorAll<HTMLInputElement>('input[name="actions"]:checked')]
      .map((b) => b.value);
    if (actions.length === 0) {
      if (err) { err.textContent = 'Отметьте хотя бы одно действие.'; err.hidden = false; }
      return;
    }
    if (err) err.hidden = true;
    send.disabled = true;
    send.textContent = 'ОТПРАВЛЯЕМ…';
    trackGoal('offer_action_submit', { actions: actions.length });

    try {
      const res = await fetch('/api/offer-actions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          token,
          actions,
          comment: (form.elements.namedItem('comment') as HTMLTextAreaElement)?.value || '',
          contact_name: (form.elements.namedItem('contact_name') as HTMLInputElement)?.value || '',
          contact_phone: (form.elements.namedItem('contact_phone') as HTMLInputElement)?.value || '',
          contact_email: (form.elements.namedItem('contact_email') as HTMLInputElement)?.value || '',
          source: 'email',
        }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.ok) throw new Error(json.error || 'не отправлено');
      form.hidden = true;
      if (ok) ok.hidden = false;
      trackGoal('offer_action_success', { actions: actions.length });
    } catch (e) {
      send.disabled = false;
      send.textContent = 'ОТПРАВИТЬ ЗАПРОС';
      if (err) {
        err.textContent = 'Не удалось отправить запрос. Позвоните нам — примем по телефону.';
        err.hidden = false;
      }
      console.error(e);
    }
  });
</script>

  .sub { color: var(--color-text-muted); max-width: 64ch; margin-bottom: 1.6rem; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ── Открытие ─────────────────────────────────────────────────────── */
  .open { padding: clamp(2.2rem, 5vw, 3.4rem) 0 clamp(1.4rem, 3vw, 2rem); }
  .dateline {
    font-size: 0.76rem; letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--color-text-dim); font-weight: 700; margin-bottom: 1rem;
  }
  h1 { font-size: clamp(2.3rem, 5.2vw, 3.7rem); margin: 0 0 1.1rem; line-height: 1.06; max-width: 20ch; }
  .accent { color: var(--color-accent); }
  .standfirst { font-size: clamp(1.02rem, 1.5vw, 1.15rem); color: var(--color-text-muted); max-width: 60ch; }
  .byline {
    display: flex; gap: 0.5rem 1.8rem; flex-wrap: wrap;
    margin-top: 1.5rem; font-size: 0.86rem; color: var(--color-text-dim);
  }
  .byline b { color: var(--color-text); font-variant-numeric: tabular-nums; }
  .byline a { color: var(--color-accent); font-weight: 700; }

  /* ── Развилка маршрутов ───────────────────────────────────────────── */
  .routes { margin-top: 0.6rem; }
  .doors {
    display: grid; grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--color-border-strong); border-bottom: 0;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0; overflow: hidden;
    background: var(--color-bg-card);
  }
  .door {
    padding: 1.05rem 1.15rem; text-align: left; cursor: pointer;
    background: var(--color-bg-elevated); border: 0;
    border-right: 1px solid var(--color-border);
    border-top: 3px solid transparent;
    font: inherit; color: var(--color-text); transition: background-color 0.16s ease;
  }
  .door:last-child { border-right: 0; }
  .door:hover { background: var(--color-bg-card); }
  .door.on { background: var(--color-bg-card); border-top-color: var(--color-accent); }
  .door b { display: block; font-size: 0.98rem; font-weight: 700; margin-bottom: 0.15rem; }
  .door.on b { color: var(--color-accent); }
  .door span { display: block; font-size: 0.8rem; color: var(--color-text-dim); line-height: 1.4; }
  .lane {
    border: 1px solid var(--color-border-strong);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: var(--color-bg-card);
    padding: 1.6rem 1.7rem; box-shadow: var(--shadow-sm);
  }
  .lane[hidden] { display: none; }
  .lane-head {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.1rem;
  }
  .lane-head h2 { font-size: 1.3rem; margin: 0 0 0.25rem; }
  .lane-head p { color: var(--color-text-muted); font-size: 0.92rem; max-width: 60ch; margin: 0; }
  .lane-empty { color: var(--color-text-muted); }
  .lane-empty a { color: var(--color-accent); font-weight: 600; }
  .lane-search {
    display: flex; align-items: center; gap: 0.7rem;
    border: 2px solid var(--color-text); border-radius: var(--radius);
    padding: 0.55rem 0.8rem; color: var(--color-text-dim); max-width: 560px;
  }
  .lane-search input {
    flex: 1; min-width: 0; border: 0; outline: 0; background: transparent;
    font: inherit; font-size: 1rem; color: var(--color-text);
  }
  .legal-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 2rem; align-items: start; }
  .legal-side { padding: 1.1rem 1.2rem; display: flex; flex-direction: column; gap: 0.55rem; align-items: flex-start; }
  .legal-side p { color: var(--color-text-muted); font-size: 0.88rem; margin: 0; }
  .legal-note { font-size: 0.8rem !important; color: var(--color-text-dim) !important; margin-top: 0.3rem !important; }
  .know-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1.6rem; }
  .kcap {
    font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--color-text-dim); font-weight: 700; margin: 0 0 0.2rem;
  }
  .klist a {
    display: flex; justify-content: space-between; gap: 1rem;
    padding: 0.62rem 0; border-top: 1px solid var(--color-border);
    font-weight: 600; font-size: 0.9rem;
  }
  .klist a:hover { color: var(--color-accent); }
  .klist a span { color: var(--color-text-dim); font-weight: 400; }

  /* ── Строки товаров ───────────────────────────────────────────────── */
  .rows { list-style: none; padding: 0; margin: 1.2rem 0 0; }
  .rows.framed {
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    overflow: hidden; margin-top: 0;
  }
  .all-link { margin-top: 1rem; }
  .all-link a { color: var(--color-accent); font-weight: 600; }

  /* ── Полоса-подпись ───────────────────────────────────────────────── */
  .strip {
    margin-top: clamp(2rem, 4vw, 3rem);
    border-block: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }
  .strip-inner {
    display: flex; gap: 0.5rem 2.2rem; flex-wrap: wrap;
    padding-block: 0.95rem; font-size: 0.88rem; color: var(--color-text-muted);
  }
  .strip-inner b { color: var(--color-text); }

  /* ── Направления ──────────────────────────────────────────────────── */
  .dirs {
    /* auto-fit, а не жёсткие четыре колонки: разделов может оказаться два
       (часть каталога без цен), и фиксированная сетка оставляла бы в рамке
       две пустые клетки с границами. */
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    overflow: hidden; background: var(--color-bg-card);
  }
  .dir { padding: 1.2rem 1.3rem; border-right: 1px solid var(--color-border); display: block; }
  .dir:last-child { border-right: 0; }
  .dir:hover { background: var(--color-accent-soft); }
  .dir-ico {
    width: 40px; height: 40px; border-radius: 11px; margin-bottom: 0.6rem;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-accent-soft); color: var(--color-accent);
  }
  .dir em {
    font-style: normal; display: block; color: var(--color-accent);
    font-weight: 800; font-size: 1.4rem; line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .dir b { display: block; font-size: 1rem; margin: 0.1rem 0 0.15rem; }
  .dir-note { color: var(--color-text-dim); font-size: 0.82rem; }
  .ps-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; margin: 1.2rem 0 0; align-items: baseline; }
  /* Та же строка-реестр, что у популярных сервисов: одинаковый приём для
     одинаковой по смыслу вещи — плотный список входов вглубь сайта. */
  .kb-line { padding-top: clamp(2rem, 4vw, 3rem); }
  .kb-line .ps-links { margin-top: 0; }
  .ps-cap { color: var(--color-text-dim); font-size: 0.88rem; }
  .ps-links a { color: var(--color-text-muted); font-size: 0.9rem; font-weight: 600; }
  .ps-links a:hover { color: var(--color-accent); }

  /* ── Логопанель ───────────────────────────────────────────────────── */
  .logos-sec { margin-top: clamp(2rem, 4vw, 3rem); }
  .logos-cap { text-align: center; color: var(--color-text-dim); font-size: 0.9rem; margin-bottom: 1rem; }
  .logo-chip {
    display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.1rem;
    border: 1px solid var(--color-border); border-radius: var(--radius);
    background: var(--color-bg-card); box-shadow: var(--shadow-sm);
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .logo-chip:hover { border-color: var(--color-accent); transform: translateY(-3px); box-shadow: var(--shadow); }
  .logo-badge {
    width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-bg-card); border: 1px solid var(--color-border);
    /* --bc — фирменный цвет вендора: им красится глиф simple-icons и
       буквенный знак-фолбэк (оба наследуют currentColor). */
    color: var(--bc, var(--color-text));
    font-weight: 800; font-size: 1.1rem;
  }
  .logo-name { font-weight: 600; font-size: 0.92rem; white-space: nowrap; }

  /* ── Механика закупки ─────────────────────────────────────────────── */
  .flow-sec { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: 2.6rem; align-items: center; }
  .flow-text p { color: var(--color-text-muted); margin-bottom: 0.9rem; max-width: 56ch; }
  .flow-text p b { color: var(--color-text); }
  .flow-more { margin-top: 1.2rem; }
  .flow-more a { color: var(--color-accent); font-weight: 600; }
  .flow-fig { margin: 0; }
  /* Две схемы, а не одна масштабируемая: в широкой на телефоне подписи
     сжимались до пяти пикселей. Узкая — та же механика тремя ярусами.
     display:none у скрытой убирает её и из чтения скринридером, поэтому
     одинаковый aria-label у обеих не задваивается. */
  .flow-fig svg { width: 100%; height: auto; display: block; }
  .flow-fig .flow-svg-narrow { display: none; }
  .flow-fig figcaption {
    font-size: 0.82rem; color: var(--color-text-dim);
    margin-top: 0.8rem; padding-top: 0.8rem; border-top: 1px solid var(--color-border);
  }
  .fg-box { fill: var(--color-bg-card); stroke: var(--color-border-strong); stroke-width: 1.5; }
  .fg-box-acc { fill: var(--color-accent-soft); stroke: var(--color-accent); stroke-width: 1.8; }
  .fg-line-acc { stroke: var(--color-accent); stroke-width: 2.4; }
  .fg-line-bd { stroke: var(--color-border-strong); stroke-width: 2.2; fill: none; }
  .fg-line-ok { stroke: var(--color-success); stroke-width: 2.4; }
  .m-acc { fill: var(--color-accent); }
  .m-bd { fill: var(--color-border-strong); }
  .m-ok { fill: var(--color-success); }
  .fg-t { font-family: var(--font-sans); font-size: 14px; font-weight: 700; fill: var(--color-text); }
  .fg-t2 { font-family: var(--font-sans); font-size: 13px; font-weight: 700; fill: var(--color-text); }
  .fg-box-ok { fill: color-mix(in srgb, var(--color-success) 8%, var(--color-bg-card)); stroke: var(--color-success); stroke-width: 1.5; }
  .fg-ok-t { font-family: var(--font-sans); font-size: 13.5px; font-weight: 700; fill: var(--color-success); }
  .fg-s { font-family: var(--font-sans); font-size: 11.5px; fill: var(--color-text-dim); }
  .fg-a { font-family: var(--font-sans); font-size: 12px; font-weight: 700; fill: var(--color-accent); }
  .fg-ok { font-family: var(--font-sans); font-size: 12px; font-weight: 600; fill: var(--color-success); }

  /* ── Документы и образец ──────────────────────────────────────────── */
  .docs-sec { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 2.6rem; align-items: center; }
  .check-list { list-style: none; padding: 0; margin: 0; }
  .check-list li {
    padding: 0.72rem 0 0.72rem 1.9rem; border-top: 1px solid var(--color-border);
    position: relative; color: var(--color-text-muted);
  }
  .check-list li b { color: var(--color-text); }
  .check-list li::before {
    content: ''; position: absolute; left: 0; top: 1.15rem;
    width: 13px; height: 8px; border-left: 2px solid var(--color-success);
    border-bottom: 2px solid var(--color-success); transform: rotate(-45deg);
  }
  .paper {
    background: var(--color-bg-card); border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm); box-shadow: var(--shadow-lg);
    padding: 1.2rem 1.3rem; font-size: 0.75rem; color: var(--color-text-muted);
    transform: rotate(-1deg); display: flex; flex-direction: column; gap: 0.2rem;
  }
  .paper-h { font-size: 0.88rem; color: var(--color-text); }
  .paper-d { font-size: 0.72rem; }
  .paper-t { width: 100%; border-collapse: collapse; margin: 0.7rem 0 0.5rem; }
  .paper-t th, .paper-t td { border: 1px solid var(--color-border); padding: 0.26rem 0.4rem; text-align: left; font-size: 0.7rem; }
  .paper-t th { background: var(--color-bg-elevated); font-weight: 700; color: var(--color-text-muted); }
  .paper-tot { text-align: right; font-weight: 800; color: var(--color-text); font-size: 0.78rem; }
  .paper-f { font-size: 0.7rem; color: var(--color-text-dim); margin-top: 0.4rem; }

  /* ── Спрос, которого нет в каталоге ───────────────────────────────── */
  .miss { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 2.4rem; padding: 1.8rem 2rem; align-items: center; }
  .miss .h2 { font-size: clamp(1.35rem, 2.2vw, 1.7rem); }
  .miss .sub { margin-bottom: 1rem; }
  .miss-form { display: flex; gap: 0.55rem; flex-wrap: wrap; }
  .miss-form input {
    flex: 1; min-width: 200px; font: inherit; font-size: 0.95rem;
    padding: 0.62rem 0.85rem; background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm);
    color: var(--color-text);
  }
  .miss-form input:focus { border-color: var(--color-accent); outline: none; }
  .miss-note { font-size: 0.82rem; color: var(--color-text-dim); margin: 0.6rem 0 0; }
  .miss-side { border-left: 1px solid var(--color-border); padding-left: 2.4rem; }
  .miss-side p { color: var(--color-text-muted); font-size: 0.9rem; margin: 0; }
  .miss-direct { margin-top: 0.7rem !important; font-weight: 700; }
  .miss-direct a { color: var(--color-accent); }

  /* ── Финал ────────────────────────────────────────────────────────── */
  .fin-sec { display: grid; grid-template-columns: 400px minmax(0, 1fr); gap: 2.5rem; align-items: start; }
  .fin-kp { padding: 1.7rem 1.8rem; display: flex; flex-direction: column; align-items: flex-start; gap: 0.8rem; }
  .fin-kp h2 { font-size: 1.35rem; }
  .fin-kp p { color: var(--color-text-muted); font-size: 0.92rem; margin: 0; }
  .fin-ctx {
    background: var(--color-accent-soft); border-left: 3px solid var(--color-accent);
    border-radius: 0 8px 8px 0; padding: 0.5rem 0.7rem; font-size: 0.88rem !important;
    color: var(--color-text) !important; align-self: stretch;
  }
  .fin-ctx b { font-variant-numeric: tabular-nums; }
  .fin-empty { color: var(--color-accent) !important; font-size: 0.86rem !important; }
  .fin-note { font-size: 0.8rem !important; color: var(--color-text-dim) !important; }

  /* ── Телефон: каждый блок укладывается своим порядком ─────────────── */
  @media (max-width: 980px) {
    .legal-grid, .flow-sec, .docs-sec, .miss, .fin-sec { grid-template-columns: 1fr; }
    .dirs { grid-template-columns: 1fr 1fr; }
    .dir { border-bottom: 1px solid var(--color-border); }
    .miss-side { border-left: 0; border-top: 1px solid var(--color-border); padding: 1.2rem 0 0; }
    /* Схема идёт после текста: сначала объяснение, потом картинка к нему. */
    .flow-fig { order: 2; }
    .flow-fig .flow-svg-wide { display: none; }
    .flow-fig .flow-svg-narrow { display: block; }
    /* Образец КП без наклона — на узком экране он заезжал за край. */
    .paper { transform: none; }
    .fin-kp { order: 2; }
  }
  @media (max-width: 720px) {
    /* Двери превращаются в ленту с прокруткой: четыре колонки на телефоне
       дают по два слова в строку и нечитаемы. Обрезка четвёртой двери —
       подсказка, что лента продолжается. */
    .doors { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
    .door { flex: 0 0 68%; scroll-snap-align: start; }
    .lane { padding: 1.2rem 1.1rem; }
    .dirs { grid-template-columns: 1fr; }
    .dir { border-right: 0; }
  }
</style>

<script>
  import { trackGoal } from '@/lib/analytics';
  import { readCart, cartCount, cartTotal } from '@/lib/cart-client';
  import { formatRub } from '@/lib/pricing';

  // ── Маршруты первого экрана ────────────────────────────────────────
  // Дорожки уже в разметке: скрипт только переключает видимость. Без
  // JavaScript посетитель видит первую дорожку, а краулер — все четыре.
  const doors = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-door]'));
  const lanes = Array.from(document.querySelectorAll<HTMLElement>('[data-lane]'));

  const openRoute = (id: string, focus = false) => {
    doors.forEach((d) => {
      const on = d.dataset.door === id;
      d.classList.toggle('on', on);
      d.setAttribute('aria-selected', on ? 'true' : 'false');
      d.tabIndex = on ? 0 : -1;
      if (on && focus) d.focus();
    });
    lanes.forEach((l) => { l.hidden = l.dataset.lane !== id; });
  };

  doors.forEach((d) => {
    d.addEventListener('click', () => {
      const id = d.dataset.door || '';
      openRoute(id);
      // Какой маршрут выбирают — первый шаг воронки главной. Без него
      // видно только, что человек ушёл, но не с какой развилки.
      trackGoal('home_route_pick', { route: id });
    });
    // Стрелки внутри группы вкладок — требование клавиатурной навигации.
    d.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const i = doors.indexOf(d);
      const next = doors[(i + (e.key === 'ArrowRight' ? 1 : doors.length - 1)) % doors.length];
      openRoute(next.dataset.door || '', true);
    });
  });

  // ── Спрос, которого нет в каталоге ─────────────────────────────────
  // Название сервиса уходит в цель сразу, а форму открывает штатный
  // диалог вопроса: /api/lead требует полный набор реквизитов, и своя
  // усечённая форма здесь означала бы вторую точку приёма заявок.
  // Цель отправляется до открытия формы: спрос ценен и тогда, когда
  // человек форму не дозаполнил.
  const missInput = document.querySelector<HTMLInputElement>('[data-miss-input]');
  const missBtn = document.querySelector<HTMLButtonElement>('[data-miss-submit]');
  const missNote = document.querySelector<HTMLElement>('[data-miss-note]');

  // Название подставляется по мере ввода, а не в обработчике нажатия:
  // диалог вопроса читает data-product в своём слушателе, и порядок двух
  // слушателей на одной кнопке не гарантирован.
  missInput?.addEventListener('input', () => {
    const value = missInput.value.trim().slice(0, 120);
    if (missBtn) missBtn.dataset.product = value;
    if (missNote && value) missNote.textContent = `Спросим по запросу «${value}» — ответим, как его закупить и сколько это выйдет.`;
  });

  missBtn?.addEventListener('click', () => {
    const value = (missInput?.value || '').trim().slice(0, 120);
    // Цель уходит до формы: спрос ценен и тогда, когда человек её не
    // дозаполнил. Пустое поле — тоже сигнал, но другой, и в отчёте их
    // путать нельзя.
    trackGoal('home_missing_service', { service: value || '(не назван)' });
  });

  missInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); missBtn?.click(); }
  });

  // ── Контекст подборки в финальном блоке ────────────────────────────
  // Человек, собравший подборку, не должен гадать, попадёт ли она в КП.
  const finCtx = document.querySelector<HTMLElement>('[data-fin-ctx]');
  const renderFinCtx = () => {
    if (!finCtx) return;
    const items = readCart();
    const n = cartCount(items);
    finCtx.hidden = n === 0;
    if (n === 0) return;
    const word = (() => {
      const d = n % 10, h = n % 100;
      if (d === 1 && h !== 11) return 'позиция';
      if ([2, 3, 4].includes(d) && ![12, 13, 14].includes(h)) return 'позиции';
      return 'позиций';
    })();
    finCtx.innerHTML = `В предложение войдут <b>${n}</b> ${word} на <b>${formatRub(cartTotal(items))}</b> — состав подставится сам.`;
  };
  renderFinCtx();
  window.addEventListener('cart:change', renderFinCtx);
</script>

---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import CTASection from '../components/CTASection.astro';
import QuestionForm from '../components/QuestionForm.astro';
import JsonLd from '../components/JsonLd.astro';
import { getCategories, getProducts } from '../lib/directus';
import { localBusinessSchema } from '../lib/seo';
import { site } from '../config/site';

let categories = [];
let featured = [];
const originCounts: Record<string, number> = { domestic: 0, foreign: 0 };
try {
  categories = await getCategories();
  const all = await getProducts();
  for (const p of all) if (p.origin) originCounts[p.origin] = (originCounts[p.origin] || 0) + 1;
  featured = all.slice(0, 6);
} catch (e) {
  console.error('home data error', e);
}

const originCards = [
  { key: 'domestic', label: 'Отечественное ПО', desc: 'Российское ПО из реестра: офис, ОС, безопасность, САПР, коммуникации.' },
  { key: 'foreign', label: 'Иностранное ПО', desc: 'Зарубежные сервисы: офис, разработка, дизайн, ВКС, AI. Оплата в рублях.' },
] as const;

const trust = [
  { num: '01', title: 'Работаем по договору', text: 'Прозрачные условия поставки и ответственность сторон закреплены документально.' },
  { num: '02', title: 'Оплата по счёту', text: 'Безналичный расчёт для юрлиц и ИП. Реквизиты и счёт — сразу после согласования.' },
  { num: '03', title: 'Закрывающие через ЭДО', text: 'Акты и счета-фактуры передаём через электронный документооборот.' },
  { num: '04', title: 'Ответственность за качество', text: 'Своевременная поставка доступов и поддержка на всём сроке подписки.' },
];
---
<BaseLayout
  title={undefined}
  description={site.description}
>
  <JsonLd schema={localBusinessSchema()} />

  <!-- HERO -->
  <section class="hero">
    <div class="container-page hero-inner">
      <div class="hero-content reveal is-visible">
        <span class="eyebrow">Легальное ПО для бизнеса · РФ</span>
        <h1>Подписки на зарубежное ПО<br />для российских компаний — <span class="accent">по договору и счёту</span></h1>
        <p class="hero-sub">
          Подключаем юрлицам и ИП доступ к AI-сервисам, графическим редакторам,
          видеоконференцсвязи и инструментам разработки. Договор, оплата по счёту,
          закрывающие документы через ЭДО.
        </p>
        <div class="hero-actions">
          <a href="/catalog" class="btn btn-primary" data-goal="hero_catalog">Перейти в каталог</a>
          <a href="/pricing" class="btn btn-ghost" data-goal="hero_calc">Запросить расчёт</a>
        </div>
        <ul class="hero-badges">
          <li>● Договор и счёт</li>
          <li>● Закрывающие через ЭДО</li>
          <li>● Своевременная поставка</li>
        </ul>
      </div>
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
  </section>

  <!-- КАТАЛОГ -->
  <section class="container-page section">
    <SectionHeading num="01" eyebrow="Каталог" title="Отечественное и иностранное ПО">
      <p>Выберите происхождение, затем фильтруйте по категории, производителю и названию.</p>
    </SectionHeading>
    <div class="cat-grid">
      {originCards.map((o) => (
        <a href={`/catalog/${o.key}`} class="card card-hover cat-card reveal">
          <div class="cat-head">
            <h3>{o.label}</h3>
            <span class="cat-num">{originCounts[o.key] || 0}</span>
          </div>
          <p>{o.desc}</p>
          <span class="cat-link">Смотреть раздел →</span>
        </a>
      ))}
      {categories.length === 0 && <p class="muted">Каталог временно недоступен. Загляните позже.</p>}
    </div>
  </section>

  <!-- БЛОК ДОВЕРИЯ -->
  <section class="container-page section">
    <SectionHeading num="02" eyebrow="Почему BizSoft" title="Прозрачно и по закону">
      <p>Мы продаём не «серый» доступ, а оформленную поставку с полным пакетом документов.</p>
    </SectionHeading>
    <div class="trust-grid">
      {trust.map((t) => (
        <div class="card trust-card reveal">
          <span class="section-num">/{t.num}</span>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ПОПУЛЯРНЫЕ ТОВАРЫ -->
  {featured.length > 0 && (
    <section class="container-page section">
      <SectionHeading num="03" eyebrow="Популярное" title="Готовые подписки">
        <p>Примеры позиций каталога. Цены ориентировочные — финальную стоимость подтверждаем в счёте.</p>
      </SectionHeading>
      <div class="product-grid">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </section>
  )}

  <CTASection />
  <QuestionForm source="home" />
</BaseLayout>

<style>
  .section {
    padding-top: 4rem;
  }
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(2.5rem, 5vw, 4rem);
  }
  .hero-glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 60%;
    height: 120%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 62%);
    filter: blur(60px);
    z-index: 0;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }
  .hero-content {
    max-width: 820px;
  }
  h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.6rem);
    margin: 1rem 0 1.2rem;
  }
  .accent {
    color: var(--color-accent);
  }
  .hero-sub {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    max-width: 60ch;
  }
  .hero-actions {
    display: flex;
    gap: 0.8rem;
    margin: 2rem 0 1.5rem;
    flex-wrap: wrap;
  }
  .hero-badges {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .hero-badges li::marker {
    content: '';
  }
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.2rem;
  }
  .cat-card {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .cat-head { display: flex; align-items: center; justify-content: space-between; }
  .cat-num { color: var(--color-text-dim); font-size: 0.85rem; background: var(--color-bg-elevated); padding: 0.1rem 0.6rem; border-radius: 999px; }
  .cat-card h3 {
    font-size: 1.3rem;
  }
  .cat-card p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    flex-grow: 1;
  }
  .cat-link {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.2rem;
  }
  .trust-card {
    padding: 1.6rem;
  }
  .trust-card h3 {
    font-size: 1.15rem;
    margin: 0.8rem 0 0.5rem;
  }
  .trust-card p {
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.2rem;
  }
  .muted {
    color: var(--color-text-muted);
  }
</style>

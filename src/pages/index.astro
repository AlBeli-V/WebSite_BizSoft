---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import Carousel from '../components/Carousel.astro';
import StatsDigits from '../components/StatsDigits.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { SEO_EXPERIMENT_LINKS } from '../data/seo-experiments';
import { STATS } from '../data/stats';
import Banner from '../components/Banner.astro';
import LeadForm from '../components/LeadForm.astro';
import QuestionForm from '../components/QuestionForm.astro';
import VendorLogo from '../components/VendorLogo.astro';
import ProductCard from '../components/ProductCard.astro';
import JsonLd from '../components/JsonLd.astro';
import { localBusinessSchema } from '../lib/seo';
import { site, seller } from '../config/site';
import { POPULAR_VENDORS } from '../data/popular';
import { getProducts } from '../lib/directus';
import { effectivePrice, formatRub } from '../lib/pricing';

// Узнаваемые бренды для логопанели. Ссылки — на готовые лендинги.
type Brand = { name: string; slug: string; color: string; blurb: string };
const brands: Brand[] = [
  { name: 'Adobe', slug: 'adobe', color: '#FA0F00', blurb: 'Photoshop, Illustrator, Premiere Pro, Acrobat и весь Creative Cloud.' },
  { name: 'Figma', slug: 'figma', color: '#F24E1E', blurb: 'Дизайн интерфейсов и совместная работа над макетами.' },
  { name: 'JetBrains', slug: 'jetbrains', color: '#000000', blurb: 'IDE для разработчиков: IntelliJ IDEA, PyCharm, GoLand, Rider.' },
  { name: 'Miro', slug: 'miro', color: '#F2C500', blurb: 'Онлайн-доски для брейнштормов и работы распределённых команд.' },
  { name: 'Zoom', slug: 'zoom', color: '#0B5CFF', blurb: 'Видеосвязь, вебинары и телефония для бизнеса.' },
  { name: 'OpenAI', slug: 'openai', color: '#10A37F', blurb: 'ChatGPT Business и OpenAI API для команд.' },
  { name: 'Canva', slug: 'canva', color: '#00C4CC', blurb: 'Дизайн, презентации и брендинг без штатного дизайнера.' },
  { name: 'Autodesk', slug: 'autodesk', color: '#111111', blurb: '3D и VFX: Maya, 3ds Max, Media & Entertainment Collection.' },
];

// Чёрный/белый текст на цветной плитке по яркости фона.
function textOn(hex: string): string {
  const h = hex.replace('#', '');
  const r = parseInt(h.slice(0, 2), 16), g = parseInt(h.slice(2, 4), 16), b = parseInt(h.slice(4, 6), 16);
  const lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
  return lum > 0.62 ? '#1d1d1f' : '#ffffff';
}

// ── Живые данные каталога: цифры доверия, плитки категорий, товары с ценами ──
let all = [];
try {
  all = await getProducts();
} catch (e) {
  console.error('home products error', e);
}
const catSlug = (p) => (typeof p.category === 'object' && p.category ? p.category.slug : '');
const productCount = all.length;
const vendorCount = new Set(all.map((p) => p.vendor).filter(Boolean)).size;
// округляем вниз до десятка — «380+»
const tenDown = (n: number) => `${Math.max(10, Math.floor(n / 10) * 10)}+`;

const catCount = (pred: (s: string) => boolean) => all.filter((p) => pred(catSlug(p))).length;
const firstPresent = (slugs: string[]) => slugs.find((s) => all.some((p) => catSlug(p) === s));
const tiles = [
  { icon: 'ai', name: 'AI-сервисы', href: '/catalog/ai', note: 'ChatGPT, Claude, Copilot, Midjourney', count: catCount((s) => s.startsWith('ai')) },
  { icon: 'design', name: 'Дизайн и графика', href: `/catalog/${firstPresent(['design', 'graphics-design']) || 'design'}`, note: 'Figma, Adobe, Canva, CorelDRAW', count: catCount((s) => ['design', 'graphics-design'].includes(s)) },
  { icon: 'develop', name: 'Разработка', href: `/catalog/${firstPresent(['developer-tools', 'development']) || 'development'}`, note: 'JetBrains, Unity, Unreal', count: catCount((s) => ['developer-tools', 'development'].includes(s)) },
  { icon: 'video', name: 'Видео и медиа', href: `/catalog/${firstPresent(['media']) || 'media'}`, note: 'DaVinci, Avid, Runway', count: catCount((s) => s === 'media') },
].filter((t) => t.count > 0);

// Кураторский список бестселлеров (slug'и подтверждены в БД).
const POPULAR_SLUGS = ['chatgpt-business', 'anthropic-team', 'ghcopilot-business', 'cursor-business', 'mscopilot-m365', 'gemini-workspace-standard', 'mj-standard', 'recraft-advanced'];
const bySlug = new Map(all.map((p) => [p.slug, p]));
const popular = POPULAR_SLUGS.map((s) => bySlug.get(s)).filter(Boolean);
// Hero-карточки: первые 4 бестселлера с известной ценой.
const heroCards = popular.filter((p) => effectivePrice(p).price > 0).slice(0, 4);
const VENDOR_COLOR: Record<string, string> = {
  OpenAI: '#10A37F', Anthropic: '#D97757', GitHub: '#24292F', Cursor: '#111111',
  Microsoft: '#0078D4', Google: '#4285F4', Midjourney: '#1a1a2e', Recraft: '#111111',
};

const tracks = [
  {
    tag: 'Простой случай',
    title: 'Вендор принимает карту',
    text: 'Многие сервисы из ЕС и США оплачиваются банковской картой. Оформляем подписку, оплачиваем и передаём вам активированные доступы — быстро, без лишних шагов.',
    points: ['Быстрый старт', 'Оплата и активация на нашей стороне', 'Доступы — вашей команде'],
  },
  {
    tag: 'Сложный случай',
    title: 'Картой не оплатить',
    text: 'Часть вендоров работает только с зарубежными юрлицами и их счетами. Закупаем через счёт нашей компании за рубежом — вы получаете тот же сервис и полный пакет документов в России.',
    points: ['Закупка через зарубежный счёт компании', 'Тот же сервис без ограничений', 'Договор и закрывающие в РФ'],
  },
];

const outcomes = [
  { num: '01', title: 'Непрерывность работы', text: 'Специалисты остаются в привычных инструментах — проекты и процессы не встают из-за перехода на аналоги.' },
  { num: '02', title: 'Официальные расходы', text: 'Оплата по договору и счёту, закрывающие документы через ЭДО. Затраты учитываются в бухгалтерии.' },
  { num: '03', title: 'Мировой уровень инструментов', text: 'Доступ к сервисам, которые задают стандарт в дизайне, разработке и коммуникациях.' },
  { num: '04', title: 'Одна точка ответственности', text: 'Подбор, закупка, оплата, активация и поддержка на всём сроке подписки.' },
];

const steps = [
  { n: '1', t: 'Заявка', d: 'Рассказываете, какие сервисы и на сколько пользователей нужны.' },
  { n: '2', t: 'Расчёт и КП', d: 'Подбираем варианты, считаем стоимость и готовим коммерческое предложение.' },
  { n: '3', t: 'Договор и оплата', d: 'Заключаем договор, выставляем счёт и оплачиваем вендору.' },
  { n: '4', t: 'Активация и документы', d: 'Передаём доступы и закрывающие документы через ЭДО.' },
];

const docBadges = [
  { icon: 'office', t: 'Договор поставки', d: 'на ООО или ИП' },
  { icon: 'документ', t: 'Счёт в рублях', d: 'по курсу ЦБ на дату счёта' },
  { icon: 'security', t: 'Закрывающие через ЭДО', d: 'акты и УПД' },
  { icon: 'защит', t: seller.shortName, d: `ИНН ${seller.inn} · с 2022 года` },
];

const cases = [
  { tag: 'Дизайн-студия · 12 мест', title: 'Figma + Adobe CC на всю команду', text: 'Единый счёт, доступы за 2 дня, продление без участия бухгалтерии.' },
  { tag: 'IT-компания · 30 мест', title: 'JetBrains + GitHub Copilot', text: 'Годовые лицензии с фиксацией в счёте, закрывающие через ЭДО.' },
  { tag: 'Агентство · 8 мест', title: 'ChatGPT Business + Midjourney', text: 'Корпоративные тарифы вместо личных карт сотрудников.' },
];

const compareLinks = [
  { label: 'ChatGPT vs Claude: что выбрать бизнесу', href: '/compare/chatgpt-vs-claude' },
  { label: 'Cursor vs GitHub Copilot', href: '/compare/cursor-vs-copilot' },
  { label: 'Midjourney vs Adobe Firefly', href: '/compare/midjourney-vs-firefly' },
];
const kbLinks = [
  { label: 'Как оформить AI-подписку на юрлицо', href: '/blog/kak-oformit-korporativnuyu-ai-podpisku-na-yurlico' },
  { label: 'Enterprise или Team: чем отличаются тарифы', href: '/blog/enterprise-vs-team-korporativnye-tarify-ai' },
  { label: 'Безопасность данных в корпоративных AI', href: '/blog/bezopasnost-dannyh-v-korporativnyh-ai' },
];

// GEO/AEO: список подключаемых сервисов со ссылками на лендинги — для поиска и ИИ-ответов.
const servicesItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Зарубежные сервисы и ПО, которые подключает BizSoft для юрлиц',
  description: 'Популярные зарубежные SaaS-сервисы и ПО, которые BizSoft закупает и активирует для российских компаний по договору и счёту.',
  itemListElement: brands.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    url: `${site.url}/vendors/${b.slug}`,
  })),
};
---
<BaseLayout
  title="BizSoft — Adobe, Figma, JetBrains и мировые сервисы для бизнеса по договору"
  description="Помогаем российским компаниям закупать и активировать зарубежные SaaS и ПО: Adobe, Figma, JetBrains, ChatGPT, Claude. Годовые подписки по договору и счёту, закрывающие через ЭДО."
>
  <JsonLd schema={[localBusinessSchema(), servicesItemList]} />

  <!-- HERO: заголовок + бестселлеры с ценами -->
  <section class="hero">
    <div class="container-page hero-grid">
      <div class="hero-content reveal is-visible">
        <span class="eyebrow">SaaS и ПО для бизнеса без границ</span>
        <h1>Закупку зарубежного ПО <span class="accent">берём на себя</span></h1>
        <p class="hero-sub">
          Команда остаётся в привычных инструментах: Adobe, Figma, JetBrains, ChatGPT, Claude
          и сотни зарубежных сервисов. Договор, счёт в рублях, закрывающие — через ЭДО.
        </p>
        <div class="hero-actions">
          <button class="btn btn-primary" data-open-question data-goal="hero_discuss">Обсудить задачу</button>
          <a href="/catalog" class="btn btn-ghost" data-goal="hero_catalog">Смотреть каталог</a>
        </div>
        <ul class="hero-badges">
          <li>Договор и счёт в ₽</li>
          <li>Закрывающие через ЭДО</li>
          <li>Поставка 1–3 дня</li>
        </ul>
      </div>

      {heroCards.length >= 2 ? (
        <div class="hero-media reveal is-visible">
          <div class="hero-cards">
            {heroCards.map((p, i) => {
              const eff = effectivePrice(p);
              const color = VENDOR_COLOR[p.vendor || ''] || 'var(--color-accent)';
              return (
                <a href={`/product/${p.slug}`} class="card mini-card" data-goal="hero_product">
                  {i === 0 && <span class="hit-badge">Хит</span>}
                  <span class="mini-logo" style={`--bc:${color}; --tc:${textOn(color.startsWith('#') ? color : '#f2591d')}`}>{(p.vendor || p.name).slice(0, 1)}</span>
                  <h3>{p.name}</h3>
                  <div class="mini-price">от {formatRub(eff.price)} <small>{p.price_note || 'в год'}</small></div>
                </a>
              );
            })}
          </div>
        </div>
      ) : (
        <div class="hero-media reveal is-visible" aria-hidden="true">
          <div class="tile-cloud">
            {brands.slice(0, 6).map((b, i) => (
              <span class={`app-tile t${i}`} style={`--bc:${b.color}; --tc:${textOn(b.color)}`}>{b.name.slice(0, 1)}</span>
            ))}
          </div>
        </div>
      )}
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
  </section>

  <!-- ЦИФРЫ ДОВЕРИЯ -->
  <StatsDigits stats={[
    { num: productCount > 0 ? Math.max(10, Math.floor(productCount / 10) * 10) : STATS.productsFallback, suf: '+', label: 'позиций в каталоге' },
    { num: vendorCount > 0 ? Math.max(10, Math.floor(vendorCount / 10) * 10) : STATS.vendorsFallback, suf: '+', label: 'мировых вендоров' },
    { num: STATS.sinceYear, pre: 'с ', suf: ' г.', label: 'работаем на рынке' },
    { num: STATS.aiDirections, label: 'AI-направлений в каталоге' },
    { num: 1, suf: ' день', label: 'на КП и счёт' },
    { num: 100, suf: '%', label: 'сделок с закрывающими по ЭДО' },
  ]} />

  <!-- ЛОГОПАНЕЛЬ -->
  <section class="container-page logos-sec">
    <p class="logos-cap">Помогаем подключать сервисы, которыми пользуется весь мир</p>
    <Carousel label="Производители, которых мы подключаем" autoplay={2600} slideWidth="clamp(200px, 60vw, 240px)">
      {POPULAR_VENDORS.map((b) => (
        <a href={`/vendors/${b.slug}`} class="logo-chip" role="listitem" aria-label={`${b.name} — купить для юрлица`}>
          <span class="logo-badge" style={`--bc:${b.color}; --tc:${textOn(b.color)}`}><VendorLogo slug={b.slug} name={b.name} size={24} /></span>
          <span class="logo-name">{b.name}</span>
        </a>
      ))}
    </Carousel>
  </section>

  <!-- Популярные сервисы для бизнеса (перелинковка SEO-эксперимента P0-1) -->
  <section class="container-page pop-services">
    <p class="ps-cap">Популярные сервисы для бизнеса:</p>
    <p class="ps-links">
      {SEO_EXPERIMENT_LINKS.map((l) => <a href={`/vendors/${l.slug}`}>{l.anchor}</a>)}
    </p>
  </section>

  <!-- КАТЕГОРИИ КАТАЛОГА -->
  {tiles.length > 0 && (
    <section class="container-page section">
      <SectionHeading num="01" eyebrow="Каталог" title="Направления">
        <p>Разделы каталога с фильтрами, ценами в рублях и оформлением на юрлицо.</p>
      </SectionHeading>
      <div class="cat-tiles">
        {tiles.map((t) => (
          <a href={t.href} class="card card-hover cat-tile" data-goal="home_category">
            <span class="cat-ico" aria-hidden="true"><CategoryIcon slug={t.icon} name={t.name} size={34} /></span>
            <b>{t.name}</b>
            <span class="cat-note">{t.count} {t.count % 10 === 1 && t.count % 100 !== 11 ? 'товар' : [2, 3, 4].includes(t.count % 10) && ![12, 13, 14].includes(t.count % 100) ? 'товара' : 'товаров'} · {t.note}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ПОПУЛЯРНЫЕ ТОВАРЫ С ЦЕНАМИ -->
  {popular.length >= 4 && (
    <section class="container-page section band">
      <SectionHeading num="02" eyebrow="Популярное" title="Чаще всего оформляют">
        <p>Реальные карточки каталога: цена за год, оформление на юрлицо в два клика.</p>
      </SectionHeading>
      <div class="product-grid">
        {popular.slice(0, 8).map((p) => <ProductCard product={p} />)}
      </div>
      <p class="all-vendors"><a href="/catalog">Весь каталог →</a></p>
    </section>
  )}

  <!-- ДВА ПУТИ ЗАКУПКИ -->
  <section class="container-page section">
    <SectionHeading num="03" eyebrow="Как это устроено" title="Два пути закупки — подбираем под вендора">
      <p>Способ оплаты зависит от того, как вендор принимает деньги. Оба пути ведут к легальной поставке с документами.</p>
    </SectionHeading>
    <div class="track-grid">
      {tracks.map((t, i) => (
        <div class="card track-card reveal">
          <span class="track-tag">{t.tag}</span>
          <div class="track-num" aria-hidden="true">{i + 1}</div>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
          <ul class="track-points">
            {t.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ПРОМО-БАННЕР -->
  <section class="container-page section band">
    <Banner
      variant="accent"
      eyebrow="Не нашли нужный сервис?"
      title="Подключим почти любой зарубежный SaaS или ПО"
      text="Работаем со всеми популярными вендорами и разбираем нестандартные запросы. Опишите задачу — подберём способ закупки и посчитаем стоимость."
      ctaLabel="Обсудить задачу"
      ctaHref="/contacts"
      ctaGoal="banner_discuss"
    />
  </section>

  <!-- ВЫГОДЫ -->
  <!-- СНЯТИЕ РИСКОВ (Б6 аудита): отвечаем на возражения до формы -->
  <section class="container-page section">
    <SectionHeading num="03•1" eyebrow="Частые сомнения" title="Снимаем риски закупки">
      <p>Четыре вопроса, которые задаёт каждый закупщик, — отвечаем сразу.</p>
    </SectionHeading>
    <div class="risk-grid">
      <div class="card risk-card"><h3>Это легально?</h3><p>Да: вы заключаете договор поставки с российским поставщиком и платите в рублях по безналу. Валютных операций и зарубежных платежей у вашей компании не возникает.</p></div>
      <div class="card risk-card"><h3>Не заблокируют ли аккаунт?</h3><p>Оформляем официальные корпоративные тарифы на вашу команду и сопровождаем доступ весь срок подписки. Если у вендора возникают вопросы — решаем их мы.</p></div>
      <div class="card risk-card"><h3>Что будет при продлении?</h3><p>Заранее напоминаем об окончании срока, выставляем счёт на новый период и продлеваем так, чтобы доступ команды не прерывался.</p></div>
      <div class="card risk-card"><h3>Как с НДС и закрывающими?</h3><p>Выставляем счёт в рублях, передаём договор, акт и УПД через ЭДО — полный комплект для бухгалтерии. Ставка НДС указывается в счёте и КП.</p></div>
    </div>
  </section>
  <section class="container-page section">
    <SectionHeading num="04" eyebrow="Зачем это бизнесу" title="Устойчивость работы и прозрачные расходы">
      <p>Мы закрываем не разовую покупку, а непрерывный доступ к инструментам с корректным оформлением.</p>
    </SectionHeading>
    <div class="outcome-grid">
      {outcomes.map((o) => (
        <div class="card outcome-card reveal">
          <span class="section-num">/{o.num}</span>
          <h3>{o.title}</h3>
          <p>{o.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ПРОЦЕСС -->
  <section class="container-page section band">
    <SectionHeading num="05" eyebrow="Процесс" title="От заявки до активации">
      <p>Прозрачный порядок работы: вы видите стоимость и получаете полный пакет документов.</p>
    </SectionHeading>
    <ol class="steps-grid">
      {steps.map((s) => (
        <li class="card step-card reveal">
          <span class="step-num">{s.n}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ОФОРМЛЕНИЕ ДЛЯ ЮРЛИЦ -->
  <section class="container-page section">
    <SectionHeading num="06" eyebrow="Оформление" title="Всё, что нужно бухгалтерии">
      <p>Покупка выглядит как обычная поставка ПО от российского поставщика.</p>
    </SectionHeading>
    <div class="doc-grid">
      {docBadges.map((d) => (
        <div class="card doc-card">
          <span class="doc-ico" aria-hidden="true"><CategoryIcon slug={d.icon} name={d.t} size={24} /></span>
          <div><b>{d.t}</b><span>{d.d}</span></div>
        </div>
      ))}
    </div>
  </section>

  <!-- КЕЙСЫ -->
  <section class="container-page section">
    <SectionHeading eyebrow="Кейсы" title="Как это работает у клиентов">
      <p>Типовые комплекты, которые оформляют команды. Подробнее — в разделе кейсов.</p>
    </SectionHeading>
    <div class="case-grid">
      {cases.map((c) => (
        <a href="/cases" class="card card-hover case-card">
          <span class="case-tag">{c.tag}</span>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </a>
      ))}
    </div>
  </section>


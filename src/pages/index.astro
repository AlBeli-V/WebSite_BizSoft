---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import Carousel from '../components/Carousel.astro';
import Banner from '../components/Banner.astro';
import LeadForm from '../components/LeadForm.astro';
import QuestionForm from '../components/QuestionForm.astro';
import JsonLd from '../components/JsonLd.astro';
import { localBusinessSchema } from '../lib/seo';

// Узнаваемые бренды для логопанели и карточек. Ссылки — на готовые лендинги.
type Brand = { name: string; slug: string; color: string; blurb: string };
const brands: Brand[] = [
  { name: 'Adobe', slug: 'adobe', color: '#FA0F00', blurb: 'Photoshop, Illustrator, Premiere Pro, Acrobat и весь Creative Cloud.' },
  { name: 'Figma', slug: 'figma', color: '#F24E1E', blurb: 'Дизайн интерфейсов и совместная работа над макетами.' },
  { name: 'JetBrains', slug: 'jetbrains', color: '#000000', blurb: 'IDE для разработчиков: IntelliJ IDEA, PyCharm, GoLand, Rider.' },
  { name: 'Miro', slug: 'miro', color: '#F2C500', blurb: 'Онлайн-доски для брейнштормов и работы распределённых команд.' },
  { name: 'Zoom', slug: 'zoom', color: '#0B5CFF', blurb: 'Видеосвязь, вебинары и телефония для бизнеса.' },
  { name: 'OpenAI', slug: 'openai', color: '#10A37F', blurb: 'ChatGPT Business и OpenAI API для команд.' },
  { name: 'Canva', slug: 'canva', color: '#00C4CC', blurb: 'Дизайн, презентации и брендинг без штатного дизайнера.' },
  { name: 'Autodesk', slug: 'autodesk', color: '#111111', blurb: '3D и VFX: Maya, 3ds Max, Media & Entertainment Collection.' },
];

// Дополнительные логотипы для верхней ленты (только узнаваемость).
const logoStrip: { name: string; slug: string; color: string }[] = [
  ...brands.map(({ name, slug, color }) => ({ name, slug, color })),
  { name: 'Unreal Engine', slug: 'unreal-engine', color: '#0E1128' },
  { name: 'DaVinci Resolve', slug: 'blackmagic', color: '#FF9E1E' },
  { name: 'Unity', slug: 'unity', color: '#111111' },
  { name: 'Maxon', slug: 'maxon', color: '#E5006D' },
];

// Чёрный/белый текст на цветной плитке по яркости фона.
function textOn(hex: string): string {
  const h = hex.replace('#', '');
  const r = parseInt(h.slice(0, 2), 16), g = parseInt(h.slice(2, 4), 16), b = parseInt(h.slice(4, 6), 16);
  const lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
  return lum > 0.62 ? '#1d1d1f' : '#ffffff';
}

const tracks = [
  {
    tag: 'Простой случай',
    title: 'Вендор принимает карту',
    text: 'Многие сервисы из ЕС и США оплачиваются банковской картой. Оформляем подписку, оплачиваем и передаём вам активированные доступы — быстро, без лишних шагов.',
    points: ['Быстрый старт', 'Оплата и активация на нашей стороне', 'Доступы — вашей команде'],
  },
  {
    tag: 'Сложный случай',
    title: 'Картой не оплатить',
    text: 'Часть вендоров работает только с зарубежными юрлицами и их счетами. Закупаем через счёт нашей компании за рубежом — вы получаете тот же сервис и полный пакет документов в России.',
    points: ['Закупка через зарубежный счёт компании', 'Тот же сервис без ограничений', 'Договор и закрывающие в РФ'],
  },
];

const outcomes = [
  { num: '01', title: 'Непрерывность работы', text: 'Специалисты остаются в привычных инструментах — проекты и процессы не встают из-за перехода на аналоги.' },
  { num: '02', title: 'Официальные расходы', text: 'Оплата по договору и счёту, закрывающие документы через ЭДО. Затраты учитываются в бухгалтерии.' },
  { num: '03', title: 'Мировой уровень инструментов', text: 'Доступ к сервисам, которые задают стандарт в дизайне, разработке и коммуникациях.' },
  { num: '04', title: 'Одна точка ответственности', text: 'Подбор, закупка, оплата, активация и поддержка на всём сроке подписки.' },
];

const steps = [
  { n: '1', t: 'Заявка', d: 'Рассказываете, какие сервисы и на сколько пользователей нужны.' },
  { n: '2', t: 'Расчёт и КП', d: 'Подбираем варианты, считаем стоимость и готовим коммерческое предложение.' },
  { n: '3', t: 'Договор и оплата', d: 'Заключаем договор, выставляем счёт и оплачиваем вендору.' },
  { n: '4', t: 'Активация и документы', d: 'Передаём доступы и закрывающие документы через ЭДО.' },
];
---
<BaseLayout
  title="BizSoft — Adobe, Figma, JetBrains и мировые сервисы для бизнеса по договору"
  description="Помогаем российским компаниям закупать и активировать зарубежные SaaS и ПО: Adobe, Figma, JetBrains, Miro, Zoom, OpenAI. Оплата картой или через счёт зарубежной компании, расходы по договору с закрывающими через ЭДО."
>
  <JsonLd schema={localBusinessSchema()} />

  <!-- HERO -->
  <section class="hero">
    <div class="container-page hero-grid">
      <div class="hero-content reveal is-visible">
        <span class="eyebrow">SaaS и ПО для бизнеса без границ</span>
        <h1>Команда остаётся в привычных инструментах — <span class="accent">закупку и оплату берём на себя</span></h1>
        <p class="hero-sub">
          Adobe, Figma, JetBrains, Miro, Zoom, OpenAI и сотни зарубежных сервисов для российских
          компаний. Оплачиваем картой, где вендор её принимает, и через счёт нашей зарубежной
          компании, где иначе не выйдет. Расходы идут по договору, закрывающие — через ЭДО.
        </p>
        <div class="hero-actions">
          <button class="btn btn-primary" data-open-question data-goal="hero_discuss">Обсудить задачу</button>
          <a href="/catalog/foreign" class="btn btn-ghost" data-goal="hero_catalog">Смотреть сервисы</a>
        </div>
        <ul class="hero-badges">
          <li>Оплата картой или через зарубежный счёт</li>
          <li>Расходы по договору и ЭДО</li>
          <li>Активация и поддержка на весь срок</li>
        </ul>
      </div>

      <!-- Hero-визуал: плитки узнаваемых приложений -->
      <div class="hero-media reveal is-visible" aria-hidden="true">
        <div class="tile-cloud">
          {brands.slice(0, 6).map((b, i) => (
            <span class={`app-tile t${i}`} style={`--bc:${b.color}; --tc:${textOn(b.color)}`}>{b.name.slice(0, 1)}</span>
          ))}
        </div>
      </div>
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
  </section>

  <!-- ЛОГОПАНЕЛЬ -->
  <section class="container-page logos-sec">
    <p class="logos-cap">Помогаем подключать сервисы, которыми пользуется весь мир</p>
    <Carousel label="Производители, которых мы подключаем" autoplay={2800} slideWidth="clamp(150px, 42vw, 190px)">
      {logoStrip.map((b) => (
        <a href={`/vendors/${b.slug}`} class="logo-chip" role="listitem">
          <span class="logo-badge" style={`--bc:${b.color}; --tc:${textOn(b.color)}`}>{b.name.slice(0, 1)}</span>
          <span class="logo-name">{b.name}</span>
        </a>
      ))}
    </Carousel>
  </section>

  <!-- ДВА ПУТИ ЗАКУПКИ -->
  <section class="container-page section">
    <SectionHeading num="01" eyebrow="Как это устроено" title="Два пути закупки — подбираем под вендора">
      <p>Способ оплаты зависит от того, как вендор принимает деньги. Оба пути ведут к легальной поставке с документами.</p>
    </SectionHeading>
    <div class="track-grid">
      {tracks.map((t, i) => (
        <div class="card track-card reveal">
          <span class="track-tag">{t.tag}</span>
          <div class="track-num" aria-hidden="true">{i + 1}</div>
          <h3>{t.title}</h3>
          <p>{t.text}</p>
          <ul class="track-points">
            {t.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ПРОМО-БАННЕР -->
  <section class="container-page section">
    <Banner
      variant="accent"
      eyebrow="Не нашли нужный сервис?"
      title="Подключим почти любой зарубежный SaaS или ПО"
      text="Работаем со всеми популярными вендорами и разбираем нестандартные запросы. Опишите задачу — подберём способ закупки и посчитаем стоимость."
      ctaLabel="Обсудить задачу"
      ctaHref="/contacts"
      ctaGoal="banner_discuss"
    />
  </section>

  <!-- ВЫГОДЫ -->
  <section class="container-page section">
    <SectionHeading num="02" eyebrow="Зачем это бизнесу" title="Устойчивость работы и прозрачные расходы">
      <p>Мы закрываем не разовую покупку, а непрерывный доступ к инструментам с корректным оформлением.</p>
    </SectionHeading>
    <div class="outcome-grid">
      {outcomes.map((o) => (
        <div class="card outcome-card reveal">
          <span class="section-num">/{o.num}</span>
          <h3>{o.title}</h3>
          <p>{o.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ПОПУЛЯРНЫЕ СЕРВИСЫ (карусель → лендинги) -->
  <section class="container-page section">
    <SectionHeading num="03" eyebrow="Популярное" title="Сервисы, которые подключают чаще всего">
      <p>Открывайте страницу сервиса — там тарифы, сравнение и оформление на юрлицо.</p>
    </SectionHeading>
    <Carousel label="Популярные сервисы" slideWidth="clamp(240px, 78vw, 300px)">
      {brands.map((b) => (
        <a href={`/vendors/${b.slug}`} class="card card-hover service-card" role="listitem" data-goal="home_service">
          <span class="logo-badge lg" style={`--bc:${b.color}; --tc:${textOn(b.color)}`}>{b.name.slice(0, 1)}</span>
          <h3>{b.name}</h3>
          <p>{b.blurb}</p>
          <span class="service-link">Открыть →</span>
        </a>
      ))}
    </Carousel>
    <p class="all-vendors"><a href="/vendors">Все производители →</a></p>
  </section>

  <!-- ПРОЦЕСС -->
  <section class="container-page section">
    <SectionHeading num="04" eyebrow="Процесс" title="От заявки до активации">
      <p>Прозрачный порядок работы: вы видите стоимость и получаете полный пакет документов.</p>
    </SectionHeading>
    <ol class="steps-grid">
      {steps.map((s) => (
        <li class="card step-card reveal">
          <span class="step-num">{s.n}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ФОРМА ОБРАТНОЙ СВЯЗИ -->
  <section class="container-page section contact-sec">
    <div class="contact-grid">
      <div class="reveal">
        <SectionHeading eyebrow="Связаться" title="Расскажите, чем пользуется команда">
          <p>Подберём способ закупки, посчитаем стоимость и подготовим коммерческое предложение. Отвечаем в рабочее время.</p>
        </SectionHeading>
        <ul class="contact-points">
          <li>Оформление на юрлицо: договор, счёт, закрывающие</li>
          <li>Оплата в рублях по безналичному расчёту</li>
          <li>Поддержка и продление на всём сроке подписки</li>
        </ul>
      </div>
      <LeadForm source="home" title="Оставить заявку" submitLabel="Отправить заявку" />
    </div>
  </section>

  <CTASection
    title="Готовы подобрать сервисы под вашу команду?"
    text="Оставьте заявку — рассчитаем стоимость, подготовим договор и счёт. Закрывающие документы через ЭДО."
    primaryLabel="Обсудить задачу"
    primaryHref="/contacts/"
    secondaryLabel="Смотреть сервисы"
    secondaryHref="/catalog/foreign/"
  />
  <QuestionForm source="home" />
</BaseLayout>

<style>
  .section { padding-top: clamp(3rem, 6vw, 5rem); }

  /* HERO */
  .hero { position: relative; overflow: hidden; padding: clamp(2.5rem, 7vw, 5.5rem) 0 clamp(2rem, 4vw, 3.5rem); }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 2.5rem; align-items: center; }
  .hero-content { max-width: 640px; }
  h1 { font-size: clamp(2rem, 5vw, 3.4rem); margin: 1rem 0 1.2rem; }
  .accent { color: var(--color-accent); }
  .hero-sub { font-size: clamp(1.03rem, 1.6vw, 1.2rem); color: var(--color-text-muted); max-width: 60ch; }
  .hero-actions { display: flex; gap: 0.8rem; margin: 2rem 0 1.5rem; flex-wrap: wrap; }
  .hero-badges { display: flex; gap: 0.6rem 1.4rem; list-style: none; padding: 0; margin: 0; flex-wrap: wrap; color: var(--color-text-muted); font-size: 0.9rem; }
  .hero-badges li { position: relative; padding-left: 1.1rem; }
  .hero-badges li::before { content: '●'; position: absolute; left: 0; color: var(--color-accent); font-size: 0.6rem; top: 0.35em; }
  .hero-glow {
    position: absolute; top: -30%; right: -10%; width: 60%; height: 120%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 62%);
    filter: blur(60px); z-index: 0; pointer-events: none;
  }
  /* Hero-визуал: облако плиток приложений */
  .hero-media { display: flex; justify-content: center; }
  .tile-cloud {
    position: relative; width: min(360px, 90%); aspect-ratio: 1 / 0.9;
    display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; gap: 1rem; place-items: center;
  }
  .app-tile {
    width: 100%; aspect-ratio: 1; border-radius: 22px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-size: clamp(1.4rem, 3vw, 2rem);
    background: var(--bc); color: var(--tc);
    box-shadow: var(--shadow);
  }
  .app-tile.t1 { transform: translateY(-14px) rotate(-4deg); }
  .app-tile.t2 { transform: translateY(10px) rotate(3deg); }
  .app-tile.t3 { transform: translateY(8px) rotate(4deg); }
  .app-tile.t4 { transform: translateY(-10px) rotate(-3deg); }
  @media (prefers-reduced-motion: reduce) { .app-tile { transform: none !important; } }

  /* Логопанель */
  .logos-sec { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .logos-cap { text-align: center; color: var(--color-text-dim); font-size: 0.9rem; margin-bottom: 1rem; }
  .logo-chip { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.9rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-bg-card); box-shadow: var(--shadow-sm); transition: border-color 0.18s ease, transform 0.18s ease; }
  .logo-chip:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  .logo-badge { width: 30px; height: 30px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.95rem; background: var(--bc); color: var(--tc); flex-shrink: 0; }
  .logo-name { font-weight: 600; font-size: 0.92rem; white-space: nowrap; }

  /* Два пути закупки */
  .track-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
  .track-card { padding: 1.9rem; position: relative; display: flex; flex-direction: column; gap: 0.6rem; }
  .track-tag { align-self: flex-start; font-size: 0.74rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent); background: var(--color-accent-soft); padding: 0.25rem 0.6rem; border-radius: 999px; }
  .track-num { position: absolute; top: 1.6rem; right: 1.8rem; font-size: 2.4rem; font-weight: 800; color: var(--color-border-strong); line-height: 1; }
  .track-card h3 { font-size: 1.35rem; margin-top: 0.3rem; }
  .track-card > p { color: var(--color-text-muted); }
  .track-points { list-style: none; padding: 0; margin: 0.4rem 0 0; display: grid; gap: 0.4rem; }
  .track-points li { padding-left: 1.5rem; position: relative; font-size: 0.92rem; }
  .track-points li::before { content: '✓'; position: absolute; left: 0; color: var(--color-accent); font-weight: 700; }

  /* Выгоды */
  .outcome-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.2rem; }
  .outcome-card { padding: 1.7rem; }
  .outcome-card h3 { font-size: 1.15rem; margin: 0.7rem 0 0.5rem; }
  .outcome-card p { color: var(--color-text-muted); font-size: 0.92rem; }

  /* Популярные сервисы */
  .service-card { padding: 1.6rem; display: flex; flex-direction: column; gap: 0.5rem; height: 100%; }
  .logo-badge.lg { width: 48px; height: 48px; border-radius: 12px; font-size: 1.5rem; margin-bottom: 0.5rem; }
  .service-card h3 { font-size: 1.25rem; }
  .service-card p { color: var(--color-text-muted); font-size: 0.92rem; flex-grow: 1; }
  .service-link { color: var(--color-accent); font-weight: 600; font-size: 0.9rem; }
  .all-vendors { margin-top: 1rem; }
  .all-vendors a { color: var(--color-accent); font-weight: 600; }

  /* Процесс */
  .steps-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.2rem; counter-reset: step; }
  .step-card { padding: 1.6rem; }
  .step-num { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 999px; background: var(--color-accent); color: #fff; font-weight: 700; margin-bottom: 0.7rem; }
  .step-card h3 { font-size: 1.1rem; margin-bottom: 0.4rem; }
  .step-card p { color: var(--color-text-muted); font-size: 0.92rem; }

  /* Контактная секция */
  .contact-grid { display: grid; grid-template-columns: 1fr 420px; gap: 2.5rem; align-items: start; }
  .contact-points { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.5rem; }
  .contact-points li { padding-left: 1.5rem; position: relative; color: var(--color-text-muted); }
  .contact-points li::before { content: '✓'; position: absolute; left: 0; color: var(--color-accent); font-weight: 700; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-media { order: -1; }
    .tile-cloud { width: min(300px, 80%); }
    .track-grid { grid-template-columns: 1fr; }
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>

---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from '../components/Carousel.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import VendorLogo from '../components/VendorLogo.astro';
import ProductRow from '../components/ProductRow.astro';
import PresetCards from '../components/PresetCards.astro';
import QuoteDialog from '../components/QuoteDialog.astro';
import SpecShelf from '../components/SpecShelf.astro';
import LeadForm from '../components/LeadForm.astro';
import QuestionForm from '../components/QuestionForm.astro';
import FAQ from '../components/FAQ.astro';
import JsonLd from '../components/JsonLd.astro';
import { SEO_EXPERIMENT_LINKS } from '../data/seo-experiments';
import { POPULAR_VENDORS } from '../data/popular';
import { site, seller } from '../config/site';
import { getCatalogFacets, getProductsBySlugs } from '../lib/directus';
import { getPresets, type ResolvedPreset } from '../lib/presets';
import { formatRub } from '../lib/pricing';
import type { Product } from '../lib/types';

// ─────────────────────────────────────────────────────────────────────────
// Главная перестроена 11.09.2026 по аудиту `docs/design/homepage-redesign/`.
//
// Что было: двенадцать секций одинакового веса, восемь карточных сеток
// подряд, сквозная нумерация /01…/06 с дробным /03•1, семь повторов
// «договор — счёт в рублях — ЭДО» и одно измеримое действие на всю
// страницу (добавление в подборку с восьми карточек). Кнопка «Получить
// КП» в шапке вела на пустую страницу подборки.
//
// Что стало (выбор руководителя — гибрид концепций B+C+A):
//   • короткое редакционное открытие вместо рекламного первого экрана;
//   • развилка из четырёх маршрутов — посетители с разной готовностью
//     идут разными путями, но все четыре дорожки рендерит сервер, и текст
//     неактивных остаётся в HTML (иначе основной SEO-текст стал бы
//     client-only и выпал из индекса);
//   • ритм задают сами блоки: реестр, карусель, строки, текст со схемой,
//     список с образцом КП, раскрывающиеся ответы — а не одна сетка;
//   • воронка стала измеримой по шагам: маршрут → позиция или набор →
//     подборка → КП → контакт, каждый шаг со своей целью.
//
// H1, title, description, ItemList вендоров и вся внутренняя перелинковка
// сохранены дословно: это точка отсчёта SEO-замера (см. раздел E аудита).
// ─────────────────────────────────────────────────────────────────────────

// Две узкие выборки вместо одной полной. Прежде главная брала весь каталог
// через getProducts() — с описаниями, SEO-текстами, характеристиками и
// вопросами по каждой позиции, — хотя ей нужны только счётчики и восемь
// строк. После истечения кэша первый запрос оплачивал всю выгрузку, и
// главная проваливалась по времени ответа: три подряд замера Lighthouse на
// одном и том же коде дали 52, 73 и 95 баллов. Теперь счётчики берутся из
// среза в два поля, карточки — по списку слагов, наборы — своим запросом.
const POPULAR_SLUGS = ['chatgpt-business', 'anthropic-team', 'ghcopilot-business', 'cursor-business', 'mscopilot-m365', 'gemini-workspace-standard', 'mj-standard', 'recraft-advanced'];

const [facets, popularRows, presets] = await Promise.all([
  getCatalogFacets().catch((e) => {
    console.error('home facets error', e);
    return [] as Awaited<ReturnType<typeof getCatalogFacets>>;
  }),
  getProductsBySlugs(POPULAR_SLUGS).catch((e) => {
    console.error('home popular error', e);
    return [] as Product[];
  }),
  getPresets().catch((e) => {
    console.error('home presets error', e);
    return [] as ResolvedPreset[];
  }),
]);

const facetSlug = (f: (typeof facets)[number]) => f.category?.slug ?? '';
const productCount = facets.length;
const vendorCount = new Set(facets.map((f) => f.vendor).filter(Boolean)).size;
const catCount = (pred: (s: string) => boolean) => facets.filter((f) => pred(facetSlug(f))).length;
const firstPresent = (slugs: string[]) => slugs.find((s) => facets.some((f) => facetSlug(f) === s));

const plural = (n: number, one: string, few: string, many: string) => {
  const d = n % 10, h = n % 100;
  if (d === 1 && h !== 11) return one;
  if ([2, 3, 4].includes(d) && ![12, 13, 14].includes(h)) return few;
  return many;
};

const tiles = [
  { icon: 'ai', name: 'AI-сервисы', href: '/catalog/ai', note: 'ChatGPT, Claude, Copilot, Midjourney', count: catCount((s) => s.startsWith('ai')) },
  { icon: 'design', name: 'Дизайн и графика', href: `/catalog/${firstPresent(['design', 'graphics-design']) || 'design'}`, note: 'Figma, Adobe, Canva, CorelDRAW', count: catCount((s) => ['design', 'graphics-design'].includes(s)) },
  { icon: 'develop', name: 'Разработка', href: `/catalog/${firstPresent(['developer-tools', 'development']) || 'development'}`, note: 'JetBrains, Unity, Unreal', count: catCount((s) => ['developer-tools', 'development'].includes(s)) },
  { icon: 'video', name: 'Видео и медиа', href: `/catalog/${firstPresent(['media']) || 'media'}`, note: 'DaVinci, Avid, Runway', count: catCount((s) => s === 'media') },
].filter((t) => t.count > 0);

// Порядок строк задаёт список выше: выборка по слагам возвращает записи в
// порядке базы, а витрина показывает бестселлеры в кураторском порядке.
const bySlug = new Map(popularRows.map((p) => [p.slug, p]));
const popular = POPULAR_SLUGS.map((s) => bySlug.get(s)).filter((p): p is Product => Boolean(p));
// Первый маршрут показывает короткий срез того же списка: он отвечает на
// «я знаю, что мне нужно», а не заменяет витрину ниже.
const routePicks = popular.slice(0, 5);

// Узнаваемые бренды для ItemList: список подключаемых сервисов со ссылками
// на лендинги — для поиска и ИИ-ответов (GEO/AEO).
const brands = [
  { name: 'Adobe', slug: 'adobe' },
  { name: 'Figma', slug: 'figma' },
  { name: 'JetBrains', slug: 'jetbrains' },
  { name: 'Miro', slug: 'miro' },
  { name: 'Zoom', slug: 'zoom' },
  { name: 'OpenAI', slug: 'openai' },
  { name: 'Canva', slug: 'canva' },
  { name: 'Autodesk', slug: 'autodesk' },
];

const servicesItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Зарубежные сервисы и ПО, которые подключает BIZSoft для юрлиц',
  description: 'Популярные зарубежные SaaS-сервисы и ПО, которые BIZSoft закупает и активирует для российских компаний по договору и счёту.',
  itemListElement: brands.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    url: `${site.url}/vendors/${b.slug}`,
  })),
};

const documents = [
  { t: 'Договор поставки', d: 'на ООО или ИП, с вашими реквизитами и предметом «право использования ПО»' },
  { t: 'Счёт в рублях', d: 'по курсу ЦБ на дату выставления, ставка НДС отдельной строкой' },
  { t: 'Акт и УПД через ЭДО', d: 'Диадок, СБИС, Контур; бумажный комплект — по запросу' },
  { t: 'Коммерческое предложение', d: 'состав, цены, срок действия и реквизиты поставщика одним документом' },
];

// Возражения закупщика. Тот же текст, что раньше лежал карточками «Снимаем
// риски», плюс два вопроса, которых на главной не было. Компонент FAQ даёт
// им разметку FAQPage — на главной её прежде не было вовсе.
const objections = [
  { q: 'Это законно?', a: 'Да: вы заключаете договор поставки с российским поставщиком и платите в рублях по безналичному расчёту. Валютных операций и зарубежных платежей у вашей компании не возникает — они остаются на стороне поставщика.' },
  { q: 'Не заблокируют ли аккаунт?', a: 'Оформляем официальные корпоративные тарифы на вашу команду и сопровождаем доступ весь срок подписки. Если у вендора возникают вопросы — решаем их мы.' },
  { q: 'Что будет при продлении?', a: 'Заранее напоминаем об окончании срока, выставляем счёт на новый период и продлеваем так, чтобы доступ команды не прерывался.' },
  { q: 'Как с НДС и закрывающими документами?', a: 'Выставляем счёт в рублях, передаём договор, акт и УПД через ЭДО — полный комплект для бухгалтерии. Ставка НДС указывается и в счёте, и в коммерческом предложении.' },
  { q: 'Сколько занимает поставка?', a: 'Расчёт и коммерческое предложение готовим в рабочий день обращения. После оплаты счёта доступы передаём за 1–3 рабочих дня; по вендорам, которые требуют закупки через зарубежный счёт, срок обсуждаем отдельно и называем до выставления счёта.' },
  { q: 'А если нужного сервиса нет в каталоге?', a: 'Подключаем почти любого зарубежного вендора, включая тех, кто не принимает карту. Назовите сервис в блоке «Не нашли нужный сервис» — ответим, как его закупить и сколько это выйдет.' },
];

const compareLinks = [
  { label: 'ChatGPT vs Claude: что выбрать бизнесу', href: '/compare/chatgpt-vs-claude' },
  { label: 'Cursor vs GitHub Copilot', href: '/compare/cursor-vs-copilot' },
  { label: 'Midjourney vs Adobe Firefly', href: '/compare/midjourney-vs-firefly' },
];
const kbLinks = [
  { label: 'Как оформить AI-подписку на юрлицо', href: '/blog/kak-oformit-korporativnuyu-ai-podpisku-na-yurlico' },
  { label: 'Enterprise или Team: чем отличаются тарифы', href: '/blog/enterprise-vs-team-korporativnye-tarify-ai' },
  { label: 'Безопасность данных в корпоративных AI', href: '/blog/bezopasnost-dannyh-v-korporativnyh-ai' },
];

const routes = [
  { id: 'known', tab: 'Знаю, что купить', hint: 'Найти сервис и добавить в подборку' },
  { id: 'task', tab: 'Нужно решение под задачу', hint: 'Готовые наборы под роль команды' },
  { id: 'legal', tab: 'Закупка на юрлицо', hint: 'Документы, НДС, ЭДО, сроки' },
  { id: 'choosing', tab: 'Ещё выбираю', hint: 'Сравнения и разборы перед покупкой' },
];
---
<BaseLayout
  title="BIZSoft — ПО и AI-сервисы для бизнеса: ChatGPT, Claude, Adobe, Figma, JetBrains"
  description="Единая точка доступа к зарубежному ПО и AI-сервисам для российских юрлиц: ChatGPT, Claude, Midjourney, Adobe, Figma, JetBrains. Договор, оплата в рублях по счёту, закрывающие через ЭДО, доступ за 1–3 дня."
  localBusiness
>
  <JsonLd schema={servicesItemList} />

  <!-- ОТКРЫТИЕ: короткое, без рекламного разворота и без декоративного свечения -->
  <section class="open">
    <div class="container-page">
      <p class="dateline">Закупка зарубежного ПО для российских компаний</p>
      <h1>Закупку зарубежного ПО <span class="accent">берём на себя</span></h1>
      <p class="standfirst">
        Команда остаётся в привычных инструментах: Adobe, Figma, JetBrains, ChatGPT, Claude
        и сотни зарубежных сервисов. Договор, счёт в рублях, закрывающие — через ЭДО.
      </p>
      <p class="byline">
        <!-- Якорь ведёт на витрину, только если она отрисована: блок
             бестселлеров требует минимум четырёх позиций с ценой, и при
             недоступной базе ссылка вела бы в пустоту. -->
        <a href={popular.length >= 4 ? '#popular' : '/catalog'} data-goal="home_catalog">Сразу к ценам и подборке →</a>
        {productCount > 0 && <span><b>{productCount}</b> {plural(productCount, 'позиция', 'позиции', 'позиций')} в каталоге</span>}
        {vendorCount > 0 && <span><b>{vendorCount}</b> {plural(vendorCount, 'вендор', 'вендора', 'вендоров')}</span>}
        <span>Поставщик — <b>{seller.shortName}</b>, ИНН {seller.inn}</span>
      </p>
    </div>
  </section>

  <!-- РАЗВИЛКА МАРШРУТОВ.
       Все четыре дорожки рендерит сервер; неактивные скрыты атрибутом
       hidden, а не отсутствуют в разметке: иначе основной текст про
       договор, ЭДО и НДС стал бы client-only и выпал бы из индекса. -->
  <section class="container-page routes">
    <h2 class="sr-only">С чего начать</h2>
    <div class="doors" role="tablist" aria-label="С чего начать">
      {routes.map((r, i) => (
        <button
          class:list={['door', { on: i === 0 }]}
          role="tab"
          id={`door-${r.id}`}
          aria-controls={`lane-${r.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-door={r.id}
        >
          <b>{r.tab}</b><span>{r.hint}</span>
        </button>
      ))}
    </div>

    <!-- Дорожка 1: знаю, что купить -->
    <div class="lane" id="lane-known" role="tabpanel" aria-labelledby="door-known" data-lane="known">
      <div class="lane-head">
        <div>
          <h2>Найдите сервис и добавьте в подборку</h2>
          <p>Цена за место в год, в рублях, по курсу ЦБ. Количество мест уточним в коммерческом предложении — сейчас это не нужно.</p>
        </div>
        <a href="/catalog" class="btn btn-ghost btn-sm" data-goal="home_catalog">Весь каталог →</a>
      </div>
      <form class="lane-search" action="/catalog" method="get" role="search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" name="q" placeholder="ChatGPT, Figma, JetBrains, Autodesk…" aria-label="Поиск по каталогу" />
        <button type="submit" class="btn btn-primary btn-sm">Найти</button>
      </form>
      {routePicks.length > 0 && (
        <ul class="rows">
          {routePicks.map((p) => <ProductRow product={p} />)}
        </ul>
      )}
    </div>

    <!-- Дорожка 2: решение под задачу -->
    <div class="lane" id="lane-task" role="tabpanel" aria-labelledby="door-task" data-lane="task" hidden>
      <div class="lane-head">
        <div>
          <h2>Готовые наборы под роль команды</h2>
          <p>Набор кладётся в подборку целиком одной кнопкой. Состав можно поменять — это черновик, а не заказ.</p>
        </div>
      </div>
      {presets.length > 0 ? (
        <PresetCards presets={presets} showAudience withQuote />
      ) : (
        <p class="lane-empty">Наборы сейчас недоступны — <a href="/catalog">соберите подборку из каталога</a>, и мы посчитаем её целиком.</p>
      )}
    </div>

    <!-- Дорожка 3: закупка на юрлицо -->
    <div class="lane" id="lane-legal" role="tabpanel" aria-labelledby="door-legal" data-lane="legal" hidden>
      <div class="lane-head">
        <div>
          <h2>Закупка выглядит как обычная поставка ПО</h2>
          <p>Договор с российским поставщиком, оплата в рублях по безналичному расчёту. Валютной операции у вашей компании не возникает.</p>
        </div>
      </div>
      <div class="legal-grid">
        <ul class="check-list">
          {documents.map((d) => <li><b>{d.t}</b> — {d.d}</li>)}
          <li><b>Корпоративные аккаунты</b> — доступы оформлены на команду, а не на личные карты сотрудников</li>
        </ul>
        <div class="card legal-side">
          <b>Посмотреть до разговора</b>
          <p>Условия поставки, реквизиты и порядок работы — открыто, без заявки.</p>
          <a href="/documents" class="btn btn-ghost btn-sm" data-goal="home_knowledge">Документы и реквизиты</a>
          <a href="/how-we-work" class="btn btn-ghost btn-sm" data-goal="home_knowledge">Как мы работаем</a>
          <p class="legal-note">Коммерческое предложение с вашими реквизитами формируется по подборке — соберите позиции и нажмите «Получить КП».</p>
        </div>
      </div>
    </div>

    <!-- Дорожка 4: ещё выбираю -->
    <div class="lane" id="lane-choosing" role="tabpanel" aria-labelledby="door-choosing" data-lane="choosing" hidden>
      <div class="lane-head">
        <div>
          <h2>Разборы, которые помогают решить до покупки</h2>
          <p>Сравнения тарифов и ответы на вопросы, которые задают перед первой закупкой. Без звонка и без реквизитов.</p>
        </div>
      </div>
      <div class="know-grid">
        <div>
          <p class="kcap">Сравнения сервисов</p>
          <div class="klist">
            {compareLinks.map((l) => <a href={l.href} data-goal="home_knowledge">{l.label} <span aria-hidden="true">→</span></a>)}
          </div>
        </div>
        <div>
          <p class="kcap">База знаний</p>
          <div class="klist">
            {kbLinks.map((l) => <a href={l.href} data-goal="home_knowledge">{l.label} <span aria-hidden="true">→</span></a>)}
          </div>
        </div>
        <div>
          <p class="kcap">Готовые решения</p>
          <div class="klist">
            <a href="/solutions" data-goal="home_knowledge">Подбор по задаче отдела <span aria-hidden="true">→</span></a>
            <a href="/cases" data-goal="home_knowledge">Как это работает у клиентов <span aria-hidden="true">→</span></a>
            <a href="/faq" data-goal="home_knowledge">Частые вопросы о закупке <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ПОЛОСА-ПОДПИСЬ: единственное место, где условия сказаны списком.
       Раньше этот же довод повторялся на странице семь раз. -->
  <div class="strip">
    <div class="container-page strip-inner">
      <span><b>Договор и счёт в ₽</b> — без валютных операций</span>
      <span><b>Закрывающие через ЭДО</b> — акт и УПД</span>
      <span><b>Поставка 1–3 дня</b> после оплаты</span>
      <span><b>С 2022 года</b> — {seller.shortName}</span>
    </div>
  </div>

  <!-- НАПРАВЛЕНИЯ: реестр в одной рамке, а не четыре отдельные карточки -->
  {tiles.length > 0 && (
    <section class="container-page section">
      <h2 class="h2">Каталог по направлениям</h2>
      <p class="sub">Счётчик живой: столько позиций с ценой в разделе прямо сейчас.</p>
      <div class="dirs">
        {tiles.map((t) => (
          <a href={t.href} class="dir" data-goal="home_category">
            <span class="dir-ico" aria-hidden="true"><CategoryIcon slug={t.icon} name={t.name} size={26} /></span>
            <em>{t.count}</em>
            <b>{t.name}</b>
            <span class="dir-note">{t.note}</span>
          </a>
        ))}
      </div>
      <p class="ps-links">
        <span class="ps-cap">Популярные сервисы для бизнеса:</span>
        {SEO_EXPERIMENT_LINKS.map((l) => <a href={`/vendors/${l.slug}`} data-goal="home_vendor">{l.anchor}</a>)}
      </p>
    </section>
  )}

  <!-- ЛОГОПАНЕЛЬ: настоящие знаки вендоров вместо декоративной графики -->
  <section class="container-page logos-sec">
    <p class="logos-cap">Помогаем подключать сервисы, которыми пользуется весь мир</p>
    <Carousel label="Производители, которых мы подключаем" autoplay={2600} slideWidth="clamp(200px, 60vw, 240px)">
      {POPULAR_VENDORS.map((b) => (
        <!-- role="listitem" живёт на обёртке, не на <a>: ARIA не допускает
             listitem у ссылки, роль затирала бы нативную link — скринридер и
             AI-агент переставали видеть чип как переход (аудит 30.08.2026). -->
        <div role="listitem">
          <a href={`/vendors/${b.slug}`} class="logo-chip" aria-label={`${b.name} — купить для юрлица`} data-goal="home_vendor">

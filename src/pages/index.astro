      <p class="sub">Подберём способ закупки, посчитаем стоимость и подготовим предложение. Отвечаем в рабочее время.</p>
      <LeadForm source="home" title="Оставить заявку" submitLabel="Отправить заявку" compact />
    </div>
  </section>

  <SpecShelf />
  <QuoteDialog />
  <QuestionForm source="home" />
</BaseLayout>

<style>
  .section { padding-top: clamp(2.6rem, 5vw, 4rem); }

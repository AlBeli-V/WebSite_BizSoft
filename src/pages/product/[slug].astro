</style>

<script>
  import { trackGoal, trackGoalOnce } from '@/lib/analytics';
  import { addToCart, readCart, removeFromCart } from '../../lib/cart-client';
  import { formatRub } from '../../lib/pricing';
  import { quoteCtaLabel, quoteProductRef, unitPhrase, type CommerceState } from '@/lib/product-commerce';
  // «Подробнее» у описания и подсказки блока фактов: по тычку на телефоне
  // кнопка фокус не получает, поэтому состояние держит aria-expanded.
  document.querySelector('[data-lede-toggle]')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const more = document.getElementById('lede-more');
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Свернуть' : 'Подробнее';
    if (more) more.hidden = !open;
  });
  document.querySelectorAll<HTMLButtonElement>('[data-hint]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = btn.getAttribute('aria-expanded') !== 'true';
      document.querySelectorAll('[data-hint]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('click', () => {
    document.querySelectorAll('[data-hint]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
  });

  // ── «Развернуть/Свернуть» длинного описания (Cut) ──
  document.querySelectorAll('[data-collapsible]').forEach((el) => {
    const box = el as HTMLElement;
    const btn = box.parentElement?.querySelector('[data-readmore]') as HTMLElement | null;
    if (!btn) return;
    if (box.scrollHeight > box.clientHeight + 4) {
      btn.hidden = false;
      btn.addEventListener('click', () => {
        const clamped = box.classList.toggle('clamped');
        btn.textContent = clamped ? 'Развернуть ▾' : 'Свернуть ▴';
      });
    }
  });

  // ── Количество + живой пересчёт (карточка покупки; у подарочной карты
  // свой блок с теми же data-атрибутами — его обслуживает GiftCardSelector) ──
  const layout = document.querySelector<HTMLElement>('.product-layout');
  let commerce: CommerceState | null = null;
  try { commerce = JSON.parse(layout?.dataset.commerce || 'null'); } catch { commerce = null; }
  // Вид позиции решает, называть ли в подписи расчётную единицу: у пополнения
  // баланса её нет, и «Получить КП на 1 лицензию» обещает не то, что покупают.
  const namedUnit = layout?.dataset.composition === 'unit_subscription';
  const minQty = Math.max(1, commerce?.minQty || 1);

  const buyCard = document.querySelector<HTMLElement>('.buy-card');
  const qtyInput = buyCard?.querySelector<HTMLInputElement>('[data-qty]') ?? null;
  const totalEl = buyCard?.querySelector<HTMLElement>('[data-total]') ?? null;
  const addBtn = buyCard?.querySelector<HTMLButtonElement>('[data-add-cart]') ?? null;
  const quoteBtns = Array.from(document.querySelectorAll<HTMLElement>('[data-quote-cta]'));
  const barTotal = document.querySelector<HTMLElement>('[data-bar-total]');
  const barQty = document.querySelector<HTMLElement>('[data-bar-qty]');
  const unit = commerce?.unitPrice || (addBtn ? Number(addBtn.dataset.price || 0) : 0);
  const itemName = quoteBtns[0]?.dataset.product || addBtn?.dataset.name || '';
  const itemSku = quoteBtns[0]?.dataset.sku || addBtn?.dataset.sku || '';

  // Первое осмысленное действие в карточке: между «открыл» и «оставил
  // заявку» до 12.09.2026 не было ни одного шага, и потерю не было видно.
  // Раз на страницу: дальше действия считаются своими целями.
  const schema = { analytics_schema_version: 'pcf_v3' };
  function interaction(kind: string) {
    trackGoalOnce('product_interaction', { ...schema, sku: itemSku, kind });
  }

  buyCard?.querySelectorAll<HTMLButtonElement>('[data-team]').forEach((b) => {
    b.addEventListener('click', () => {
      if (!qtyInput) return;
      qtyInput.value = b.dataset.team || String(minQty);
      interaction('team_preset');
      refresh();
    });
  });

  function curQty() {
    const n = Math.floor(Number(qtyInput?.value || minQty) || minQty);
    return Math.max(minQty, n);
  }

  // Подпись призыва и позиция заявки считаются той же функцией, что и на
  // сервере: два правила на одну кнопку разъехались бы при первой правке.
  function refresh() {
    const q = curQty();
    if (totalEl) totalEl.textContent = formatRub(unit * q);
    if (barTotal) barTotal.textContent = formatRub(unit * q);
    if (barQty && commerce) barQty.textContent = namedUnit ? unitPhrase(q, commerce.qtyLabel) : `${q} шт.`;
    if (!commerce) return;
    for (const b of quoteBtns) {
      b.dataset.ref = quoteProductRef(itemName, itemSku, commerce, q, namedUnit);
      if (b.dataset.ctaShort === undefined) b.textContent = quoteCtaLabel(commerce, q, namedUnit);
    }
  }

  buyCard?.querySelector('[data-inc]')?.addEventListener('click', () => {
    if (!qtyInput) return;
    qtyInput.value = String(curQty() + 1);
    interaction('qty');
    refresh();
  });
  buyCard?.querySelector('[data-dec]')?.addEventListener('click', () => {
    if (!qtyInput) return;
    qtyInput.value = String(Math.max(minQty, curQty() - 1));
    interaction('qty');
    refresh();
  });
  qtyInput?.addEventListener('input', () => { interaction('qty'); refresh(); });
  // Ввод руками ниже минимума поправляется по уходу из поля: пока фокус в
  // поле, подмена цифры под пальцами мешает печатать.
  qtyInput?.addEventListener('blur', () => { if (qtyInput) qtyInput.value = String(curQty()); refresh(); });
  refresh();

  // Раскрытый вопрос и развёрнутое описание — тоже осмысленные действия:
  // человек ищет ответ, а не просто скроллит.
  document.querySelectorAll('.faq-item').forEach((d) => {
    d.addEventListener('toggle', () => { if ((d as HTMLDetailsElement).open) interaction('faq'); });
  });
  document.querySelector('[data-readmore]')?.addEventListener('click', () => interaction('description'));

  // ── Липкая полоса призыва ───────────────────────────────────────────
  // Появляется, когда призыв первого экрана ушёл из виду, и прячется, когда
  // он снова виден: две одинаковые кнопки на одном экране спорят друг с
  // другом. Без IntersectionObserver полоса просто не показывается.
  const heroCta = document.querySelector<HTMLElement>('.buy-cta');
  const buyBar = document.querySelector<HTMLElement>('[data-buy-bar]');
  if (heroCta && buyBar && typeof IntersectionObserver === 'function') {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) buyBar.hidden = e.isIntersecting;
    }, { rootMargin: '-8px 0px 0px 0px' });
    io.observe(heroCta);
  }

  // Просмотр карточки: знаменатель для добавлений в подборку. Без него
  // «добавили 3 раза» не говорит ничего — 3 из 5 и 3 из 500 разные вещи.
  const giftRoot = document.querySelector<HTMLElement>('[data-gift-card]');
  trackGoal('view_product', {
    ...schema,
    sku: itemSku || giftRoot?.dataset.sku || '',
    slug: addBtn?.dataset.slug || location.pathname,
  });

  // ── Подборка для КП ────────────────────────────────────────────────
  // Действие обратимое: пока позиция в подборке, флажок зажжён, а кнопка
  // предлагает исключить. Одноразовое «Добавлено ✓» не давало ни состояния,
  // ни способа передумать — покупатель шёл искать корзину.
  const collCheck = document.querySelector<HTMLInputElement>('[data-coll-check]');
  const collLabel = document.querySelector<HTMLElement>('[data-coll-label]');

  function inCollection(): boolean {
    return readCart().some((i) => i.sku === (addBtn?.dataset.sku || ''));
  }
  function paintCollection() {
    const on = inCollection();
    if (collCheck) collCheck.checked = on;
    if (collLabel) collLabel.textContent = on ? 'Исключить из подборки' : 'Добавить в подборку';
    // Диагональ на знаке — второй, не словесный признак состояния.
    addBtn?.classList.toggle('is-in', on);
  }
  function toggleCollection() {
    if (!addBtn) return;
    if (inCollection()) {
      removeFromCart(addBtn.dataset.sku!);
    } else {
      addToCart({ sku: addBtn.dataset.sku!, slug: addBtn.dataset.slug!, name: addBtn.dataset.name!, price: unit }, curQty());
      trackGoal('add_to_cart', { ...schema, sku: addBtn.dataset.sku || '' });
    }
    paintCollection();
  }
  addBtn?.addEventListener('click', toggleCollection);
  // Флажок — вторая точка входа в то же действие: клик по нему не должен
  // менять отметку сам по себе, иначе она разъедется с содержимым подборки.
  collCheck?.addEventListener('click', (e) => { e.preventDefault(); toggleCollection(); });
  paintCollection();
  window.addEventListener('cart:change', paintCollection);

  // ── Подарочная карта: выбор номинала из региональных списков → селектор ──
  document.querySelectorAll<HTMLButtonElement>('[data-pick-sku]').forEach((b) => {
    b.addEventListener('click', () => {
      const sku = (b.dataset.pickSku || '').toUpperCase();
      const target = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gift-card] [data-variant]'))
        .find((v) => (v.dataset.sku || '').toUpperCase() === sku);
      if (!target) return;
      const panel = target.closest<HTMLElement>('[data-region-panel]');
      const regionBtn = panel ? document.querySelector<HTMLButtonElement>(`[data-gift-card] [data-region="${panel.dataset.regionPanel}"]`) : null;
      regionBtn?.click();
      target.click();
      document.querySelector('[data-gift-card]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // ── Лайтбокс галереи ──
  const lb = document.querySelector('[data-lightbox]') as HTMLElement | null;
  const lbImg = document.querySelector('[data-lb-img]') as HTMLImageElement | null;
  const thumbs = Array.from(document.querySelectorAll('[data-full]')) as HTMLElement[];
  let cur = 0;
  function show(i: number) {
    if (!lb || !lbImg || thumbs.length === 0) return;
    cur = (i + thumbs.length) % thumbs.length;
    lbImg.src = thumbs[cur].dataset.full!;
    lb.hidden = false;
  }
  thumbs.forEach((t, i) => t.addEventListener('click', () => show(i)));
  document.querySelector('[data-lb-close]')?.addEventListener('click', () => { if (lb) lb.hidden = true; });
  document.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(cur - 1));
  document.querySelector('[data-lb-next]')?.addEventListener('click', () => show(cur + 1));
  lb?.addEventListener('click', (e) => { if (e.target === lb) lb.hidden = true; });
  document.addEventListener('keydown', (e) => {
    if (!lb || lb.hidden) return;
    if (e.key === 'Escape') lb.hidden = true;
    if (e.key === 'ArrowLeft') show(cur - 1);
    if (e.key === 'ArrowRight') show(cur + 1);
  });
</script>

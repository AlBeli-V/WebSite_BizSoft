  .ai-interlinks { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 1.2rem; }
  .ai-interlinks h3 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-dim); margin-bottom: 0.6rem; }
  .ai-interlinks ul { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .ai-interlinks a { color: var(--color-accent); font-weight: 600; font-size: 0.92rem; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 0.8rem; }

  .specs { width: 100%; border-collapse: collapse; }
  .specs th, .specs td { text-align: left; padding: 0.55rem 0.8rem; border-bottom: 1px solid var(--color-border); font-size: 0.93rem; }
  .specs th { color: var(--color-text-muted); font-weight: 500; width: 40%; }
  .steps { padding-left: 1.2rem; color: var(--color-text); display: grid; gap: 0.5rem; }
  /* Цена и призыв в первом экране. На широком экране их держит липкая
     карточка покупки справа — блок нужен там, где её рядом нет. */
  .hero-buy { display: none; }
  .hb-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
  .hb-price b { font-size: 1.6rem; font-variant-numeric: tabular-nums; }
  .hb-note { color: var(--color-text-muted); font-size: 0.85rem; }
  .hb-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; margin-top: 0.9rem; }
  .hb-actions .btn { width: 100%; }
  .hb-link { color: var(--color-accent); font-weight: 600; font-size: 0.9rem; }
  .qty-check { margin: 0; color: var(--color-text-muted); font-size: 0.82rem; }
  /* Второстепенное действие — ссылкой, а не третьей кнопкой: спорить с
     главным призывом оно не должно. */
  .btn-link { background: none; border: none; padding: 0; font: inherit; font-size: 0.9rem; font-weight: 600; color: var(--color-accent); cursor: pointer; align-self: center; }
  .deal-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 1.4rem; }
  .deal-col h3 { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-dim); margin-bottom: 0.6rem; }
  .deal-col .features li { font-size: 0.92rem; }
  .deal .muted { margin-top: 1.2rem; }
  /* Липкая полоса призыва (узкий экран). Показывает её скрипт, когда призыв
     первого экрана уходит из виду. */
  .buy-bar { display: none; }
  .product-aside { position: sticky; top: 124px; }
  .buy-card { padding: 1.6rem; display: flex; flex-direction: column; gap: 1rem; }
  .price-req { font-weight: 800; font-size: 1.5rem; }
  .price-min { display: flex; flex-direction: column; gap: 0.3rem; }
  .price-min b { font-size: 1.9rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .price-min .promo-label { align-self: flex-start; background: color-mix(in srgb, var(--color-accent) 18%, transparent); color: var(--color-accent); font-size: 0.72rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 6px; }

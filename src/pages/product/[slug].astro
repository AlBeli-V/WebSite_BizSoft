  .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.12); border: none; color: #fff; font-size: 2rem; width: 48px; height: 48px; border-radius: 999px; cursor: pointer; }
  .lb-prev { left: 1rem; } .lb-next { right: 1rem; }

  @media (max-width: 1100px) {
    .product-layout { column-gap: 2.2rem; grid-template-columns: minmax(0, 1fr) 330px; }

---
import { getCollection } from 'astro:content';
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import QuestionForm from '../../components/QuestionForm.astro';
import JsonLd from '../../components/JsonLd.astro';
import OfferLogisticsMicrodata from '../../components/OfferLogisticsMicrodata.astro';
import { getProductBySlug, findCanonicalProductSlug, getProductsBySlugs, getProductsBySkus, getProductVariants, getProducts, galleryImages , getCurrencyRate } from '../../lib/directus';
import { isSourceUnavailable, serviceUnavailable } from '../../lib/http';
import { productSchema, giftCardProductSchema, canonicalUrl } from '../../lib/seo';
import { effectivePrice, formatRub } from '../../lib/pricing';
import { LICENSE_LABEL, listValues } from '../../lib/types';
import { vendorLegal, productNoindex, isGiftCard, isVariant } from '../../lib/catalog';
import { groupGiftCardVariants, giftCardPriceRange, pickInitialVariant, variantLabel, formatDenomination, type GiftCardRegion } from '../../lib/gift-cards';
import { giftCardContent } from '../../data/gift-cards';
import GiftCardSelector from '../../components/GiftCardSelector.astro';
import { getAiInterlinks } from '../../data/ai-interlinks';
import { productIcons } from '../../data/product-icons';
import ProductIcon from '../../components/ProductIcon.astro';
import VendorLogo from '../../components/VendorLogo.astro';
import CollectionMark from '../../components/CollectionMark.astro';
import { vendorContent } from '../../data/vendor-content';
import { vendorSlug } from '../../lib/vendor-links';
import { vendorBySlug } from '../../data/vendors';
import { commerceState, quoteCtaLabel, quoteProductRef, unitNoun, unitPhrase, qtyPresets, unitPlural } from '../../lib/product-commerce';
import { planType, PLAN_MARKER, PLAN_MARKER_UNIVERSAL, PLAN_SHORT } from '../../lib/plan-type';
import { cardComposition, KIND_MARKER } from '../../lib/product-composition';
import { displayName, termLabel, TERM } from '../../lib/card-display';
import { parseSku } from '../../lib/sku';
import { FACT_HEADS, factTerm, factMin, factTransfer, splitLede, creditsLabel } from '../../lib/card-facts';
import { PROCUREMENT_FLOW, TRUST_LINES } from '../../data/policies';
import { seller } from '../../config/site';

const { slug } = Astro.params;

let product = null;
try {
  product = await getProductBySlug(slug!);
} catch (e) {
  // Сбой БД — это не «товара нет». Отдать 404 значит попросить робота
  // выкинуть живую страницу из индекса; отдаём 503, см. lib/http.ts.
  console.error('product page error', e);
  if (isSourceUnavailable(e)) return serviceUnavailable();
}
if (!product) {
  // 301 со старого slug на актуальный, если задан в old_slugs
  try {
    const canonical = await findCanonicalProductSlug(slug!);
    if (canonical) return Astro.redirect(`/product/${canonical}`, 301);
  } catch (e) {
    console.error('product redirect lookup', e);
    if (isSourceUnavailable(e)) return serviceUnavailable();
  }
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Отечественное ПО убрано с сайта — страницы таких товаров недоступны.
if (product.origin === 'domestic') {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Вариант (номинал подарочной карты) своей страницы не имеет: отдельный
// адрес на каждый номинал — те же дубли, что у пакетов кредитов. Отдаём 301
// на родительскую карточку с уже выбранным вариантом (?sku=…); canonical
// у неё без параметров, поэтому в индекс идёт один адрес.
if (isVariant(product)) {
  try {
    const [parent] = await getProductsBySkus([product.parent_sku!]);
    if (parent) return Astro.redirect(`/product/${parent.slug}?sku=${encodeURIComponent(product.sku)}`, 301);
  } catch (e) {
    console.error('variant parent lookup', e);
    if (isSourceUnavailable(e)) return serviceUnavailable();
  }
}

// Подарочная карта: варианты (регион + номинал) — из Directus, порядок и
// группировку задаёт lib/gift-cards.ts; редакторские разделы — data/gift-cards.ts.
const isGift = isGiftCard(product);
let giftRegions: GiftCardRegion[] = [];
if (isGift) {
  try {
    giftRegions = groupGiftCardVariants(await getProductVariants(product.sku));
  } catch (e) {
    console.error('gift card variants', e);
    if (isSourceUnavailable(e)) return serviceUnavailable();
  }
}
const giftRange = isGift ? giftCardPriceRange(giftRegions) : null;
const giftInitial = isGift ? pickInitialVariant(giftRegions, Astro.url.searchParams.get('sku')) : null;
const gift = isGift ? giftCardContent(product.slug) : undefined;

const eff = effectivePrice(product);
const category = typeof product.category === 'object' ? product.category : null;
const features = Array.isArray(product.features)
  ? product.features.map((f) => (typeof f === 'string' ? f : (f as { value?: string }).value)).filter(Boolean)
  : [];
// У подарочной карты вопросы из редакторского модуля; у остальных — из Directus.
const catalogFaq = Array.isArray(product.faq) ? product.faq : [];
const gallery = galleryImages(product);
const vat = product.vat_percent ?? 0;
const byRequest = product.price <= 0 && !eff.isPromo;

// ── Коммерческая модель позиции ──────────────────────────────────────
// Минимальный объём заказа и подпись единиц ведутся в контенте вендора
// (VendorCardMeta) и до 12.09.2026 работали только на лендинге: карточка
// товара показывала цену одного места там, где заказ идёт от двух, и
// счётчик разрешал единицу. Ключ меты — slug или sku (правило catalog.md).
const vendorCards = product.vendor ? vendorContent(vendorSlug(product.vendor)).cards : undefined;
const cardMeta = vendorCards?.[product.slug] ?? vendorCards?.[product.sku];
// Вопросы карточки: каталог первичен. Когда в позиции их нет, берутся
// вопросы из контента вендора — иначе раздел, согласованный на макете,
// просто не выводится.
const commerce = commerceState({
  price: eff.price,
  priceFrom: product.price_from,
  availability: product.availability,
  minQty: cardMeta?.minQty,
  // Единица без указания вендора: у подписки — рабочее место, у бессрочной
  // лицензии — лицензия (решение руководителя 13.09.2026: «1 рабочее место,
  // 1 календарный год» у годовых подписок, «бессрочно» у лицензий).
  qtyLabel: cardMeta?.qtyLabel || (/\bPERP\b|бессрочн|вечная лицензия/i.test(`${product.sku} ${product.name}`) ? 'Лицензий' : 'Рабочих мест'),
  check: cardMeta?.check,
});
// ── Вид позиции ──────────────────────────────────────────────────────
// Эталонная композиция (счётчик расчётных единиц, минимальный заказ, «что
// входит в план») годится подписке за расчётную единицу. Пополнение
// баланса, номинал и дополнение к основному продукту устроены иначе, и
// переносить на них ту же подачу нельзя: у номинала нет рабочих мест, у
// дополнения главный вопрос — к чему оно. Вид берётся из данных.
const composition = cardComposition(product);
const isUnitPlan = composition === 'unit_subscription';

// Подпись призыва и позиция заявки считаются из состояния, а не пишутся в
// разметке: то же правило потом повторяет клиентский скрипт при смене
// счётчика, и разойтись им не с чего.
const faq = gift ? gift.faq : (catalogFaq.length > 0 ? catalogFaq : (cardMeta?.faq ?? []));

const ctaLabel = quoteCtaLabel(commerce, commerce.minQty, isUnitPlan);
const ctaRef = quoteProductRef(product.name, product.sku, commerce, commerce.minQty, isUnitPlan);

// ── Подача первого экрана ────────────────────────────────────────────
// Тип плана — коммерческий маркер («Командный», «Индивидуальный»), а не
// ответ на вопрос «кому можно пользоваться»: тот даёт license_type и живёт
// в параметрах. Поля в каталоге нет, эвристика по названию и описанию —
// это DATA GAP, поэтому маркер не показывается, когда уверенности нет.
// Разметка оператора (VendorCardMeta.marker) старше эвристики: тип плана по
// названию угадывается не всегда, и подставлять догадку нельзя.
const markerOverride = cardMeta?.marker;
const planKind = markerOverride === 'team' ? 'team'
  : markerOverride === 'individual' ? 'individual'
  : (markerOverride ? null : planType(product.name, product.short_description || '', product.sku));
const planMarker = planKind ? PLAN_MARKER[planKind] : '';
const planShort = planKind ? PLAN_SHORT[planKind] : '';

// Первая плашка называет вид позиции (правило docs/rules/product-markers.md):
// у пополнения — «Универсальный продукт», у дополнения — «Дополнение к
// продукту», у подписки — тип плана. Тип плана данными не выводится, и там,
// где он не подтверждён, стоит «Универсальный план»: деления на командный и
// индивидуальный у таких позиций нет вовсе, а угадывать его по названию
// нельзя — это уже дало «Командный план · VFX и моушн» на Red Giant.
const kindMarker = markerOverride === 'universal' ? KIND_MARKER.balance_topup
  : markerOverride === 'addon' ? KIND_MARKER.addon
  : KIND_MARKER[composition] ?? '';
const primaryMarker = kindMarker || planMarker || PLAN_MARKER_UNIVERSAL;

// Вторая плашка — одна основная категория. У пополнения и дополнения это
// основная категория производителя (реестр vendors.ts): сама позиция —
// надстройка над его продуктом, и своя категория у неё бывает служебной.
const vendorCatEntry = product.vendor ? vendorBySlug(vendorSlug(product.vendor)) : undefined;
const categoryMarker = (kindMarker && vendorCatEntry?.catLabel && vendorCatEntry?.catSeg)
  ? { name: vendorCatEntry.catLabel, slug: vendorCatEntry.catSeg }
  : category ? { name: category.name, slug: category.slug } : null;
const unitName = unitNoun(commerce.qtyLabel);
// Строка под заголовком — тип плана и срок (правило docs/rules/card-title.md).
// Тип плана: командный, индивидуальный, а без деления — универсальный; у
// пополнения — тоже «Универсальный план». Срок считает termLabel из данных
// позиции: явный срок в названии и артикуле, бессрочность, вид позиции;
// подписка без явного срока — годовая, у пополнения — «до истечения
// баланса», у договорной позиции срока нет. Плашка `badge` в строку не
// идёт: это тематическая подпись линейки, от неё получалось
// «Командный план · VFX и моушн».
const planLine = planMarker || PLAN_MARKER_UNIVERSAL;
const term = termLabel(product, composition);
const subtitleParts = [planLine, term].filter(Boolean) as string[];

// Блок фактов под описанием (правило docs/rules/card-lede-facts.md): три
// колонки у любой позиции — срок действия плана, минимальное количество,
// возможность переназначения. Значения — из данных карточки: срок тот же,
// что в строке под заголовком, минимум — из контента вендора (по умолчанию
// 1), переназначение — по типу плана и виду позиции; отметка оператора
// (VendorCardMeta.reassign) старше правила.
// Минимум у пополнения — наименьший номинал линейки: у подарочной карты — в
// регионе, выбранном на карточке; у пакета кредитов — среди пакетов той же
// линейки (артикулы одной линейки: всё до варианта-номинала). Иначе — «50 $/€».
let balanceMin: string | null = null;
if (isGift && giftInitial) {
  const region = giftRegions.find((r) => r.variants.some((v) => v.sku === giftInitial.sku));
  const least = region?.variants.reduce((a, v) => (v.denomination < a.denomination ? v : a), region.variants[0]);
  if (least) balanceMin = formatDenomination(least);
} else if (term === TERM.balance && parseSku(product.sku)?.kind === 'CRD' && parseSku(product.sku)?.variant) {
  // Линейка номиналов: всё до варианта (<…>-CRD-<продукт>-UNI-BAL-NOM-).
  const prefix = product.sku.slice(0, product.sku.lastIndexOf('-') + 1);
  try {
    const packs = (await getProducts({ vendor: product.vendor || undefined })).filter((p) => p.sku.startsWith(prefix));
    const least = Math.min(...packs.map((p) => Number(p.sku.slice(prefix.length))).filter(Number.isFinite));
    if (Number.isFinite(least)) balanceMin = creditsLabel(least, product.name);
  } catch { /* линейка недоступна — остаётся умолчание */ }
}
const factValues: Record<'term' | 'min' | 'transfer', string> = {
  term: factTerm(term),
  min: factMin(composition, commerce.minQty, term, balanceMin),
  transfer: factTransfer(composition, planKind, cardMeta?.reassign),
};
const heroFacts = FACT_HEADS.map((h) => ({ ...h, value: factValues[h.key] }));

// Описание: видимая часть — первый абзац или первые предложения, остальное
// раскрывается по «Подробнее». В разметке текст целиком.
const lede = splitLede(product.short_description || '');

// Зона «за что» у цены — три пункта справа от суммы (правило
// docs/rules/card-price-block.md): единица с минимумом в скобках
// («1 рабочее место (от 2)»), срок («1 календарный год», «бессрочно»,
// «до истечения»), тип плана. Категория сюда не идёт.
const priceWhat: string[] = [];
if (!byRequest) {
  if (isUnitPlan) priceWhat.push(unitPhrase(1, commerce.qtyLabel) + (commerce.minQty > 1 ? ` (от ${commerce.minQty})` : ''));
  if (term === TERM.balance) priceWhat.push('до истечения');
  else if (term === TERM.year) priceWhat.push('1 календарный год');
  else if (term) priceWhat.push(term);
  priceWhat.push(planLine);
}

// Ступени объёма: 2, 3, 5, 10, 20 с учётом минимума (product-commerce.ts).
const qtySteps = qtyPresets(commerce.minQty);

// Письмо специалисту с готовой темой и началом текста: человеку остаётся
// назвать компанию и дописать вопрос.
const askSubject = `Запрос на уточнение информации с сайта BIZSoft от компании ….`;
const askBody = `Добрый день,\n\nПросим уточнить `;
const askHref = `mailto:${seller.salesEmail}?subject=${encodeURIComponent(askSubject)}&body=${encodeURIComponent(askBody)}`;

// ── Путь до карточки ─────────────────────────────────────────────────
// Правило docs/rules/breadcrumbs.md: путь карточки всегда из трёх уровней —
// Главная → Производитель → Продукт. Карточку покупатель выбирает у
// производителя, туда же возвращается сравнивать редакции; раздел каталога
// остаётся маркером над заголовком и строкой в параметрах.
//
// Раздел «Каталог» в пути появляется единственным случаем: у позиции не
// заполнен вендор. Это дефект данных, а не композиция — иначе путь оборвётся
// на главной. Страница производителя при этом всегда существует: лендинг
// собирается и по живым позициям каталога, а у вендора с карточкой их как
// минимум одна.
const vendorPageSlug = product.vendor ? vendorSlug(product.vendor) : '';
const vendorEntry = vendorPageSlug ? vendorBySlug(vendorPageSlug) : undefined;
const vendorCrumb = product.vendor
  ? { name: vendorEntry?.title || vendorEntry?.vendor || product.vendor, url: `/vendors/${vendorPageSlug}` }
  : null;
let rateDate: string | null = null;
try {
  const rate = await getCurrencyRate();
  if (rate?.rate_date) rateDate = new Date(rate.rate_date).toLocaleDateString('ru-RU');
} catch { /* индикатор курса просто не показываем */ }

// Архитектурные блоки масштабирования
const useCases = listValues(product.use_cases);
const relatedSlugs = listValues(product.related_products);
// Динамическая нижняя часть (13.09.2026): модули из Directus заменяют
// «Что входит», «Подробно о продукте» и seo_text. Пустое поле — legacy-ветка
// без изменений: откат = обнулить content_modules.
const modules = Array.isArray(product.content_modules) ? product.content_modules.filter((m) => m && m.code && m.title) : [];
const hasModules = modules.length > 0 && !gift;
const moduleLinkSlugs = [...new Set(modules.flatMap((m) => [...(m.links || []), ...((m.items || []).map((i) => i.link).filter(Boolean) as string[])]))];
const moduleLinkNames: Record<string, string> = {};
if (moduleLinkSlugs.length) {
  for (const lp of await getProductsBySlugs(moduleLinkSlugs)) moduleLinkNames[lp.slug] = lp.name;
}
const nameOf = (s: string) => moduleLinkNames[s] || s;
const proseParas = (m: { body?: string }) => (m.body || '').split(/\n{2,}/).filter(Boolean);
const compareCols = (m: { rows?: { values: Record<string, string> }[] }) => {
  const cols = new Set<string>([product.slug]);
  for (const r of m.rows || []) for (const k of Object.keys(r.values || {})) cols.add(k);
  return [...cols];
};
let relatedProducts: Awaited<ReturnType<typeof getProductsBySlugs>> = [];
try {
  if (relatedSlugs.length) relatedProducts = await getProductsBySlugs(relatedSlugs);
} catch (e) {
  console.error('related products', e);
}

// Перелинковка AI-карточки (сравнения / статьи / категория) — только для AI-вендоров.
const aiLinks = product.vendor ? getAiInterlinks(product.vendor) : null;

// Товарная разметка. JSON-LD — для Google и общих потребителей; ниже в
// шаблоне тот же товар продублирован microdata-слоем для Яндекса (его
// справка гарантирует обработку товарной разметки только в microdata,
// и только microdata показывает валидатор Вебмастера). Оба слоя строятся
// из одних данных (effectivePrice + Directus) — расходиться им не с чего;
// согласованность закреплена смоук-проверкой. Для «цены по запросу»
// productSchema возвращает null — товарной разметки нет ни в одном слое.
// Подарочная карта — один Product с AggregateOffer по вариантам (без Product
// на каждый номинал); диапазон — из тех же вариантов, что видит покупатель.
const productLd = isGift
  ? giftCardProductSchema(product, giftRange, { images: gallery.map((g) => g.url) })
  : productSchema(product, { images: gallery.map((g) => g.url) });
const canonicalProductUrl = canonicalUrl(`/product/${product.slug}`);
const microImage = gallery.length > 0 ? gallery[0].url : canonicalUrl('/og-default.png');
// Наборы microdata-атрибутов: у «цены по запросу» пустые — атрибуты не
// выводятся вовсе, страница остаётся без товарной microdata.
// У подарочной карты microdata есть только при наличии диапазона (как и JSON-LD).
const hasMd = isGift ? productLd !== null : !byRequest;
// itemid у microdata-слоя не ставится намеренно. Google связывает узлы
// разных синтаксисов по общему идентификатору (@id ≡ itemid) и склеивает их
// в одну сущность: при itemid = @id JSON-LD у объединённого товара каждое
// поле приходило дважды, и Search Console закрывала карточку ошибкой
// «Поле "brand" дублируется» (01.09.2026, /product/mj-standard). Слои обязаны
// оставаться двумя независимыми сериализациями одного товара — JSON-LD для
// Google, microdata для Яндекса, — поэтому общего идентификатора у них нет.
const mdProduct = hasMd
  ? { itemscope: true, itemtype: 'https://schema.org/Product' }
  : {};
// Заголовок — имя продукта без маркеров плана и срока (правило
// docs/rules/card-title.md): «Cinema 4D 1Y (Teams)» → «Cinema 4D», план и
// срок стоят строкой ниже. Короткое имя из контента вендора старше правила.
// Когда H1 отличается от названия каталога, itemprop="name" уезжает с
// заголовка в отдельный meta: иначе microdata назвала бы товар иначе, чем
// JSON-LD, и слои разошлись бы (смоук-проверка их сверяет).
const h1Text = cardMeta?.shortName || displayName(product.name);
const mdName = hasMd && h1Text === product.name ? { itemprop: 'name' } : {};
const mdDesc = hasMd && product.short_description ? { itemprop: 'description' } : {};
const mdOffer = hasMd
  ? { itemprop: 'offers', itemscope: true, itemtype: isGift ? 'https://schema.org/AggregateOffer' : 'https://schema.org/Offer' }
  : {};

// Обратная перелинковка «карточка → статья»: берём статьи, которые сами
// ссылаются на этот товар через relatedProducts, — связь описывается один раз
// во frontmatter статьи и работает для любого вендора, не только AI.
let blogLinks: { id: string; title: string }[] = [];
try {
  const posts = await getCollection('blog', ({ data }) => !data.draft && !data.noindex);
  blogLinks = posts
    .filter((p) => (p.data.relatedProducts || []).includes(product.slug))
    .map((p) => ({ id: p.id, title: p.data.title }));
} catch (e) {
  console.error('blog interlinks', e);
}
---
<BaseLayout
  title={product.meta_title || product.name}
  description={product.meta_description || product.short_description || product.name}
  type="product"
  keywords={product.keywords || undefined}
  noindex={Boolean(product.noindex) || productNoindex(product.sku)}
  ogImage={`/og/product/${product.slug}.png`}
>
  {productLd && <JsonLd schema={productLd} />}
  <div class="container-page section">
    <Breadcrumbs
      items={[
        vendorCrumb ?? { name: 'Каталог', url: '/catalog' },
        { name: h1Text, url: `/product/${product.slug}` },
      ]}
    />

    {/* Коммерческая модель уезжает в разметку одним объектом: клиентский
        скрипт считает подпись призыва и позицию заявки той же функцией, что
        и страница, а не повторяет правило второй раз.

        Каркас — три области: первый экран и остальная страница в левой
        колонке, покупка — липкой колонкой справа во всю высоту. На телефоне
        порядок в разметке (экран → покупка → остальное) сам даёт нужную
        последовательность: цена сразу после названия, а не в хвосте. */}
    <div class:list={['product-layout', { gift: isGift }]} data-commerce={JSON.stringify(commerce)} data-composition={composition} data-nature={product.product_nature || undefined} data-packaging={product.packaging || undefined} data-content={hasModules ? product.content_version || "cm" : "legacy"} {...mdProduct}>
      {hasMd && (
        <>
          <meta itemprop="sku" content={product.sku} />
          {h1Text !== product.name && <meta itemprop="name" content={product.name} />}
          <link itemprop="url" href={canonicalProductUrl} />
          <link itemprop="image" href={microImage} />
          {!product.short_description && (
            <meta itemprop="description" content={product.meta_description || product.name} />
          )}
          {product.vendor && (
            <span hidden itemprop="brand" itemscope itemtype="https://schema.org/Brand">
              <meta itemprop="name" content={product.vendor} />
            </span>
          )}
        </>
      )}

      <div class="col-hero">
        {/* Маркеры отвечают на два вопроса: какой это план и для какой
            задачи. Происхождение сюда не выносится — это признак каталога,
            а не свойство, влияющее на выбор; артикул ушёл в параметры. */}
        <div class="chips">
          {primaryMarker && <span class="chip chip-plan">{primaryMarker}</span>}
          {categoryMarker && (
            <a class="chip chip-link" href={`/catalog/${categoryMarker.slug}`}>{categoryMarker.name}</a>
          )}
        </div>
        {/* Строка производителя ведёт на его страницу: знак и название —
            одна ссылка без подчёркивания и без цвета ссылки. Правило
            docs/rules/vendor-line.md: у покупателя, узнающего бренд по знаку,
            путь к лендингу короче на один взгляд, а у остальных строка
            остаётся строкой, а не рекламой перехода. */}
        {product.vendor && (
          <p class="vendorline">Производитель: <a class="vendorline-link" href={`/vendors/${vendorPageSlug}`}>
            <VendorLogo slug={vendorPageSlug} name={vendorLegal(product.vendor)} size={20} fluid />
            <b>{vendorLegal(product.vendor)}</b>
          </a></p>
        )}
        <div class="title-row">
          {productIcons(product.slug).length > 0 && (
            <ProductIcon slug={product.slug} name={product.name} size={52} variant="color" />
          )}
          <h1 {...mdName}>{h1Text}</h1>
        </div>
        {subtitleParts.length > 0 && <p class="subtitle">{subtitleParts.join(' · ')}</p>}
        {lede.head && (
          <div class="lede-wrap" lang="ru" {...mdDesc}>
            <p class="lede">{lede.head}</p>
            {lede.tail.length > 0 && (
              <div class="lede-more" id="lede-more" hidden>
                {lede.tail.map((t) => <p class="lede">{t}</p>)}
              </div>
            )}
          </div>
        )}
        {lede.tail.length > 0 && (
          <button type="button" class="lede-toggle" aria-expanded="false" aria-controls="lede-more" data-lede-toggle>Подробнее</button>
        )}
        {(
          <dl class="facts">
            {heroFacts.map((f) => (
              <div class="fact">
                <dt>
                  <span class="fact-short">{f.short}</span><span class="fact-long">{f.long}</span>
                  <span class="hint">
                    <button type="button" class="hint-btn" aria-label={`Пояснение: ${f.long.toLowerCase()}`} aria-expanded="false" aria-describedby={`hint-${f.key}`} data-hint></button>
                    <span class="hint-box" role="tooltip" id={`hint-${f.key}`}>{f.hint}</span>
                  </span>
                </dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        )}
        {gift && (
          <div class="gift-intro">
            <p class="gift-warn">{gift.regionWarning}</p>
            <p class="muted">{gift.disclaimer}</p>
          </div>
        )}
      </div>

      <aside class="product-aside">
        {isGift ? (
          <div {...mdOffer}>
            {hasMd && giftRange && (
              <>
                <link itemprop="url" href={canonicalProductUrl} />
                <meta itemprop="lowPrice" content={String(giftRange.low)} />
                <meta itemprop="highPrice" content={String(giftRange.high)} />
                <meta itemprop="offerCount" content={String(giftRange.count)} />
                <meta itemprop="priceCurrency" content={product.currency || 'RUB'} />
                <link itemprop="availability" href="https://schema.org/InStock" />
                <OfferLogisticsMicrodata currency={product.currency || 'RUB'} />
              </>
            )}
            <GiftCardSelector
              regions={giftRegions}
              initial={giftInitial}
              productName={product.name}
              sku={product.sku}
              vendor={product.vendor || ''}
              regionLabel={gift?.regionLabel}
              denominationNote={gift?.denominationNote || 'Номинал — сумма, которая будет зачислена на баланс аккаунта после активации.'}
              regionWarning={gift?.regionWarning || 'Карта предназначена только для аккаунта соответствующего региона: проверьте регион учётной записи до заказа.'}
              availabilityNote={gift?.availabilityNote || 'Количество кодов отдельных номиналов может быть ограничено.'}
              rateDate={rateDate}
              vat={vat}
            />
            {/* Доверительные признаки показываются один раз на страницу — и у
                подарочной карты тоже: до 12.09.2026 их на ней не было вовсе. */}
            <ul class="buy-trust">
              {TRUST_LINES.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        ) : (
        <div class="card buy-card" id="buy" {...mdOffer}>
          {!byRequest && (
            <>
              <link itemprop="url" href={canonicalProductUrl} />
              <meta itemprop="price" content={String(eff.price)} />
              <meta itemprop="priceCurrency" content={product.currency || 'RUB'} />
              <link itemprop="availability" href="https://schema.org/InStock" />
              <OfferLogisticsMicrodata currency={product.currency || 'RUB'} />
            </>
          )}

          {byRequest ? (
            <div class="price-req">
              <b>Цена по запросу</b>
              <span>Рассчитаем стоимость под вашу конфигурацию и количество.</span>
            </div>
          ) : (
            /* Две ячейки без оформления: слева цена единицы и налог (по
               центру), справа — за что платят (по левому краю, прижато к
               концу). Слова «от» и «цена за 1 место» сняты: минимум заказа
               назван в первом пункте справа и в счётчике, а ИТОГО ниже
               сразу считается за минимальный заказ. */
            <div class="price-zones">
              <div class="pz-sum">
                {eff.isPromo && eff.promoLabel && <span class="promo-label">{eff.promoLabel}</span>}
                <b>{formatRub(eff.price)}</b>
                {vat > 0 && <span>в том числе НДС {vat}%</span>}
              </div>
              <ul class="pz-what">
                {priceWhat.map((w) => <li>{w}</li>)}
              </ul>
            </div>
          )}

          {/* Приписки к цене под блоком нет: «за пользователя в год» повторяет
              пункты справа («1 рабочее место», «1 календарный год»), а рыжая
              раскладка «в т.ч. НДС N% ⓘ» — строку «в том числе НДС N%» под
              суммой. Две строки сняты решением руководителя 14.09.2026:
              налог назван один раз, у суммы, и там же в ИТОГО. */}

          {!byRequest && (
            <div class="buy-qty">
              <span class="qty-label">{isUnitPlan ? `Количество ${unitPlural(commerce.qtyLabel)}` : 'Количество'}</span>
              <div class="qty-controls">
                {qtySteps.length > 0 && (
                  <div class="presets">
                    {qtySteps.map((n) => <button type="button" data-team={n}>{n}</button>)}
                  </div>
                )}
                <span class="qty" data-qty-wrap>
                  <button type="button" data-dec aria-label="Меньше">−</button>
                  {/* Нижняя граница счётчика — минимум вендора, а не единица:
                      иначе покупатель считает бюджет по невозможному заказу. */}
                  <input
                    type="number" min={commerce.minQty} value={commerce.minQty} inputmode="numeric"
                    data-qty data-min={commerce.minQty} aria-label={isUnitPlan ? `Количество ${unitPlural(commerce.qtyLabel)}` : 'Количество'}
                  />
                  <button type="button" data-inc aria-label="Больше">+</button>
                </span>
              </div>
            </div>
          )}

          {!byRequest && commerce.check && <p class="qty-check">{commerce.check}</p>}

          {!byRequest && (
            <div class="buy-total">
              <div class="bt-row">
                <span class="bt-lbl">ИТОГО{vat > 0 ? ` в т.ч. НДС ${vat}%` : ''}:</span>
                <b data-total>{formatRub(commerce.purchasePrice)}</b>
              </div>
              {rateDate && <p class="rate-note">Цена по курсу ЦБ РФ на {rateDate}</p>}
            </div>
          )}

          {/* Главный призыв называет результат, а не механику. Подборка —
              второе действие: ею собирают КП из нескольких позиций, и
              отметка о том, что позиция уже в подборке, видна флажком, а не
              только подписью кнопки. Кнопка подборки повторяет форму
              главного призыва и занимает строку от флажка до правого края:
              два действия одного веса читаются как пара, а не как кнопка и
              приписка. Третьего действия («Задать вопрос») в колонке нет —
              вопрос задаётся из шапки и из блоков ниже. */}
          <div class="buy-cta">
            <button
              class="btn btn-primary btn-caps"
              data-open-question
              data-quote-cta
              data-product={product.name}
              data-sku={product.sku}
              data-ref={ctaRef}
              data-dialog-title={byRequest ? 'Запросить цену' : 'Запросить КП'}
            >{ctaLabel}</button>
            {!byRequest && (
              <div class="coll-strip">
                <p>Нужно несколько продуктов в одном предложении? Соберите подборку и запросите единое КП.</p>
                <div class="coll-toggle">
                  <input type="checkbox" id="coll-check" class="coll-check" data-coll-check />
                  <label for="coll-check" class="coll-box" aria-label="Добавить в подборку для КП">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5.5 5.5L20 6.5" /></svg>
                  </label>
                  {/* Знак-матрица слева — тот же, что в плашке «Подборка для
                      КП» в шапке: покупатель видит, куда уходит позиция.
                      Справа знак действия: плюс — положить, диагональный
                      крестик — исключить. Состояние названо дважды, словом
                      и знаком, и читается, не читая подпись. */}
                  <button
                    class="coll-btn" type="button"
                    data-add-cart
                    data-sku={product.sku}
                    data-slug={product.slug}
                    data-name={product.name}
                    data-price={eff.price}
                  >
                    <CollectionMark size={18} />
                    <span class="coll-sep" aria-hidden="true"></span>
                    <span class="coll-txt" data-coll-label>Добавить в подборку</span>
                    <svg class="coll-sign" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true" focusable="false">
                      <g class="sign-plus"><line x1="12" y1="4.5" x2="12" y2="19.5" /><line x1="4.5" y1="12" x2="19.5" y2="12" /></g>
                      <g class="sign-cross" opacity="0"><line x1="5.8" y1="5.8" x2="18.2" y2="18.2" /><line x1="18.2" y1="5.8" x2="5.8" y2="18.2" /></g>
                    </svg>
                  </button>
                  {/* «Задать вопрос» вернулся в колонку кнопкой и стоит в том
                      же ряду, что подборка (решение руководителя 14.09.2026).
                      Обводка, а не заливка: главный призыв в колонке один. */}
                  <button class="ask-btn" type="button" data-open-question data-product={product.name} data-sku={product.sku}>Задать вопрос</button>
                </div>
              </div>
            )}
          </div>

          <ul class="buy-trust">
            {TRUST_LINES.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        )}
      </aside>

      <div class="col-rest">
        {gift && gift.regions.map((rc) => {
          const region = giftRegions.find((r) => r.code === rc.code);
          return (
            <div class="block gift-region" id={`region-${rc.code.toLowerCase()}`}>
              <h2>{rc.h2}</h2>
              <p class="muted">{rc.text}</p>
              {rc.note && <p class="muted small-note">{rc.note}</p>}
              {region && region.variants.length > 0 ? (
                <ul class="gift-denoms" aria-label={`Номиналы, ${region.name}`}>
                  {region.variants.map((v) => (
                    <li>
                      <button type="button" class="gift-pick" data-pick-sku={v.sku} disabled={v.availability === 'out_of_stock' || !(v.price > 0)}>
                        <span class="gp-nom">{variantLabel(v)}</span>
                        <span class="gp-arrow" aria-hidden="true">→</span>
                        <span class="gp-price">{v.price > 0 ? formatRub(v.price) : 'по запросу'}</span>
                      </button>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="muted">Номиналы этого региона временно недоступны — уточните наличие через форму вопроса.</p>
              )}
            </div>
          );
        })}

        {gift && gift.sections.map((sec) => (
          <div class="block prose-bizsoft">
            <h2>{sec.h2}</h2>
            {sec.paragraphs.map((t) => <p>{t}</p>)}
            {sec.bullets && sec.bullets.length > 0 && <ul class="features">{sec.bullets.map((b) => <li>{b}</li>)}</ul>}
          </div>
        ))}

        {gift && (
          <div class="block" id="activation">
            <h2>{gift.activation.h2}</h2>
            <p class="muted">{gift.activation.intro}</p>
            <ol class="steps">{gift.activation.steps.map((st) => <li>{st}</li>)}</ol>
            <p class="gift-warn">{gift.activation.warning}</p>
          </div>
        )}

        {gallery.length > 0 && (
          <div class="gallery" data-gallery>
            {gallery.map((g, i) => (
              <button type="button" class="gthumb" data-full={g.url} data-i={i} aria-label={`Открыть изображение ${i + 1}`}>
                <img src={`${g.url}?width=240&height=180&fit=contain&format=webp`} alt={`${product.name} — изображение ${i + 1}`} loading="lazy" width="120" height="90" />
              </button>
            ))}
          </div>
        )}

        {/* Состав подписки — выше описания: «что я получу за эти деньги»
            читают до маркетингового текста, а не после него. */}
        {hasModules && modules.map((m) => (
          <section class="sec" data-module={m.code}>
            <h2 class="sec-head"><i aria-hidden="true">/</i>{m.title}</h2>
            {m.kind !== 'prose' && m.body && <p class="mod-body">{m.body}</p>}
            {m.kind === 'items' && (
              <ul class="incl incl-wide">
                {(m.items || []).map((it) => (
                  <li><b>{it.t}</b><p>{it.d}{it.link && <> <a class="mod-link" href={`/product/${it.link}`}>{nameOf(it.link)} →</a></>}</p></li>
                ))}
              </ul>
            )}
            {m.kind === 'prose' && proseParas(m).map((par) => <p class="mod-body">{par}</p>)}
            {m.kind === 'compare' && (
              <div class="cmp"><table>
                <tr><th></th>{compareCols(m).map((c) => <th class={c === product.slug ? 'me' : ''}>{c === product.slug ? 'Эта карточка' : <a class="mod-link" href={`/product/${c}`}>{nameOf(c)}</a>}</th>)}</tr>
                {(m.rows || []).map((r) => <tr><td>{r.label}</td>{compareCols(m).map((c) => <td class={c === product.slug ? 'me' : ''}>{r.values?.[c] || '—'}</td>)}</tr>)}
              </table></div>
            )}
            {m.kind !== 'items' && m.links && m.links.length > 0 && (
              <p class="mod-body">{m.links.map((l, i) => <>{i > 0 && ' · '}<a class="mod-link" href={`/product/${l}`}>{nameOf(l)} →</a></>)}</p>
            )}
          </section>
        ))}

        {!hasModules && (cardMeta?.includes?.length || features.length > 0) && !gift && (
          <section class="sec">
            <h2 class="sec-head"><i aria-hidden="true">/</i>{isUnitPlan ? 'Что входит в план' : 'Что входит'}</h2>
            {cardMeta?.includes?.length ? (
              /* Заголовок пункта с пояснением: плоский список отвечает на
                 «что перечислено», а покупателю нужно «что это значит». */
              <ul class="incl incl-wide">
                {cardMeta.includes.map((it) => <li><b>{it.t}</b><p>{it.d}</p></li>)}
              </ul>
            ) : (
              <ul class="incl">{features.map((f) => <li>{f}</li>)}</ul>
            )}
          </section>
        )}

        <section class="sec">
          <h2 class="sec-head"><i aria-hidden="true">/</i>Основные параметры</h2>
          {/* Таблица без границ: строка — подпись и значение, а не ячейки
              сетки. Полезные покупателю параметры идут выше административных,
              артикул — последним: внутренний артикул BIZSoft при выборе не
              используется. */}
          <div class="params">
            {product.vendor && <div class="prow"><span class="k">Производитель:</span><span class="v">{vendorLegal(product.vendor)}</span></div>}
            {planShort && <div class="prow"><span class="k">Тип плана:</span><span class="v">{planShort}</span></div>}
            {term && <div class="prow"><span class="k">Срок:</span><span class="v">{term}</span></div>}
            {(isUnitPlan || product.unit_label) && <div class="prow"><span class="k">Расчётная единица:</span><span class="v">{product.unit_label || unitName}</span></div>}
            {isUnitPlan && <div class="prow"><span class="k">Минимальное количество:</span><span class="v">{commerce.minQty}</span></div>}
            {cardMeta?.reassign && <div class="prow"><span class="k">Переназначение пользователей:</span><span class="v">{cardMeta.reassign}</span></div>}
            {cardMeta?.management && <div class="prow"><span class="k">Управление:</span><span class="v">{cardMeta.management}</span></div>}
            {category && <div class="prow"><span class="k">Категория:</span><span class="v">{category.name}</span></div>}
            {product.license_type && LICENSE_LABEL[product.license_type] && (
              <div class="prow"><span class="k">Тип использования:</span><span class="v">{LICENSE_LABEL[product.license_type]}</span></div>
            )}
            {isGift && giftRegions.length > 0 && (
              <div class="prow"><span class="k">Регионы:</span><span class="v">{giftRegions.map((r) => `${r.name} (${r.currency})`).join(', ')}</span></div>
            )}
            {isGift && giftRegions.length > 0 && (
              <div class="prow"><span class="k">Номиналов:</span><span class="v">{giftRegions.reduce((n, r) => n + r.variants.length, 0)}</span></div>
            )}
            {/* Объяснение налога переехало сюда из блока цены (14.09.2026).
                В колонке покупки налог назван цифрой — у суммы и в ИТОГО, —
                а «включён, не сверху, принимается к вычету» это ответ
                бухгалтерии, и его место в параметрах. Совсем убирать текст
                нельзя: до 12.09.2026 покупатель читал одну цифру и делал
                вывод, что вычета не будет (`tests/taxation-consistency`). */}
            {(!byRequest || isGift) && vat > 0 && (
              <div class="prow">
                <span class="k">НДС:</span>
                <span class="v">
                  {vat}% (включено в стоимость)
                  <span class="vat-note">
                    Налог включён в цену, сверху не добавляется. В счёте, КП и
                    закрывающих документах выделен отдельной строкой.
                    {' '}Принимается к вычету, если вы на общей системе.
                    {' '}<a href="/blog/zakryvayushchie-dokumenty-na-po">Подробнее о документах</a>
                  </span>
                </span>
              </div>
            )}
            <div class="prow"><span class="k">Артикул BIZSoft:</span><span class="v">{product.sku}</span></div>
          </div>
        </section>

        {isGift ? (
          <section class="sec">
            <h2 class="sec-head"><i aria-hidden="true">/</i>Как купить {gift?.shortName || h1Text} для юридического лица</h2>
            <ol class="steps">
              <li>Выбираете {gift?.regionLabel ? gift.regionLabel.toLowerCase() : 'регион аккаунта'} и вариант, добавляете позицию в подборку и формируете заявку или КП.</li>
              <li>Заключаем договор и выставляем счёт на оплату в рублях.</li>
              <li>{gift?.deliveryNote || 'После оплаты передаём цифровой код на указанную почту.'}</li>
              <li>Передаём закрывающие документы через ЭДО.</li>
            </ol>
            {gift && <p class="muted">{gift.availabilityNote}</p>}
          </section>
        ) : (
          /* Порядок поставки — из единого источника условий работы
             (src/data/policies.ts): тот же текст должен доставаться агенту
             и другим страницам, поэтому в шаблоне его нет. */
          <section class="sec" id="deal">
            <h2 class="sec-head"><i aria-hidden="true">/</i>Как организовано взаимодействие</h2>
            <div class="deal">
              {PROCUREMENT_FLOW.map((g) => (
                <div class="deal-row">
                  <span class="num">/{g.n}</span>
                  <h3>{g.title}</h3>
                  <ul>
                    {g.points.map((pt) => (
                      <li>
                        {pt.text}
                        {pt.links && pt.links.map((l, i) => (
                          <>
                            {i > 0 && ', '}
                            <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
                          </>
                        ))}
                        {pt.tail}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )}

        {!hasModules && (product.description || product.for_whom || useCases.length > 0) && !gift && (
          <section class="sec" id="detail">
            <h2 class="sec-head"><i aria-hidden="true">/</i>Подробно о продукте и условиях использования</h2>
            <div class="split">
              <div class="longread prose-bizsoft">
                {product.description && (
                  <>
                    <div class="collapsible clamped" data-collapsible><p>{product.description}</p></div>
                    <button class="readmore" data-readmore hidden>Развернуть ▾</button>
                  </>
                )}
                {product.for_whom && (
                  <>
                    <h3>Кому подходит</h3>
                    <p class="muted">{product.for_whom}</p>
                  </>
                )}
                {useCases.length > 0 && (
                  <>
                    <h3>Какие задачи закрывает</h3>
                    <ul class="incl">{useCases.map((u) => <li>{u}</li>)}</ul>
                  </>
                )}
              </div>
              {/* Помощь с выбором — другое намерение, чем запрос КП: человек
                  не знает, что выбрать, а не готов запрашивать предложение.
                  Письмо открывается с готовой темой и началом текста. */}
              <div class="assist">
                <h3>Не уверены, что выбран правильный план?</h3>
                <p>Поможем проверить редакцию, объём и условия использования под вашу задачу.</p>
                <a class="btn btn-primary" href={askHref}>Задать вопрос специалисту</a>
              </div>
            </div>
          </section>
        )}

        {!hasModules && product.seo_text && (
          <div class="prose-bizsoft block"><p>{product.seo_text}</p></div>
        )}
        {hasModules && (
          <section class="sec"><div class="assist assist-inline">
            <h3>Не уверены, что выбран правильный план?</h3>
            <p>Поможем проверить редакцию, объём и условия использования под вашу задачу.</p>
            <a class="btn btn-primary" href={askHref}>Задать вопрос специалисту</a>
          </div></section>
        )}

        <FAQ items={faq} title={gift ? 'Вопросы и ответы' : 'Частые вопросы'} columns={2} mark={true} />

        {relatedProducts.length > 0 && (
          <section class="sec">
            <h2 class="sec-head"><i aria-hidden="true">/</i>Похожие товары</h2>
            <div class="related-grid">
              {relatedProducts.map((rp) => (
                <a href={`/product/${rp.slug}`} class="card card-hover related-card">
                  <strong>{rp.name}</strong>
                  {rp.vendor && <span>{rp.vendor}</span>}
                </a>
              ))}
            </div>
          </section>
        )}

        {blogLinks.length > 0 && (
          <section class="sec">
            <h2 class="sec-head"><i aria-hidden="true">/</i>Полезные статьи</h2>
            <ul class="blog-links">
              {blogLinks.map((b) => (
                <li><a href={`/blog/${b.id}`}>{b.title}</a></li>
              ))}
            </ul>
          </section>
        )}

        {aiLinks && (
          <div class="block ai-interlinks">
            <div class="il-col">
              <h3>Сравнения</h3>
              <ul>{aiLinks.compare.map((l) => <li><a href={l.href}>{l.label} →</a></li>)}</ul>
            </div>
            <div class="il-col">
              <h3>База знаний</h3>
              <ul>{aiLinks.articles.map((l) => <li><a href={l.href}>{l.label} →</a></li>)}</ul>
            </div>
            <div class="il-col">
              <h3>Категория</h3>
              <ul><li><a href={aiLinks.category.href}>{aiLinks.category.label} →</a></li></ul>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  {/* Липкая полоса: появляется, когда призыв первого экрана ушёл из виду.
      Пока он на экране, вторая такая же кнопка только спорит с ним — поэтому
      условие именно такое, а не «после четвёртого блока». На широком экране
      полосы нет вовсе: там призыв держит липкая карточка покупки. */}
  {!isGift && (
    <div class="buy-bar" data-buy-bar hidden>
      <div class="bb-inner container-page">
        <span class="bb-sum">
          {byRequest ? <b>Цена по запросу</b> : (
            <>
              <b data-bar-total>{formatRub(commerce.purchasePrice)}</b>
              <span class="bb-qty" data-bar-qty>{isUnitPlan ? unitPhrase(commerce.minQty, commerce.qtyLabel) : `${commerce.minQty} шт.`}</span>
            </>
          )}
        </span>
        <button
          class="btn btn-primary"
          data-open-question
          data-quote-cta
          data-cta-short
          data-product={product.name}
          data-sku={product.sku}
          data-ref={ctaRef}
          data-dialog-title={byRequest ? 'Запросить цену' : 'Запросить КП'}
        >{byRequest ? 'Получить расчёт' : 'Получить КП'}</button>
      </div>
    </div>
  )}

  <!-- Лайтбокс -->
  <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Просмотр изображения товара">
    <button class="lb-close" data-lb-close aria-label="Закрыть">✕</button>
    <button class="lb-nav lb-prev" data-lb-prev aria-label="Назад">‹</button>
    <img data-lb-img src="" alt={product.name} />
    <button class="lb-nav lb-next" data-lb-next aria-label="Вперёд">›</button>
  </div>

  <QuestionForm source="product" />
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  /* Каркас: слева первый экран и остальная страница, справа липкая колонка
     покупки во всю высоту. minmax(0, …) — право колонки сжаться: колонка
     шириной 1fr не уходит уже своего содержимого, и длинное название товара
     распирало страницу. */
  .product-layout { display: grid; grid-template-columns: minmax(0, 1fr) 368px; column-gap: 3.5rem; align-items: start; }
  .col-hero { grid-column: 1; grid-row: 1; min-width: 0; }
  .col-rest { grid-column: 1; grid-row: 2; min-width: 0; }
  .product-aside { grid-column: 2; grid-row: 1 / span 2; position: sticky; top: 124px; }

  /* ── Первый экран ────────────────────────────────────────────────── */
  .chips { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 1rem; }
  .chip { font-size: 0.75rem; font-weight: 700; padding: 0.3rem 0.7rem; border-radius: 6px; background: var(--color-bg-elevated); color: var(--color-text-muted); }
  .chip-plan { background: color-mix(in srgb, var(--color-accent) 12%, transparent); color: var(--color-accent); }
  .chip-link:hover { color: var(--color-accent); }
  .vendorline { color: var(--color-text-dim); font-size: 0.87rem; margin: 0 0 0.75rem; }
  /* Единая высота знака для всех вендоров — 20px. Ширина считается по
     пропорциям файла, поэтому длинный логотип-надпись сдвигает название
     вправо и строку не ломает. */
  .vendorline-link { display: inline-flex; align-items: center; gap: 0.4rem; vertical-align: middle; color: inherit; text-decoration: none; }
  .vendorline b { color: var(--color-text); font-weight: 700; }
  .title-row { display: flex; align-items: center; gap: 1rem; }
  h1 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin: 0; line-height: 1.08; }
  .subtitle { font-size: 1rem; font-weight: 600; color: var(--color-text-muted); margin: 0.5rem 0 1.1rem; }
  /* Выключка по формату: описание читается как блок текста, а не как рваная
     колонка. Переносы включены, иначе в русском тексте появляются «реки». */
  .lede { color: var(--color-text-muted); font-size: 1.02rem; line-height: 1.6; max-width: 64ch; margin: 0; text-align: justify; hyphens: auto; -webkit-hyphens: auto; }
  .lede-more { margin-top: 0.8rem; display: grid; gap: 0.8rem; }
  .lede-toggle { margin-top: 0.6rem; background: none; border: 0; padding: 0; color: var(--color-accent, #d9480f); font: inherit; font-size: 0.92rem; font-weight: 600; cursor: pointer; }
  .lede-toggle::after { content: ' ↓'; }
  .lede-toggle[aria-expanded="true"]::after { content: ' ↑'; }
  /* Блок фактов — всегда таблица из трёх равных колонок: линия сверху, две
     вертикали, заголовки и значения в одну строку по центру. На любой ширине
     она та же и лишь растягивается; колонка не сжимается меньше содержимого,
     поэтому шрифт подстраивается под ширину. */
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 1.8rem 0 0; padding-top: 1.2rem; border-top: 1px solid var(--color-border); }
  .fact { position: relative; min-width: 0; padding-inline: 0.4rem; border-right: 1px solid var(--color-border); text-align: center; }
  .fact:last-child { border-right: 0; }
  .fact dt { display: flex; align-items: center; justify-content: center; gap: 0.3rem; white-space: nowrap; font-size: clamp(0.6rem, 2.4vw, 0.72rem); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-dim); font-weight: 700; margin-bottom: 0.4rem; }
  .fact dd { margin: 0; font-size: clamp(0.82rem, 3vw, 0.95rem); font-weight: 600; white-space: nowrap; }
  /* Полные заголовки — только там, где три из них помещаются в строку. */
  .fact-long { display: none; }
  @media (min-width: 1101px) {
    .fact-long { display: inline; }
    .fact-short { display: none; }
    .fact dt { font-size: 0.66rem; letter-spacing: 0.05em; }
  }
  /* Значок «i» — верхним индексом у заголовка, как сноска: маленький кружок
     с прямой «i» без курсива (решение руководителя 13.09.2026). */
  .hint { display: inline-flex; flex-shrink: 0; align-self: flex-start; position: relative; top: -0.35em; margin-left: -0.1rem; }
  .hint-btn { width: 10px; height: 10px; border-radius: 50%; border: 1px solid currentColor; background: none; color: inherit; padding: 0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font: 600 7px/1 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; font-style: normal; text-transform: none; letter-spacing: 0; }
  .hint-btn::before { content: 'i'; }
  /* Подсказка позиционируется от ячейки, а не от значка: у крайних колонок
     она прижата к краю таблицы и на 320px не выходит за экран. Скрытая
     подсказка не занимает места — иначе она же и давала прокрутку вбок. */
  .hint-box { display: none; position: absolute; left: 50%; bottom: calc(100% - 0.2rem); transform: translateX(-50%); width: min(260px, calc(100vw - 2rem)); padding: 0.55rem 0.7rem; background: var(--color-text); color: #fff; border-radius: 8px; font-size: 0.78rem; font-weight: 500; line-height: 1.4; text-transform: none; letter-spacing: 0; white-space: normal; text-align: left; z-index: 5; }
  .fact:first-child .hint-box { left: 0; transform: none; }
  .fact:last-child .hint-box { left: auto; right: 0; transform: none; }
  .hint:hover .hint-box, .hint:focus-within .hint-box, .hint-btn[aria-expanded="true"] + .hint-box { display: block; }

  /* ── Колонка покупки ─────────────────────────────────────────────── */
  .buy-card { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.1rem; }
  .price-req b { display: block; font-weight: 800; font-size: 1.5rem; }
  .price-req span { color: var(--color-text-dim); font-size: 0.85rem; }
  /* Две зоны цены: слева сумма и налог, справа — за что платят. */
  .price-zones { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; align-items: center; }
  .pz-sum { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .pz-sum b { font-size: 1.75rem; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .pz-sum span { color: var(--color-text-dim); font-size: 0.79rem; }
  .pz-sum .promo-label { align-self: flex-start; background: color-mix(in srgb, var(--color-accent) 18%, transparent); color: var(--color-accent); font-size: 0.72rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 6px; margin-bottom: 0.3rem; }
  /* Правая ячейка: по левому краю, но сдвинута к концу — заполняет ширину. */
  .pz-what { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; justify-self: end; text-align: left; }
  .pz-what li { position: relative; padding-left: 0.7rem; font-size: 0.85rem; color: var(--color-text-muted); }
  .pz-what li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 4px; height: 4px; background: var(--color-accent); }
  .rate-note { color: var(--color-text-dim); font-size: 0.78rem; margin: 0.35rem 0 0; }
  .buy-qty { display: flex; flex-direction: column; gap: 0.5rem; }
  .qty-label { color: var(--color-text); font-size: 0.9rem; font-weight: 700; }
  /* Ступени и счётчик — одной строкой: это один выбор, а не два блока. */
  .qty-controls { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; flex-wrap: wrap; }
  .presets { display: flex; gap: 0.3rem; }
  .presets button { min-width: 34px; padding: 0.3rem 0.5rem; border: 1px solid var(--color-border-strong); border-radius: 999px; background: var(--color-bg); color: var(--color-text-muted); font: inherit; font-size: 0.85rem; cursor: pointer; }
  .presets button:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .qty { display: inline-flex; align-items: center; gap: 0.2rem; border: 1px solid var(--color-border-strong); border-radius: 999px; padding: 0.2rem 0.25rem; }
  .qty button { width: 30px; height: 30px; border-radius: 999px; border: none; background: var(--color-bg-elevated); color: var(--color-text); cursor: pointer; font-size: 1.05rem; }
  .qty input { width: 46px; text-align: center; background: none; border: none; color: var(--color-text); padding: 0.2rem; font: inherit; font-weight: 700; }
  .qty-check { margin: 0; color: var(--color-text-muted); font-size: 0.82rem; }
  .buy-total { border-top: 1px solid var(--color-border); padding-top: 0.9rem; }
  .bt-row { display: flex; align-items: baseline; justify-content: space-between; gap: 0.8rem; }
  /* Итоговая строка — жирным целиком: это то, что уйдёт в счёт. */
  .bt-lbl { font-weight: 700; font-size: 0.9rem; }
  .bt-row b { font-size: 1.3rem; font-variant-numeric: tabular-nums; }
  .buy-cta { display: flex; flex-direction: column; gap: 0.8rem; }
  .buy-cta .btn { width: 100%; }
  /* Главный призыв — в той же типографике, что подборка и вопрос: прописные,
     тот же трекинг. Кегль чуть меньше обычного: «ПОЛУЧИТЬ КП НА 20 РАБОЧИХ
     МЕСТ» прописными длиннее строчного и иначе ломается на две строки уже на
     широкой колонке. */
  .btn-caps { font-size: 0.85rem; font-weight: 800; letter-spacing: 0.03em; text-transform: uppercase; }
  /* Подборка: отметка видна флажком, а не только подписью кнопки —
     состояние «позиция уже в подборке» читается без чтения текста. */
  .coll-strip { border-top: 1px dashed var(--color-border); padding-top: 0.8rem; }
  .coll-strip p { margin: 0 0 0.6rem; color: var(--color-text-dim); font-size: 0.81rem; line-height: 1.45; text-align: center; }
  /* Ряд подборки: флажок, кнопка подборки и «Задать вопрос» — строго в одну
     строку (решение руководителя 14.09.2026). Перенос запрещён: обе кнопки
     сжимаются, подпись внутри ложится на две строки — это честнее, чем
     уронить вопрос на свою строку и разорвать пару действий. */
  .coll-toggle { display: flex; align-items: stretch; gap: 0.45rem; flex-wrap: nowrap; }
  .coll-check { position: absolute; opacity: 0; width: 0; height: 0; }
  .coll-box { width: 22px; height: 22px; flex: none; border: 1.5px solid var(--color-border-strong); border-radius: 6px; display: grid; place-items: center; cursor: pointer; background: var(--color-bg); }
  .coll-box svg { width: 14px; height: 14px; color: #fff; opacity: 0; }
  .coll-check:checked + .coll-box { background: var(--color-success); border-color: var(--color-success); }
  .coll-check:checked + .coll-box svg { opacity: 1; }
  .coll-check:focus-visible + .coll-box { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  /* Кнопка подборки повторяет форму главного призыва (скруглением, высотой
     и заливкой) и занимает всю оставшуюся ширину — от флажка до правого
     края колонки. Флажок слева от неё, не поверх: клик по любому из двух
     переключает подборку. min-width: 0 обязателен — без него длинная
     подпись «Исключить из подборки» распирает строку и выносит кнопку за
     край колонки. */
  /* Кнопка подборки повторяет плашку «Подборка для КП» из шапки: знак-матрица,
     тонкий разделитель, прописная подпись, знак действия справа. */
  .coll-btn { flex: 1 1 auto; min-width: 0; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.7rem 0.9rem; border: 1px solid transparent; border-radius: 980px; background: var(--color-accent); color: #fff; font: inherit; cursor: pointer; text-align: center; transition: background-color 0.22s ease, transform 0.15s ease; }
  .coll-btn:hover { background: var(--color-accent-hover); }
  .coll-btn:active { transform: translateY(1px); }
  .coll-sep { flex: none; width: 1px; align-self: stretch; margin: 0.1rem 0; background: color-mix(in srgb, #fff 55%, transparent); }
  .coll-txt { min-width: 0; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.03em; text-transform: uppercase; line-height: 1.25; }
  .coll-sign { flex: none; width: 16px; height: 16px; }
  /* Позиция уже в подборке — плюс сменяется диагональным крестиком: кнопка
     называет и показывает обратное действие, а не то же самое другими словами. */
  .coll-btn.is-in .sign-plus { opacity: 0; }
  .coll-btn.is-in .sign-cross { opacity: 1; }
  /* Второе действие ряда — обводкой: заливок акцентом в колонке ровно две,
     главный призыв и подборка. */
  .ask-btn { flex: 0 1 auto; min-width: 0; display: inline-flex; align-items: center; justify-content: center; padding: 0.7rem 0.9rem; border: 1px solid var(--color-border-strong); border-radius: 980px; background: var(--color-bg-card); color: var(--color-text); font: inherit; font-size: 0.8rem; font-weight: 800; letter-spacing: 0.03em; text-transform: uppercase; line-height: 1.25; cursor: pointer; transition: border-color 0.22s ease, color 0.22s ease, transform 0.15s ease; }
  .ask-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .ask-btn:active { transform: translateY(1px); }
  /* На телефоне ряд остаётся рядом, но при прежнем кегле «ДОБАВИТЬ В
     ПОДБОРКУ» ложилось в три строки и кнопки вырастали в столбики. Кегль,
     отступы и промежутки поджимаются — две строки максимум. */
  @media (max-width: 560px) {
    .coll-toggle { gap: 0.35rem; }

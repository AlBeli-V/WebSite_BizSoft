---
import { getCollection } from 'astro:content';
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PriceTag from '../../components/PriceTag.astro';
import FAQ from '../../components/FAQ.astro';
import QuestionForm from '../../components/QuestionForm.astro';
import CTASection from '../../components/CTASection.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getProductBySlug, findCanonicalProductSlug, getProductsBySlugs, getProductsBySkus, getProductVariants, galleryImages , getCurrencyRate } from '../../lib/directus';
import { isSourceUnavailable, serviceUnavailable } from '../../lib/http';
import { productSchema, giftCardProductSchema, canonicalUrl } from '../../lib/seo';
import { effectivePrice, formatRub } from '../../lib/pricing';
import { ORIGIN_LABEL, LICENSE_LABEL, listValues } from '../../lib/types';
import { vendorLegal, productNoindex, isGiftCard, isVariant } from '../../lib/catalog';
import { groupGiftCardVariants, giftCardPriceRange, pickInitialVariant, variantLabel, type GiftCardRegion } from '../../lib/gift-cards';
import { giftCardContent } from '../../data/gift-cards';
import GiftCardSelector from '../../components/GiftCardSelector.astro';
import { getAiInterlinks } from '../../data/ai-interlinks';
import { productIcons } from '../../data/product-icons';
import ProductIcon from '../../components/ProductIcon.astro';

const { slug } = Astro.params;

let product = null;
try {
  product = await getProductBySlug(slug!);
} catch (e) {
  // Сбой БД — это не «товара нет». Отдать 404 значит попросить робота
  // выкинуть живую страницу из индекса; отдаём 503, см. lib/http.ts.
  console.error('product page error', e);
  if (isSourceUnavailable(e)) return serviceUnavailable();
}
if (!product) {
  // 301 со старого slug на актуальный, если задан в old_slugs
  try {
    const canonical = await findCanonicalProductSlug(slug!);
    if (canonical) return Astro.redirect(`/product/${canonical}`, 301);
  } catch (e) {
    console.error('product redirect lookup', e);
    if (isSourceUnavailable(e)) return serviceUnavailable();
  }
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Отечественное ПО убрано с сайта — страницы таких товаров недоступны.
if (product.origin === 'domestic') {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Вариант (номинал подарочной карты) своей страницы не имеет: отдельный
// адрес на каждый номинал — те же дубли, что у пакетов кредитов. Отдаём 301
// на родительскую карточку с уже выбранным вариантом (?sku=…); canonical
// у неё без параметров, поэтому в индекс идёт один адрес.
if (isVariant(product)) {
  try {
    const [parent] = await getProductsBySkus([product.parent_sku!]);
    if (parent) return Astro.redirect(`/product/${parent.slug}?sku=${encodeURIComponent(product.sku)}`, 301);
  } catch (e) {
    console.error('variant parent lookup', e);
    if (isSourceUnavailable(e)) return serviceUnavailable();
  }
}

// Подарочная карта: варианты (регион + номинал) — из Directus, порядок и
// группировку задаёт lib/gift-cards.ts; редакторские разделы — data/gift-cards.ts.
const isGift = isGiftCard(product);
let giftRegions: GiftCardRegion[] = [];
if (isGift) {
  try {
    giftRegions = groupGiftCardVariants(await getProductVariants(product.sku));
  } catch (e) {
    console.error('gift card variants', e);
    if (isSourceUnavailable(e)) return serviceUnavailable();
  }
}
const giftRange = isGift ? giftCardPriceRange(giftRegions) : null;
const giftInitial = isGift ? pickInitialVariant(giftRegions, Astro.url.searchParams.get('sku')) : null;
const gift = isGift ? giftCardContent(product.slug) : undefined;

const eff = effectivePrice(product);
const category = typeof product.category === 'object' ? product.category : null;
const features = Array.isArray(product.features)
  ? product.features.map((f) => (typeof f === 'string' ? f : (f as { value?: string }).value)).filter(Boolean)
  : [];
// У подарочной карты вопросы из редакторского модуля; у остальных — из Directus.
const faq = gift ? gift.faq : (Array.isArray(product.faq) ? product.faq : []);
const gallery = galleryImages(product);
const vat = product.vat_percent ?? 0;
const byRequest = product.price <= 0 && !eff.isPromo;
let rateDate: string | null = null;
try {
  const rate = await getCurrencyRate();
  if (rate?.rate_date) rateDate = new Date(rate.rate_date).toLocaleDateString('ru-RU');
} catch { /* индикатор курса просто не показываем */ }

// Архитектурные блоки масштабирования
const useCases = listValues(product.use_cases);
const relatedSlugs = listValues(product.related_products);
let relatedProducts: Awaited<ReturnType<typeof getProductsBySlugs>> = [];
try {
  if (relatedSlugs.length) relatedProducts = await getProductsBySlugs(relatedSlugs);
} catch (e) {
  console.error('related products', e);
}

// Перелинковка AI-карточки (сравнения / статьи / категория) — только для AI-вендоров.
const aiLinks = product.vendor ? getAiInterlinks(product.vendor) : null;

// Товарная разметка. JSON-LD — для Google и общих потребителей; ниже в
// шаблоне тот же товар продублирован microdata-слоем для Яндекса (его
// справка гарантирует обработку товарной разметки только в microdata,
// и только microdata показывает валидатор Вебмастера). Оба слоя строятся
// из одних данных (effectivePrice + Directus) — расходиться им не с чего;
// согласованность закреплена смоук-проверкой. Для «цены по запросу»
// productSchema возвращает null — товарной разметки нет ни в одном слое.
// Подарочная карта — один Product с AggregateOffer по вариантам (без Product
// на каждый номинал); диапазон — из тех же вариантов, что видит покупатель.
const productLd = isGift
  ? giftCardProductSchema(product, giftRange, { images: gallery.map((g) => g.url) })
  : productSchema(product, { images: gallery.map((g) => g.url) });
const canonicalProductUrl = canonicalUrl(`/product/${product.slug}`);
const microImage = gallery.length > 0 ? gallery[0].url : canonicalUrl('/og-default.png');
// Наборы microdata-атрибутов: у «цены по запросу» пустые — атрибуты не
// выводятся вовсе, страница остаётся без товарной microdata.
// У подарочной карты microdata есть только при наличии диапазона (как и JSON-LD).
const hasMd = isGift ? productLd !== null : !byRequest;
// itemid у microdata-слоя не ставится намеренно. Google связывает узлы
// разных синтаксисов по общему идентификатору (@id ≡ itemid) и склеивает их
// в одну сущность: при itemid = @id JSON-LD у объединённого товара каждое
// поле приходило дважды, и Search Console закрывала карточку ошибкой
// «Поле "brand" дублируется» (01.09.2026, /product/mj-standard). Слои обязаны
// оставаться двумя независимыми сериализациями одного товара — JSON-LD для
// Google, microdata для Яндекса, — поэтому общего идентификатора у них нет.
const mdProduct = hasMd
  ? { itemscope: true, itemtype: 'https://schema.org/Product' }
  : {};
const mdName = hasMd ? { itemprop: 'name' } : {};
const mdDesc = hasMd && product.short_description ? { itemprop: 'description' } : {};
const mdOffer = hasMd
  ? { itemprop: 'offers', itemscope: true, itemtype: isGift ? 'https://schema.org/AggregateOffer' : 'https://schema.org/Offer' }
  : {};

// Обратная перелинковка «карточка → статья»: берём статьи, которые сами
// ссылаются на этот товар через relatedProducts, — связь описывается один раз
// во frontmatter статьи и работает для любого вендора, не только AI.
let blogLinks: { id: string; title: string }[] = [];
try {
  const posts = await getCollection('blog', ({ data }) => !data.draft && !data.noindex);
  blogLinks = posts
    .filter((p) => (p.data.relatedProducts || []).includes(product.slug))
    .map((p) => ({ id: p.id, title: p.data.title }));
} catch (e) {
  console.error('blog interlinks', e);
}
---
<BaseLayout
  title={product.meta_title || product.name}
  description={product.meta_description || product.short_description || product.name}
  type="product"
  keywords={product.keywords || undefined}
  noindex={Boolean(product.noindex) || productNoindex(product.sku)}
  ogImage={`/og/product/${product.slug}.png`}
>
  {productLd && <JsonLd schema={productLd} />}
  <div class="container-page section">
    <Breadcrumbs
      items={[
        { name: 'Каталог', url: '/catalog' },
        ...(product.origin ? [{ name: ORIGIN_LABEL[product.origin], url: `/catalog/${product.origin}` }] : []),
        ...(category ? [{ name: category.name, url: `/catalog/${category.slug}` }] : []),
        { name: product.name, url: `/product/${product.slug}` },
      ]}
    />

    <div class:list={['product-layout', { gift: isGift }]} {...mdProduct}>
      <div class="product-main">
        {hasMd && (
          <>
            <meta itemprop="sku" content={product.sku} />
            <link itemprop="url" href={canonicalProductUrl} />
            <link itemprop="image" href={microImage} />
            {!product.short_description && (
              <meta itemprop="description" content={product.meta_description || product.name} />
            )}
            {product.vendor && (
              <span hidden itemprop="brand" itemscope itemtype="https://schema.org/Brand">
                <meta itemprop="name" content={product.vendor} />
              </span>
            )}
          </>
        )}
        <div class="badges">
          {product.origin && <span class="badge" data-origin={product.origin}>{ORIGIN_LABEL[product.origin]}</span>}
          {product.license_type && <span class="badge badge-muted">{LICENSE_LABEL[product.license_type]}</span>}
          {category && <a class="badge badge-link" href={`/catalog/${category.slug}`}>{category.name}</a>}
        </div>
        <span class="sku">Артикул: {product.sku}{product.vendor ? ` · Производитель: ${vendorLegal(product.vendor)}` : ''}</span>
        {productIcons(product.slug).length > 0 ? (
          <h1 class="h1-ico" {...mdName}><ProductIcon slug={product.slug} name={product.name} size={44} variant="color" /> {product.name}</h1>
        ) : (
          <h1 {...mdName}>{product.name}</h1>
        )}
        {product.short_description && <p class="lead" {...mdDesc}>{product.short_description}</p>}

        {gift && (
          <div class="gift-intro">
            <p class="gift-warn">{gift.regionWarning}</p>
            <p class="muted">{gift.disclaimer}</p>
          </div>
        )}

        {gift && gift.regions.map((rc) => {
          const region = giftRegions.find((r) => r.code === rc.code);
          return (
            <div class="block gift-region" id={`region-${rc.code.toLowerCase()}`}>
              <h2>{rc.h2}</h2>
              <p class="muted">{rc.text}</p>
              {rc.note && <p class="muted small-note">{rc.note}</p>}
              {region && region.variants.length > 0 ? (
                <ul class="gift-denoms" aria-label={`Номиналы, ${region.name}`}>
                  {region.variants.map((v) => (
                    <li>
                      <button type="button" class="gift-pick" data-pick-sku={v.sku} disabled={v.availability === 'out_of_stock' || !(v.price > 0)}>
                        <span class="gp-nom">{variantLabel(v)}</span>
                        <span class="gp-arrow" aria-hidden="true">→</span>
                        <span class="gp-price">{v.price > 0 ? formatRub(v.price) : 'по запросу'}</span>
                      </button>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="muted">Номиналы этого региона временно недоступны — уточните наличие через форму вопроса.</p>
              )}
            </div>
          );
        })}

        {gift && gift.sections.map((sec) => (
          <div class="block prose-bizsoft">
            <h2>{sec.h2}</h2>
            {sec.paragraphs.map((t) => <p>{t}</p>)}
            {sec.bullets && sec.bullets.length > 0 && <ul class="features">{sec.bullets.map((b) => <li>{b}</li>)}</ul>}
          </div>
        ))}

        {gift && (
          <div class="block" id="activation">
            <h2>{gift.activation.h2}</h2>
            <p class="muted">{gift.activation.intro}</p>
            <ol class="steps">{gift.activation.steps.map((st) => <li>{st}</li>)}</ol>
            <p class="gift-warn">{gift.activation.warning}</p>
          </div>
        )}

        {gallery.length > 0 && (
          <div class="gallery" data-gallery>
            {gallery.map((g, i) => (
              <button type="button" class="gthumb" data-full={g.url} data-i={i} aria-label={`Открыть изображение ${i + 1}`}>
                <img src={`${g.url}?width=240&height=180&fit=contain&format=webp`} alt={`${product.name} — изображение ${i + 1}`} loading="lazy" width="120" height="90" />
              </button>
            ))}
          </div>
        )}

        {product.description && !gift && (
          <div class="prose-bizsoft block">
            <h2>Описание</h2>
            <div class="collapsible clamped" data-collapsible><p>{product.description}</p></div>
            <button class="readmore" data-readmore hidden>Развернуть ▾</button>
          </div>
        )}

        {features.length > 0 && !gift && (
          <div class="block">
            <h2>Что входит</h2>
            <ul class="features">{features.map((f) => <li>{f}</li>)}</ul>
          </div>
        )}

        <div class="block">
          <h2>Характеристики</h2>
          <table class="specs">
            <tbody>
              {product.vendor && <tr><th>Производитель</th><td>{vendorLegal(product.vendor)}</td></tr>}
              {product.origin && <tr><th>Происхождение</th><td>{ORIGIN_LABEL[product.origin]}</td></tr>}
              {category && <tr><th>Категория</th><td>{category.name}</td></tr>}
              {product.license_type && <tr><th>Тип использования</th><td>{LICENSE_LABEL[product.license_type]}</td></tr>}
              {isGift && giftRegions.length > 0 && (
                <tr><th>Регионы</th><td>{giftRegions.map((r) => `${r.name} (${r.currency})`).join(', ')}</td></tr>
              )}
              {isGift && giftRegions.length > 0 && (
                <tr><th>Номиналов</th><td>{giftRegions.reduce((n, r) => n + r.variants.length, 0)}</td></tr>
              )}
              <tr><th>Артикул</th><td>{product.sku}</td></tr>
              {(!byRequest || isGift) && vat > 0 && <tr><th>НДС</th><td>в т.ч. {vat}%</td></tr>}
            </tbody>
          </table>
        </div>

        {product.for_whom && (
          <div class="block">
            <h2>Для кого подходит</h2>
            <p class="muted">{product.for_whom}</p>
          </div>
        )}

        {useCases.length > 0 && (
          <div class="block">
            <h2>Какие задачи закрывает</h2>
            <ul class="features">{useCases.map((u) => <li>{u}</li>)}</ul>
          </div>
        )}

        {isGift ? (
          <div class="block">
            <h2>Как купить {gift?.shortName || product.name} для юридического лица</h2>
            <ol class="steps">
              <li>Выбираете {gift?.regionLabel ? gift.regionLabel.toLowerCase() : 'регион аккаунта'} и вариант, добавляете позицию в избранное и формируете заявку или КП.</li>
              <li>Заключаем договор и выставляем счёт на оплату в рублях.</li>
              <li>{gift?.deliveryNote || 'После оплаты передаём цифровой код на указанную почту.'}</li>
              <li>Передаём закрывающие документы через ЭДО.</li>
            </ol>
            <p class="muted">Оформляем на юридическое лицо или ИП: счёт в рублях,
            оплата с расчётного счёта, зарубежная карта не требуется. Цена
            зависит от региона и номинала и фиксируется в счёте и КП.</p>
            {gift && <p class="muted">{gift.availabilityNote}</p>}
          </div>
        ) : (
          <div class="block">
            <h2>Как купить {product.name} для юридического лица</h2>
            <ol class="steps">
              <li>Добавляете товар в избранное и формируете заявку или КП.</li>
              <li>Заключаем договор и выставляем счёт на оплату.</li>
              <li>После оплаты предоставляем доступ к сервису или аккаунту.</li>
              <li>Передаём закрывающие документы через ЭДО.</li>
            </ol>
            <p class="muted">Подписку или лицензию оформляем из России на
            юридическое лицо: счёт в рублях, оплата с расчётного счёта,
            зарубежная карта не требуется. Стоимость зависит от редакции,
            числа рабочих мест и срока — актуальную цену указываем в счёте
            и КП.</p>
          </div>
        )}

        <div class="block">
          <h2>Что получает юридическое лицо</h2>
          <ul class="features">
            <li>Договор поставки/оказания услуг</li>
            <li>Счёт на оплату по безналу в рублях</li>
            <li>Акт об оказании услуг</li>
            <li>Закрывающие документы через ЭДО</li>
          </ul>
        </div>

        {product.seo_text && (
          <div class="prose-bizsoft block"><p>{product.seo_text}</p></div>
        )}

        <FAQ items={faq} title={gift ? 'Вопросы и ответы' : 'Частые вопросы о товаре'} />

        {relatedProducts.length > 0 && (
          <div class="block">
            <h2>Похожие товары</h2>
            <div class="related-grid">
              {relatedProducts.map((rp) => (
                <a href={`/product/${rp.slug}`} class="card card-hover related-card">
                  <strong>{rp.name}</strong>
                  {rp.vendor && <span>{rp.vendor}</span>}
                </a>
              ))}
            </div>
          </div>
        )}

        {blogLinks.length > 0 && (
          <div class="block">
            <h2>Полезные статьи</h2>
            <ul class="blog-links">
              {blogLinks.map((b) => (
                <li><a href={`/blog/${b.id}`}>{b.title}</a></li>
              ))}
            </ul>
          </div>
        )}

        {aiLinks && (
          <div class="block ai-interlinks">
            <div class="il-col">
              <h3>Сравнения</h3>
              <ul>{aiLinks.compare.map((l) => <li><a href={l.href}>{l.label} →</a></li>)}</ul>
            </div>
            <div class="il-col">
              <h3>База знаний</h3>
              <ul>{aiLinks.articles.map((l) => <li><a href={l.href}>{l.label} →</a></li>)}</ul>
            </div>
            <div class="il-col">
              <h3>Категория</h3>
              <ul><li><a href={aiLinks.category.href}>{aiLinks.category.label} →</a></li></ul>
            </div>
          </div>
        )}
      </div>

      <aside class="product-aside">
        {isGift ? (
          <div {...mdOffer}>
            {hasMd && giftRange && (
              <>
                <link itemprop="url" href={canonicalProductUrl} />
                <meta itemprop="lowPrice" content={String(giftRange.low)} />
                <meta itemprop="highPrice" content={String(giftRange.high)} />
                <meta itemprop="offerCount" content={String(giftRange.count)} />
                <meta itemprop="priceCurrency" content={product.currency || 'RUB'} />
                <link itemprop="availability" href="https://schema.org/InStock" />
              </>
            )}
            <GiftCardSelector
              regions={giftRegions}
              initial={giftInitial}
              productName={product.name}
              sku={product.sku}
              vendor={product.vendor || ''}
              regionLabel={gift?.regionLabel}
              denominationNote={gift?.denominationNote || 'Номинал — сумма, которая будет зачислена на баланс аккаунта после активации.'}
              regionWarning={gift?.regionWarning || 'Карта предназначена только для аккаунта соответствующего региона: проверьте регион учётной записи до заказа.'}
              availabilityNote={gift?.availabilityNote || 'Количество кодов отдельных номиналов может быть ограничено.'}
              rateDate={rateDate}
              vat={vat}
            />
          </div>
        ) : (
        <div class="card buy-card" {...mdOffer}>
          {!byRequest && (
            <>
              <link itemprop="url" href={canonicalProductUrl} />
              <meta itemprop="price" content={String(eff.price)} />
              <meta itemprop="priceCurrency" content={product.currency || 'RUB'} />
              <link itemprop="availability" href="https://schema.org/InStock" />
            </>
          )}
          {byRequest ? (
            <div class="price-req">Цена по запросу</div>
          ) : (
            <PriceTag product={product} size="lg" />
          )}
          {product.price_note && !byRequest && (
            <p class="price-note">
              {product.price_note}
              {vat > 0 && (
                <details class="vat-hint">
                  <summary>в т.ч. НДС {vat}% ⓘ</summary>
                  <span>
                    Налог включён в цену, сверху не добавляется. В счёте, КП и
                    закрывающих документах выделен отдельной строкой.
                    {' '}Принимается к вычету, если вы на общей системе.
                    {' '}<a href="/blog/zakryvayushchie-dokumenty-na-po">Подробнее о документах</a>
                  </span>
                </details>
              )}
            </p>
          )}
          {!byRequest && rateDate && <p class="rate-note">Цена рассчитана по курсу ЦБ на {rateDate} и фиксируется в счёте.</p>}
          {byRequest && <p class="price-note">Рассчитаем стоимость под вашу конфигурацию и количество.</p>}

          {!byRequest && (
            <div class="qty-row">
              <span class="qty-label">Количество</span>
              <div class="qty" data-qty-wrap>
                <button type="button" data-dec aria-label="Меньше">−</button>
                <input type="number" min="1" value="1" data-qty aria-label="Количество" />
                <button type="button" data-inc aria-label="Больше">+</button>
              </div>
            </div>
          )}

          {!byRequest && (
            <div class="total-row">
              <span>Итого</span>
              <b data-total>{formatRub(eff.price)}</b>
            </div>
          )}

          {!byRequest && (
            <div class="team-calc">
              <span class="tc-cap">Сколько выйдет на команду</span>
              {[5, 10, 30].map((n) => (
                <button type="button" class="tc-row" data-team={n}>
                  <span>{n} мест</span><b>{formatRub(eff.price * n)}</b>
                </button>
              ))}
            </div>
          )}

          <div class="buy-actions">
            {byRequest ? (
              <button class="btn btn-primary" data-open-question data-product={product.name} data-sku={product.sku}>Запросить цену</button>
            ) : (
              <button
                class="btn btn-primary add-to-cart"
                data-add-cart
                data-sku={product.sku}
                data-slug={product.slug}
                data-name={product.name}
                data-price={eff.price}
              >
                <span class="lbl-def">В избранное</span><span class="lbl-add" hidden>Добавлено ✓</span>
              </button>
            )}
            <button class="btn btn-ghost" data-open-question data-product={product.name} data-sku={product.sku}>Задать вопрос</button>
          </div>

          <ul class="buy-trust">
            <li>✓ Договор и счёт в рублях</li>
            <li>✓ Закрывающие через ЭДО</li>
            <li>✓ Поддержка на весь срок</li>
          </ul>
        </div>
        )}
      </aside>
    </div>
  </div>

  <!-- Лайтбокс -->
  <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Просмотр изображения товара">
    <button class="lb-close" data-lb-close aria-label="Закрыть">✕</button>
    <button class="lb-nav lb-prev" data-lb-prev aria-label="Назад">‹</button>
    <img data-lb-img src="" alt={product.name} />
    <button class="lb-nav lb-next" data-lb-next aria-label="Вперёд">›</button>
  </div>

  <CTASection />
  <QuestionForm source="product" />
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .product-layout { display: grid; grid-template-columns: 1fr 360px; gap: 3rem; align-items: start; }
  .badges { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.7rem; }
  .badge { font-size: 0.74rem; font-weight: 600; padding: 0.18rem 0.55rem; border-radius: 6px; background: var(--color-bg-elevated); color: var(--color-text-muted); }
  .badge[data-origin='domestic'] { background: color-mix(in srgb, var(--color-success) 18%, transparent); color: var(--color-success); }
  .badge[data-origin='foreign'] { background: color-mix(in srgb, var(--color-accent) 16%, transparent); color: var(--color-accent); }
  .badge-link:hover { color: var(--color-accent); }
  .sku { color: var(--color-text-dim); font-size: 0.85rem; }
  h1 { font-size: clamp(1.8rem, 3.5vw, 2.6rem); margin: 0.4rem 0 1rem; }
  /* Профильный значок продукта рядом с названием */
  .h1-ico { display: flex; align-items: center; gap: 0.7rem; }
  .lead { color: var(--color-text-muted); font-size: 1.1rem; max-width: 60ch; }
  .gallery { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1.4rem; }
  .gthumb { padding: 0; border: 1px solid var(--color-border); border-radius: 10px; background: #fff; cursor: zoom-in; overflow: hidden; }
  .gthumb img { display: block; width: 120px; height: 90px; object-fit: contain; }
  .block { margin-top: 2.2rem; }
  .block h2 { font-size: 1.4rem; margin-bottom: 0.9rem; }
  .collapsible.clamped { display: -webkit-box; -webkit-line-clamp: 8; line-clamp: 8; -webkit-box-orient: vertical; overflow: hidden; }
  /* Описание в Directus хранится абзацами через перевод строки — сохраняем разбивку,
     иначе текст склеивается в сплошную простыню. */
  .collapsible p { white-space: pre-line; }
  .blog-links { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .blog-links a { color: var(--color-accent); font-weight: 600; }
  .readmore { margin-top: 0.6rem; background: none; border: none; color: var(--color-accent); font-weight: 600; cursor: pointer; padding: 0; font-size: 0.92rem; }
  .features { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .features li { padding-left: 1.6rem; position: relative; color: var(--color-text); }
  .features li::before { content: '✓'; position: absolute; left: 0; color: var(--color-accent); font-weight: 700; }
  .specs { width: 100%; border-collapse: collapse; }
  .specs th, .specs td { text-align: left; padding: 0.55rem 0.8rem; border-bottom: 1px solid var(--color-border); font-size: 0.93rem; }
  .specs th { color: var(--color-text-muted); font-weight: 500; width: 40%; }
  .steps { padding-left: 1.2rem; color: var(--color-text); display: grid; gap: 0.5rem; }
  .product-aside { position: sticky; top: 124px; }
  .buy-card { padding: 1.6rem; display: flex; flex-direction: column; gap: 1rem; }
  .price-req { font-weight: 800; font-size: 1.5rem; }
  .price-note { color: var(--color-text-dim); font-size: 0.82rem; margin: 0; }
  .vat-hint { display: inline-block; margin-left: 0.3rem; }
  .vat-hint summary { display: inline; cursor: pointer; color: var(--color-accent); list-style: none; }
  .vat-hint summary::-webkit-details-marker { display: none; }
  .vat-hint span { display: block; margin-top: 0.4rem; padding: 0.6rem 0.8rem; background: var(--color-bg-elevated); border-radius: 8px; color: var(--color-text-muted); font-size: 0.82rem; }
  .rate-note { color: var(--color-text-dim); font-size: 0.8rem; margin: 0; }
  .team-calc { border-top: 1px dashed var(--color-border); padding-top: 0.8rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .tc-cap { font-size: 0.8rem; color: var(--color-text-dim); font-weight: 600; }
  .tc-row { display: flex; justify-content: space-between; align-items: baseline; background: none; border: none; padding: 0.25rem 0; font: inherit; font-size: 0.9rem; color: var(--color-text-muted); cursor: pointer; }
  .tc-row b { color: var(--color-text); font-variant-numeric: tabular-nums; }
  .tc-row:hover span { color: var(--color-accent); }
  .qty-row { display: flex; align-items: center; justify-content: space-between; }
  .qty-label { color: var(--color-text-muted); font-size: 0.9rem; }
  .qty { display: flex; align-items: center; gap: 0.3rem; }
  .qty button { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--color-border-strong); background: var(--color-bg-elevated); color: var(--color-text); cursor: pointer; font-size: 1.1rem; }
  .qty input { width: 52px; text-align: center; background: var(--color-bg-elevated); border: 1px solid var(--color-border-strong); border-radius: 8px; color: var(--color-text); padding: 0.4rem; font: inherit; }
  .total-row { display: flex; align-items: baseline; justify-content: space-between; border-top: 1px solid var(--color-border); padding-top: 0.8rem; }
  .total-row b { font-size: 1.4rem; }
  .buy-actions { display: flex; flex-direction: column; gap: 0.6rem; }
  .buy-actions .btn { width: 100%; }
  .buy-trust { list-style: none; padding: 1rem 0 0; margin: 0; border-top: 1px solid var(--color-border); display: grid; gap: 0.4rem; color: var(--color-text-muted); font-size: 0.88rem; }
  .muted { color: var(--color-text-muted); max-width: 65ch; }
  /* Подарочные карты: предупреждение о регионе и списки номиналов по регионам */
  .gift-intro { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 1rem; }
  .gift-warn { margin: 0; padding: 0.8rem 1rem; border-radius: 10px; font-weight: 600; line-height: 1.45; max-width: 70ch;
    background: color-mix(in srgb, #e07b00 14%, transparent); border: 1px solid color-mix(in srgb, #e07b00 45%, transparent); }
  .small-note { font-size: 0.88rem; }
  .gift-denoms { list-style: none; padding: 0; margin: 0.8rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.4rem; }
  .gift-pick { width: 100%; display: grid; grid-template-columns: auto auto 1fr; align-items: baseline; gap: 0.5rem; text-align: left; padding: 0.5rem 0.8rem;
    border-radius: 10px; border: 1px solid var(--color-border); background: var(--color-bg-card); color: var(--color-text); font: inherit; cursor: pointer; }
  .gift-pick:hover { border-color: var(--color-accent); }
  .gift-pick:disabled { opacity: 0.55; cursor: not-allowed; }
  .gp-nom { font-weight: 700; font-variant-numeric: tabular-nums; }
  .gp-arrow { color: var(--color-text-dim); }
  .gp-price { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
  .ai-interlinks { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.2rem; }
  .ai-interlinks h3 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-dim); margin-bottom: 0.6rem; }
  .ai-interlinks ul { list-style: none; padding: 0; display: grid; gap: 0.4rem; }
  .ai-interlinks a { color: var(--color-accent); font-weight: 600; font-size: 0.92rem; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.8rem; }
  .related-card { padding: 1rem 1.2rem; display: flex; flex-direction: column; gap: 0.2rem; }
  .related-card strong { font-size: 0.98rem; }
  .related-card span { color: var(--color-text-dim); font-size: 0.8rem; }
  .lightbox { position: fixed; inset: 0; background: rgba(0,0,0,0.9); z-index: 100; display: flex; align-items: center; justify-content: center; }
  .lightbox[hidden] { display: none; }
  .lightbox img { max-width: 90vw; max-height: 88vh; object-fit: contain; background: #fff; border-radius: 8px; }
  .lb-close { position: absolute; top: 1rem; right: 1.2rem; background: none; border: none; color: #fff; font-size: 1.6rem; cursor: pointer; }
  .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.12); border: none; color: #fff; font-size: 2rem; width: 48px; height: 48px; border-radius: 999px; cursor: pointer; }
  .lb-prev { left: 1rem; } .lb-next { right: 1rem; }
  @media (max-width: 900px) {
    .product-layout { grid-template-columns: 1fr; }
    .product-aside { position: static; }
    /* Подарочная карта: выбор региона и номинала — первым экраном, до описания */
    .product-layout.gift .product-aside { order: -1; }
    /* Более удобные зоны нажатия на мобильном */
    .qty button { width: 40px; height: 40px; }
    .qty input { height: 40px; }
  }
</style>

<script>
  import { trackGoal } from '@/lib/analytics';
  import { addToCart } from '../../lib/cart-client';
  import { formatRub } from '../../lib/pricing';

  // ── «Развернуть/Свернуть» длинного описания (Cut) ──
  document.querySelectorAll('[data-collapsible]').forEach((el) => {
    const box = el as HTMLElement;
    const btn = box.parentElement?.querySelector('[data-readmore]') as HTMLElement | null;
    if (!btn) return;
    if (box.scrollHeight > box.clientHeight + 4) {
      btn.hidden = false;
      btn.addEventListener('click', () => {
        const clamped = box.classList.toggle('clamped');
        btn.textContent = clamped ? 'Развернуть ▾' : 'Свернуть ▴';
      });
    }
  });

  // ── Количество + живой пересчёт (карточка покупки; у подарочной карты
  // свой блок с теми же data-атрибутами — его обслуживает GiftCardSelector) ──
  const buyCard = document.querySelector<HTMLElement>('.buy-card');
  const qtyInput = buyCard?.querySelector<HTMLInputElement>('[data-qty]') ?? null;
  const totalEl = buyCard?.querySelector<HTMLElement>('[data-total]') ?? null;
  const addBtn = buyCard?.querySelector<HTMLButtonElement>('[data-add-cart]') ?? null;
  const unit = addBtn ? Number(addBtn.dataset.price || 0) : 0;
  buyCard?.querySelectorAll<HTMLButtonElement>('[data-team]').forEach((b) => {
    b.addEventListener('click', () => {
      if (qtyInput) { qtyInput.value = b.dataset.team || '1'; qtyInput.dispatchEvent(new Event('input', { bubbles: true })); }
    });
  });

  function curQty() { return Math.max(1, Math.floor(Number(qtyInput?.value || 1) || 1)); }
  function refreshTotal() { if (totalEl) totalEl.textContent = formatRub(unit * curQty()); }

  buyCard?.querySelector('[data-inc]')?.addEventListener('click', () => { if (qtyInput) { qtyInput.value = String(curQty() + 1); refreshTotal(); } });
  buyCard?.querySelector('[data-dec]')?.addEventListener('click', () => { if (qtyInput) { qtyInput.value = String(Math.max(1, curQty() - 1)); refreshTotal(); } });
  qtyInput?.addEventListener('input', refreshTotal);
  refreshTotal();

  // Просмотр карточки: знаменатель для добавлений в подборку. Без него
  // «добавили 3 раза» не говорит ничего — 3 из 5 и 3 из 500 разные вещи.
  const giftRoot = document.querySelector<HTMLElement>('[data-gift-card]');
  trackGoal('view_product', {
    sku: addBtn?.dataset.sku || giftRoot?.dataset.sku || '',
    slug: addBtn?.dataset.slug || location.pathname,
  });

  addBtn?.addEventListener('click', () => {
    addToCart({ sku: addBtn.dataset.sku!, slug: addBtn.dataset.slug!, name: addBtn.dataset.name!, price: unit }, curQty());
    trackGoal('add_to_cart', { sku: addBtn.dataset.sku || '' });
    const def = addBtn.querySelector('.lbl-def') as HTMLElement;
    const add = addBtn.querySelector('.lbl-add') as HTMLElement;
    def.hidden = true; add.hidden = false;
    setTimeout(() => { def.hidden = false; add.hidden = true; }, 1600);
  });

  // ── Подарочная карта: выбор номинала из региональных списков → селектор ──
  document.querySelectorAll<HTMLButtonElement>('[data-pick-sku]').forEach((b) => {
    b.addEventListener('click', () => {
      const sku = (b.dataset.pickSku || '').toUpperCase();
      const target = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gift-card] [data-variant]'))
        .find((v) => (v.dataset.sku || '').toUpperCase() === sku);
      if (!target) return;
      const panel = target.closest<HTMLElement>('[data-region-panel]');
      const regionBtn = panel ? document.querySelector<HTMLButtonElement>(`[data-gift-card] [data-region="${panel.dataset.regionPanel}"]`) : null;
      regionBtn?.click();
      target.click();
      document.querySelector('[data-gift-card]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // ── Лайтбокс галереи ──
  const lb = document.querySelector('[data-lightbox]') as HTMLElement | null;
  const lbImg = document.querySelector('[data-lb-img]') as HTMLImageElement | null;
  const thumbs = Array.from(document.querySelectorAll('[data-full]')) as HTMLElement[];
  let cur = 0;
  function show(i: number) {
    if (!lb || !lbImg || thumbs.length === 0) return;
    cur = (i + thumbs.length) % thumbs.length;
    lbImg.src = thumbs[cur].dataset.full!;
    lb.hidden = false;
  }
  thumbs.forEach((t, i) => t.addEventListener('click', () => show(i)));
  document.querySelector('[data-lb-close]')?.addEventListener('click', () => { if (lb) lb.hidden = true; });
  document.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(cur - 1));
  document.querySelector('[data-lb-next]')?.addEventListener('click', () => show(cur + 1));
  lb?.addEventListener('click', (e) => { if (e.target === lb) lb.hidden = true; });
  document.addEventListener('keydown', (e) => {
    if (!lb || lb.hidden) return;
    if (e.key === 'Escape') lb.hidden = true;
    if (e.key === 'ArrowLeft') show(cur - 1);
    if (e.key === 'ArrowRight') show(cur + 1);
  });
</script>

    .product-layout { grid-template-columns: minmax(0, 1fr); }
    .col-hero, .col-rest, .product-aside { grid-column: 1; grid-row: auto; }
    .product-aside { position: static; margin-top: 1.5rem; }
    .buy-bar {
      display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      background: var(--color-bg-card); border-top: 1px solid var(--color-border-strong);
      box-shadow: 0 -6px 18px rgba(0, 0, 0, 0.08);
      padding: 0.55rem 0; padding-bottom: calc(0.55rem + env(safe-area-inset-bottom, 0px));
    }
    .buy-bar[hidden] { display: none; }
    .bb-inner { display: flex; align-items: center; gap: 0.8rem; }
    .bb-sum { display: flex; flex-direction: column; line-height: 1.2; }
    .bb-sum b { font-size: 1rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .bb-qty { font-size: 0.72rem; color: var(--color-text-dim); }

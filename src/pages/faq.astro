---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSteps from '../components/HeroSteps.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { policyFaq } from '../data/policies';

const faq = policyFaq('/faq');
---
<BaseLayout title="Вопросы и ответы" description="Частые вопросы о покупке ПО для юрлиц через BIZSoft: договор, счёт, ЭДО, сроки поставки, стоимость и КП.">
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'FAQ', url: '/faq' }]} />
    <header class="head hero-cols">
      <div>
      <h1>Частые вопросы</h1>
      <p class="lead">Коротко о том, как мы работаем, оформляем документы и считаем стоимость.</p>
    </div>
      <HeroSteps />
    </header>
    <FAQ items={faq} title="" />
  </div>
  <CTASection />
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .head { max-width: 720px; margin-bottom: 1.5rem; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); margin-bottom: 1rem; }
  .lead { color: var(--color-text-muted); font-size: 1.08rem; }
</style>

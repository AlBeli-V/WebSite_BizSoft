---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';

const faq = [
  { q: 'Как купить ПО для юрлица через BizSoft?', a: 'Соберите нужные сервисы в корзину и нажмите «Получить КП» либо оставьте заявку. Мы заключим договор, выставим счёт, после оплаты предоставим доступы и передадим закрывающие документы через ЭДО.' },
  { q: 'Вы работаете по договору и даёте закрывающие документы?', a: 'Да. Работаем по договору с оплатой по счёту. Закрывающие документы (акт, при необходимости счёт-фактуру) передаём через электронный документооборот.' },
  { q: 'Сколько стоит подписка?', a: 'Цены в каталоге ориентировочные. Итоговую стоимость рассчитываем под состав, количество пользователей, срок и актуальный курс ЦБ РФ и фиксируем в счёте.' },
  { q: 'Чем вы отличаетесь от покупки напрямую?', a: 'Мы оформляем поставку под российское юрлицо: договор, счёт в рублях, закрывающие документы для бухгалтерии и сопровождение. Это снимает с вас вопросы оплаты и документов.' },
  { q: 'Как быстро происходит поставка?', a: 'Договор и счёт — обычно в течение рабочего дня. Поставка доступов — в оговорённый срок, чаще всего 1–3 рабочих дня.' },
  { q: 'В какой валюте оплата?', a: 'Оплата в рублях по счёту с расчётного счёта организации.' },
  { q: 'Можно ли получить коммерческое предложение в PDF?', a: 'Да. В корзине нажмите «Получить КП» — сформируем PDF с реквизитами, составом и итогом, отправим на e-mail и дадим скачать.' },
];
---
<BaseLayout title="Вопросы и ответы" description="Частые вопросы о покупке ПО для юрлиц через BizSoft: договор, счёт, ЭДО, сроки поставки, стоимость и КП.">
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'FAQ', url: '/faq/' }]} />
    <header class="head">
      <h1>Частые вопросы</h1>
      <p class="lead">Коротко о том, как мы работаем, оформляем документы и считаем стоимость.</p>
    </header>
    <FAQ items={faq} title="" />
  </div>
  <CTASection />
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .head { max-width: 720px; margin-bottom: 1.5rem; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); margin-bottom: 1rem; }
  .lead { color: var(--color-text-muted); font-size: 1.08rem; }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSteps from '../components/HeroSteps.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import { seller, expert, workingHours, knowsAbout } from '../config/site';

const values = [
  { t: 'Легально', d: 'Только оформленная поставка с договором, счётом и закрывающими документами.' },
  { t: 'Прозрачно', d: 'Понятные условия, реквизиты и сроки. Никаких скрытых платежей.' },
  { t: 'Ответственно', d: 'Отвечаем за своевременность поставки и работоспособность доступов.' },
];
---
<BaseLayout title="О компании" description="BIZSoft (ИП Беляев А.В.) — поставка подписок на зарубежное ПО для российских юрлиц по договору и счёту с закрывающими документами через ЭДО.">
  <div class="container-page section">
    <Breadcrumbs items={[{ name: 'О нас', url: '/about' }]} />
    <header class="head hero-cols">
      <div>
      <h1>О компании BIZSoft</h1>
      <p class="lead">BIZSoft помогает российским организациям легально пользоваться нужными зарубежными ПО-сервисами: оформляем поставку по договору, с оплатой по счёту и закрывающими документами для бухгалтерии.</p>
    </div>
      <HeroSteps />
    </header>

    <div class="prose-bizsoft block">
      <h2>Что мы делаем</h2>
      <p>Мы подбираем и поставляем подписки и доступы к сервисам — AI-инструментам для текста, кода и графики, графическим редакторам, видеоконференцсвязи и инструментам разработки. Берём на себя оформление: договор, счёт, своевременную поставку и передачу закрывающих документов через ЭДО.</p>
      <h2>Почему это удобно бизнесу</h2>
      <p>Бухгалтерии нужен полный пакет документов, а компании — работающий доступ в срок. Мы закрываем обе задачи: вы платите по счёту с расчётного счёта и получаете акт через электронный документооборот.</p>

      <h2>Как устроена поставка</h2>
      <p>Порядок один для любого сервиса. Вы описываете задачу: какой продукт, сколько лицензий, на какой срок. Мы проверяем условия вендора для российских юрлиц, подбираем тариф и готовим коммерческое предложение или счёт с ценой в рублях по курсу ЦБ РФ. После согласования заключаем договор, вы оплачиваете с расчётного счёта, мы рассчитываемся с вендором и передаём доступ, ключи или инструкции по активации. Закрывающие документы уходят через ЭДО. Продление оформляется тем же порядком: счёт выставляем до конца оплаченного периода, чтобы доступ не прерывался.</p>
      <p>Подробный порядок с оговорками и сроками — в разделе <a href="/how-we-work">«Как мы работаем»</a>, состав документов — на странице <a href="/documents">«Документы»</a>, ответы на частые вопросы — в <a href="/faq">FAQ</a>.</p>

      <h2>С чем мы работаем</h2>
      <ul>{knowsAbout.map((k) => <li>{k}</li>)}</ul>
      <p>Что именно поставляем — <a href="/catalog">в каталоге</a>; разборы по конкретным сервисам собраны в <a href="/blog">базе знаний</a>, сравнения — в разделе <a href="/compare">«Сравнения»</a>, замены недоступным сервисам — в разделе <a href="/alternatives">«Аналоги»</a>.</p>

      <h2>Кто отвечает</h2>
      <p>За подбор, сделку и материалы сайта отвечает <a href={`/authors/${expert.slug}`}>{expert.fullName}</a>, {expert.jobTitle.toLowerCase()}. {expert.tagline} Связаться напрямую: <a href={`mailto:${expert.email}`}>{expert.email}</a>, {seller.phone}. Работаем {workingHours.label}.</p>
    </div>

    <div class="values">
      {values.map((v) => (<div class="card val reveal"><h3>{v.t}</h3><p>{v.d}</p></div>))}
    </div>

    <p class="req">Продавец: {seller.legalName}. ИНН {seller.inn}, ОГРНИП {seller.ogrnip}. На учёте с {seller.registrationDate}. Адрес: {seller.address}.</p>
  </div>
  <CTASection />
</BaseLayout>

<style>
  .section { padding-top: 2rem; }
  .head { max-width: 760px; margin-bottom: 2rem; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); margin-bottom: 1rem; }
  .lead { color: var(--color-text-muted); font-size: 1.08rem; }
  .block { margin-bottom: 2.5rem; }
  .values { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.2rem; margin-bottom: 2rem; }
  .val { padding: 1.5rem; }
  .val h3 { font-size: 1.2rem; margin-bottom: 0.5rem; color: var(--color-accent); }
  .val p { color: var(--color-text-muted); font-size: 0.94rem; }
  .req { color: var(--color-text-dim); font-size: 0.9rem; }
</style>

---
/**
 * Старый адрес политики. Постоянные адреса правовых документов — /legal/*
 * (ТЗ 16.09.2026, п. 1), но /privacy уже в индексе и на него ссылается всё,
 * что выпущено до 16.09.2026: формы, письма, внешние страницы.
 *
 * Отдаём настоящий 301, а не meta-refresh: страница обязана ssr-иться, иначе
 * в статике получилась бы HTML-заглушка с перенаправлением на стороне
 * браузера, и поисковик держал бы оба адреса.
 */
export const prerender = false;
import { LEGAL_LINKS } from '../config/legal';
---
{Astro.redirect(LEGAL_LINKS.privacy, 301)}

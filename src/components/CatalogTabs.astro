---
/**
 * Переключатель разделов каталога «Производители | Категории» —
 * единая навигация между /vendors и /catalog (как у крупных софт-магазинов).
 */
interface Props {
  active: 'vendors' | 'categories';
}
const { active } = Astro.props;
---
<nav class="cat-tabs" aria-label="Разделы каталога">
  <a href="/vendors" class:list={['cat-tab', { active: active === 'vendors' }]} aria-current={active === 'vendors' ? 'page' : undefined}>Производители</a>
  <a href="/catalog" class:list={['cat-tab', { active: active === 'categories' }]} aria-current={active === 'categories' ? 'page' : undefined}>Категории</a>
</nav>

<style>
  .cat-tabs { display: flex; gap: 1.8rem; border-bottom: 1px solid var(--color-border); margin-bottom: 1.6rem; }
  .cat-tab {
    padding: 0.6rem 0.2rem 0.7rem;
    font-size: 1.02rem; font-weight: 700; letter-spacing: 0.02em;
    color: var(--color-text-dim); text-transform: uppercase;
    border-bottom: 3px solid transparent; margin-bottom: -1px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .cat-tab:hover { color: var(--color-text); }
  .cat-tab.active { color: var(--color-text); border-bottom-color: var(--color-accent); }
</style>

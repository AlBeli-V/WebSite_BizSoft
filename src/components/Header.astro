---
import { mainNav, site, seller, vendorLandings } from '../config/site';
import SiteLogo from './SiteLogo.astro';
import CategoryIcon from './CategoryIcon.astro';
import { getVendors, getCategories } from '../lib/directus';
import { logoFile } from '../data/logos';
import { VENDORS } from '../data/vendors';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const vendorsActive = path.startsWith('/vendors');
const typeActive = path.startsWith('/catalog');

// «Производители» и «Тип» — живые раскрывающиеся списки (кэш 60 c в directus.ts).
const slugByName = new Map<string, string>();
const landingSlugs = new Set<string>();
for (const v of VENDORS) {
  slugByName.set(v.vendor.toLowerCase(), v.slug);
  if (v.title) slugByName.set(v.title.toLowerCase(), v.slug);
  landingSlugs.add(v.slug);
}
for (const l of vendorLandings) {
  slugByName.set(l.name.toLowerCase(), l.slug);
  landingSlugs.add(l.slug);
}
const AI_SLUGS: Record<string, string> = {
  openai: 'openai', anthropic: 'anthropic', github: 'github', cursor: 'cursor',
  microsoft: 'microsoft', google: 'google', perplexity: 'perplexity', notion: 'notion',
  gamma: 'gamma', grammarly: 'grammarly', jasper: 'jasper',
  magnific: 'freepik', 'magnific (freepik)': 'freepik',
};
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const vendorSlug = (name: string) => slugByName.get(name.toLowerCase()) || AI_SLUGS[name.toLowerCase()] || slugify(name);

let ddVendors: { name: string; href: string; logo?: string }[] = [];
let ddCats: { name: string; slug: string }[] = [];
try {
  ddVendors = (await getVendors()).map((r) => {
    const slug = vendorSlug(r.vendor);
    const m = r.vendor.match(/^(.+?)\s*\((.+)\)$/);
    return {
      name: m ? m[1] : r.vendor,
      href: landingSlugs.has(slug) ? `/vendors/${slug}` : `/catalog?q=${encodeURIComponent(r.vendor)}`,
      logo: slug === 'freepik' ? '/brand-logos/magnific-logo.svg' : logoFile(slug),
    };
  }).sort((a, b) => a.name.localeCompare(b.name, 'en'));
} catch { /* фолбэк ниже — статичные лендинги */ }
if (ddVendors.length === 0) {
  ddVendors = vendorLandings.map((v) => ({ name: v.name, href: `/vendors/${v.slug}`, logo: logoFile(v.slug) }));
}
try {
  ddCats = (await getCategories()).map((c) => ({ name: c.name, slug: c.slug }));
} catch { /* меню «Тип» покажет только ссылку на каталог */ }

const navRest = mainNav.filter((i) => i.href !== '/catalog');
---
<header class="site-header">
  <!-- Ряд 1: логотип · каталог · поиск · телефон · корзина · КП -->
  <div class="container-page header-inner">
    <a href="/" class="wordmark" aria-label={`${site.name} — на главную`}>
      <SiteLogo variant="header" />
    </a>

    <form class="h-search" action="/catalog" method="get" role="search">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="search" name="q" placeholder="Поиск: ChatGPT, Figma, JetBrains…" aria-label="Поиск по каталогу" />
    </form>

    <a href={`tel:${seller.phoneHref}`} class="h-phone">
      {seller.phone}
      <small>Пн–Пт 10:00–19:00</small>
    </a>

    <div class="header-actions">
      <a href="/cart" class="cart-link" aria-label="Корзина">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="cart-count" data-cart-count hidden>0</span>
      </a>
      <a href="/pricing" class="btn btn-primary btn-kp" data-goal="header_kp">Получить КП</a>
      <button class="burger" aria-label="Меню" aria-expanded="false" data-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Ряд 2: навигация -->
  <div class="nav-row">
    <div class="container-page">
    <nav class="main-nav" aria-label="Главное меню">
      <div class="nav-dd">
        <a href="/vendors" class:list={['nav-link', 'nav-dd-toggle', { active: vendorsActive }]} aria-haspopup="true" aria-expanded="false" data-dd-toggle>
          Производители
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        </a>
        <div class="nav-dd-menu dd-scroll dd-cols" role="menu">
          {ddVendors.map((v) => (
            <a href={v.href} class="dd-item dd-logo-item" role="menuitem">
              {v.logo ? <img src={v.logo} alt="" width="18" height="18" loading="lazy" /> : <span class="dd-dot" aria-hidden="true">{v.name.charAt(0)}</span>}
              {v.name}
            </a>
          ))}
          <a href="/vendors" class="dd-item dd-all" role="menuitem">Все производители →</a>
        </div>
      </div>
      <div class="nav-dd">
        <a href="/catalog" class:list={['nav-link', 'nav-dd-toggle', { active: typeActive }]} aria-haspopup="true" aria-expanded="false" data-dd-toggle>
          Тип
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        </a>
        <div class="nav-dd-menu dd-scroll" role="menu">
          {ddCats.map((c) => (
            <a href={`/catalog/${c.slug}`} class="dd-item dd-logo-item" role="menuitem">
              <span class="dd-ic"><CategoryIcon slug={c.slug} name={c.name} size={17} /></span>
              {c.name}
            </a>
          ))}
          <a href="/catalog" class="dd-item dd-all" role="menuitem">Весь каталог →</a>
        </div>
      </div>
      {navRest.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="Мобильное меню" data-mobile-nav hidden>
    <form class="m-search" action="/catalog" method="get" role="search">
      <input type="search" name="q" placeholder="Поиск по каталогу…" aria-label="Поиск по каталогу" />
    </form>
    <details class="mobile-dd" open={vendorsActive}>
      <summary class:list={['mobile-link', 'mobile-dd-summary', { active: vendorsActive }]}>
        Производители
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
      </summary>
      <a href="/vendors" class="mobile-link mobile-sub mobile-sub-all">Все производители →</a>
      {ddVendors.map((v) => (
        <a href={v.href} class="mobile-link mobile-sub">{v.name}</a>
      ))}
    </details>
    <details class="mobile-dd" open={typeActive}>
      <summary class:list={['mobile-link', 'mobile-dd-summary', { active: typeActive }]}>
        Тип
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
      </summary>
      <a href="/catalog" class="mobile-link mobile-sub mobile-sub-all">Весь каталог →</a>
      {ddCats.map((c) => (
        <a href={`/catalog/${c.slug}`} class="mobile-link mobile-sub">{c.name}</a>
      ))}
    </details>
    {navRest.map((item) => (
      <a href={item.href} class:list={['mobile-link', { active: isActive(item.href) }]}>{item.label}</a>
    ))}
    <a href="/cart" class="mobile-link">Корзина</a>
    <a href={`tel:${seller.phoneHref}`} class="mobile-link m-phone">{seller.phone}</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    height: 62px;
  }
  .wordmark { white-space: nowrap; --logo-halo: var(--color-bg); }
  /* Поиск */
  .h-search {
    flex: 1; min-width: 120px;
    display: flex; align-items: center; gap: 0.5rem;
    background: var(--color-bg-elevated); border: 1px solid var(--color-border-strong);
    border-radius: 999px; padding: 0.45rem 0.95rem; color: var(--color-text-dim);
  }
  .h-search:focus-within { border-color: var(--color-accent); }
  .h-search input { flex: 1; min-width: 0; border: none; background: transparent; font: inherit; font-size: 0.9rem; color: var(--color-text); outline: none; }
  /* Телефон */
  .h-phone { font-weight: 700; font-size: 0.92rem; white-space: nowrap; text-align: right; line-height: 1.25; color: var(--color-text); }
  .h-phone small { display: block; font-weight: 400; color: var(--color-text-muted); font-size: 0.7rem; }
  .h-phone:hover { color: var(--color-accent); }
  .btn-kp { padding: 0.5rem 1.05rem; font-size: 0.88rem; white-space: nowrap; }
  /* Ряд навигации */
  .nav-row { border-top: 1px solid var(--color-border); }
  .main-nav {
    display: flex;
    gap: 1.4rem;
    padding: 0.5rem 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .main-nav::-webkit-scrollbar { display: none; }
  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    transition: color 0.18s ease;
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
  }
  .nav-link.active {
    color: var(--color-accent);
  }
  /* Выпадающий список «Производители» */
  .nav-dd { position: relative; display: inline-flex; align-items: center; }
  .nav-dd-toggle { display: inline-flex; align-items: center; gap: 3px; cursor: pointer; }
  .nav-dd-toggle svg { opacity: 0.65; transition: transform 0.18s ease; }
  .nav-dd:hover .nav-dd-toggle svg, .nav-dd:focus-within .nav-dd-toggle svg { transform: rotate(180deg); }
  .nav-dd-menu {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(6px);
    min-width: 230px; padding: 6px; margin-top: 8px;
    background: var(--color-bg-card); border: 1px solid var(--color-border);
    border-radius: 14px; box-shadow: var(--shadow-lg);
    display: flex; flex-direction: column; gap: 2px;
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.16s ease, transform 0.16s ease; z-index: 60;
  }
  .nav-dd-menu::before { content: ''; position: absolute; left: 0; right: 0; top: -10px; height: 10px; }
  .nav-dd:hover .nav-dd-menu, .nav-dd:focus-within .nav-dd-menu {
    opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0);
  }
  .dd-item { padding: 0.5rem 0.7rem; border-radius: 8px; font-size: 0.9rem; color: var(--color-text-muted); white-space: nowrap; transition: background 0.14s ease, color 0.14s ease; }
  .dd-item:hover { background: color-mix(in srgb, var(--color-accent) 12%, transparent); color: var(--color-text); }
  .dd-all { color: var(--color-accent); font-weight: 600; border-top: 1px solid var(--color-border); margin-top: 2px; }
  /* Длинные списки: помещаются на экран, иначе листаются */
  .dd-scroll { max-height: min(64vh, 560px); overflow-y: auto; overscroll-behavior: contain; }
  .dd-cols { display: grid; grid-template-columns: repeat(2, minmax(180px, 1fr)); gap: 2px; min-width: 420px; }
  .dd-cols .dd-all { grid-column: 1 / -1; }
  .dd-logo-item { display: flex; align-items: center; gap: 0.55rem; }
  .dd-logo-item img { width: 18px; height: 18px; object-fit: contain; border-radius: 4px; flex-shrink: 0; }
  .dd-dot { width: 18px; height: 18px; border-radius: 4px; background: var(--color-bg-elevated); border: 1px solid var(--color-border); display: inline-flex; align-items: center; justify-content: center; font-size: 0.62rem; font-weight: 800; color: var(--color-text-muted); flex-shrink: 0; }
  .dd-ic { width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center; color: var(--color-accent); flex-shrink: 0; }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cart-link {
    position: relative;
    display: inline-flex;
    color: var(--color-text-muted);
    transition: color 0.18s ease;
  }
  .cart-link:hover {
    color: var(--color-accent);
  }
  .cart-count {
    position: absolute;
    top: -8px;
    right: -10px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .burger {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .burger span {
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
  }
  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 0.5rem 20px 1.5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
    /* Своя прокрутка: длинный список вендоров помещается и листается */
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }
  .mobile-link {
    padding: 0.7rem 0;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-link.active {
    color: var(--color-accent);
  }
  .mobile-sub { padding-left: 1rem; color: var(--color-text-dim); font-size: 0.92rem; }
  .mobile-dd { display: flex; flex-direction: column; }
  /* В Chromium содержимое <details> оборачивается в ::details-content,
     из-за чего ссылки не наследуют flex-колонку — принудительно делаем их блоками. */
  .mobile-dd a { display: block; width: 100%; }
  .mobile-dd-summary { display: flex; align-items: center; justify-content: space-between; list-style: none; cursor: pointer; }
  .mobile-dd-summary::-webkit-details-marker { display: none; }
  .mobile-dd-summary svg { opacity: 0.6; transition: transform 0.2s ease; }
  .mobile-dd[open] .mobile-dd-summary svg { transform: rotate(180deg); }
  .mobile-sub-all { color: var(--color-accent); font-weight: 600; }
  .m-search { padding: 0.7rem 0 0.3rem; }
  .m-search input { width: 100%; box-sizing: border-box; background: var(--color-bg-elevated); border: 1px solid var(--color-border-strong); border-radius: 999px; padding: 0.55rem 1rem; font: inherit; font-size: 0.95rem; color: var(--color-text); }
  .m-phone { color: var(--color-text); font-weight: 700; }
  /* Постепенное сжатие первого ряда */
  @media (max-width: 1120px) { .h-phone small { display: none; } }
  @media (max-width: 1020px) { .h-phone { display: none; } }
  @media (max-width: 920px) {
    .nav-row { display: none; }
    .h-search { display: none; }
    .cat-btn { display: none; }
    .btn-kp { display: none; }
    .burger { display: flex; }
    .header-inner { justify-content: space-between; }
    .mobile-nav[data-open] { display: flex; }
  }
</style>

<script>
  // Бургер-меню
  const burger = document.querySelector('[data-burger]');
  const mobileNav = document.querySelector('[data-mobile-nav]');
  burger?.addEventListener('click', () => {
    const open = mobileNav?.hasAttribute('data-open');
    if (open) {
      mobileNav?.removeAttribute('data-open');
      mobileNav?.setAttribute('hidden', '');
      burger.setAttribute('aria-expanded', 'false');
    } else {
      mobileNav?.setAttribute('data-open', '');
      mobileNav?.removeAttribute('hidden');
      burger.setAttribute('aria-expanded', 'true');
    }
  });

  // Счётчик корзины из localStorage (обновляется событием cart:change)
  function refreshCartCount() {
    try {
      const raw = localStorage.getItem('bizsoft_cart');
      const items = raw ? JSON.parse(raw) : [];
      const count = Array.isArray(items) ? items.reduce((s, i) => s + (i.qty || 0), 0) : 0;
      document.querySelectorAll('[data-cart-count]').forEach((el) => {
        const node = el as HTMLElement;
        if (count > 0) {
          node.textContent = String(count);
          node.removeAttribute('hidden');
        } else {
          node.setAttribute('hidden', '');
        }
      });
    } catch {
      /* ignore */
    }
  }
  refreshCartCount();
  window.addEventListener('cart:change', refreshCartCount);
  window.addEventListener('storage', refreshCartCount);
</script>

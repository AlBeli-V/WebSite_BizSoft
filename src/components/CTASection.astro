---
interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  title = 'Готовы подобрать лицензии под вашу задачу?',
  text = 'Оставьте заявку — рассчитаем стоимость, подготовим договор и счёт. Закрывающие документы через ЭДО.',
  primaryLabel = 'Запросить расчёт',
  primaryHref = '/pricing/',
  secondaryLabel = 'Перейти в каталог',
  secondaryHref = '/catalog/',
} = Astro.props;
---
<section class="cta-section container-page reveal">
  <div class="cta-box">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a href={primaryHref} class="btn btn-primary" data-goal="cta_primary">{primaryLabel}</a>
      <a href={secondaryHref} class="btn btn-ghost">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    margin-top: 4rem;
  }
  .cta-box {
    background: linear-gradient(135deg, var(--color-accent-soft), var(--color-bg-elevated));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .cta-box h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    margin-bottom: 0.6rem;
  }
  .cta-box p {
    color: var(--color-text-muted);
    max-width: 48ch;
  }
  .cta-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
</style>

---
interface Props {
  sku: string;
  slug: string;
  name: string;
  vendor?: string;
  price: number;
  compact?: boolean;
  label?: string;
}
const { sku, slug, name, vendor = '', price, compact = false, label = 'В спецификацию' } = Astro.props;
---
<button
  class:list={['btn', 'btn-primary', 'add-to-cart', { 'btn-sm': compact }]}
  data-add-to-cart
  data-sku={sku}
  data-slug={slug}
  data-name={name}
  data-vendor={vendor}
  data-price={price}
>
  <span class="label-default">{label}</span>
  <span class="label-added" hidden>Добавлено ✓</span>
</button>

<script>
  import { trackGoal } from '@/lib/analytics';
  import { addToCart } from '../lib/cart-client';

  document.querySelectorAll('[data-add-to-cart]').forEach((el) => {
    const btn = el as HTMLButtonElement;
    if (btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', () => {
      addToCart({
        sku: btn.dataset.sku!,
        slug: btn.dataset.slug!,
        name: btn.dataset.name!,
        vendor: btn.dataset.vendor || '',
        price: Number(btn.dataset.price || 0),
      });
      trackGoal('add_to_cart', { sku: btn.dataset.sku || '' });
      const def = btn.querySelector('.label-default') as HTMLElement;
      const added = btn.querySelector('.label-added') as HTMLElement;
      def.hidden = true;
      added.hidden = false;
      setTimeout(() => {
        def.hidden = false;
        added.hidden = true;
      }, 1600);
    });
  });
</script>

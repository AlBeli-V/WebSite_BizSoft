---
/**
 * Доверительные признаки под призывом карточки: договор, счёт в рублях, ЭДО,
 * закрывающие документы. Показываются один раз на страницу — повтор после
 * каждой кнопки превращает их в шум.
 *
 * Каждая строка со своим контурным знаком (решение руководителя 14.09.2026 по
 * референсу): четыре одинаковых пункта списка читаются как перечисление, знак
 * даёт зацепку глазу и отличает строку об оплате от строки о документах.
 * Знаки живут здесь, а не в `policies.ts`: там текст условий, разметки в нём
 * не бывает. Компонент один на обе колонки — обычную и подарочной карты.
 */
import { TRUST_LINES } from '../data/policies';

/** Знак по порядку строк: договор, оплата, ЭДО, комплект документов. */
const ICONS: string[][] = [
  // Договор: лист с текстом.
  ['M7 3h7l4 4v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z', 'M14 3v4h4', 'M9 13h6', 'M9 17h4'],
  // Оплата: стопка монет.
  ['M12 4.5c3.9 0 7 1 7 2.3S15.9 9 12 9 5 8.1 5 6.8 8.1 4.5 12 4.5Z', 'M5 6.8v4.4c0 1.3 3.1 2.3 7 2.3s7-1 7-2.3V6.8', 'M5 11.2v4.4c0 1.3 3.1 2.3 7 2.3s7-1 7-2.3v-4.4'],
  // ЭДО: лист с пером — документ подписывают, а не печатают.
  ['M13 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-5', 'M13 3v4h4', 'M8 11h5', 'M8 15h3', 'M20.6 8.4l-5.1 5.1-.5 2.5 2.5-.5 5.1-5.1a1.4 1.4 0 0 0-2-2Z'],
  // Комплект документов: щит с галкой.
  ['M12 3l7 3v5.5c0 4.2-2.9 7.6-7 8.5-4.1-.9-7-4.3-7-8.5V6l7-3Z', 'M9 12.2l2.1 2.1L15.4 10'],
];
---
<ul class="buy-trust">
  {TRUST_LINES.map((t, i) => (
    <li>
      <svg class="trust-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        {(ICONS[i] ?? ICONS[0]).map((d) => <path d={d} />)}
      </svg>
      <span>{t}</span>
    </li>
  ))}
</ul>

<style>
  .buy-trust {
    list-style: none;
    padding: 1rem 0 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: 0.7rem;
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }
  /* Знак и текст на одной оси; знак не сжимается, текст переносится. */
  .buy-trust li { display: flex; align-items: center; gap: 0.7rem; line-height: 1.35; }
  .trust-ic { flex: none; width: 20px; height: 20px; color: var(--color-text-dim); }
</style>

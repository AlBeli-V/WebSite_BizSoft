---
/**
 * Инфографика для героев страниц (вариант A): стильная карточка
 * с тремя шагами закупки — линейные иконки в акцентном цвете.
 * Ставится справа от текста героя в сетке .hero-cols (см. global.css).
 */
interface Step {
  icon: 'grid' | 'doc' | 'shield';
  t: string;
  d: string;
}
interface Props {
  steps?: Step[];
}
const defaults: Step[] = [
  { icon: 'grid', t: 'Выбираете сервис', d: '380+ продуктов: Adobe, Figma, ChatGPT, Claude, JetBrains…' },
  { icon: 'doc', t: 'Договор и счёт в рублях', d: 'КП за 1 день, оплата с расчётного счёта вашей компании' },
  { icon: 'shield', t: 'Доступ и закрывающие', d: 'Рабочий доступ команде + документы через ЭДО' },
];
const { steps = defaults } = Astro.props;
---
<aside class="hero-steps" aria-label="Как проходит закупка">
  {steps.map((s) => (
    <div class="hs-step">
      <span class="hs-ic">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {s.icon === 'grid' && (<><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></>)}
          {s.icon === 'doc' && (<><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></>)}
          {s.icon === 'shield' && (<><path d="M12 3 5 6v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/><path d="m9.5 12 1.8 1.8 3.2-3.6"/></>)}
        </svg>
      </span>
      <span class="hs-t"><b>{s.t}</b><span>{s.d}</span></span>
    </div>
  ))}
</aside>

<style>
  .hero-steps {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.6rem 1.9rem;
    background: linear-gradient(145deg, color-mix(in srgb, var(--color-accent) 5%, #fff), var(--color-bg-card) 55%);
  }
  .hs-step { display: flex; align-items: center; gap: 1.05rem; padding: 0.8rem 0; }
  .hs-step + .hs-step { border-top: 1px dashed var(--color-border); }
  .hs-ic {
    width: 62px; height: 62px; border-radius: 16px; flex-shrink: 0;
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
    color: var(--color-accent);
    display: flex; align-items: center; justify-content: center;
  }
  .hs-t b { display: block; color: var(--color-text); font-size: 0.98rem; margin-bottom: 3px; }
  .hs-t > span { color: var(--color-text-muted); font-size: 0.86rem; line-height: 1.45; }
</style>

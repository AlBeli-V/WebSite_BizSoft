---
import PriceTag from './PriceTag.astro';
import AddToCartButton from './AddToCartButton.astro';
import { effectivePrice } from '../lib/pricing';
import { logoUrl } from '../lib/directus';
import { logoFile } from '../data/logos';
import { vendorIcon } from '../data/vendor-icons';
import { vendorSlug } from '../lib/vendor-links';
import VendorIcon from './VendorIcon.astro';
import { productIcons } from '../data/product-icons';
import ProductIcon from './ProductIcon.astro';
import { ORIGIN_LABEL, LICENSE_LABEL } from '../lib/types';
import { planType, PLAN_LABEL } from '../lib/plan-type';
import type { Product } from '../lib/types';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const eff = effectivePrice(product);
const logo = logoUrl(product, { width: 96, height: 96, fit: 'contain', format: 'webp' });
const byRequest = !(product.price > 0) && !eff.isPromo; // NaN и null — тоже «по запросу»
// Ребрендинг вендора «Новое имя (прежнее)»: новое — крупно, прежнее — мельче ниже,
// рядом с прежним названием показываем его логотип (если есть в brand-logos).
const renamed = (product.vendor || '').match(/^(.+?)\s*\((.+)\)$/);
const vendorMain = renamed ? renamed[1] : product.vendor;
const vendorPrev = renamed ? renamed[2] : null;
const vendorPrevLogo = vendorPrev
  ? logoFile(vendorPrev.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''))
  : null;
// Кому адресован тариф — бейдж только при уверенном определении
const plan = planType(product.name, product.short_description || '');
// Профильная иконка ПРОДУКТА (каталожный пакет) — приоритет; иначе иконка
// вендора из фирменного пакета. Обе: монохром → цвет при наведении.
const hasProductIcon = productIcons(product.slug).length > 0;
const packSlug = !hasProductIcon && product.vendor ? vendorSlug(product.vendor) : '';
const packIcon = packSlug ? vendorIcon(packSlug) : null;
---
<article class="card card-hover product-card reveal">
  <a href={`/product/${product.slug}`} class="product-link" aria-label={product.name}>
    <div class="product-top">
      <div class="ptop-row">
        {hasProductIcon ? (
          <span class="logo logo-pack"><ProductIcon slug={product.slug} name={product.name} size={34} /></span>
        ) : packIcon ? (
          <span class="logo logo-pack"><VendorIcon slug={packSlug} name={product.vendor} size={34} /></span>
        ) : logo ? (
          <img src={logo} alt={`Логотип ${product.vendor || product.name}`} class="logo" width="40" height="40" loading="lazy" />
        ) : (
          <span class="logo logo-ph" aria-hidden="true">{(product.vendor || product.name).slice(0, 1)}</span>
        )}
      </div>
      {product.vendor && (
        <span class="vendor">
          {vendorMain}
          {vendorPrev && (
            <span class="vendor-prev">
              {vendorPrevLogo && <img src={vendorPrevLogo} alt={`Логотип ${vendorPrev} — прежнее название ${vendorMain}`} width="14" height="14" loading="lazy" />}
              ({vendorPrev})
            </span>
          )}
        </span>
      )}
      <h3>{product.name}</h3>
      {product.short_description && <p class="desc">{product.short_description}</p>}
      <div class="tags">
        {plan && <span class="tag plan" data-plan={plan}>{PLAN_LABEL[plan]}</span>}
        {product.license_type && <span class="tag">{LICENSE_LABEL[product.license_type]}</span>}
      </div>
    </div>
  </a>
  <div class="product-bottom">
    {byRequest ? (
      <div class="price-req">Цена по запросу</div>
    ) : (
      <PriceTag product={product} />
    )}
    {product.price_note && !byRequest && <span class="price-note">{product.price_note}</span>}
    <div class="product-actions">
      {byRequest ? (
        <button class="btn btn-primary btn-sm" data-open-question data-product={product.name} data-sku={product.sku}>Запросить цену</button>
      ) : (
        <AddToCartButton sku={product.sku} slug={product.slug} name={product.name} vendor={vendorMain || ''} price={eff.price} compact />
      )}
      <a href={`/product/${product.slug}`} class="btn btn-ghost btn-sm">Подробнее</a>
    </div>
  </div>
</article>

<style>
  .product-card { display: flex; flex-direction: column; justify-content: space-between; padding: 1.4rem; height: 100%; }
  .product-link { display: block; }
  .ptop-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.7rem; }
  .logo { width: 40px; height: 40px; border-radius: 8px; object-fit: contain; background: #fff; padding: 3px; }
  .logo-ph { display: flex; align-items: center; justify-content: center; background: var(--color-bg-elevated); color: var(--color-accent); font-weight: 800; font-size: 1.2rem; padding: 0; }
  .logo-pack { display: flex; align-items: center; justify-content: center; }
  .origin-tag { font-size: 0.68rem; font-weight: 700; padding: 0.12rem 0.45rem; border-radius: 5px; }
  .origin-tag[data-origin='domestic'] { background: color-mix(in srgb, var(--color-success) 18%, transparent); color: var(--color-success); }
  .origin-tag[data-origin='foreign'] { background: color-mix(in srgb, var(--color-accent) 16%, transparent); color: var(--color-accent); }
  .vendor { font-size: 0.78rem; color: var(--color-text-dim); display: flex; flex-direction: column; gap: 0.1rem; }
  .vendor-prev { display: inline-flex; align-items: center; gap: 0.28rem; font-size: 0.7rem; color: var(--color-text-muted); }
  .vendor-prev img { width: 14px; height: 14px; object-fit: contain; border-radius: 3px; }
  .product-card h3 {
    font-size: 1.1rem;
    margin: 0.2rem 0 0.5rem;
    /* единая высота заголовка: максимум 2 строки */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.4em;
  }
  .desc {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0;
    /* единый объём текста в карточке: максимум 3 строки, остальное скрыто */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.7rem; }
  .tag { font-size: 0.72rem; color: var(--color-text-muted); background: var(--color-bg-elevated); padding: 0.12rem 0.5rem; border-radius: 6px; }
  /* Кому адресован тариф: команда — акцентный, индивидуальный — нейтральный контур */
  .tag.plan[data-plan='team'] { color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 12%, transparent); font-weight: 700; }
  .tag.plan[data-plan='individual'] { color: var(--color-text-muted); background: transparent; border: 1px solid var(--color-border-strong); font-weight: 600; }
  .product-bottom { margin-top: 1.2rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .price-req { font-weight: 700; font-size: 1.05rem; color: var(--color-text); }
  .price-note { color: var(--color-text-dim); font-size: 0.78rem; }
  .product-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.6rem; }
  :global(.btn-sm) { padding: 0.5rem 0.9rem; font-size: 0.85rem; }
</style>

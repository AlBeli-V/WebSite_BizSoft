---
// Инлайн-форма подбора (vendor-лендинги, /pricing и др.). Постит на /api/lead.
// Все поля обязательные; телефон — с маской +7; чипы топ-вендоров с иконками.
//
// Режим compact — двухшаговый вариант той же формы для первого экрана
// рекламных посадочных. Состав реквизитов не меняется (решение
// руководителя 28.08.2026: заявка и КП собирают одно и то же), меняется
// только порядок предъявления: сперва три поля, остальные — вторым шагом.
// Замер кампании 04.09.2026 показал ноль form_start на 226 визитов: семь
// обязательных полей с ИНН в первом контакте — барьер, который посетитель
// рекламы не проходит.
import VendorChips from './VendorChips.astro';
import FormGuardFields from './FormGuardFields.astro';
import ConsentControls from './ConsentControls.astro';
import ContactDirect from './ContactDirect.astro';

interface Props {
  source?: string;
  title?: string;
  submitLabel?: string;
  /** Двухшаговый вид для первого экрана: 3 поля, остальные — вторым шагом. */
  compact?: boolean;
  /**
   * Список тарифов для выбора прямо в форме (лендинги производителей).
   * Значение уходит в `product_ref` — то же поле, которое заполняла модальная
   * форма вопроса, поэтому менеджер видит тариф в письме без изменений в API.
   * Кнопки страницы с `data-plan="<value>"` подставляют выбор сами: посетителю
   * не нужно вспоминать, какой из тарифов он смотрел.
   */
  plans?: { value: string; label: string }[];
}
const {
  source = 'pricing',
  title = 'Запросить расчёт',
  submitLabel = 'Отправить заявку',
  compact = false,
  plans,
} = Astro.props;

// Поля описаны один раз и раскладываются по шагам: две ветки разметки
// разъехались бы при первой же правке валидации.
type Field = {
  key: string; label: string; pii?: boolean;
  type?: astroHTML.JSX.HTMLInputTypeAttribute;
  autocomplete?: string; placeholder?: string;
  inputmode?: 'numeric' | 'tel' | 'email' | 'text';
  pattern?: string; min?: string; max?: string;
};
const FIELDS: Record<string, Field> = {
  name: { key: 'name', label: 'ФИО', pii: true, autocomplete: 'name' },
  email: { key: 'email', label: 'E-mail', type: 'email', pii: true, autocomplete: 'email' },
  phone: { key: 'phone', label: 'Телефон', type: 'tel', pii: true, autocomplete: 'tel', placeholder: '+7 (___) ___-__-__' },
  company: { key: 'company', label: 'Компания', pii: true, autocomplete: 'organization' },
  inn: { key: 'inn', label: 'ИНН', pii: true, inputmode: 'numeric', pattern: '[0-9]{10,12}', placeholder: '10 или 12 цифр' },
  seats: { key: 'seats', label: 'Количество мест', type: 'number', inputmode: 'numeric', min: '1', max: '10000', placeholder: 'например, 10' },
};
// Первый шаг компактного вида — минимум, по которому можно ответить: адрес
// и задача. Решение руководителя 14.09.2026 по итогу первой недели замера:
// форма попала на экран 24 раза, а начатых заполнений не было ни одного —
// снимаем с первого контакта всё, кроме способа ответить. Состав реквизитов
// заявки при этом прежний (решение 28.08.2026), меняется только момент, когда
// о них спрашивают: компания уехала на второй шаг к остальным реквизитам.
const STEP1 = compact ? ['email'] : ['name', 'email', 'phone', 'company', 'inn', 'seats'];
const STEP2 = compact ? ['company', 'name', 'phone', 'inn', 'seats'] : [];
const messageLabel = compact ? 'Что требуется?' : 'Что нужно подобрать?';
const messagePlaceholder = compact
  ? 'Например: Claude Team на 5 человек, нужен счёт'
  : 'Сервисы, количество пользователей, сроки…';
---
<form
  class:list={['lead-form', 'card', compact && 'lf-compact']}
  data-lead-form
  data-source={source}
  data-compact={compact ? 'yes' : undefined}
>
  {/* В первом экране форма — часть блока, а не самостоятельный раздел:
      заголовок h3 сразу после h1 страницы рвал иерархию (смоук ловит это
      проверкой «h1→h3»). Вне компактного вида выше по странице всегда есть
      h2, и h3 остаётся корректным. */}
  {compact ? <p class="lf-title">{title}</p> : <h3>{title}</h3>}
  {/* Имени у списка тарифов нет намеренно: поле заявки одно — скрытое
      product_ref ниже. Пока их было два с одним именем, браузер отправлял
      оба, а /api/lead читал последнее — выбор посетителя молча терялся. */}
  {plans && plans.length > 0 && (
    <label class="lf-plan">Что рассчитать:<select data-lead-plan>
      <option value="">Подберите под задачу</option>
      {plans.map((p) => <option value={p.value}>{p.label}</option>)}
    </select></label>
  )}
  <div class:list={['lf-grid', STEP1.length === 1 && 'lf-grid-one']}>
    {STEP1.map((k) => {
      const f = FIELDS[k];
      return (
        <label>{f.label}:<input
          class={f.pii ? 'ym-disable-keys' : undefined}
          name={f.key} type={f.type} required
          autocomplete={f.autocomplete} placeholder={f.placeholder}
          inputmode={f.inputmode} pattern={f.pattern} min={f.min} max={f.max}
        /></label>
      );
    })}
  </div>
  <label>{messageLabel}<textarea class="ym-disable-keys" name="message" rows={compact ? 2 : 3} required placeholder={messagePlaceholder}></textarea></label>

  {compact && (
    <div class="lf-step2" data-step2 hidden>
      <p class="lf-step2-note">Реквизиты для счёта и договора:</p>
      <div class="lf-grid">
        {STEP2.map((k) => {
          const f = FIELDS[k];
          return (
            <label>{f.label}:<input
              class={f.pii ? 'ym-disable-keys' : undefined}
              name={f.key} type={f.type} data-step2-required
              autocomplete={f.autocomplete} placeholder={f.placeholder}
              inputmode={f.inputmode} pattern={f.pattern} min={f.min} max={f.max}
            /></label>
          );
        })}
      </div>
    </div>
  )}

  {!compact && <VendorChips />}
  {/* Что именно считаем: тариф и количество подставляет страница (лендинг
      производителя — из подборки и из кнопки, по которой пришли). Поле
      уходит в заявку как product_ref, поэтому менеджер видит выбор
      покупателя, а не пересказ своими словами. */}
  <input type="hidden" name="product_ref" data-product-ref value="" />
  <FormGuardFields />
  <ConsentControls formId="lead-form" submitPurpose="Подбор и расчёт, подготовка ответа и КП" />
  <button type="submit" class="btn btn-primary lf-submit" data-submit-label={submitLabel}>
    {compact ? 'Продолжить' : submitLabel}
  </button>
  <div class="lf-alt"><ContactDirect /></div>
  <p class="lf-status" data-status role="status" aria-live="polite"></p>
</form>

<style>
  .lead-form { padding: 1.8rem; display: flex; flex-direction: column; gap: 0.9rem; }
  .lead-form h3 { font-size: 1.3rem; }
  /* Всегда ровная сетка: подписи в одну строку, инпуты выровнены по горизонтали */
  .lf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .lf-grid > label { min-width: 0; }
  .lead-form label { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.88rem; font-weight: 600; color: var(--color-text); white-space: nowrap; }
  .lead-form label:has(textarea) { white-space: normal; }
  .lead-form select { background: var(--color-bg-elevated); border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); padding: 0.6rem 0.7rem; color: var(--color-text); font: inherit; font-weight: 400; width: 100%; min-width: 0; box-sizing: border-box; }
  .lead-form select:focus { border-color: var(--color-accent); outline: none; }
  .lead-form .lf-plan { white-space: normal; }
  .lead-form input, .lead-form textarea { background: var(--color-bg-elevated); border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); padding: 0.6rem 0.7rem; color: var(--color-text); font: inherit; font-weight: 400; width: 100%; min-width: 0; box-sizing: border-box; }
  .lead-form input:focus, .lead-form textarea:focus { border-color: var(--color-accent); outline: none; }
  .lf-alt { margin: 0; }
  .lf-status { font-size: 0.9rem; margin: 0; }
  .lf-status.ok { color: var(--color-success); }
  .lf-status.err { color: var(--color-danger); }
  @media (max-width: 520px) { .lf-grid { grid-template-columns: 1fr; } }

  /* Компактный вид первого экрана: меньше воздуха, одна колонка на узком
     экране, второй шаг появляется в потоке и не двигает страницу рывком. */
  .lead-form.lf-compact { padding: 1.15rem; gap: 0.7rem; }
  .lf-title { margin: 0; font-size: 1.12rem; font-weight: 700; color: var(--color-text); }
  .lf-compact .lf-grid { grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  /* Единственное поле первого шага занимает строку целиком: половина ширины
     рядом с пустотой читается как незаконченная вёрстка. */
  .lf-grid.lf-grid-one { grid-template-columns: 1fr; }
  .lf-step2 { display: flex; flex-direction: column; gap: 0.6rem; }
  .lf-step2-note { margin: 0; font-size: 0.82rem; color: var(--color-text-muted); }
  @media (max-width: 900px) { .lf-compact .lf-grid { grid-template-columns: 1fr; } }
</style>

<script>
  import { trackGoal, trackGoalOnce } from '@/lib/analytics';
  import { requireConsent, readConsent, lockConsent, unlockConsent, markConsentSubmitting } from '@/lib/consent-controls';
  import { attributionPayload } from '@/lib/attribution';
  import { maskAllPhones } from '../lib/phone-mask';
  import { readCart } from '@/lib/cart-client';
  maskAllPhones();

  document.querySelectorAll('[data-lead-form]').forEach((el) => {
    const form = el as HTMLFormElement;
    const status = form.querySelector('[data-status]') as HTMLElement;
    const source = () => form.dataset.source || 'site';

    // Второй шаг компактной формы. Пока он скрыт, его поля не обязательны:
    // иначе браузер отказал бы в отправке, ругаясь на поле, которого
    // посетитель не видит.
    const step2 = form.querySelector('[data-step2]') as HTMLElement | null;
    const step2Fields = Array.from(
      form.querySelectorAll('[data-step2-required]')) as HTMLInputElement[];
    const submitBtn = form.querySelector('.lf-submit') as HTMLButtonElement;
    let step2Shown = false;

    function revealStep2() {
      if (!step2 || step2Shown) return;
      step2Shown = true;
      step2.hidden = false;
      step2Fields.forEach((f) => { f.required = true; });
      submitBtn.textContent = submitBtn.dataset.submitLabel || 'Отправить заявку';
      (step2Fields[0] as HTMLInputElement | undefined)?.focus();
    }

    // Форма показана — шаг воронки между визитом и первым вводом. Для
    // инлайн-формы «открыть» нечего, поэтому считаем показ на экране:
    // половина формы в поле зрения. Один раз на страницу.
    let opened = false;
    function markOpen(kind: string) {
      if (opened) return;
      opened = true;
      trackGoalOnce('form_open', { form_source: source(), form_kind: kind });
    }
    if (typeof IntersectionObserver === 'function') {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { markOpen(step2 ? 'inline-compact' : 'inline'); io.disconnect(); }
        }
      }, { threshold: 0.5 });
      io.observe(form);
    } else {
      markOpen(step2 ? 'inline-compact' : 'inline');
    }

    // Начало заполнения — один раз на форму. Разрыв между form_start и
    // lead_sent показывает, сколько людей упирается в саму форму: без него
    // брошенная форма и непосещённая страница выглядят одинаково.
    let started = false;
    form.addEventListener('input', () => {
      if (started) return;
      started = true;
      trackGoal('form_start', { form_source: source() });
    }, { passive: true });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Первый шаг заполнен — показываем реквизиты и ждём второй отправки.
      // Состав полей заявки при этом прежний: меняется момент, когда о них
      // спрашивают, а не сам их набор.
      if (step2 && !step2Shown) {
        revealStep2();
        status.textContent = 'Остались реквизиты для счёта — и отправляем.';
        status.className = 'lf-status';
        return;
      }
      // Согласие проверяется после раскрытия второго шага: на первом шаге
      // форма ещё не отправляется, и требовать галочку там значило бы
      // ругаться на человека до того, как он дошёл до отправки.
      if (!requireConsent(form)) return;
      const submit = form.querySelector('.lf-submit') as HTMLButtonElement;
      submit.disabled = true;
      markConsentSubmitting(form);
      status.textContent = 'Отправляем…'; status.className = 'lf-status';
      // Количество из поля дописывается к составу заявки: без этого число
      // мест оставалось в форме и до заявки не доезжало (в payload
      // /api/lead поля seats нет). База хранится отдельно, иначе повторная
      // отправка после ошибки дописала бы количество второй раз.
      const ref = form.querySelector('[data-product-ref]') as HTMLInputElement | null;
      if (ref) {
        // Выбор из списка тарифов — такой же источник состава, как кнопка
        // страницы: чей выбор свежее, тот и уходит в заявку.
        const picked = (form.querySelector('[data-lead-plan]') as HTMLSelectElement | null)?.value;
        if (picked) ref.dataset.base = picked;
        const seats = (form.elements.namedItem('seats') as HTMLInputElement | null)?.value?.trim();
        ref.value = [ref.dataset.base || '', seats ? `количество: ${seats}` : '']
          .filter(Boolean).join(' · ').slice(0, 300);
      }
      let httpStatus = 0;
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const attribution = await attributionPayload();
        // Состав подборки уходит вместе с заявкой: человек, написавший нам
        // из корзины, уже назвал позиции артикулами — разбирать после этого
        // свободный текст значило бы гадать поверх точных данных.
        const cart = readCart().map((i) => ({ sku: i.sku, name: i.name, qty: i.qty }));
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ...data, source: form.dataset.source, attribution, ...readConsent(form),
            ...(cart.length ? { cart } : {}),
          }),
        });
        if (!res.ok) {
          let msg = 'Не удалось отправить. Проверьте поля и попробуйте снова.';
          try { const j = await res.json(); if (j?.error) msg = j.error; } catch { /* not json */ }
          httpStatus = res.status;
          throw new Error(msg);
        }
        lockConsent(form);
        form.querySelectorAll('label, .lf-grid, .vc-cap, .vc-chips, [data-chips], .lf-submit, [data-consent-block], .lf-alt').forEach((n) => n.remove());
        status.className = 'lf-status ok';
        status.innerHTML = '<b>Заявка получена.</b> Ответим в рабочее время. Пока ждёте — посмотрите <a href="/documents">образцы документов</a> или <a href="/how-we-work">как проходит поставка</a>.';
        form.reset();
        trackGoal('lead_sent', { form_source: source() });
      } catch (err) {
        status.textContent = err instanceof Error && err.message ? err.message : 'Не удалось отправить. Позвоните нам или попробуйте позже.'; status.className = 'lf-status err';
        unlockConsent(form);
        // Сбой отправки — не то же самое, что передумал: без отдельной цели
        // техническая потеря заявки списывается на поведение клиента.
        //
        // Событие одно на все виды сбоя и отправляется только здесь. Пока
        // рядом стояла вторая цель в ветке !res.ok, throw из неё попадал в
        // этот же catch и один отказ 422 считался дважды.
        trackGoal('lead_error', {
          form_source: source(),
          http_status: httpStatus,
          reason: err instanceof Error ? err.message.slice(0, 100) : 'unknown',
        });
      } finally {
        submit.disabled = false;
      }
    });
  });
</script>

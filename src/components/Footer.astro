---
import { seller, site, mainNav, footerNav } from '../config/site';
const year = 2026;
---
<footer class="site-footer">
  <div class="container-page footer-grid">
    <div class="footer-brand">
      <a href="/" class="wordmark">Biz<span>Soft</span></a>
      <p class="footer-tagline">{site.tagline}</p>
      <p class="footer-trust">
        Работаем по договору, оплата по счёту, закрывающие документы через ЭДО.
      </p>
    </div>

    <nav class="footer-col" aria-label="Разделы">
      <h3>Разделы</h3>
      {mainNav.map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>

    <nav class="footer-col" aria-label="Документы">
      <h3>Документы</h3>
      {footerNav.map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>

    <div class="footer-col footer-contacts">
      <h3>Контакты</h3>
      <a href={`tel:${seller.phoneHref}`}>{seller.phone}</a>
      <a href={`mailto:${seller.email}`}>{seller.email}</a>
      <p class="footer-req">{seller.shortName}</p>
      <p class="footer-req">ИНН {seller.inn}</p>
      <p class="footer-req">ОГРНИП {seller.ogrnip}</p>
      <p class="footer-req">{seller.address}</p>
    </div>
  </div>

  <div class="container-page footer-bottom">
    <p>© {year} {seller.brand}. {seller.legalName}.</p>
    <p>Сайт носит информационный характер и не является публичной офертой.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    padding: 3rem 0 2rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
  }
  .wordmark {
    font-weight: 800;
    font-size: 1.25rem;
  }
  .wordmark span {
    color: var(--color-accent);
  }
  .footer-tagline {
    margin: 0.8rem 0 0.4rem;
    color: var(--color-text);
  }
  .footer-trust {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    max-width: 32ch;
  }
  .footer-col h3 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-dim);
    margin-bottom: 1rem;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-col a {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    transition: color 0.18s ease;
  }
  .footer-col a:hover {
    color: var(--color-accent);
  }
  .footer-req {
    color: var(--color-text-dim);
    font-size: 0.82rem;
    margin: 0;
  }
  .footer-bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--color-text-dim);
    font-size: 0.82rem;
  }
  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

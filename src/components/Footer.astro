---
import { seller, site, mainNav, footerNav } from '../config/site';
import { LEGAL_FOOTER_NAV, COOKIE_UI } from '../config/legal';
import SiteLogo from './SiteLogo.astro';
const year = 2026;
---
<footer class="site-footer">
  <div class="container-page footer-grid">
    <div class="footer-brand">
      <a href="/" class="wordmark"><SiteLogo variant="footer" /></a>
      <p class="footer-trust">
        Работаем по договору, оплата по счёту, закрывающие документы через ЭДО.
      </p>
    </div>

    <nav class="footer-col" aria-label="Разделы">
      <h3>Разделы</h3>
      {mainNav.map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>

    <nav class="footer-col" aria-label="Документы">
      <h3>Документы</h3>
      {footerNav.map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>

    <div class="footer-col footer-contacts">
      <h3>Контакты</h3>
      <a href={`tel:${seller.phoneHref}`}>{seller.phone}</a>
      <a href={`mailto:${seller.email}`}>{seller.email}</a>
      <a class="footer-req-link" href="/documents#requisites">Реквизиты</a>
    </div>
  </div>

  {/* Правовая информация — отдельным блоком во всю ширину и только в
      подвале: в главное меню документы не выносятся (ТЗ 16.09.2026, п. 1).
      «Настройки cookies» стоит здесь же, потому что по документу 05 (п. 5)
      именно отсюда посетитель меняет однажды сделанный выбор. */}
  <div class="container-page footer-legal">
    <h3>Правовая информация</h3>
    <ul>
      {LEGAL_FOOTER_NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      <li>
        <button type="button" class="footer-cookie-btn" data-cookie-settings>{COOKIE_UI.footerLink}</button>
      </li>
    </ul>
  </div>

  {/* Нижняя строка идентифицирует продавца коротко: полное имя ИП звучит
      один раз в правовых документах, а адрес регистрации в подвале не
      публикуется вовсе — для корреспонденции есть страница реквизитов. */}
  <div class="container-page footer-bottom">
    <p>© {year} {seller.brand} · {seller.shortName} · ИНН {seller.inn} · ОГРНИП {seller.ogrnip}</p>
    <p>Сайт носит информационный характер и не является публичной офертой.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    padding: 3rem 0 2rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
  }
  .wordmark { display: inline-block; --logo-halo: var(--color-bg-elevated); }
  .footer-trust {
    margin-top: 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    max-width: 32ch;
  }
  .footer-col h3 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-dim);
    margin-bottom: 1rem;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-col a {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    transition: color 0.18s ease;
  }
  .footer-col a:hover {
    color: var(--color-accent);
  }
  /* Ссылка на реквизиты живёт в колонке контактов, но читается как
     служебная: продавец и его номера — на отдельной странице, а не
     четырьмя строками мелким шрифтом в подвале. */
  .footer-req-link { font-size: 0.86rem; }
  /* Правовой блок: подписи длинные, поэтому не колонка сетки, а строка
     ссылок во всю ширину — на телефоне она сворачивается сама. */
  .footer-legal {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .footer-legal h3 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-dim);
    margin-bottom: 0.8rem;
  }
  .footer-legal ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.4rem;
  }
  .footer-legal a,
  .footer-cookie-btn {
    color: var(--color-text-muted);
    font-size: 0.86rem;
    transition: color 0.18s ease;
  }
  .footer-legal a:hover,
  .footer-cookie-btn:hover { color: var(--color-accent); }
  /* Кнопка, а не ссылка: она открывает интерфейс выбора, а не страницу.
     Выглядеть должна как соседние ссылки — иначе читается как призыв. */
  .footer-cookie-btn {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 0.86rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-bottom {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--color-text-dim);
    font-size: 0.82rem;
  }
  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
/**
 * Фирменный логотип BIZSoft — ЕДИНОЕ НЕИЗМЕНЯЕМОЕ ИЗОБРАЖЕНИЕ
 * public/brand/bizsoft-logo-primary-transparent.png (1140×350, 114:35).
 *
 * По брендбуку (docs: CLAUDE_TASK.md) логотип НЕЛЬЗЯ перерисовывать
 * HTML/CSS/SVG-средствами, набирать текстом или обрезать — допускается
 * только пропорциональное масштабирование: меняем width, height всегда auto.
 */
interface Props {
  /** header — крупный, на две строки шапки; footer — компактнее. */
  variant?: 'header' | 'footer';
}
const { variant = 'header' } = Astro.props;
---
<img
  class:list={['bizsoft-logo', variant]}
  src="/brand/bizsoft-logo-primary-transparent.png"
  width="1140"
  height="350"
  alt="BIZSoft — Business Integration Zone"
/>

<style>
  .bizsoft-logo {
    display: block;
    height: auto;
    object-fit: contain;
  }
  /* Ширина в шапке задаётся ячейкой .wordmark (фикс. ширина — иначе
     процент в auto-треке грида зацикливается и раздувает колонку). */
  .header { width: 100%; }
  .footer { width: min(252px, 100%); }
</style>

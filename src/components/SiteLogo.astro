---
/**
 * Фирменный логотип BIZSoft — перекомпонованный лок-ап из фрагментов
 * оригинального файла бренда (без перерисовки элементов):
 * знак уменьшен и выровнен по высоте с блоком «BIZSoft + BUSINESS
 * INTEGRATION ZONE», слоган «Единая точка доступа к ПО и AI-сервисам»
 * растянут во всю ширину лок-апа снизу (крупный и читаемый).
 *
 * Пять файлов под плотность и ширину экрана (srcset с w-дескрипторами +
 * sizes): -256.webp (9,2 КБ), -320.webp (11,9 КБ), -384.webp (15,8 КБ),
 * -448.webp (19 КБ) и -512.webp (23 КБ, retina). Собираются одной командой —
 * scripts/build-brand-lockup.mjs, там же обоснование способа сжатия.
 * Оба промежуточных шага пришли из замеров PageSpeed. 320 — для шапки:
 * телефону профиля (ширина 180 px, DPR 1,75) нужно 315 px, и без этого шага
 * ему доставался 384-й файл. 448 — для подвала: там логотип шире (236 px),
 * на той же плотности ему нужно 413 px, и он забирал retina-файл 512,
 * который аудит доставки изображений считал избыточным.
 * Качество проверяется попиксельно против мастер-PNG на белом фоне: среднее
 * отклонение канала 0,87–1,17 по четырём ширинам против 1,55–2,16 у файлов,
 * лежавших здесь до 13.09.2026, то есть картинка стала и легче, и точнее.
 * Мастер-PNG 1024×339 остаётся рядом для схем/PDF и public/brand/. Все файлы
 * идут через ассет-пайплайн (?url) — хешированные URL в /_astro с годовым
 * immutable-кэшем.
 * Масштабирование только пропорциональное: CSS width + height:auto.
 */
import lockup1x from '../assets/brand/bizsoft-logo-lockup-256.webp?url';
import lockup320 from '../assets/brand/bizsoft-logo-lockup-320.webp?url';
import lockup384 from '../assets/brand/bizsoft-logo-lockup-384.webp?url';
import lockup448 from '../assets/brand/bizsoft-logo-lockup-448.webp?url';
import lockup2x from '../assets/brand/bizsoft-logo-lockup-512.webp?url';

interface Props {
  /** header — в шапке (занимает обе строки); footer — компактнее. */
  variant?: 'header' | 'footer';
}
const { variant = 'header' } = Astro.props;
// Ширина отрисовки — по CSS: шапка 256 px (до 920 px — clamp(180px, 42vw, 232px)),
// подвал — до 236 px.
const sizes = variant === 'header' ? '(max-width: 920px) 42vw, 256px' : '236px';
// Логотип подвала — lazy: он далеко под первым экраном, а на телефоне с DPR
// 1,75 ему подходит 512-пиксельный файл, и без lazy страница качала бы
// и 384, и 512 ещё до первой отрисовки.
---
<img
  class:list={['bizsoft-logo', variant]}
  src={lockup1x}
  srcset={`${lockup1x} 256w, ${lockup320} 320w, ${lockup384} 384w, ${lockup448} 448w, ${lockup2x} 512w`}
  sizes={sizes}
  loading={variant === 'footer' ? 'lazy' : undefined}
  width="256"
  height="85"
  alt="BIZSoft — Business Integration Zone. Единая точка доступа к ПО и AI-сервисам"
/>

<style>
  .bizsoft-logo {
    display: block;
    height: auto;
    object-fit: contain;
  }
  /* Ширина в шапке задаётся ячейкой .wordmark (фикс. ширина — иначе
     процент в auto-треке грида зацикливается и раздувает колонку). */
  .header { width: 100%; }
  .footer { width: min(236px, 100%); }
</style>

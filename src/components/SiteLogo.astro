---
/**
 * Фирменный логотип BIZSoft — векторная трассировка фирменного знака:
 * графитовая «B» (филл с круглыми чашами), акцентная «S» (толстый штрих
 * с прямыми срезами), оранжевый треугольник-курсор на стыке.
 *
 * Просвет в месте пересечения «S» с «B» берёт цвет фона через --logo-halo —
 * задайте её равной фону, на котором стоит логотип.
 */
interface Props {
  /** header — полный лок-ап со слоганами; footer — только лого (знак + BIZSoft). */
  variant?: 'header' | 'footer';
}
const { variant = 'header' } = Astro.props;
---
<span class:list={['site-logo', variant]}>
  <svg class="logo-mark" viewBox="0 0 48 62" fill="none" aria-hidden="true" focusable="false">
    <path fill="var(--logo-b, #2e2e33)" fill-rule="evenodd" d="M12 2 H26 A8.2 8.2 0 0 1 26 18.4 L27.6 18.4 A9.2 9.2 0 0 1 27.6 37 H12 Z
      M19.4 8 H24.8 A3.6 3.6 0 0 1 24.8 15.2 H19.4 Z
      M19.4 24 H26.4 A3.7 3.7 0 0 1 26.4 31.4 H19.4 Z"/>
    <path d="M35.5 30.5 H18.8 A7 7 0 0 0 18.8 44.5 H23.8 A6.8 6.8 0 0 1 23.8 58.1 H9"
      stroke="var(--logo-halo, #fff)" stroke-width="9.6" stroke-linejoin="round"/>
    <path d="M35.5 30.5 H18.8 A7 7 0 0 0 18.8 44.5 H23.8 A6.8 6.8 0 0 1 23.8 58.1 H9"
      stroke="var(--color-accent, #f2591d)" stroke-width="7.2" stroke-linejoin="round"/>
    <path d="M19.8 21.8 L28.8 25.7 L21.6 30.2 Z" fill="var(--color-accent, #f2591d)"
      stroke="var(--logo-halo, #fff)" stroke-width="1.5" stroke-linejoin="round"/>
  </svg>
  <span class="logo-text">
    <span class="logo-word">BIZ<b>Soft</b></span>
    {variant === 'header' && (
      <>
        <span class="logo-abbr"><b>B</b>USINESS <b>I</b>NTEGRATION <b>Z</b>ONE</span>
        <span class="logo-slogan">Единая точка доступа к ПО и AI-сервисам</span>
      </>
    )}
  </span>
</span>

<style>
  .site-logo { display: inline-flex; align-items: center; gap: 0.6rem; }
  .logo-mark { flex-shrink: 0; }
  .logo-text { display: flex; flex-direction: column; line-height: 1.08; }
  .logo-word { font-weight: 800; letter-spacing: -0.02em; color: var(--color-text); white-space: nowrap; }
  .logo-word b { color: var(--color-accent); font-weight: 800; }
  .logo-abbr { font-weight: 700; letter-spacing: 0.24em; color: var(--color-text-muted); white-space: nowrap; }
  .logo-abbr b { color: var(--color-accent); font-weight: 700; }
  .logo-slogan { font-weight: 500; color: var(--color-text-muted); letter-spacing: 0; white-space: nowrap; }
  /* Шапка: полный лок-ап (знак + BIZSoft + аббревиатура + слоган) */
  .header .logo-mark { width: 32px; height: 41px; }
  .header .logo-word { font-size: 1.28rem; }
  .header .logo-abbr { font-size: 0.465rem; margin-top: 2px; }
  .header .logo-slogan { font-size: 0.58rem; margin-top: 2px; }
  /* Подвал: только лого */
  .footer .logo-mark { width: 38px; height: 49px; }
  .footer .logo-word { font-size: 1.5rem; }
  @media (max-width: 480px) {
    .header .logo-slogan { display: none; }
  }
  @media (max-width: 400px) {
    .header .logo-abbr { display: none; }
  }
</style>

---
import { site } from '../config/site';
import { canonicalUrl as buildCanonical } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** canonical path or absolute url; defaults to current URL */
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'product';
  /** оставлен для обратной совместимости; meta keywords больше не выводим */
  keywords?: string;
}

const {
  title,
  description = site.description,
  canonical,
  ogImage = '/og-default.png',
  noindex = false,
  type = 'website',
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
// Единый canonical без завершающего слеша (кроме главной).
const canonicalUrl = buildCanonical(canonical || Astro.url.pathname);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, site.url).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content="ru_RU" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

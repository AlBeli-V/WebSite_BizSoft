---
/**
 * Брендовый логотип вендора: официальный SVG-глиф (simple-icons) по slug,
 * либо буквенный знак-фолбэк, если логотипа нет в наборе.
 * Декоративный (aria-hidden) — название вендора выводится рядом текстом.
 */
import { brandLogo, hasFileLogo, logoFile } from '../data/logos';

interface Props {
  slug: string;
  name: string;
  size?: number;
}
const { slug, name, size = 24 } = Astro.props;
const fileLogo = hasFileLogo(slug);
const logo = fileLogo ? undefined : brandLogo(slug);
const genFile = !fileLogo && !logo ? logoFile(slug) : undefined;
const letter = (name || '?').trim().charAt(0).toUpperCase();
---
{fileLogo ? (
  <img class="vlogo vlogo-img" src={`/brand-logos/${slug}.svg`} alt="" width={size} height={size} loading="lazy" decoding="async" aria-hidden="true" />
) : logo ? (
  <svg class="vlogo" viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" focusable="false" role="presentation"><path d={logo.path} /></svg>
) : genFile ? (
  <img class="vlogo vlogo-img" src={genFile} alt="" width={size} height={size} loading="lazy" decoding="async" aria-hidden="true" />
) : (
  <span class="vlogo-letter" aria-hidden="true" style={`font-size:${Math.round(size * 0.62)}px`}>{letter}</span>
)}

<style>
  .vlogo { display: block; }
  .vlogo-img { object-fit: contain; }
  .vlogo-letter { display: flex; align-items: center; justify-content: center; font-weight: 800; line-height: 1; }
</style>

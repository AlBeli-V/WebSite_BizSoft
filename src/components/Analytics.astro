---
// Яндекс.Метрика (с Вебвизором) + Google Analytics 4 — под согласием.
//
// Главное изменение 16.09.2026 (ТЗ 152-ФЗ, п. 7): до выбора пользователя не
// загружается ни один необязательный тег. Раньше оба счётчика стартовали на
// первом же визите, а cookie-плашка только сообщала о факте. Теперь плашка
// принимает решение, а этот код его исполняет.
//
// Что это означает на практике: визиты людей, которые закрыли страницу, не
// нажав ничего, в статистику не попадают вовсе — ни в Метрику, ни в GA. Это
// цена согласия, а не дефект, и сравнивать посещаемость с периодом до
// 16.09.2026 напрямую нельзя.
//
// Идентификаторы берутся из src/lib/analytics.ts — там же, откуда их берёт
// trackGoal. Прежде они были захардкожены и здесь, и там: две копии одного
// значения, которые ничто не сверяло.
import { METRIKA_ID, GA_ID } from '../lib/analytics';
import { CONSENT_STORAGE_KEY, CONSENT_SCHEMA_VERSION } from '../lib/cookie-consent';

const metrikaId = METRIKA_ID;
const gaId = GA_ID;
---
{(metrikaId || gaId) && (
  <script is:inline define:vars={{ metrikaId, gaId, storageKey: CONSENT_STORAGE_KEY, schemaVersion: CONSENT_SCHEMA_VERSION }}>
    (function () {
      // ── Consent Mode: запрет по умолчанию ────────────────────────────
      //
      // Значения по умолчанию выставляются ДО чего бы то ни было, даже если
      // gtag.js не будет загружен вовсе: очередь dataLayer переживает
      // страницу, и при последующем согласии Google получит сначала
      // «запрещено», потом «разрешено» — ровно тот порядок, который он
      // ожидает. Рекламные категории запрещены навсегда: рекламных тегов на
      // сайте нет, и ремаркетинга мы не ведём.
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });

      function storedChoices() {
        try {
          var raw = localStorage.getItem(storageKey);
          if (!raw) return null;
          var p = JSON.parse(raw);
          if (!p || p.v !== schemaVersion) return null;
          return {
            yandex_analytics: p.yandex_analytics === true,
            google_analytics: p.google_analytics === true,
          };
        } catch (e) { return null; }
      }

      var metrikaStarted = false;
      var gaStarted = false;

      // Загрузчики стартуют после события load (requestIdleCallback с
      // потолком 1,5 с): на мобильном профиле PageSpeed tag.js с Вебвизором
      // и gtag.js делили канал и главный поток с ресурсами первой отрисовки.
      // Когда согласие даётся уже на загруженной странице, ждать нечего —
      // тег ставится сразу.
      function schedule(run) {
        if (document.readyState === 'complete') {
          if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: 1500 });
          else setTimeout(run, 300);
          return;
        }
        window.addEventListener('load', function () {
          if ('requestIdleCallback' in window) requestIdleCallback(run, { timeout: 1500 });
          else setTimeout(run, 300);
        });
      }

      function startMetrika() {
        if (metrikaStarted || !metrikaId) return;
        metrikaStarted = true;
        // Очередь ym() создаётся только здесь, вместе с разрешением: пока
        // согласия нет, функции ym в окне не существует, и trackGoal молча
        // пропускает вызов (см. lib/analytics.ts).
        window.ym = window.ym || function () { (window.ym.a = window.ym.a || []).push(arguments); };
        window.ym.l = 1 * new Date();
        ym(Number(metrikaId), 'init', { ssr: true, webvisor: true, clickmap: true, ecommerce: 'dataLayer', accurateTrackBounce: true, trackLinks: true, referrer: document.referrer, url: location.href });
        // Тег грузится напрямую с mc.yandex.ru. Кэширующий прокси своего
        // домена (PERF-METRIKA-001) снят 08.09.2026: с ним сайт перестал
        // собирать визиты вовсе — 04.09 их было 45, 03.09 — 69, 02.09 — 80,
        // а с 05.09 счётчик показывал 0–1 в день при живой рекламе и живой
        // органике. Прокси при этом отвечал 200 и отдавал файл нужного
        // размера, поэтому onerror не срабатывал и фолбэк не включался.
        //
        // Отсюда правило: подменять адрес тега можно только с проверкой,
        // что счётчик реально инициализировался в браузере, — код ответа и
        // размер файла об этом не говорят ничего.
        //
        // Адрес ниже — единственное вхождение пути тега в этом файле: его
        // считает tests/analytics-contract.test.ts, защищая от повторного
        // подключения счётчика.
        var origin = 'https://mc.yandex.ru/metrika/tag.js?id=' + metrikaId;
        schedule(function () {
          for (var j = 0; j < document.scripts.length; j++) {
            if (document.scripts[j].src === origin) return;
          }
          var first = document.getElementsByTagName('script')[0];
          var el = document.createElement('script');
          el.async = 1;
          el.src = origin;
          first.parentNode.insertBefore(el, first);
        });
      }

      function startGa() {
        if (gaStarted || !gaId) return;
        gaStarted = true;
        gtag('consent', 'update', { analytics_storage: 'granted' });
        gtag('js', new Date());
        // anonymize_ip и запрет рекламных сигналов — минимизация состава
        // технических данных, уходящих иностранному поставщику (док. 05, п. 3).
        gtag('config', gaId, { anonymize_ip: true, allow_google_signals: false, allow_ad_personalization_signals: false });
        schedule(function () {
          var s = document.createElement('script');
          s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        });
      }

      // Единственная точка включения. Её же вызывает cookie-плашка, когда
      // человек меняет выбор без перезагрузки страницы.
      window.__bzAnalyticsConsent = function (choices) {
        if (!choices) return;
        if (choices.yandex_analytics) startMetrika();
        if (choices.google_analytics) startGa();
        // Обратного хода у загруженного тега нет: выключить уже работающий
        // счётчик в текущей вкладке нельзя. Отзыв согласия применяется со
        // следующей загрузки страницы — плашка об этом и говорит.
      };

      var saved = storedChoices();
      if (saved) window.__bzAnalyticsConsent(saved);
    })();
  </script>
)}
{/* noscript-пиксель Метрики снят вместе с безусловной загрузкой тега: без
    JavaScript спросить согласие не у чего, а считать визит без согласия
    нельзя. */}

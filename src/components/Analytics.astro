---
// Яндекс.Метрика (с Вебвизором) + Google Analytics 4.
//
// Идентификаторы берутся из src/lib/analytics.ts — там же, откуда их берёт
// trackGoal. Прежде они были захардкожены и здесь, и там: две копии одного
// значения, которые ничто не сверяло. Разъехавшись, они дали бы тег на одном
// счётчике и цели на другом — обе половины выглядели бы исправными.
import { METRIKA_ID, GA_ID } from '../lib/analytics';

const metrikaId = METRIKA_ID;
const gaId = GA_ID;
---
{metrikaId && (
  <>
    <script is:inline define:vars={{ metrikaId }}>
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
        k = e.createElement(t); a = e.getElementsByTagName(t)[0];
        k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=' + metrikaId, 'ym');
      ym(Number(metrikaId), 'init', { ssr: true, webvisor: true, clickmap: true, ecommerce: 'dataLayer', accurateTrackBounce: true, trackLinks: true, referrer: document.referrer, url: location.href });
    </script>
    <noscript><div><img src={`https://mc.yandex.ru/watch/${metrikaId}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>
  </>
)}
{gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}

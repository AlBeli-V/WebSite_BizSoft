---
/**
 * «Или свяжитесь с нами напрямую:» — строка прямых контактов под формами.
 * Активные пиктограммы Telegram и WhatsApp (ведут на номер),
 * кликабельный телефон (tel:) и почта с пиктограммой конверта (mailto:).
 */
import { seller } from '../config/site';
---
<div class="cd">
  <p class="cd-cap">Или свяжитесь с нами напрямую:</p>
  <div class="cd-row">
    <a class="cd-ic" href={`https://t.me/${seller.phoneHref}`} target="_blank" rel="noopener" data-contact="telegram" aria-label="Написать в Telegram" title="Telegram">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.5 4.5 2.9 11.7c-.9.35-.85 1.65.07 1.93l4.63 1.4 1.8 5.5c.28.86 1.4 1 1.9.25l2.4-3.6 4.9 3.6c.75.55 1.83.14 2-.78l2.5-13.8c.2-1.05-.85-1.9-1.7-1.4Z"/></svg>
    </a>
    <a class="cd-ic" href={`https://wa.me/${seller.phoneHref.replace('+', '')}`} target="_blank" rel="noopener" data-contact="whatsapp" aria-label="Написать в WhatsApp" title="WhatsApp">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z"/><path d="M8.8 8.6c.3-.7.9-.7 1.2-.1l.7 1.3c.15.3.05.6-.2.9l-.5.5c.5 1.1 1.5 2.1 2.6 2.6l.5-.5c.3-.25.6-.35.9-.2l1.3.7c.6.3.6.9-.1 1.2-3 .9-7.3-3.4-6.4-6.4Z"/></svg>
    </a>
    <a class="cd-link" data-contact="phone" href={`tel:${seller.phoneHref}`}>{seller.phone}</a>
    <a class="cd-link cd-mail" data-contact="email" href={`mailto:${seller.salesEmail}`} aria-label={`Написать на ${seller.salesEmail}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
      {seller.salesEmail}
    </a>
  </div>
</div>

<style>
  .cd { display: flex; flex-direction: column; gap: 0.5rem; }
  .cd-cap { margin: 0; color: var(--color-text-muted); font-size: 0.88rem; }
  .cd-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.9rem; }
  .cd-ic { display: inline-flex; padding: 5px; border-radius: 8px; color: var(--color-text-muted); border: 1px solid var(--color-border-strong); transition: color 0.15s ease, border-color 0.15s ease; }
  .cd-ic:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .cd-link { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--color-accent); font-weight: 600; font-size: 0.92rem; text-decoration: none; }
  .cd-link:hover { text-decoration: underline; }
  .cd-mail svg { color: var(--color-text-muted); }
  .cd-mail:hover svg { color: var(--color-accent); }
</style>

<script>
  /**
   * Обращения мимо форм.
   *
   * Строка прямых контактов стоит под каждой формой, и заметная доля B2B-
   * обращений уходит именно через неё — звонком, письмом, в Telegram. До сих
   * пор этот канал не измерялся вовсе: в отчёте он выглядел как отсутствие
   * обращений, а не как обращения, которых мы не видим.
   */
  import { trackGoal } from '@/lib/analytics';

  document.querySelectorAll('[data-contact]').forEach((el) => {
    el.addEventListener('click', () => {
      trackGoal('contact_click', {
        channel: (el as HTMLElement).dataset.contact || 'unknown',
        page_url: location.pathname,
      });
    });
  });
</script>

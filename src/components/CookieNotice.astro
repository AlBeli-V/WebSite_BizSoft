---
// Cookie-уведомление. Показывается один раз, состояние — в localStorage.
---
<div class="cookie" data-cookie hidden>
  <p>Мы используем cookie и веб-аналитику для улучшения работы сайта. Продолжая, вы соглашаетесь с <a href="/privacy">политикой обработки данных</a>.</p>
  <button class="btn btn-primary btn-sm" data-cookie-accept>Принять</button>
</div>

<style>
  .cookie {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    max-width: 640px;
    margin-inline: auto;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    z-index: 60;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }
  .cookie p { margin: 0; font-size: 0.88rem; color: var(--color-text-muted); }
  .cookie a { color: var(--color-accent); }
  .cookie button { white-space: nowrap; }
  @media (max-width: 520px) { .cookie { flex-direction: column; align-items: stretch; } }
</style>

<script>
  const KEY = 'bizsoft_cookie_ok';
  const el = document.querySelector('[data-cookie]') as HTMLElement | null;
  if (el && !localStorage.getItem(KEY)) {
    el.hidden = false;
    el.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
      localStorage.setItem(KEY, '1');
      el.hidden = true;
    });
  }
</script>

---
/**
 * Профильные значки товарной позиции (например, знаки приложений Adobe).
 * Составные позиции (тариф «Фотография» = Lightroom + Photoshop) рендерят
 * несколько значков в ряд — при наведении на плитку все становятся цветными
 * одновременно (правила .vi в global.css).
 * variant="hover": монохром → цвет при наведении на плитку/ссылку.
 * variant="color": статичные цветные (страница товара, рядом с названием).
 * Если значков для слага нет — не рендерит ничего.
 */
import { productIcons } from '../data/product-icons';

interface Props {
  slug: string;
  name?: string;
  size?: number;
  variant?: 'hover' | 'color' | 'mono';
}
const { slug, name = '', size = 40, variant = 'hover' } = Astro.props;
const icons = productIcons(slug);
const alt = name ? `Значок ${name}` : '';
---
{icons.length > 0 && (
  <span class="pi-row" style={`--pi:${size}px`}>
    {icons.map((icon, i) => (
      variant === 'hover' ? (
        <span class="vi" style={`width:${size}px;height:${size}px`}>
          <img class="vi-mono" src={icon.mono} alt={i === 0 ? alt : ''} width={size} height={size} loading="lazy" decoding="async" />
          <img class="vi-color" src={icon.color} alt="" aria-hidden="true" width={size} height={size} loading="lazy" decoding="async" />
        </span>
      ) : (
        <img class="pi-static" src={variant === 'color' ? icon.color : icon.mono} alt={i === 0 ? alt : ''} width={size} height={size} loading="lazy" decoding="async" />
      )
    ))}
  </span>
)}

<style>
  .pi-row { display: inline-flex; align-items: center; gap: 0.4rem; flex-shrink: 0; }
  .pi-static { object-fit: contain; display: block; }
</style>

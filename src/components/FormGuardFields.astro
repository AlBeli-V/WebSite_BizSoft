---
// Скрытые поля защиты публичных форм (SEC-RL-001). Ставятся в каждую форму,
// которая постит на /api/lead или /api/quote; проверяет их src/lib/form-guard.ts.
//
// Имена полей продублированы строками намеренно: тянуть сюда серверный
// модуль (node:crypto, клиент Directus) ради двух констант — значит тащить
// его в клиентский бандл. Совпадение имён держит тест tests/form-guard.test.ts.
//
//   company_site   — приманка. Человек её не видит и табом не достанет;
//                    заполнить может только разбор разметки роботом.
//   form_opened_at — когда браузер открыл страницу с формой. Отправка
//                    быстрее трёх секунд после открытия — не человек.
---
<div class="fg-trap" aria-hidden="true">
  <label>
    Сайт компании
    <input type="text" name="company_site" tabindex="-1" autocomplete="off" />
  </label>
</div>
<input type="hidden" name="form_opened_at" data-form-opened-at />

<style>
  /* Скрываем сдвигом за край экрана, а не свойством видимости: поля,
     спрятанные штатными средствами, часть роботов пропускает, а нам нужно,
     чтобы приманку заметили и заполнили. Из фокуса поле убрано атрибутом
     tabindex — для человека его не существует. */
  .fg-trap {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script>
  // Метку ставим один раз при загрузке страницы, а не при открытии диалога:
  // повторная простановка «на всякий случай» рискует сброситься кликом по
  // самой кнопке отправки, и тогда живой человек получит отказ.
  const stamp = () => {
    document.querySelectorAll('[data-form-opened-at]').forEach((el) => {
      (el as HTMLInputElement).value = String(Date.now());
    });
  };
  stamp();
  // Переходы с сохранением документа (view transitions) не перезапускают
  // модуль — метку нужно обновить вручную, иначе она останется от прошлой
  // страницы. Лишним не будет и там, где переходов нет.
  document.addEventListener('astro:page-load', stamp);
</script>

<script>
  import { trackGoal, trackGoalOnce } from '@/lib/analytics';
  import { readCart, cartTotal } from '../lib/cart-client';
  import { formatRub } from '../lib/pricing';

  trackGoal('view_vendor_landing', { page_url: location.pathname });
  document.querySelectorAll('[data-ev]').forEach((el) => {
    el.addEventListener('click', () => trackGoal((el as HTMLElement).dataset.ev!, { page_url: location.pathname }));
  });

  // ── Счётчик количества на карточке ────────────────────────────────
  // Сумма пересчитывается на месте: решение о бюджете принимается на
  // странице, а не после звонка менеджера.
  function repaintSum(scope: Element) {
    const field = scope.querySelector('[data-qty]') as HTMLInputElement | null;
    const sum = scope.querySelector('[data-sum]') as HTMLElement | null;
    if (!field || !sum) return;
    const min = Number(field.min || 1);
    const n = parseInt(field.value, 10);
    const qty = Number.isFinite(n) && n >= min ? n : min;
    const price = Number(sum.dataset.price || 0);
    const b = sum.querySelector('b');
    if (b) b.textContent = formatRub(price * qty);
  }
  document.querySelectorAll('[data-qty-scope]').forEach((scope) => {
    const field = scope.querySelector('[data-qty]') as HTMLInputElement | null;
    if (!field) return;
    const min = Number(field.min || 1);
    scope.querySelectorAll('[data-qty-step]').forEach((b) => {
      b.addEventListener('click', () => {
        const step = Number((b as HTMLElement).dataset.qtyStep || 1);
        const n = parseInt(field.value, 10);
        // Минимум вендора — нижняя граница: «от 2 мест» должно держаться
        // счётчиком, а не только строкой в вопросах.
        field.value = String(Math.max(min, (Number.isFinite(n) ? n : min) + step));
        repaintSum(scope);
      });
    });
    field.addEventListener('input', () => repaintSum(scope), { passive: true });
    field.addEventListener('blur', () => {
      const n = parseInt(field.value, 10);
      if (!Number.isFinite(n) || n < min) field.value = String(min);
      repaintSum(scope);
    });
  });

  // Тарифы показаны на экране — шаг между визитом и выбором. Раз на страницу.
  const grid = document.querySelector('#products .vgrid');
  if (grid && typeof IntersectionObserver === 'function') {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { trackGoalOnce('view_tariffs', { page_url: location.pathname }); io.disconnect(); }
      }
    }, { threshold: 0.25 });
    io.observe(grid);
  }

  // ── Состав расчёта рядом с формой ─────────────────────────────────
  // Подборка собрана на странице — значит, в заявке она должна оказаться
  // сама. Раньше выбор тарифа в форму не доезжал: клиент называл продукт
  // словами заново.
  const spec = document.querySelector('[data-spec]') as HTMLElement | null;
  const specList = document.querySelector('[data-spec-list]') as HTMLElement | null;
  const specTotal = document.querySelector('[data-spec-total]') as HTMLElement | null;
  const ref = document.querySelector('[data-product-ref]') as HTMLInputElement | null;

  function paintSpec() {
    const items = readCart();
    if (spec) spec.hidden = items.length === 0;
    if (specList) {
      specList.innerHTML = '';
      for (const it of items) {
        const li = document.createElement('li');
        li.textContent = it.name;
        const q = document.createElement('span');
        q.className = 'q';
        q.textContent = ` — ${it.qty} шт · ${formatRub(it.price * it.qty)}`;
        li.appendChild(q);
        specList.appendChild(li);
      }
    }
    if (specTotal) specTotal.textContent = formatRub(cartTotal(items));
    if (ref && items.length) {
      ref.dataset.base = items.map((i) => `${i.name} ×${i.qty}`).join('; ').slice(0, 300);
      ref.value = ref.dataset.base;
    }
  }
  paintSpec();
  window.addEventListener('cart:change', paintSpec);

  // ── Призывы ведут в одну форму и приносят с собой контекст ────────
  document.querySelectorAll('[data-quote-cta]').forEach((el) => {
    el.addEventListener('click', () => {
      const ctx = (el as HTMLElement).dataset.context || '';
      // Состав подборки важнее подписи кнопки: если человек что-то выбрал,
      // в заявку идёт выбранное, а не «подбор тарифа».
      if (ref && !ref.dataset.base && ctx) {
        ref.dataset.base = ctx;
        ref.value = ctx;
      }
      const field = document.querySelector('.final [data-lead-form] input') as HTMLInputElement | null;
      // Прокрутка уже идёт по якорю href="#lead"; фокус ставим после неё.
      setTimeout(() => field?.focus({ preventScroll: true }), 400);
    });
  });
</script>

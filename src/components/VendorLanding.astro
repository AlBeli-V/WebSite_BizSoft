  .btn-link { background: none; border: none; padding: 0.55rem 0; color: var(--color-accent); font: inherit; font-weight: 600; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .btn-link:hover { color: var(--color-accent-hover); }
  .spec { padding: 1rem 1.2rem; margin: 1.2rem 0; display: flex; flex-direction: column; gap: 0.4rem; }

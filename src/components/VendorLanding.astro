  .topup-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: 0.6rem; }
  .topup { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; background: var(--color-bg-elevated); border-radius: var(--radius-sm); padding: 0.55rem 0.8rem; }

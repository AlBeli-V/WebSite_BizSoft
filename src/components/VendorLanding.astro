</style>

<script>
  import { trackGoal } from '@/lib/analytics';
  // Единый путь заявки (счётчик, состав расчёта, перенос выбора в форму)
  // живёт в VendorQuotePath: тем же кодом пользуются остальные страницы.
  // Клики по data-ev считает общий обработчик макета: держать его здесь
  // значило бы задваивать цель на страницах, где он тоже есть.
  trackGoal('view_vendor_landing', { page_url: location.pathname });

  // ── Выбор ситуации сужает сетку ─────────────────────────────────────
  // Фильтр только прячет лишнее атрибутом hidden: без JavaScript и для
  // поискового робота на странице видны все карточки и весь текст.
  const segBtns = Array.from(document.querySelectorAll('[data-seg-btn]')) as HTMLElement[];
  if (segBtns.length > 0) {
    const segCards = Array.from(document.querySelectorAll('[data-seg-card]')) as HTMLElement[];
    const whys = Array.from(document.querySelectorAll('[data-seg-why]')) as HTMLElement[];
    const reset = document.querySelector('[data-seg-reset]') as HTMLElement | null;

    function applySegment(id: string) {
      segBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.segBtn === id)));
      // Позиция без пометки видна всегда: правка сегмента не должна тихо
      // уносить карточку со страницы.
      segCards.forEach((c) => { c.hidden = Boolean(id) && c.dataset.segCard !== id; });
      whys.forEach((w) => { w.hidden = w.dataset.segWhy !== id; });
      if (reset) reset.hidden = !id;
    }

    segBtns.forEach((b) => b.addEventListener('click', () => {
      const id = b.getAttribute('aria-pressed') === 'true' ? '' : (b.dataset.segBtn || '');
      applySegment(id);
      trackGoal('vendor_selector_step', {
        page_url: location.pathname, segment: id || 'сброшен',
      });
    }));
    reset?.addEventListener('click', () => {
      applySegment('');
      trackGoal('vendor_selector_step', { page_url: location.pathname, segment: 'сброшен' });
    });
  }
</script>

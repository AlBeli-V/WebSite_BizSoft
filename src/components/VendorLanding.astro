     куда попал. */
  #products, #lead, #security { scroll-margin-top: 96px; }
  .block > h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-bottom: 1.2rem; }
  .vgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 1.2rem; }
  /* Выбор ситуации */
  .lead-note { max-width: 70ch; margin-bottom: 1rem; }
  .segs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 1rem; }
  .seg { text-align: left; padding: 1.1rem; display: flex; flex-direction: column; gap: 0.35rem; cursor: pointer; font: inherit; color: var(--color-text); }
  .seg b { font-size: 1rem; }

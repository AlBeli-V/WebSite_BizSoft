---
/**
 * Универсальный шаблон посадочной страницы производителя.
 * Данные (карточки, цены, slug) берутся ЖИВЫМИ из Directus по полю vendor.
 * Редакторская обвязка — из src/data/vendors.ts (VendorEntry).
 */
import Breadcrumbs from './Breadcrumbs.astro';
import FAQ from './FAQ.astro';
import LeadForm from './LeadForm.astro';
import QuestionForm from './QuestionForm.astro';
import VendorLogo from './VendorLogo.astro';
import JsonLd from './JsonLd.astro';
import { getProducts } from '../lib/directus';
import { effectivePrice, formatRub } from '../lib/pricing';
import { collectionPageSchema, faqSchema, breadcrumbSchema } from '../lib/seo';
import { mergeExperimentFaq } from '../data/seo-experiments';
import { planType, PLAN_LABEL } from '../lib/plan-type';
import { productIcon } from '../data/product-icons';
import ProductIcon from './ProductIcon.astro';
import AddToCartButton from './AddToCartButton.astro';
import { DOMAIN_AUDIENCE, type VendorEntry } from '../data/vendors';
import { vendorContent } from '../data/vendor-content';
import type { Product } from '../lib/types';

interface Props { entry: VendorEntry }
const { entry } = Astro.props;
const title = entry.title || entry.vendor;
const audience = DOMAIN_AUDIENCE[entry.domain];
const content = vendorContent(entry.slug);

let products: Product[] = [];
try {
  products = await getProducts({ vendor: entry.vendor });
} catch (e) {
  console.error(`vendor landing data error (${entry.vendor})`, e);
}

// Вью-модели карточек (операторы сравнения — здесь, не в шаблоне).
const cards = products.map((p) => {
  const eff = effectivePrice(p);
  const feats = Array.isArray(p.features) ? p.features.slice(0, 5) : [];
  return {
    name: p.name,
    slug: p.slug,
    sku: p.sku,
    price: eff.price,
    priceText: formatRub(eff.price),
    note: p.price_note || '',
    byRequest: !(eff.price > 0), // NaN и null — тоже «по запросу»
    short: p.short_description || '',
    features: feats,
    plan: planType(p.name, p.short_description || ''),
    icon: Boolean(productIcon(p.slug)),
  };
});
// Карточки «Цена по запросу» — всегда в конце списка
cards.sort((a, b) => Number(a.byRequest) - Number(b.byRequest));
const priced = cards.filter((c) => !c.byRequest);
const minPrice = priced.length ? Math.min(...products.filter((p) => effectivePrice(p).price > 0).map((p) => effectivePrice(p).price)) : 0;
const hasMin = minPrice > 0;
const hasCards = cards.length > 0;

const pageUrl = `/vendors/${entry.slug}`;
const crumbs = [
  { name: 'Каталог', url: '/catalog' },
  { name: entry.catLabel, url: `/catalog/${entry.catSeg}` },
  { name: title, url: pageUrl },
];

// FAQ — свой bespoke (если задан) либо шаблонные вопросы под юрлицо.
const baseFaq = content.faq?.length ? content.faq : [
  { q: `Как купить ${title} для юридического лица в России?`, a: `Через BIZSoft: заключаем договор, выставляем счёт, оплата в рублях по безналичному расчёту. Закрывающие документы передаём в том числе через ЭДО. Оставьте заявку — подберём тариф и подготовим КП.` },
  { q: `Сколько стоит ${title}?`, a: `Цена в рублях рассчитывается от зарубежного прайса по курсу ЦБ РФ на дату счёта. Актуальную стоимость по каждому тарифу смотрите в карточках выше.` },
  { q: `Можно ли оплатить ${title} с расчётного счёта организации?`, a: `Да. Мы работаем с юрлицами и ИП по договору и счёту, предоставляем закрывающие документы для бухгалтерии.` },
  { q: `Как быстро предоставляется доступ к ${title}?`, a: `После поступления оплаты передаём ключи, доступы или инструкции по активации в согласованные сроки.` },
];
// SEO-эксперимент P0-1: коммерческий вопрос первым, без дублей (только 5 слагов).
const faq = mergeExperimentFaq(baseFaq, entry.slug, entry.vendor);

const summaryText = content.summary || `${entry.about} BIZSoft поставляет ${title} российским юрлицам и ИП по договору с оплатой по счёту.`;
const hasCompare = !!content.comparison && content.comparison.rows.length > 0;
const hasDecision = !!content.decision && content.decision.length > 0;
const hasScenarios = !!content.scenarios && content.scenarios.length > 0;

const description = `${title} для юридических лиц: ${entry.tagline} Покупка по договору и счёту, оплата в рублях, закрывающие документы через ЭДО.`;
const ld = [
  collectionPageSchema({ name: `${title} для бизнеса`, description, url: pageUrl, items: cards.map((c) => ({ name: c.name, slug: c.slug })) }),
  faqSchema(faq),
  breadcrumbSchema([{ name: 'Главная', url: '/' }, ...crumbs]),
];
---
<JsonLd schema={ld} />
<div class="container-page section" style={`--vc:${entry.brandColor}`}>
  <Breadcrumbs items={crumbs} />

  <!-- HERO -->
  <header class="hero">
    <div class="vendor-row">
      <VendorLogo slug={entry.slug} name={title} size={44} />
      <span class="vendor-name">{title}</span>
      <span class="vendor-legal">{entry.legalName}</span>
    </div>
    <h1>{title} для юридических лиц: тарифы и оформление через BIZSoft</h1>
    <p class="hero-sub">{entry.tagline} Подбор тарифа под задачи {audience}.</p>
    <ul class="chips"><li>Для юрлиц</li><li>КП и счёт</li><li>Договор и закрывающие</li><li>Оплата в рублях</li></ul>
    <div class="hero-actions">
      <button class="btn btn-primary" data-open-question data-product={`${title} — подбор тарифа`} data-ev="click_get_quote">Получить расчёт и КП</button>
      {hasCards && <a href="#products" class="btn btn-ghost" data-ev="click_choose_plan">Смотреть тарифы</a>}
    </div>
    {hasMin && <p class="from">Цены от <b>{formatRub(minPrice)}</b> в год</p>}
  </header>

  <!-- Прямой ответ (GEO/AEO) -->
  <div class="summary"><strong>Коротко:</strong> {summaryText}</div>

  <!-- Карточки продуктов -->
  {hasCards ? (
    <section class="block" id="products">
      <h2>Тарифы и продукты {title}</h2>
      <div class="vgrid">
        {cards.map((c) => (
          <article class="card vcard">
            {c.icon && <div class="vc-ico"><ProductIcon slug={c.slug} name={c.name} size={40} /></div>}
            <h3>{c.name}</h3>
            {c.plan && <span class="plan-tag" data-plan={c.plan}>{PLAN_LABEL[c.plan]}</span>}
            {c.short && <p class="forwhom">{c.short}</p>}
            <div class="vprice">
              {c.byRequest
                ? <span class="req">Цена по запросу</span>
                : <span class="pv"><b>{c.priceText}</b> <span class="note">{c.note}</span></span>}
            </div>
            {c.features.length > 0 && <ul class="vfeat">{c.features.map((f) => <li>{f}</li>)}</ul>}
            <div class="vactions">
              {c.byRequest ? (
                <button class="btn btn-primary btn-sm" data-open-question data-product={`${title} — ${c.name}`} data-sku={c.sku} data-ev="click_get_quote">Запросить цену</button>
              ) : (
                <AddToCartButton sku={c.sku} slug={c.slug} name={c.name} price={c.price} compact />
              )}
              <a href={`/product/${c.slug}`} class="btn btn-ghost btn-sm" data-ev="click_product_card">Подробнее</a>
            </div>
          </article>
        ))}
      </div>
      <p class="muted small">Стоимость в рублях пересчитывается по курсу ЦБ РФ на дату счёта.</p>
    </section>
  ) : (
    <section class="block" id="products">
      <h2>Тарифы и продукты {title}</h2>
      <p class="muted">Подберём и рассчитаем нужные лицензии {title} под вашу задачу. Оставьте заявку — подготовим КП.</p>
      <button class="btn btn-primary" data-open-question data-product={`${title} — расчёт`} data-ev="click_get_quote">Запросить расчёт</button>
    </section>
  )}

  {hasCompare && (
    <section class="block" id="compare">
      <h2>Сравнение тарифов {title}</h2>
      <div class="table-wrap">
        <table class="cmp">
          <thead><tr><th class="sticky">Параметр</th>{content.comparison!.cols.map((c) => <th>{c}</th>)}</tr></thead>
          <tbody>{content.comparison!.rows.map((r) => (<tr><th class="sticky">{r.label}</th>{r.values.map((v) => <td>{v}</td>)}</tr>))}</tbody>
        </table>
      </div>
      <p class="muted small">Цены и характеристики ориентировочные; стоимость в рублях — по курсу ЦБ РФ.</p>
    </section>
  )}

  {hasDecision && (
    <section class="block">
      <h2>Что выбрать</h2>
      <div class="table-wrap">
        <table class="cmp decision">
          <thead><tr><th class="sticky">Сценарий</th><th>Рекомендуем</th><th>Почему</th></tr></thead>
          <tbody>{content.decision!.map((d) => (<tr><th class="sticky">{d.scenario}</th><td>{d.product}</td><td class="muted">{d.note}</td></tr>))}</tbody>
        </table>
      </div>
    </section>
  )}

  {hasScenarios && (
    <section class="block">
      <h2>Сценарии использования</h2>
      <div class="cells">{content.scenarios!.map((s) => (<div class="card cell"><h3>{s.title}</h3><p>{s.text}</p></div>))}</div>
    </section>
  )}

  <!-- Для кого -->
  <section class="block">
    <h2>Для кого подходит {title}</h2>
    <div class="prose-bizsoft"><p>{entry.about} Решение востребовано у {audience}. BIZSoft оформит поставку на организацию с полным пакетом документов.</p></div>
  </section>

  <!-- Как купить -->
  <section class="block">
    <h2>Как купить {title} через BIZSoft</h2>
    <ol class="steps">
      <li>Вы оставляете заявку или выбираете тариф в каталоге.</li>
      <li>Менеджер уточняет задачу: продукт, число лицензий, срок, документы.</li>
      <li>BIZSoft готовит КП или счёт с ценой в рублях.</li>
      <li>После согласования оформляются договор и оплата по счёту.</li>
      <li>После оплаты передаются доступы, ключи или инструкции по активации.</li>
      <li>Закрывающие документы передаются в согласованном формате, в том числе через ЭДО.</li>
    </ol>
    <button class="btn btn-primary" data-open-question data-product={`${title} — расчёт и КП`} data-ev="click_get_quote">Получить расчёт и КП</button>
  </section>

  <!-- Документы -->
  <section class="block">
    <h2>Документы для бухгалтерии и закупки</h2>
    <div class="prose-bizsoft"><p>Для юридических лиц важно корректное оформление. Через BIZSoft можно запросить КП, счёт, договор и закрывающие документы; закрывающие могут передаваться через <a href="/documents">ЭДО</a>. Для КП подготовьте: название организации, ИНН, контактное лицо, email, нужный продукт и количество лицензий.</p></div>
  </section>

  <!-- FAQ -->
  <FAQ items={faq} title={`Частые вопросы про ${title} для бизнеса`} schema={false} />

  <!-- Финальный CTA -->
  <section class="block final">
    <div class="final-grid">
      <div>
        <h2>Подобрать {title} для компании</h2>
        <p class="muted">Опишите задачу: какой продукт и сколько лицензий нужно, на какой срок. Подготовим расчёт, КП или счёт с оформлением на юрлицо.</p>
        <ul class="vfeat">
          <li>Оформление для юрлиц: договор, счёт, закрывающие</li>
          <li>Оплата в рублях по курсу ЦБ РФ</li>
          <li>Подбор тарифа и количества лицензий</li>
        </ul>
      </div>
      <LeadForm source={`vendor-${entry.slug}`} title={`Подбор ${title}`} submitLabel="Получить расчёт и КП" />
    </div>
  </section>

  <!-- Внутренние ссылки -->
  <section class="block links">
    <h2>Связанные товары и разделы</h2>
    <div class="link-grid">
      {cards.slice(0, 8).map((c) => <a href={`/product/${c.slug}`}>{c.name}</a>)}
      <a href={`/catalog/${entry.catSeg}`}>Все товары раздела «{entry.catLabel}»</a>
      <a href="/vendors">Все производители</a>
      <a href="/how-we-work">Как мы работаем</a>
      <a href="/documents">Документы</a>
      <a href="/contacts">Контакты</a>
    </div>
  </section>
</div>

<QuestionForm source={`vendor-${entry.slug}`} />

<style>
  .section { padding-top: 2rem; }
  .hero { padding: 1rem 0 1.5rem; max-width: 820px; }
  .vendor-row { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1rem; flex-wrap: wrap; }
  .vendor-name { font-weight: 700; font-size: 1.05rem; }
  .vendor-legal { color: var(--color-text-dim); font-size: 0.85rem; }
  h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); margin-bottom: 1rem; }
  .hero-sub { color: var(--color-text-muted); font-size: 1.08rem; max-width: 64ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 1.2rem 0; }
  .chips li { background: var(--color-bg-elevated); border: 1px solid var(--color-border); color: var(--color-text-muted); font-size: 0.82rem; padding: 0.25rem 0.7rem; border-radius: 999px; }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 0.8rem; }
  .from { color: var(--color-text-muted); font-size: 0.92rem; }
  .from b { color: var(--color-text); }
  .summary { background: var(--color-bg-card); border: 1px solid var(--color-border); border-left: 3px solid var(--vc, var(--color-accent)); border-radius: var(--radius); padding: 1rem 1.2rem; margin: 1.5rem 0; color: var(--color-text); }
  .summary strong { color: var(--color-text); }
  .block { margin-top: 3rem; }
  .block > h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-bottom: 1.2rem; }
  .vgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.2rem; }
  .vcard { padding: 1.4rem; display: flex; flex-direction: column; }
  .vcard h3 { font-size: 1.1rem; margin-bottom: 0.4rem; }
  .vc-ico { margin-bottom: 0.6rem; }
  .forwhom { color: var(--color-text-dim); font-size: 0.85rem; margin-bottom: 0.6rem; }
  /* Кому адресован тариф */
  .plan-tag { align-self: flex-start; font-size: 0.72rem; padding: 0.14rem 0.55rem; border-radius: 6px; margin-bottom: 0.5rem; }
  .plan-tag[data-plan='team'] { color: var(--vc, var(--color-accent)); background: color-mix(in srgb, var(--vc, var(--color-accent)) 12%, transparent); font-weight: 700; }
  .plan-tag[data-plan='individual'] { color: var(--color-text-muted); border: 1px solid var(--color-border-strong); font-weight: 600; }
  .vprice { margin: 0.3rem 0 0.7rem; }
  .vprice b { font-size: 1.2rem; }
  .vprice .note { color: var(--color-text-dim); font-size: 0.8rem; }
  .vprice .req { font-weight: 700; }
  .vfeat { list-style: none; padding: 0; margin: 0 0 0.7rem; display: grid; gap: 0.3rem; }
  .vfeat li { padding-left: 1.3rem; position: relative; color: var(--color-text); font-size: 0.88rem; }
  .vfeat li::before { content: '✓'; position: absolute; left: 0; color: var(--vc, var(--color-accent)); font-weight: 700; }
  .vactions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: auto; }
  .muted { color: var(--color-text-muted); }
  .small { font-size: 0.82rem; margin-top: 0.6rem; }
  .steps { padding-left: 1.2rem; color: var(--color-text); display: grid; gap: 0.5rem; margin-bottom: 1.2rem; max-width: 800px; }
  .final-grid { display: grid; grid-template-columns: 1fr 400px; gap: 2.5rem; align-items: start; }
  .links .link-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.6rem; }
  .links a { color: var(--color-accent); font-size: 0.92rem; padding: 0.5rem 0; }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table.cmp { width: 100%; border-collapse: collapse; min-width: 560px; font-size: 0.92rem; }
  table.cmp th, table.cmp td { border: 1px solid var(--color-border); padding: 0.55rem 0.8rem; text-align: left; }
  table.cmp thead th { background: var(--color-bg-elevated); }
  table.cmp .sticky { position: sticky; left: 0; background: var(--color-bg-card); font-weight: 600; }
  .cells { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
  .cell { padding: 1.3rem; } .cell h3 { font-size: 1.05rem; margin-bottom: 0.4rem; } .cell p { color: var(--color-text-muted); font-size: 0.9rem; }
  @media (max-width: 880px) { .final-grid { grid-template-columns: 1fr; } }
</style>

<script>
  function track(name: string, params: Record<string, unknown> = {}) {
    const w = window as unknown as { ym?: (...a: unknown[]) => void; gtag?: (...a: unknown[]) => void };
    const id = (import.meta as { env: Record<string, string> }).env.PUBLIC_METRIKA_ID || '110206070';
    if (typeof w.ym === 'function' && id) w.ym(Number(id), 'reachGoal', name, params);
    if (typeof w.gtag === 'function') w.gtag('event', name, params);
  }
  track('view_vendor_landing', { page_url: location.pathname });
  document.querySelectorAll('[data-ev]').forEach((el) => {
    el.addEventListener('click', () => track((el as HTMLElement).dataset.ev!, { page_url: location.pathname }));
  });
</script>

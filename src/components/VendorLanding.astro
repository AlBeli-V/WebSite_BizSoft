<script>
  import { trackGoal } from '@/lib/analytics';
  // Единый путь заявки (счётчик, состав расчёта, перенос выбора в форму)
  // живёт в VendorQuotePath: тем же кодом пользуются остальные страницы.
  // Клики по data-ev считает общий обработчик макета: держать его здесь
  // значило бы задваивать цель на страницах, где он тоже есть.
  trackGoal('view_vendor_landing', { page_url: location.pathname });

  // ── Выбор ситуации и направления сужает сетку ───────────────────────
  // Осей две — случай («кому покупаем») и направление («какая задача»), и
  // работают они вместе: отмечены обе — остаётся пересечение. Фильтр только
  // прячет лишнее атрибутом hidden: без JavaScript и для поискового робота
  // на странице видны все карточки и весь текст.
  const segBtns = Array.from(document.querySelectorAll('[data-seg-btn]')) as HTMLElement[];
  const catBtns = Array.from(document.querySelectorAll('[data-cat-btn]')) as HTMLElement[];
  if (segBtns.length > 0 || catBtns.length > 0) {
    const items = Array.from(document.querySelectorAll('[data-seg-card], [data-cat-card]')) as HTMLElement[];
    const whys = Array.from(document.querySelectorAll('[data-seg-why]')) as HTMLElement[];
    const notes = Array.from(document.querySelectorAll('[data-cat-note]')) as HTMLElement[];
    const segReset = document.querySelector('[data-seg-reset]') as HTMLElement | null;
    const catReset = document.querySelector('[data-cat-reset]') as HTMLElement | null;
    const empty = document.querySelector('[data-filter-empty]') as HTMLElement | null;
    const state = { seg: '', cat: '' };

    function apply() {
      segBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.segBtn === state.seg)));
      catBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.catBtn === state.cat)));
      // Позиция без пометки по оси проходит эту ось: правка случая или
      // направления не должна тихо уносить карточку со страницы, а полный
      // набор виден при любом выбранном направлении — он их закрывает все.
      items.forEach((el) => {
        const okSeg = !state.seg || !el.dataset.segCard || el.dataset.segCard === state.seg;
        const okCat = !state.cat || !el.dataset.catCard || el.dataset.catCard === state.cat;
        el.hidden = !(okSeg && okCat);
      });
      whys.forEach((w) => { w.hidden = w.dataset.segWhy !== state.seg; });
      notes.forEach((n) => { n.hidden = n.dataset.catNote !== state.cat; });
      if (segReset) segReset.hidden = !state.seg;
      if (catReset) catReset.hidden = !state.cat;
      // Сообщение о пустом списке — про список позиций, а не про страницу
      // целиком: полный набор пометки направления не несёт и остаётся на
      // экране при любом выборе, поэтому считать надо только размеченные
      // позиции. Иначе «Для организации» плюс направление без командных
      // позиций даёт пустой список молча — видны одни флагманы, и покупатель
      // думает, что у вендора больше ничего нет.
      const scoped = items.filter((el) => el.dataset.catCard);
      if (empty) {
        empty.hidden = !((state.seg || state.cat) && scoped.length > 0 && scoped.every((el) => el.hidden));
      }
    }

    function step() {
      trackGoal('vendor_selector_step', {
        page_url: location.pathname,
        segment: state.seg || 'сброшен',
        direction: state.cat || 'сброшено',
      });
    }

    segBtns.forEach((b) => b.addEventListener('click', () => {
      state.seg = b.getAttribute('aria-pressed') === 'true' ? '' : (b.dataset.segBtn || '');
      apply();
      step();
    }));
    catBtns.forEach((b) => b.addEventListener('click', () => {
      state.cat = b.getAttribute('aria-pressed') === 'true' ? '' : (b.dataset.catBtn || '');
      apply();
      step();
    }));
    segReset?.addEventListener('click', () => { state.seg = ''; apply(); step(); });
    catReset?.addEventListener('click', () => { state.cat = ''; apply(); step(); });
    document.querySelector('[data-filter-reset]')?.addEventListener('click', () => {
      state.seg = ''; state.cat = ''; apply(); step();
    });
  }
</script>

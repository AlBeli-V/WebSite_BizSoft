---
/**
 * Универсальный шаблон посадочной страницы производителя.
 * Данные (карточки, цены, slug) берутся ЖИВЫМИ из Directus по полю vendor.
 * Редакторская обвязка — из src/data/vendors.ts (VendorEntry).
 */
import Breadcrumbs from './Breadcrumbs.astro';
import FAQ from './FAQ.astro';
import LeadForm from './LeadForm.astro';
import { VENDOR_SOLUTIONS } from '../data/vendor-solutions';
import { solutions } from '../data/solutions';
import QuestionForm from './QuestionForm.astro';
import VendorInterlinks from './VendorInterlinks.astro';
import VendorQuotePath from './VendorQuotePath.astro';
import VendorLogo from './VendorLogo.astro';
import JsonLd from './JsonLd.astro';
import { getProducts } from '../lib/directus';
import { effectivePrice, formatRub } from '../lib/pricing';
import { collectionPageSchema } from '../lib/seo';
import { SEO_EXPERIMENTS } from '../data/seo-experiments';
import { planType, PLAN_LABEL } from '../lib/plan-type';
import { productKind, listingProducts, isGiftCard } from '../lib/catalog';
import { productIcons } from '../data/product-icons';
import ProductIcon from './ProductIcon.astro';
import AddToCartButton from './AddToCartButton.astro';
import VendorTariffCard from './VendorTariffCard.astro';
import VendorSections from './VendorSections.astro';
import { DOMAIN_AUDIENCE, type VendorEntry } from '../data/vendors';
import { vendorContent } from '../data/vendor-content';
import type { Product } from '../lib/types';

interface Props { entry: VendorEntry }
const { entry } = Astro.props;
const title = entry.title || entry.vendor;
const audience = DOMAIN_AUDIENCE[entry.domain];
const content = vendorContent(entry.slug);

let products: Product[] = [];
try {
  products = await getProducts({ vendor: entry.vendor });
} catch (e) {
  console.error(`vendor landing data error (${entry.vendor})`, e);
}

// Вью-модели карточек (операторы сравнения — здесь, не в шаблоне).
// Варианты (номиналы подарочных карт) в сетке не показываются: их
// представляет родительская карточка с выбором региона и номинала.
// Минимальный объём заказа и подпись единиц — из vendor-content по slug или
// sku (правило catalog.md: ключи — slug или sku, не префикс артикула).
const cardMeta = (p: Product) => content.cards?.[p.slug] ?? content.cards?.[p.sku];
// Порядок линейки задаётся контентом: планы читаются от младшего к старшему,
// а база отдаёт их в своём порядке. Не перечисленные уходят в конец.
const orderKey = (p: Product) => {
  const list = content.order;
  if (!list?.length) return 0;
  const i = list.findIndex((k) => k === p.slug || k === p.sku);
  return i === -1 ? list.length : i;
};
const cards = listingProducts(products)
  .slice()
  .sort((a, b) => orderKey(a) - orderKey(b))
  .map((p) => {
  const eff = effectivePrice(p);
  const meta = cardMeta(p);
  const feats = meta?.features?.length
    ? meta.features.slice(0, 5)
    : (Array.isArray(p.features) ? p.features.slice(0, 5) : []);
  return {
    // Случай позиции: из её меты либо из состава случая — там, где
    // редактору удобнее перечислить позиции одним списком.
    seg: meta?.seg
      || (content.segments || []).find((sg) => (sg.keys || []).some((k) => k === p.slug || k === p.sku))?.id
      || '',
    minQty: Math.max(1, meta?.minQty ?? 1),
    qtyLabel: meta?.qtyLabel || 'Лицензий',
    check: meta?.check || '',
    badge: meta?.badge || '',
    name: p.name,
    slug: p.slug,
    sku: p.sku,
    price: eff.price,
    priceText: formatRub(eff.price),
    note: p.price_note || '',
    byRequest: !(eff.price > 0), // NaN и null — тоже «по запросу»
    short: meta?.forWhom || p.short_description || '',
    features: feats,
    plan: planType(p.name, p.short_description || ''),
    icon: productIcons(p.slug).length > 0,
    // Подарочная карта: цена «от» минимального номинала, в расчёт — со
    // страницы карты после выбора региона и номинала.
    gift: isGiftCard(p),
    priceFrom: Boolean(p.price_from),
  };
});
// Карточки «Цена по запросу» — в конце списка, но только там, где свой
// порядок не задан: заданный порядок и есть решение редактора.
if (!content.order?.length) {
  cards.sort((a, b) => Number(a.byRequest) - Number(b.byRequest));
}
// Номиналы пополнения (варианты родительской позиции) в сетку не идут:
// одиннадцать почти одинаковых карточек заменили бы собой страницу. Они
// показываются полосой плиток под сеткой.
const denom = content.denominations;
const denomParent = denom
  ? products.find((p) => p.slug === denom.parent || p.sku === denom.parent)
  : undefined;
const topups = denom && denomParent
  ? products
    .filter((p) => p.parent_sku === denomParent.sku)
    .map((p) => ({
      name: p.name,
      slug: p.slug,
      sku: p.sku,
      price: effectivePrice(p).price,
      priceText: formatRub(effectivePrice(p).price),
      // Номинал вытаскивается из артикула: <PREFIX>-CREDITS-<номинал>.
      nominal: Number((p.sku.match(/-(\d+)$/) || [])[1] || 0),
    }))
    .filter((p) => p.price > 0)
    .sort((a, b) => a.nominal - b.nominal)
  : [];

// Разделы линейки: личные и командные планы, редакции. Карточка без раздела
// уходит в общий список — правка раздела не должна уносить её со страницы.
const groupItems = (ids: string[]) => cards.filter((c) => ids.includes(c.slug) || ids.includes(c.sku));
const groups = (content.groups || [])
  .map((g) => ({ ...g, cards: groupItems(g.items) }))
  .filter((g) => g.cards.length > 0);
const grouped = new Set(groups.flatMap((g) => g.cards));
const ungrouped = cards.filter((c) => !grouped.has(c));

const priced = cards.filter((c) => !c.byRequest);
// «Цены от … в год» — по основным продуктам (тарифам): дополнения — пакеты
// кредитов и плагины — разовые и дешевле любого тарифа, минимум по ним выдал бы
// цену пакета кредитов за «год». Если тарифов с ценой нет — по всем позициям.
const mainPriced = priced.filter((c) => productKind({ sku: c.sku }) === 'main');
const minPool = mainPriced.length ? mainPriced : priced;
const minPrice = minPool.length ? Math.min(...minPool.map((c) => c.price)) : 0;
const hasMin = minPrice > 0;
const hasCards = cards.length > 0;

const pageUrl = `/vendors/${entry.slug}`;
const crumbs = [
  { name: 'Каталог', url: '/catalog' },
  { name: entry.catLabel, url: `/catalog/${entry.catSeg}` },
  { name: title, url: pageUrl },
];

// FAQ — свой bespoke (если задан) либо шаблонные вопросы под юрлицо.
const baseFaq = content.faq?.length ? content.faq : [
  { q: `Как купить ${title} для юридического лица в России?`, a: `Через BIZSoft: заключаем договор, выставляем счёт, оплата в рублях по безналичному расчёту. Закрывающие документы передаём в том числе через ЭДО. Оставьте заявку — подберём тариф и подготовим КП.` },
  { q: `Сколько стоит ${title}?`, a: `Цена в рублях рассчитывается от зарубежного прайса по курсу ЦБ РФ на дату счёта. Актуальную стоимость по каждому тарифу смотрите в карточках выше.` },
  { q: `Можно ли оплатить ${title} с расчётного счёта организации?`, a: `Да. Мы работаем с юрлицами и ИП по договору и счёту, предоставляем закрывающие документы для бухгалтерии.` },
  { q: `Как быстро предоставляется доступ к ${title}?`, a: `После поступления оплаты передаём ключи, доступы или инструкции по активации в согласованные сроки.` },
];
// SEO-эксперименты со сниппетами: `faq` целиком заменяет типовой блок
// (snippets-5-vendors, snippets-6-demand), `faqAdd` добавляет вопрос под
// запросную формулу первым, сохраняя собственный FAQ страницы
// (snippets-3-gap-d). Остальные vendor-страницы — контрольная группа.
const exp = SEO_EXPERIMENTS[entry.slug];
const faq = exp?.faq ?? (exp?.faqAdd ? [...exp.faqAdd, ...baseFaq] : baseFaq);
const faqTitle = exp ? exp.faqTitle : `Частые вопросы про ${title} для бизнеса`;

const summaryText = content.summary || `${entry.about} BIZSoft поставляет ${title} российским юрлицам и ИП по договору с оплатой по счёту.`;
const hasCompare = !!content.comparison && content.comparison.rows.length > 0;
const hasDecision = !!content.decision && content.decision.length > 0;
const hasScenarios = !!content.scenarios && content.scenarios.length > 0;

const description = entry.metaDescription
  || `${title} для юридических лиц: ${entry.tagline} Покупка по договору и счёту, оплата в рублях, закрывающие документы через ЭДО.`;
// FAQPage выводит компонент FAQ, BreadcrumbList — компонент Breadcrumbs.
const ld = [
  collectionPageSchema({ name: `${title} для бизнеса`, description, url: pageUrl, items: cards.map((c) => ({ name: c.name, slug: c.slug })) }),
];

// Раздел назначения ПО: какие решения под задачу отвечают на вопрос
// «как оформить это на компанию». Вендоров без записи блок не рендерит.
// Форма в первом экране — эксперимент 07.09.2026 на главных рекламных
// посадочных. Замер кампании: 226 визитов, ноль form_start при том, что цена
// «от» и оба призыва в первом экране уже стоят. Значит проверять надо не
// «видно ли цену», а «нужно ли ради заявки открывать модальное окно».
// Список узкий сознательно: это замер, а не редизайн всех лендингов.
//
// anthropic выведен из замера решением руководителя 11.09.2026: страница
// переведена на единый путь заявки, и держать на ней четвёртую точку сбора
// контакта незачем. Пары для сравнения у замера больше нет — это принятая
// цена решения; adobe остаётся с формой до отдельного решения.
const HERO_FORM_SLUGS = new Set(['adobe']);
const heroForm = HERO_FORM_SLUGS.has(entry.slug);

const solutionLinks = (VENDOR_SOLUTIONS[entry.slug] || [])
  .map((s) => solutions.find((x) => x.slug === s))
  .filter((x): x is (typeof solutions)[number] => Boolean(x));
---
<JsonLd schema={ld} />
<div class="container-page section" style={`--vc:${entry.brandColor}`}>
  <Breadcrumbs items={crumbs} />

  <!-- HERO -->
  <header class:list={['hero', heroForm && 'hero-split']}>
    <div class="hero-head">
      <div class="vendor-row">
        <VendorLogo slug={entry.slug} name={title} size={44} />
        <span class="vendor-name">{title}</span>
        <span class="vendor-legal">{entry.legalName}</span>
      </div>
      <h1>{entry.h1 || `${title} для юридических лиц: тарифы и оформление через BIZSoft`}</h1>
      {heroForm ? (
        <>
          {/* На посадочной с формой цена и действие идут сразу за
              заголовком: на телефоне между ними и формой не должно быть
              полутора экранов описания. */}
          {hasMin && <p class="from">Цены от <b>{formatRub(minPrice)}</b>{entry.domain === 'gift' ? ' за код' : ' в год'}</p>}
          <div class="hero-actions">
            {/* Ветка идущего замера первого экрана (сейчас это adobe): её
                призыв намеренно оставлен прежним — страница под замером не
                правится, иначе вывод о форме будет неотделим от вывода о
                кнопке. Закроется замер — ветка вернётся на общий путь. */}
            <button class="btn btn-primary" data-hero-form-cta data-open-question data-product={`${title} — подбор тарифа`} data-ev="click_get_quote">Получить расчёт и КП</button>
            {hasCards && <a href="#products" class="btn btn-ghost" data-ev="click_choose_plan">Смотреть тарифы</a>}
          </div>
        </>
      ) : (
        <>
          <p class="hero-sub">{entry.tagline} Подбор тарифа под задачи {audience}.</p>
          <ul class="chips"><li>Для юрлиц</li><li>КП и счёт</li><li>Договор и закрывающие</li><li>Оплата в рублях</li></ul>
          <div class="hero-actions">
            {/* Призыв ведёт к форме расчёта на этой же странице, а не в
                модальное окно «Задать вопрос»: прежняя кнопка обещала
                расчёт, а открывала форму вопроса с полем «Что хотите
                уточнить?». Модальное окно осталось лёгким каналом. */}
            <a href="#lead" class="btn btn-primary" data-quote-cta data-context={`${title} — подбор тарифа`} data-ev="click_get_quote">Получить расчёт и КП</a>
            {hasCards && <a href="#products" class="btn btn-ghost" data-ev="click_choose_plan">Смотреть тарифы</a>}
            <button class="btn-link" data-open-question data-product={`${title} — вопрос эксперту`} data-ev="click_clarify_price">Задать вопрос эксперту</button>
          </div>
          {hasMin && <p class="from">Цены от <b>{formatRub(minPrice)}</b>{entry.domain === 'gift' ? ' за код' : ' в год'}</p>}
        </>
      )}
    </div>
    {heroForm && (
      <div class="hero-form">
        <LeadForm
          compact
          source={`vendor-hero-${entry.slug}`}
          title="Счёт или КП на компанию"
          submitLabel="Отправить заявку"
        />
      </div>
    )}
    {heroForm && (
      <div class="hero-rest">
        <p class="hero-sub">{entry.tagline} Подбор тарифа под задачи {audience}.</p>
        <ul class="chips"><li>Для юрлиц</li><li>КП и счёт</li><li>Договор и закрывающие</li><li>Оплата в рублях</li></ul>
      </div>
    )}
  </header>

  <!-- Прямой ответ (GEO/AEO) -->
  <div class="summary"><strong>Коротко:</strong> {summaryText}</div>

  {/* Разбор, без которого цены не читаются: типы мест, виды лицензий,
      редакции. Ставится до сетки карточек. */}
  {content.explainer && (
    <section class="block">
      <h2>{content.explainer.title}</h2>
      <div class="cells">{content.explainer.items.map((s) => (<div class="card cell"><h3>{s.title}</h3><p>{s.text}</p></div>))}</div>
    </section>
  )}

  {/* Чем тарифы отличаются друг от друга — до сетки карточек: иначе
      покупатель сравнивает цены, не понимая, за что платит. */}
  {content.intro && (
    <section class="block intro">
      <div class="prose-bizsoft"><p>{content.intro}</p></div>
    </section>
  )}

  {/* Выбор ситуации: покупатель выбирает не между тарифами, а между
      случаями. Отмеченный случай сужает сетку; без JavaScript видны все
      карточки — фильтр только прячет лишнее атрибутом hidden. */}
  {(content.segments || []).length > 0 && (
    <section class="block" id="choose">
      <h2>С чего начать: выберите свой случай</h2>
      <p class="muted lead-note">Отметьте свою ситуацию — в списке ниже останется только подходящее.</p>
      <div class="segs" role="group" aria-label="Выбор ситуации">
        {content.segments!.map((sg) => (
          <button type="button" class="card card-hover seg" data-seg-btn={sg.id} aria-pressed="false">
            <b>{sg.title}</b>
            <span class="muted">{sg.text}</span>
            {sg.hint && <em>{sg.hint}</em>}
          </button>
        ))}
      </div>
      {content.segments!.filter((sg) => sg.why).map((sg) => (
        <p class="seg-why" data-seg-why={sg.id} hidden>{sg.why}</p>
      ))}
      <button type="button" class="btn btn-ghost btn-sm seg-reset" data-seg-reset hidden>Показать все варианты</button>
    </section>
  )}

  {/* Быстрый подбор: ярлык задачи или стека → продукт. Один клик, а не
      опросник: подставляет выбор в форму и ведёт к карточке. */}
  {content.picks && content.picks.items.length > 0 && (
    <section class="block" id="quick">
      <h2>{content.picks.title}</h2>
      {content.picks.note && <p class="muted">{content.picks.note}</p>}
      <div class="picks">
        {content.picks.items.map((pk) => (
          <a
            href={pk.target ? (pk.target.startsWith('#') ? pk.target : `#${pk.target}`) : '#products'}
            class="card card-hover pick"
            data-quote-cta
            data-context={`${title} — ${pk.query}`}
            data-ev="click_pick_licenses"
          >
            <span class="pick-lang">{pk.label}</span>
            <span class="pick-prod">{pk.product}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <VendorSections sections={content.sections || []} place="before-products" vendor={title} />

  <!-- Карточки продуктов -->
  {hasCards ? (
    <section class="block" id="products">
      <h2>Тарифы и продукты {title}</h2>
      {groups.length > 0 ? (
        <div class="vgroups">
          {groups.map((g) => (
            <div class="vgroup" id={g.id}>
              <h3 class="vgroup-title">{g.title}</h3>
              {g.note && <p class="muted small vgroup-note">{g.note}</p>}
              <div class="vgrid">
                {g.cards.map((c) => <VendorTariffCard card={c} title={title} vendor={entry.vendor} />)}
              </div>
            </div>
          ))}
          {ungrouped.length > 0 && (
            <div class="vgroup">
              <h3 class="vgroup-title">Остальные позиции</h3>
              <div class="vgrid">
                {ungrouped.map((c) => <VendorTariffCard card={c} title={title} vendor={entry.vendor} />)}
              </div>
            </div>
          )}
        </div>
      ) : (
        <div class="vgrid">
          {cards.map((c) => <VendorTariffCard card={c} title={title} vendor={entry.vendor} />)}
        </div>
      )}
      <p class="muted small">Стоимость в рублях пересчитывается по курсу ЦБ РФ на дату счёта.</p>

      {topups.length > 0 && denom && (
        <div class="topups" data-seg-card={content.cards?.[denom.parent]?.seg || undefined}>
          <h3>{denom.title}</h3>
          {denom.note && <p class="muted small topups-note">{denom.note}</p>}
          <ul class="topup-list">
            {topups.map((t) => (
              <li class="topup" data-qty-scope>
                <a class="topup-name" href={`/product/${t.slug}`} data-ev="click_product_card">
                  {t.nominal.toLocaleString('ru-RU')}{denom.unit ? ` ${denom.unit}` : ''}
                </a>
                <b class="topup-price">{t.priceText}</b>
                <AddToCartButton sku={t.sku} slug={t.slug} name={t.name} vendor={entry.vendor} price={t.price} compact />
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  ) : (
    <section class="block" id="products">
      <h2>Тарифы и продукты {title}</h2>
      <p class="muted">Подберём и рассчитаем нужные лицензии {title} под вашу задачу. Оставьте заявку — подготовим КП.</p>
      <a href="#lead" class="btn btn-primary" data-quote-cta data-context={`${title} — расчёт`} data-ev="click_get_quote">Запросить расчёт</a>
    </section>
  )}

  {hasCompare && (
    <section class="block" id="compare">
      <h2>Сравнение тарифов {title}</h2>
      <div class="table-wrap">
        <table class="cmp">
          <thead><tr><th class="sticky">Параметр</th>{content.comparison!.cols.map((c) => <th>{c}</th>)}</tr></thead>
          <tbody>{content.comparison!.rows.map((r) => (<tr><th class="sticky">{r.label}</th>{r.values.map((v) => <td>{v}</td>)}</tr>))}</tbody>
        </table>
      </div>
      <p class="muted small">Цены и характеристики ориентировочные; стоимость в рублях — по курсу ЦБ РФ.</p>
    </section>
  )}

  {hasDecision && (
    <section class="block">
      <h2>Что выбрать</h2>
      <div class="table-wrap">
        <table class="cmp decision">
          <thead><tr><th class="sticky">Сценарий</th><th>Рекомендуем</th><th>Почему</th></tr></thead>
          <tbody>{content.decision!.map((d) => (<tr><th class="sticky">{d.scenario}</th><td>{d.slug ? <a href={`/product/${d.slug}`}>{d.product}</a> : d.product}</td><td class="muted">{d.note}</td></tr>))}</tbody>
        </table>
      </div>
    </section>
  )}

  {hasScenarios && (
    <section class="block">
      <h2>Сценарии использования</h2>
      <div class="cells">{content.scenarios!.map((s) => (<div class="card cell"><h3>{s.title}</h3><p>{s.text}</p></div>))}</div>
    </section>
  )}

  <!-- Решения под задачу -->
  {solutionLinks.length > 0 && (

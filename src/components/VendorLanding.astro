  .seg em { font-style: normal; font-size: 0.82rem; color: var(--vc, var(--color-accent)); font-weight: 600; }
  .seg[aria-pressed='true'] { border-color: var(--vc, var(--color-accent)); box-shadow: 0 0 0 3px color-mix(in srgb, var(--vc, var(--color-accent)) 16%, transparent); }

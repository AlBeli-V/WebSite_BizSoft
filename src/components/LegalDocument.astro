---
/**
 * Рендер правового документа: название, дата редакции и текст.
 *
 * Дата стоит под заголовком: именно ею документ датируется и именно её
 * называют, когда просят «прислать редакцию, которая действовала тогда-то».
 *
 * Номер версии и контрольный хэш на странице не показываются (ТЗ
 * 16.09.2026, п. 6). Посетителю они ничего не объясняют, а документ,
 * который предъявляется как обязательство, рядом с ними читается как
 * техническая выгрузка. Внутренний слой не изменился: версия и SHA-256
 * по-прежнему пишутся в журнал согласий, а архив редакций открывается по
 * адресу с версией.
 */
import type { LegalDocContent } from '../lib/legal-doc';
import { legalDateRu } from '../lib/legal-doc';
import type { LegalDocMeta } from '../lib/legal';

interface Props {
  meta: LegalDocMeta;
  content: LegalDocContent;
  /** Редакция, отличная от действующей: страница помечается архивной. */
  archivedVersion?: string;
}
const { meta, content, archivedVersion } = Astro.props;
const version = archivedVersion || meta.version;
const dateRu = legalDateRu(version);
---
<article class="legal-doc prose-bizsoft">
  <h1>{content.title}</h1>
  {content.subtitle && <p class="ld-sub">{content.subtitle}</p>}

  {archivedVersion && (
    <p class="ld-archived" role="note">
      Архивная редакция. Действующая — <a href={meta.url}>редакция от {legalDateRu(meta.version)}</a>.
    </p>
  )}

  <p class="ld-meta">Редакция от {dateRu}</p>

  {content.blocks.map((b) => {
    if (b.kind === 'heading') return <h2>{b.text}</h2>;
    if (b.kind === 'paragraph') return <p>{b.text}</p>;
    if (b.kind === 'list') return <ul>{b.items.map((i) => <li>{i}</li>)}</ul>;
    return (
      <div class="ld-table-wrap">
        <table class="ld-table">
          <thead><tr>{b.head.map((c) => <th>{c}</th>)}</tr></thead>
          <tbody>{b.rows.map((r) => <tr>{r.map((c) => <td>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
    );
  })}

  {meta.revisions.length > 1 && (
    <section class="ld-revisions">
      <h2>Редакции документа</h2>
      <ul>
        {[...meta.revisions].reverse().map((r) => (
          <li>
            <a href={r.version === meta.version ? meta.url : `${meta.url}/${r.version}`}>
              Редакция от {legalDateRu(r.version)}
            </a>
            {r.version === meta.version && <span class="ld-current"> — действующая</span>}
          </li>
        ))}
      </ul>
    </section>
  )}
</article>

<style>
  .legal-doc { max-width: 820px; }
  .legal-doc h1 { font-size: clamp(1.6rem, 3.2vw, 2.2rem); margin-bottom: 0.4rem; }
  .ld-sub { color: var(--color-text-muted); font-size: 0.98rem; margin: 0 0 1.2rem; }

  .ld-archived {
    border: 1px solid var(--color-border-strong);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background: var(--color-bg-elevated);
    padding: 0.7rem 0.9rem;
    font-size: 0.9rem;
    margin-bottom: 1.2rem;
  }
  .ld-archived a { color: var(--color-accent); }

  /* Дата редакции — служебная строка, а не часть текста документа: отсюда
     мелкий кегль и приглушённый цвет. */
  .ld-meta {
    margin: 0 0 1.8rem;
    color: var(--color-text-dim);
    font-size: 0.85rem;
  }

  .legal-doc h2 { font-size: clamp(1.1rem, 2.2vw, 1.3rem); margin: 1.8rem 0 0.6rem; }
  .legal-doc p { margin: 0 0 0.9rem; line-height: 1.65; }
  .legal-doc ul { margin: 0 0 1rem; padding-left: 1.2rem; }
  .legal-doc li { margin-bottom: 0.35rem; line-height: 1.6; }

  .ld-table-wrap { margin: 0 0 1.2rem; overflow-x: auto; }
  .ld-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .ld-table th, .ld-table td {
    border: 1px solid var(--color-border);
    padding: 0.55rem 0.7rem;
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
  }
  .ld-table th { background: var(--color-bg-elevated); font-weight: 700; }

  .ld-revisions { margin-top: 2.4rem; padding-top: 1.2rem; border-top: 1px solid var(--color-border); }
  .ld-revisions ul { list-style: none; padding: 0; }
  .ld-revisions li { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: baseline; }
  .ld-revisions a { color: var(--color-accent); }
  .ld-current { color: var(--color-text-dim); font-size: 0.85rem; }
</style>

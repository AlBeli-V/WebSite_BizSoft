---
// Модальная форма «Задать вопрос». Открывается кнопкой с атрибутом
// data-open-question (и опц. data-product / data-sku для предзаполнения).
// Отправляет JSON на /api/lead → коллекция leads.
import ContactDirect from './ContactDirect.astro';
import FormGuardFields from './FormGuardFields.astro';
const { source = 'question' } = Astro.props as { source?: string };
---
<dialog class="qf-dialog" data-question-dialog aria-label="Задать вопрос">
  <form class="qf-form" data-question-form>
    <button type="button" class="qf-close" data-close aria-label="Закрыть">✕</button>
    <h2>Задать вопрос</h2>

    <div class="qf-product" data-product-line hidden>
      Вопрос по товару: <strong data-product-name></strong>
    </div>

    <label>ФИО:
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <div class="qf-row">
      <label>E-mail:
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>Телефон:
        <input type="tel" name="phone" required autocomplete="tel" placeholder="+7 (___) ___-__-__" />
      </label>
    </div>
    <div class="qf-row">
      <label>Компания:
        <input type="text" name="company" required autocomplete="organization" />
      </label>
      <label>ИНН:
        <input type="text" name="inn" required inputmode="numeric" pattern="[0-9]{10,12}" placeholder="10 или 12 цифр" />
      </label>
    </div>
    <label>Сообщение:
      <textarea name="message" rows="3" required placeholder="Что хотите уточнить?"></textarea>
    </label>

    <input type="hidden" name="product_ref" data-product-ref />
    <input type="hidden" name="source" value={source} />
    <FormGuardFields />

    <label class="qf-consent">
      <input type="checkbox" name="consent" required />
      <span>Согласен на обработку персональных данных согласно <a href="/privacy" target="_blank" rel="noopener noreferrer">политике</a>.</span>
    </label>

    <button type="submit" class="btn btn-primary qf-submit">Отправить</button>
    <ContactDirect />
    <p class="qf-status" data-status role="status" aria-live="polite"></p>
  </form>
</dialog>

<style>
  .qf-dialog {
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-bg-card);
    color: var(--color-text);
    padding: 0;
    max-width: 520px;
    width: calc(100% - 2rem);
  }
  .qf-dialog::backdrop { background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(2px); }
  .qf-form { padding: 2rem; display: flex; flex-direction: column; gap: 0.9rem; position: relative; }
  .qf-form h2 { font-size: 1.5rem; }
  .qf-close { position: absolute; top: 1rem; right: 1rem; background: none; border: none; color: var(--color-text-muted); font-size: 1.1rem; cursor: pointer; }
  .qf-product { background: var(--color-bg-elevated); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; font-size: 0.9rem; color: var(--color-text-muted); }
  .qf-product strong { color: var(--color-text); }
  .qf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  /* min-width: 0 — иначе внутренняя ширина input распирает grid-колонку за карточку */
  .qf-row > label { min-width: 0; }
  label { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.88rem; font-weight: 600; color: var(--color-text); white-space: nowrap; }
  label:has(textarea) { white-space: normal; }
  input, textarea {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.7rem;
    color: var(--color-text);
    font: inherit;
    font-size: 0.95rem;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }
  input:focus, textarea:focus { border-color: var(--color-accent); outline: none; }
  .qf-consent { flex-direction: row; align-items: flex-start; gap: 0.5rem; font-size: 0.82rem; font-weight: 400; white-space: normal; }
  .qf-consent input { width: auto; margin-top: 0.2rem; }
  .qf-consent a { color: var(--color-accent); }
  .qf-submit { margin-top: 0.4rem; }
  .qf-status { font-size: 0.9rem; margin: 0; }
  .qf-status.ok { color: var(--color-success); }
  .qf-status.err { color: var(--color-danger); }
  @media (max-width: 480px) { .qf-row { grid-template-columns: 1fr; } }
</style>

<script>
  import { trackGoal } from '@/lib/analytics';
  import { attributionPayload } from '@/lib/attribution';
  import { maskAllPhones } from '../lib/phone-mask';
  maskAllPhones();

  const dialog = document.querySelector('[data-question-dialog]') as HTMLDialogElement | null;
  const form = document.querySelector('[data-question-form]') as HTMLFormElement | null;
  if (dialog && form) {
    const productLine = dialog.querySelector('[data-product-line]') as HTMLElement;
    const productName = dialog.querySelector('[data-product-name]') as HTMLElement;
    const productRef = dialog.querySelector('[data-product-ref]') as HTMLInputElement;
    const status = dialog.querySelector('[data-status]') as HTMLElement;

    document.querySelectorAll('[data-open-question]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const name = el.dataset.product;
        if (name) {
          productLine.hidden = false;
          productName.textContent = name;
          productRef.value = el.dataset.sku ? `${name} (${el.dataset.sku})` : name;
        } else {
          productLine.hidden = true;
          productRef.value = '';
        }
        status.textContent = '';
        status.className = 'qf-status';
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

    let started = false;
    form.addEventListener('input', () => {
      if (started) return;
      started = true;
      trackGoal('form_start', { form_source: 'question' });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submit = form.querySelector('.qf-submit') as HTMLButtonElement;
      submit.disabled = true;
      status.textContent = 'Отправляем…';
      status.className = 'qf-status';
      let httpStatus = 0;
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const attribution = await attributionPayload();
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, attribution, consent: (form.elements.namedItem('consent') as HTMLInputElement).checked }),
        });
        if (!res.ok) {
          let msg = 'Не удалось отправить. Проверьте поля и попробуйте снова.';
          try { const j = await res.json(); if (j?.error) msg = j.error; } catch { /* not json */ }
          httpStatus = res.status;
          throw new Error(msg);
        }
        status.textContent = 'Готово! Мы свяжемся с вами в ближайшее время.';
        status.className = 'qf-status ok';
        form.reset();
        trackGoal('lead_sent', { form_source: 'question' });
        setTimeout(() => dialog.close(), 1800);
      } catch (err) {
        status.textContent = err instanceof Error && err.message ? err.message : 'Не удалось отправить. Позвоните нам или попробуйте позже.';
        status.className = 'qf-status err';
        // Событие одно на все виды сбоя и отправляется только здесь. Пока
        // рядом стояла вторая цель в ветке !res.ok, throw из неё попадал в
        // этот же catch и один отказ 422 считался дважды.
        trackGoal('lead_error', {
          form_source: 'question',
          http_status: httpStatus,
          reason: err instanceof Error ? err.message.slice(0, 100) : 'unknown',
        });
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

---
import JsonLd from './JsonLd.astro';
import { faqSchema } from '../lib/seo';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
  /** добавлять ли FAQPage-разметку (по умолчанию да) */
  schema?: boolean;
}
const { items, title = 'Частые вопросы', schema = true } = Astro.props;
---
{items.length > 0 && (
  <section class="faq reveal">
    {title && <h2>{title}</h2>}
    <div class="faq-list">
      {items.map((item) => (
        <details class="faq-item">
          <summary>
            <span>{item.q}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </summary>
          <div class="faq-answer"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
    {schema && <JsonLd schema={faqSchema(items)} />}
  </section>
)}

<style>
  .faq {
    margin-top: 3rem;
  }
  .faq > h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 1.5rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 800px;
  }
  .faq-item {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  .faq-answer {
    padding: 0 1.3rem 1.2rem;
    color: var(--color-text-muted);
  }
  .faq-answer p {
    margin: 0;
  }
</style>

<script>
  // Какие вопросы раскрывают — это перечень возражений перед сделкой.
  // Цель шлётся один раз на вопрос: повторное сворачивание и раскрытие
  // одного и того же блока — не новое сомнение.
  import { trackGoal } from '@/lib/analytics';
  document.querySelectorAll('.faq-item').forEach((el) => {
    const item = el as HTMLDetailsElement;
    item.addEventListener('toggle', () => {
      if (!item.open || item.dataset.counted) return;
      item.dataset.counted = '1';
      trackGoal('faq_expand', {
        page_url: location.pathname,
        question: (item.querySelector('summary span')?.textContent || '').slice(0, 100),
      });
    });
  });
</script>

---
import JsonLd from './JsonLd.astro';
import { faqSchema } from '../lib/seo';

interface Props {
  items: { q: string; a: string; group?: string }[];
  title?: string;
  /** добавлять ли FAQPage-разметку (по умолчанию да) */
  schema?: boolean;
  /**
   * Разбивка списка на смысловые группы (порядок — как в массиве).
   * Вопросы при этом не меняются и не убираются: группа — только подача,
   * разметка FAQPage выводится одна на все вопросы страницы. Вопрос без
   * группы или с чужим ключом попадает в конец, отдельным списком, —
   * иначе правка группы тихо уносила бы вопрос со страницы.
   */
  groups?: { id: string; title: string }[];
  /** Список в две колонки — для страниц, где вопросов больше семи. */
  columns?: 1 | 2;
  /** Косая черта перед заголовком — подача разделов карточки товара. */
  mark?: boolean;
  /**
   * Ссылка «Все вопросы» справа от заголовка (решение руководителя
   * 14.09.2026): на карточке показаны вопросы этой позиции, а общий список
   * живёт на /faq — без ссылки покупатель считает, что вопросов больше нет.
   */
  allHref?: string;
  allLabel?: string;
}
const { items, title = 'Частые вопросы', schema = true, groups, columns = 1, mark = false, allHref, allLabel = 'Все вопросы' } = Astro.props;

const grouped = (groups || []).map((g) => ({ ...g, items: items.filter((i) => i.group === g.id) })).filter((g) => g.items.length > 0);
const shown = new Set(grouped.flatMap((g) => g.items));
const rest = items.filter((i) => !shown.has(i));
const blocks = grouped.length > 0
  ? [...grouped, ...(rest.length > 0 ? [{ id: 'rest', title: 'Остальные вопросы', items: rest }] : [])]
  : [{ id: 'all', title: '', items }];
---
{items.length > 0 && (
  <section class="faq reveal">
    {title && (
      allHref ? (
        <div class="faq-head">
          <h2 class:list={{ marked: mark }}>{mark && <i aria-hidden="true">/</i>}{title}</h2>
          <a class="faq-all" href={allHref}>{allLabel} <span aria-hidden="true">›</span></a>
        </div>
      ) : (
        <h2 class:list={{ marked: mark }}>{mark && <i aria-hidden="true">/</i>}{title}</h2>
      )
    )}
    {blocks.map((b) => (
      <div class="faq-group">
        {b.title && <h3 class="faq-group-title">{b.title}</h3>}
        <div class:list={['faq-list', { cols2: columns === 2 }]}>
          {b.items.map((item) => (
            <details class="faq-item">
              <summary>
                <span>{item.q}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </summary>
              <div class="faq-answer"><p>{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    ))}
    {schema && <JsonLd schema={faqSchema(items)} />}
  </section>
)}

<style>
  .faq {
    margin-top: 3rem;
  }
  .faq > h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 1.5rem;
  }
  /* Заголовок и ссылка «все …» — одной строкой, по краям блока. */
  .faq-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .faq-head h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin: 0; }
  .faq-all { flex: none; color: var(--color-accent); font-size: 0.88rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .faq-all:hover { text-decoration: underline; }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 800px;
  }
  /* Две колонки — только когда вопросов много: узкая колонка из девяти
     блоков растягивает страницу так, что до подвала никто не доходит.
     align-self: start не даёт раскрытому ответу тянуть соседей. */
  .faq-list.cols2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 0.6rem 1.2rem;
    max-width: none;
  }
  @media (max-width: 760px) {
    .faq-list.cols2 { grid-template-columns: minmax(0, 1fr); }
  }
  .faq > h2.marked i {
    font-style: normal;
    color: var(--color-accent);
    margin-right: 0.4rem;
  }
  .faq-group + .faq-group {
    margin-top: 1.6rem;
  }
  .faq-group-title {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-text-dim);
    margin-bottom: 0.7rem;
  }
  .faq-item {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  .faq-answer {
    padding: 0 1.3rem 1.2rem;
    color: var(--color-text-muted);
  }
  .faq-answer p {
    margin: 0;
  }
</style>

<script>
  // Какие вопросы раскрывают — это перечень возражений перед сделкой.
  // Цель шлётся один раз на вопрос: повторное сворачивание и раскрытие
  // одного и того же блока — не новое сомнение.
  import { trackGoal } from '@/lib/analytics';
  document.querySelectorAll('.faq-item').forEach((el) => {
    const item = el as HTMLDetailsElement;
    item.addEventListener('toggle', () => {
      if (!item.open || item.dataset.counted) return;
      item.dataset.counted = '1';
      trackGoal('faq_expand', {
        page_url: location.pathname,
        question: (item.querySelector('summary span')?.textContent || '').slice(0, 100),
      });
    });
  });
</script>

---
import JsonLd from './JsonLd.astro';
import { breadcrumbSchema, type Crumb } from '../lib/seo';

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
// Всегда начинаем с главной
const crumbs: Crumb[] = [{ name: 'Главная', url: '/' }, ...items];
---
<nav class="breadcrumbs" aria-label="Хлебные крошки">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i < crumbs.length - 1 ? (
          <a href={c.url}>{c.name}</a>
        ) : (
          <span aria-current="page">{c.name}</span>
        )}
        {i < crumbs.length - 1 && <span class="sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
<JsonLd schema={breadcrumbSchema(crumbs)} />

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: var(--color-text-dim);
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .breadcrumbs a {
    color: var(--color-text-muted);
  }
  .breadcrumbs a:hover {
    color: var(--color-accent);
  }
  .breadcrumbs .sep {
    color: var(--color-text-dim);
  }
  .breadcrumbs [aria-current='page'] {
    color: var(--color-text);
  }
</style>

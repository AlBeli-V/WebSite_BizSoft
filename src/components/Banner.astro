---
/**
 * Промо-баннер: заголовок, текст и кнопка на мягкой подложке.
 * variant: 'accent' — тёплый градиент; 'neutral' — светло-серый.
 * Слот media (опц.) — место под инфографику/картинку справа.
 */
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  ctaGoal?: string;
  variant?: 'accent' | 'neutral';
}
const { eyebrow, title, text, ctaLabel, ctaHref = '/contacts', ctaGoal, variant = 'accent' } = Astro.props;
const hasMedia = Astro.slots.has('media');
---
<section class:list={['banner', variant, { 'has-media': hasMedia }]}>
  <div class="banner-body">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2>{title}</h2>
    {text && <p>{text}</p>}
    {ctaLabel && (
      <a href={ctaHref} class="btn btn-primary" data-goal={ctaGoal}>{ctaLabel}</a>
    )}
  </div>
  {hasMedia && (
    <div class="banner-media">
      <slot name="media" />
    </div>
  )}
</section>

<style>
  .banner {
    border-radius: var(--radius-lg);
    padding: clamp(1.8rem, 4vw, 3rem);
    display: grid;
    gap: 2rem;
    align-items: center;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
  }
  .banner.has-media { grid-template-columns: 1.3fr 1fr; }
  .banner.accent {
    background: linear-gradient(135deg, var(--color-accent-soft), var(--color-bg-elevated));
  }
  .banner.neutral {
    background: var(--color-bg-elevated);
  }
  .banner-body { max-width: 60ch; }
  .banner h2 {
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    margin: 0.6rem 0 0.7rem;
  }
  .banner p {
    color: var(--color-text-muted);
    margin: 0 0 1.4rem;
    font-size: 1.02rem;
  }
  .banner-media { min-height: 180px; }
  @media (max-width: 760px) {
    .banner.has-media { grid-template-columns: 1fr; }
  }
</style>

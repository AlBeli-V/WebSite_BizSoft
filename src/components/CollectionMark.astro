---
/**
 * Знак подборки для КП — матрица решений: три ряда по три точки.
 *
 * Один знак на два места (решение руководителя 14.09.2026): плашка «Подборка
 * для КП» в шапке сайта и кнопка подборки в карточке товара. Второго
 * начертания не заводится — покупатель должен узнавать в кнопке карточки тот
 * же значок, что видит в шапке, иначе связь между действием и местом, куда
 * уходит позиция, приходится объяснять словами.
 *
 * Состояние «позиция уже в подборке» этот знак не показывает: его называет
 * знак действия справа от подписи (плюс → диагональный крестик). Перечёркивать
 * саму матрицу незачем — два перечёркивания в одной кнопке спорят друг с другом.
 */
interface Props {
  /** Сторона знака в пикселях. */
  size?: number;
  class?: string;
}
const { size = 20, class: cls = '' } = Astro.props;
const AXIS = [5, 12, 19];
---
<svg
  class:list={['collection-mark', cls]}
  width={size} height={size} viewBox="0 0 24 24"
  fill="currentColor" aria-hidden="true" focusable="false"
>
  {AXIS.map((y) => AXIS.map((x) => <circle cx={x} cy={y} r="2.1" />))}
</svg>

<style>
  .collection-mark { display: block; flex: none; }
</style>

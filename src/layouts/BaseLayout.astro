---
// Фирменные шрифты: Raleway (текст) + Prosto One (заголовки/цифры).
// Оба — SIL OFL 1.1, self-host с нашего сервера (woff2 в /_astro с вечным
// кэшем) — быстрее из РФ, без стороннего CDN. Правила @font-face — в
// global.css.
//
// preload у них снят. Он ставил оба файла (79 КБ) в начало очереди, на один
// канал с документом первого экрана, а выигрыша не давал: с font-display
// optional шрифт применяется, только если успел к первой отрисовке, и на
// медленной сети он не успевает всё равно. Замеры прода 04.09.2026: без
// загрузки шрифтов балл 98 и LCP 1,8 с, с загрузкой — 92 и 3,3 с; то есть
// платим именно за место в очереди, а не за подмену шрифта.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import Analytics from '../components/Analytics.astro';
import CookieNotice from '../components/CookieNotice.astro';
import JsonLd from '../components/JsonLd.astro';
import WebMCP from '../components/WebMCP.astro';
import { WEBMCP_ENABLED } from '../webmcp/flag';
import { organizationSchema, localBusinessSchema, websiteSchema } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'product';
  keywords?: string;
  /**
   * Страница с локальным профилем компании (главная, контакты): узел
   * организации выводится расширенным — с графиком работы, ценовым
   * диапазоном и картинкой. Именно расширенным, а не вторым узлом рядом:
   * два узла с одним @id потребитель склеивает, и каждое общее поле
   * приходит дважды (см. localBusinessSchema в lib/seo.ts).
   */
  localBusiness?: boolean;
}

const { title, description, canonical, ogImage, noindex, type, keywords, localBusiness } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <!-- Фавикон — фирменный знак из брендового пакета (без перерисовки);
         180 px, палитровый PNG 9 КБ вместо 256 px / 35 КБ на каждой странице.
         Оригинал 256 px остаётся в public/brand/bizsoft-favicon.png. -->
    <link rel="icon" type="image/png" href="/brand/bizsoft-favicon-180.png" />
    <link rel="apple-touch-icon" href="/brand/bizsoft-favicon-180.png" />
    <SeoHead title={title} description={description} canonical={canonical} ogImage={ogImage} noindex={noindex} type={type} keywords={keywords} />
    <JsonLd schema={[localBusiness ? localBusinessSchema() : organizationSchema(), websiteSchema()]} />
  </head>
  <body>
    <a href="#main" class="skip-link">К содержимому</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <CookieNotice />
    {WEBMCP_ENABLED && <WebMCP />}

    <style is:global>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-accent);
        color: #fff;
        padding: 0.6rem 1rem;
        z-index: 100;
        border-radius: 0 0 8px 0;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>

    <script>
      // Источник визита фиксируется до любых действий пользователя: заявка,
      // отправленная через минуту, должна знать, откуда человек пришёл.
      import { captureVisit } from '@/lib/attribution';
      captureVisit();

      // Клики по CTA с атрибутом data-goal.
      //
      // Атрибут стоял на главных кнопках сайта — «Получить КП» в шапке, герой
      // главной, каталог, страницы сравнения — и выглядел как разметка целей,
      // но слушателя не имел ни одного: ни один клик никуда не уходил.
      // Привязка живёт в макете, а не в каждом компоненте: иначе следующая
      // кнопка снова окажется размеченной и неподключённой.
      import { trackGoal } from '@/lib/analytics';
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement)?.closest?.('[data-goal]') as HTMLElement | null;
        if (!el) return;
        const name = el.dataset.goal;
        if (name) trackGoal(name, { page_url: location.pathname });
      });

      // Плавное появление получают только секции ниже первого экрана.
      //
      // Разметка идёт здесь, после первой отрисовки (rAF + setTimeout), а не
      // синхронным скриптом в конце body, как было раньше. Тот скрипт читал
      // геометрию всех секций до первой отрисовки и заставлял браузер считать
      // раскладку всей страницы разом — это и был forced-reflow в отчётах
      // PageSpeed. Замер локально при процессоре в 10 раз медленнее: без него
      // первая отрисовка 464 мс против 624, LCP 764 мс против 936.
      //
      // Прятать после отрисовки безопасно: помечаются только секции, целиком
      // ушедшие за нижнюю границу экрана (top >= высоты окна), — на экране
      // ничего не меняется, а opacity и transform раскладку не двигают.
      const afterPaint = (fn: () => void) => requestAnimationFrame(() => setTimeout(fn, 0));
      const reveal = () => afterPaint(() => {
        // Сначала все замеры, потом все правки классов: чередование чтения
        // геометрии и записи заставляет пересчитывать раскладку на каждом шаге.
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const below: Element[] = [];
        document.querySelectorAll('.reveal:not(.is-below):not(.is-visible)').forEach((el) => {
          if (el.getBoundingClientRect().top >= vh) below.push(el);
        });
        below.forEach((el) => el.classList.add('is-below'));

        const els = document.querySelectorAll('.reveal.is-below:not(.is-visible)');
        if (!('IntersectionObserver' in window) || els.length === 0) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      });
      reveal();
      document.addEventListener('astro:after-swap', reveal);

      // Подсветка иконок на тач-устройствах: плитка с иконкой (.vi) получает
      // класс vi-lit, пока находится в центральной полосе экрана (средние 30%,
      // rootMargin -35% сверху и снизу), — цветной слой включается CSS-правилом
      // в global.css (@media (hover: none)). При уходе вверх/вниз класс
      // снимается — иконка возвращается в монохром. Ряд плиток входит в полосу
      // одновременно, поэтому зажигается целиком. На устройствах с ховером
      // скрипт не запускается — там работает обычный hover.
      const viLit = () => {
        if (!window.matchMedia('(hover: none)').matches || !('IntersectionObserver' in window)) return;
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.target.classList.toggle('vi-lit', e.isIntersecting)),
          { rootMargin: '-35% 0px -35% 0px' },
        );
        const seen = new WeakSet<Element>();
        const watch = (vi: Element) => {
          const tile = vi.closest('a, button, .card, .card-hover') ?? vi;
          if (seen.has(tile)) return;
          seen.add(tile);
          io.observe(tile);
        };
        const scan = (root: Element | Document) => {
          if (root instanceof Element && root.matches('.vi')) watch(root);
          root.querySelectorAll('.vi').forEach(watch);
        };
        scan(document);
        // Часть списков (например, витрины из Directus) дорисовывается
        // клиентскими скриптами — подхватываем добавленные плитки.
        new MutationObserver((muts) => {
          for (const m of muts) {
            m.addedNodes.forEach((n) => {
              if (n.nodeType === 1) scan(n as Element);
            });
          }
        }).observe(document.body, { childList: true, subtree: true });
      };
      viLit();
      document.addEventListener('astro:after-swap', viLit);
    </script>
      <script>
      // Клики по телефону, почте и мессенджерам — одним обработчиком на сайт.
      import { initContactGoals } from '../lib/contact-goals';
      initContactGoals();
    </script>
  </body>
</html>

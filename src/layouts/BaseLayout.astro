---
// Фирменные шрифты: Raleway (текст) + Prosto One (заголовки/цифры).
// Оба — SIL OFL 1.1 (полностью бесплатные), self-host с нашего сервера
// (woff2 в /_astro с вечным кэшем) — быстрее из РФ, без стороннего CDN.
// Подключаем только нужные сайту наборы символов: кириллица, латиница и
// latin-ext (в нём живёт знак рубля U+20BD). Полные файлы @fontsource везли
// ещё cyrillic-ext и vietnamese — 30 правил @font-face вместо 18, из них
// ~16 КБ CSS, которые не использует ни одна страница (Lighthouse,
// unused-css-rules). Сами woff2 грузятся по факту нужного диапазона, так
// что убраны именно неиспользуемые описания, а не шрифты.
import '@fontsource/raleway/cyrillic-400.css';
import '@fontsource/raleway/latin-400.css';
import '@fontsource/raleway/latin-ext-400.css';
import '@fontsource/raleway/cyrillic-500.css';
import '@fontsource/raleway/latin-500.css';
import '@fontsource/raleway/latin-ext-500.css';
import '@fontsource/raleway/cyrillic-600.css';
import '@fontsource/raleway/latin-600.css';
import '@fontsource/raleway/latin-ext-600.css';
import '@fontsource/raleway/cyrillic-700.css';
import '@fontsource/raleway/latin-700.css';
import '@fontsource/raleway/latin-ext-700.css';
import '@fontsource/raleway/cyrillic-800.css';
import '@fontsource/raleway/latin-800.css';
import '@fontsource/raleway/latin-ext-800.css';
import '@fontsource/prosto-one/cyrillic-400.css';
import '@fontsource/prosto-one/latin-400.css';
import '@fontsource/prosto-one/latin-ext-400.css';
// Preload критичных начертаний: шрифт готов к первой отрисовке даже при
// холодном кэше (инкогнито) — страница сразу в фирменной типографике.
import ralewayCyr400 from '@fontsource/raleway/files/raleway-cyrillic-400-normal.woff2?url';
import ralewayCyr700 from '@fontsource/raleway/files/raleway-cyrillic-700-normal.woff2?url';
import ralewayLat400 from '@fontsource/raleway/files/raleway-latin-400-normal.woff2?url';
import prostoCyr400 from '@fontsource/prosto-one/files/prosto-one-cyrillic-400-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import Analytics from '../components/Analytics.astro';
import CookieNotice from '../components/CookieNotice.astro';
import JsonLd from '../components/JsonLd.astro';
import WebMCP from '../components/WebMCP.astro';
import { WEBMCP_ENABLED } from '../webmcp/flag';
import { organizationSchema, websiteSchema } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'product';
  keywords?: string;
}

const { title, description, canonical, ogImage, noindex, type, keywords } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <!-- Фавикон — фирменный знак из брендового пакета (без перерисовки) -->
    <link rel="icon" type="image/png" href="/brand/bizsoft-favicon.png" />
    <link rel="apple-touch-icon" href="/brand/bizsoft-favicon.png" />
    <link rel="preload" href={ralewayCyr400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ralewayCyr700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ralewayLat400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={prostoCyr400} as="font" type="font/woff2" crossorigin />
    <noscript>
      <style>
        /* Без JS секции с плавным появлением остаются видимыми */
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
    <SeoHead title={title} description={description} canonical={canonical} ogImage={ogImage} noindex={noindex} type={type} keywords={keywords} />
    <JsonLd schema={[organizationSchema(), websiteSchema()]} />
  </head>
  <body>
    <a href="#main" class="skip-link">К содержимому</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <CookieNotice />
    {WEBMCP_ENABLED && <WebMCP />}

    <style is:global>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-accent);
        color: #fff;
        padding: 0.6rem 1rem;
        z-index: 100;
        border-radius: 0 0 8px 0;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>

    <script>
      // Источник визита фиксируется до любых действий пользователя: заявка,
      // отправленная через минуту, должна знать, откуда человек пришёл.
      import { captureVisit } from '@/lib/attribution';
      captureVisit();

      // Клики по CTA с атрибутом data-goal.
      //
      // Атрибут стоял на главных кнопках сайта — «Получить КП» в шапке, герой
      // главной, каталог, страницы сравнения — и выглядел как разметка целей,
      // но слушателя не имел ни одного: ни один клик никуда не уходил.
      // Привязка живёт в макете, а не в каждом компоненте: иначе следующая
      // кнопка снова окажется размеченной и неподключённой.
      import { trackGoal } from '@/lib/analytics';
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement)?.closest?.('[data-goal]') as HTMLElement | null;
        if (!el) return;
        const name = el.dataset.goal;
        if (name) trackGoal(name, { page_url: location.pathname });
      });

      // Плавное появление секций (уважает prefers-reduced-motion через CSS)
      const reveal = () => {
        const els = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window) || els.length === 0) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      };
      reveal();
      document.addEventListener('astro:after-swap', reveal);

      // Подсветка иконок на тач-устройствах: плитка с иконкой (.vi) получает
      // класс vi-lit, пока находится в центральной полосе экрана (средние 30%,
      // rootMargin -35% сверху и снизу), — цветной слой включается CSS-правилом
      // в global.css (@media (hover: none)). При уходе вверх/вниз класс
      // снимается — иконка возвращается в монохром. Ряд плиток входит в полосу
      // одновременно, поэтому зажигается целиком. На устройствах с ховером
      // скрипт не запускается — там работает обычный hover.
      const viLit = () => {
        if (!window.matchMedia('(hover: none)').matches || !('IntersectionObserver' in window)) return;
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.target.classList.toggle('vi-lit', e.isIntersecting)),
          { rootMargin: '-35% 0px -35% 0px' },
        );
        const seen = new WeakSet<Element>();
        const watch = (vi: Element) => {
          const tile = vi.closest('a, button, .card, .card-hover') ?? vi;
          if (seen.has(tile)) return;
          seen.add(tile);
          io.observe(tile);
        };
        const scan = (root: Element | Document) => {
          if (root instanceof Element && root.matches('.vi')) watch(root);
          root.querySelectorAll('.vi').forEach(watch);
        };
        scan(document);
        // Часть списков (например, витрины из Directus) дорисовывается
        // клиентскими скриптами — подхватываем добавленные плитки.
        new MutationObserver((muts) => {
          for (const m of muts) {
            m.addedNodes.forEach((n) => {
              if (n.nodeType === 1) scan(n as Element);
            });
          }
        }).observe(document.body, { childList: true, subtree: true });
      };
      viLit();
      document.addEventListener('astro:after-swap', viLit);
    </script>
      <script>
      // Клики по телефону, почте и мессенджерам — одним обработчиком на сайт.
      import { initContactGoals } from '../lib/contact-goals';
      initContactGoals();
    </script>
  </body>
</html>

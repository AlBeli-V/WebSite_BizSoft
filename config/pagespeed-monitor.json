      },
      {
        "path": "/product/heygen-business",
        "pageType": "product"
      },
      {
        "path": "/product/cdr-gs-sub",
        "pageType": "product"
      },
      {
        "path": "/blog/kak-oplatit-coreldraw-dlya-yurlica",

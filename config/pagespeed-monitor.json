{
  "schema_version": "1.0.0",
  "base": "https://biz-soft.pro",
  "note": "Наблюдение за скоростью сайта. Ежедневно меряются три представителя основных шаблонов, раз в неделю — расширенная выборка по трём прогонам (медиана). Только мобильная стратегия: по ней идёт основной трафик и принимаются решения, а десктопный замер отчёт всё равно не показывает. Адреса живут здесь, а не в workflow, чтобы менять их без правки прогона.",
  "daily": {
    "strategy": "mobile",
    "runs": 1,
    "urls": [
      {
        "path": "/",
        "pageType": "homepage",
        "why": "точка входа бренда и самая посещаемая страница"
      },
      {
        "path": "/vendors/anthropic",
        "pageType": "vendor",
        "why": "шаблон вендорской страницы; кластер SEO-EXP-003, позиции 2-7"
      },
      {
        "path": "/product/chatgpt-business",
        "pageType": "product",
        "why": "шаблон карточки товара с ценой и микроразметкой"
      }
    ]
  },
  "weekly": {
    "strategy": "mobile",
    "runs": 3,

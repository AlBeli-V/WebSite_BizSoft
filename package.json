{
  "name": "bizsoft-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "BizSoft (biz-soft.pro) — маркетинговый B2B-сайт на Astro + Directus",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-logos.mjs && astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/ci/smoke.mjs",
    "check:metrika": "node scripts/ci/metrika-check.mjs",
    "test:webmcp-browser": "node scripts/ci/webmcp-browser.mjs",
    "check:mobile": "node scripts/ci/mobile-layout.mjs",
    "check:artifacts": "node scripts/ci/check-artifacts.mjs",
    "verify": "pnpm test && pnpm typecheck && pnpm build && pnpm check:artifacts && pnpm smoke && pnpm check:metrika",
    "directus:schema": "node scripts/directus-setup.mjs",
    "ai:cards": "node scripts/build-vendor-cards.mjs scripts/ai-catalog-cards.json out/ai-cards.xlsx",
    "ai:import": "node scripts/import-cards.mjs out/ai-cards.xlsx",
    "check:serp-reference": "node scripts/ci/serp-reference-check.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^9.1.3",
    "@astrojs/sitemap": "^3.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.0.6",
    "astro": "^5.3.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.7.1",
    "jpeg-js": "^0.4.4",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.16.0",
    "tailwindcss": "^4.0.6",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "playwright": "^1.62.1",
    "sharp": "^0.34.5",
    "simple-icons": "^16.25.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

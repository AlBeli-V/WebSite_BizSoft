# Jail fail2ban против сканеров-переборщиков по 404/444.
# Ставится в /etc/fail2ban/jail.d/nginx-noscript.local на сервере (нужен root).
# fail2ban-server уже запущен на хосте — достаточно добавить этот jail и
# перезапустить сервис: systemctl reload fail2ban
#
# Логика: >40 «мусорных» ответов (404/444/403/400) с одного IP за 10 минут →
# бан на 24 часа. Легитимные пользователи столько 404 не собирают.

# Исключения (SEO-GBOT-002). Первый разрез логов по ботам 08.09.2026 показал
# 3002 ответа 404 за неделю на /wp-config.php, /.git/index, /.env и /yarn.lock
# с адресов 94.154.46.243–247, представлявшихся Googlebot. Сканер jail и
# ловит — это его работа. Но правило «>40 мусорных ответов за 10 минут = бан
# на сутки» не различает, кто их набрал: настоящий Googlebot, дойдя до партии
# снятых с публикации карточек, набрал бы порог так же и замолчал бы на сутки.
# Обход — единственный дефицитный ресурс сайта (490 из 729 путей инвентаря не
# скачаны ни разу, подтверждённый обход Googlebot — единицы запросов в сутки),
# и терять его на собственной защите нельзя.
#
# Диапазоны — публичные сети поисковиков. Подделать их нельзя: адрес
# соединения не заголовок, а самозванцы из примера выше как раз в них не
# попадают и банятся по-прежнему.
ignoreip = 127.0.0.1/8 ::1
           66.249.64.0/19
           64.233.160.0/19 66.102.0.0/20 72.14.192.0/18 74.125.0.0/16
           209.85.128.0/17 216.239.32.0/19
           5.45.192.0/18 5.255.192.0/18 37.9.64.0/18 77.88.0.0/18
           87.250.224.0/19 93.158.128.0/18 95.108.128.0/17
           141.8.128.0/18 178.154.128.0/17 213.180.192.0/19
           40.77.160.0/19 157.55.32.0/20 207.46.0.0/16

[nginx-noscript]
enabled  = true
port     = http,https
filter   = nginx-noscript
logpath  = /var/log/nginx/access.log
findtime = 600
maxretry = 40
bantime  = 86400

# Снято с прода 20.08.2026 воркфлоу ops-server-config (/etc/nginx/sites-enabled/biz-soft.conf).
# Это НЕ шаблон для применения — фактическое состояние сервера на дату снятия,
# чтобы было с чем сверять deploy/nginx-biz-soft.conf.template (расхождение BLD-003).
server {
    server_name biz-soft.pro www.biz-soft.pro;
    # Единый URL-стандарт: 301 со слеша на без-слеша (кроме корня "/"), с сохранением query.
    if ($uri ~ "^/(.+)/$") { return 301 /$1$is_args$args; }
    # Статика Astro (хешированные ассеты) — длинный кэш.
    location /_astro/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
    listen [::]:443 ssl http2 ipv6only=on; # managed by Certbot
    listen 443 ssl http2; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/biz-soft.pro/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/biz-soft.pro/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}
server {
    if ($host = www.biz-soft.pro) {
        return 301 https://$host$request_uri;
    } # managed by Certbot
    if ($host = biz-soft.pro) {
        return 301 https://$host$request_uri;
    } # managed by Certbot
    listen 80;
    listen [::]:80;
    server_name biz-soft.pro www.biz-soft.pro;
    return 404; # managed by Certbot
}
